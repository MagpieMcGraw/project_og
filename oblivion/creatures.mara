// `oblivion creatures`: every creature (CREA) put together as the viewer
// puts it together, headless — its look read, its skeleton and
// animations, its meshes made — and what couldn't be, counted: how many
// of each kind of failure, and the first creature with each. To see what
// the game's creatures need that isn't read yet. `oblivion creatures
// placed [editor id]`: where Tamriel's are placed (creatures_placed).
module oblivion

use mara.core
use mara.os
use mara.math
use mara.memory
use mara.time
use mara.string
use bsa
use world
use scene
use logging
use indexing
use esm

// A kind of failure the sweep counted: what failed (its stage) and why,
// how many creatures, the first's editor id.
Creature_Failure :: struct {
	stage: str64
	reason: err
	count: i64
	first: str64
}

command_creatures :: fun(placed: bool, wanted: []utf8) {
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&index_storage)
	if load_error {
		print("couldn't load the plugins: %", load_error)
		return
	}
	directory_storage : [64 * MB]byte
	archives : Archives
	open_error := open_all_archives(&archives, &directory_storage)
	if open_error {
		print("couldn't open the archives: %", open_error)
		return
	}
	defer close_archives(&archives)
	if placed {
		creatures_placed(&plugin, wanted)
		return
	}
	file_room : [16 * MB]byte = void
	block_room : [16 * MB]byte = void
	model_room : [64 * MB]byte = void
	texture_room : [1 * KB]byte = void
	file_room.len = 0
	block_room.len = 0
	model_room.len = 0
	texture_room.len = 0
	room := load_room(&file_room, &block_room, &model_room, &texture_room)
	failures : [32]Creature_Failure
	creatures : i64 = 0
	whole_ones : i64 = 0
	walking : i64 = 0
	running : i64 = 0
	scratch : [64 * KB]byte = void
	skeleton : Npc_Skeleton = void
	started := time_now()
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		if record_header_at(&plugin, i64(plugin.records.values[slot])).kind != "CREA" do continue
		creatures += 1
		scratch.len = 0
		record, _ := record_at(&plugin, i64(plugin.records.values[slot]), &scratch)
		name : str64
		add_what_fits(&name, editor_id(record.data))
		look : Npc_Look
		look_error := read_actor_look(&plugin, &archives, u32(key), &look)
		if look_error {
			count_failure(&failures, "its look", look_error, name)
			continue
		}
		skeleton_error := read_skeleton(&archives, &room, &look, &skeleton)
		if skeleton_error {
			count_failure(&failures, "its skeleton or idle", skeleton_error, name)
			continue
		}
		if skeleton.motion_failure do count_failure(&failures, "a walk or a run", skeleton.motion_failure, name)
		if skeleton.walk.rig.len > 0 do walking += 1
		if skeleton.run.rig.len > 0 do running += 1
		report := Npc_Report{failures = 0, first = [], reason = Not_In_Archive}
		skins : [4]Face_Skin
		skin_storage : [1 * KB]byte
		_ = assemble_npc(&archives, &room, &look, skeleton.bones, true, &report, &skins, &skin_storage)
		if report.failures > 0 {
			count_failure(&failures, "a mesh", report.reason, name)
			continue
		}
		whole_ones += 1
	}
	print("% creatures in % ms: % put together whole; % walk, % run", creatures, elapsed_ms(started), whole_ones, walking, running)
	for failure in failures do print("  % (%): % creatures, the first %", failure.stage, failure.reason, failure.count, failure.first)
}

// Where Tamriel's creatures are placed: its cells' creature references
// (and its persistent cell's), how many are disabled (a quest brings them
// in), how many leveled ones come to none (their list's chance of none),
// and how many cells have any — the creatures a player meets outside.
// Given a creature's editor id, also where it stands (the first 10), a
// leveled one as its list gives that placing.
creatures_placed :: fun(plugin: ^Plugin, wanted: []utf8) {
	scratch : [64 * KB]byte = void
	scratch.len = 0
	tamriel := find_world(plugin, "Tamriel", &scratch)
	if tamriel == 0 {
		print("no world Tamriel")
		return
	}
	cells : i64 = 0
	cells_with : i64 = 0
	placed : i64 = 0
	disabled : i64 = 0
	leveled : i64 = 0
	none : i64 = 0
	shown_at : i64 = 0
	references : [16384]Reference = void
	for key, slot in plugin.exterior_cells.keys {
		if key == 0 or u32(key >> 32) != tamriel do continue
		cells += 1
		references.len = 0
		_ = cell_references(plugin, plugin.exterior_cells.values[slot], &references)
		here : i64 = 0
		for reference in references {
			at, found := index_get(&plugin.records, u64(reference.base))
			if not found do continue
			kind := record_header_at(plugin, at).kind
			if kind != "CREA" and kind != "LVLC" do continue
			placed += 1
			if reference.flags & RECORD_DISABLED != 0 {
				disabled += 1
				continue
			}
			creature := reference.base
			if kind == "LVLC" {
				leveled += 1
				creature = leveled_form(plugin, reference.base, u64(reference.form_id))
				if creature == 0 {
					none += 1
					continue
				}
			}
			here += 1
			if wanted.len > 0 and shown_at < 10 {
				scratch.len = 0
				record, record_error := find_record(plugin, creature, &scratch)
				if not record_error and editor_id(record.data) == wanted {
					cell_key := key & 0xFFFFFFFF
					print("  % at % (grid % %)", wanted, reference.position, i64(i16(u16(cell_key >> 16))), i64(i16(u16(cell_key & 0xFFFF))))
					shown_at += 1
				}
			}
		}
		if here > 0 do cells_with += 1
	}
	print("Tamriel: % cells; % creatures placed in them (% disabled), % leveled (% of those come to none); % cells with one",
		cells, placed, disabled, leveled, none, cells_with)
}

// Counts a creature's failure with those of its stage and reason.
count_failure :: fun(failures: ^[]Creature_Failure, stage: []utf8, reason: err, name: []utf8) {
	for &failure in failures {
		if failure.stage == stage and failure.reason == reason {
			failure.count += 1
			return
		}
	}
	if not fits(failures.len + 1, failures.cap) do return
	failure := next(failures)
	failure.stage.len = 0
	add_what_fits(&failure.stage, stage)
	failure.reason = reason
	failure.count = 1
	failure.first.len = 0
	add_what_fits(&failure.first, name)
}
