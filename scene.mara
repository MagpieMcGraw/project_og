// What's drawn: the models the shown cells need, each loaded once, the
// instances of them placed by the cells' references, the lights they
// give, the land outside.
//
// What an instance needs to be drawn is worked out once, when it's placed:
// its matrix, a sphere around it, the lights that reach it (the lights
// don't move).
//
// Loading is spread over frames: a cell's references whose meshes aren't
// on the card yet wait in a queue (and land in another), and each frame
// loads from the queues for a few milliseconds. Arriving somewhere new
// loads everything at once; walking into the next cell outside doesn't.
module scene

use mara.core
use mara.math
use mara.string
use mara.memory
use mara.time
use bsa
use nif
use model
use render
use world
use esm
use land

// How many cells around the camera's are loaded outside: 2 is 5 by 5.
EXTERIOR_RADIUS :: 2

// A part of the world the grid's cells x and y go from low to high in.
Grid_Area :: struct {
	everywhere: bool   // no limit: an interior cell's
	low_x: i64
	low_y: i64
	high_x: i64
	high_y: i64
}

EVERYWHERE :: Grid_Area{everywhere = true, low_x = 0, low_y = 0, high_x = 0, high_y = 0}
NOWHERE :: Grid_Area{everywhere = false, low_x = 1, low_y = 1, high_x = 0, high_y = 0}

// Whether a place is in an area.
area_holds :: fun(area: Grid_Area, position: Vec3) -> bool {
	if area.everywhere do return true
	x, y := grid_of(position)
	return x >= area.low_x and x <= area.high_x and y >= area.low_y and y <= area.high_y
}

// A door in the scene that leads somewhere.
Scene_Door :: struct {
	reference: u32
	position: Vec3
}

// A reference waiting for its mesh to be put on the card.
Waiting_Instance :: struct {
	path: [256]utf8
	world: Mat4
}

// A cell waiting for its land to be put on the card.
Waiting_Land :: struct {
	cell: u32
	x: i64
	y: i64
}

// The models on the card, and what's drawn with them: instances, lights,
// doors, lighting, land — an interior cell's, or the exterior cells around
// the camera. Models stay loaded from cell to cell; land is let go when
// the camera leaves it behind.
Scene :: struct {
	models: [4096]Gpu_Model
	paths: Key_Index             // each mesh's model (+1; 0 when it couldn't be loaded), by the path's hash
	failed_paths: i64
	instances: [32768]Instance
	lights: [4096]Point_Light
	lights_changed: bool         // since the renderer was last given them (set_scene_lights)
	doors: [1024]Scene_Door
	lighting: Cell_Lighting
	world: u32                   // the world shown outside, 0 inside
	center_x: i64                // the cell the exterior was loaded around
	center_y: i64
	grounds: [LAND_SLOTS]Gpu_Land
	waters: [WATER_SLOTS]Water_Cell
	waters_changed: bool         // since the renderer was last given them (upload_waters)

	// What's still to load, in order, and how far along that is.
	waiting: [16384]Waiting_Instance
	waiting_next: i64
	waiting_land: [64]Waiting_Land
	waiting_land_next: i64
}

// Where the scene's models come from: the archives, and the renderer that
// puts them on the card, with the rooms loading uses.
Loader :: struct {
	renderer: ^Renderer
	meshes: ^Archive
	textures: ^Archive
	room: ^Load_Room
}

// The rooms loading uses: for a mesh's file, its blocks, its model, and
// for reading and decoding textures.
Load_Room :: struct {
	file: []byte
	blocks: []byte
	model: []byte
	texture: []byte
}

// An empty scene, its lighting daylight; its table of paths carved from
// storage.
scene_clear :: fun(scene: ^Scene, storage: ^[]byte) {
	scene.models.len = 0
	scene.paths = key_index(1 << 13, storage)
	scene.failed_paths = 0
	scene.grounds.len = 0
	scene.world = 0
	scene_clear_cell(scene)
}

// The scene without its cells: the models kept, nothing waiting.
scene_clear_cell :: fun(scene: ^Scene) {
	scene.instances.len = 0
	scene.lights.len = 0
	scene.lights_changed = true
	scene.doors.len = 0
	scene.waters.len = 0
	scene.waters_changed = true
	scene.lighting = DAYLIGHT
	scene.waiting.len = 0
	scene.waiting_next = 0
	scene.waiting_land.len = 0
	scene.waiting_land_next = 0
}

// ---- models ---------------------------------------------------------------------

// The scene's model for a mesh path: loaded the first time it's asked
// for. -1 when it can't be.
scene_model :: fun(scene: ^Scene, loader: Loader, path: []utf8) -> i64 {
	key := text_hash(path)
	known, found := index_get(&scene.paths, key)
	if found do return known - 1
	model_index := load_model(scene, loader, path)
	if model_index < 0 do scene.failed_paths += 1
	_ = index_put(&scene.paths, key, model_index + 1)
	return model_index
}

// Whether a mesh path's model has been asked for before: its index (-1
// when it couldn't be loaded), and false when it hasn't.
known_model :: fun(scene: ^Scene, path: []utf8) -> i64, bool {
	known, found := index_get(&scene.paths, text_hash(path))
	return known - 1, found
}

// Reads a mesh, makes its model and puts it on the card: its index in the
// scene's models, or -1.
load_model :: fun(scene: ^Scene, loader: Loader, path: []utf8) -> i64 {
	if scene.models.len == scene.models.cap do return -1
	room := loader.room
	index, found := find_file(loader.meshes, path)
	if not found do return -1
	room.file.len = 0
	data, read_error := read_file(loader.meshes, index, &room.file)
	if read_error do return -1

	room.blocks.len = 0
	failure := Nif_Failure{block = 0, type_name = room.file[0:0]}
	mesh, nif_error := read_nif(data, &room.blocks, &failure)
	if nif_error do return -1
	room.model.len = 0
	built, model_error := build_model(&mesh, &room.model)
	if model_error do return -1

	gpu, upload_error := upload_model(loader.renderer, built, loader.textures, &room.texture)
	if upload_error do return -1
	&scene.models + gpu
	return scene.models.len - 1
}

// Whether a mesh is an editor's marker, not drawn in the game: the
// markers' meshes are in meshes\ itself, named marker….
is_marker :: fun(path: []utf8) -> bool {
	return starts_with(path, "meshes\\marker")
}

// Places an instance of a model, when there's room: lit by the scene's
// lights as they are now (choose_all_lights does them all again).
add_instance :: fun(scene: ^Scene, model_index: i64, placement: Mat4) {
	if scene.instances.len == scene.instances.cap do return
	instance := next(&scene.instances)
	instance^ = place_instance(scene.models[model_index], model_index, placement)
	choose_lights(instance, &scene.lights)
}

// Chooses every instance's lights again: after a cell's lights are all known.
choose_all_lights :: fun(scene: ^Scene) {
	for &instance in scene.instances do choose_lights(instance, &scene.lights)
}

// ---- cells -----------------------------------------------------------------------

// Places a cell's references in the scene, those in area and not in placed
// (where they're placed already): their instances (or, for meshes not yet
// loaded, their places in the queue), the lights they give and the doors
// that lead somewhere.
add_cell :: fun(scene: ^Scene, plugin: ^Plugin, cell: u32, area: Grid_Area, placed: Grid_Area) -> err {
	references : [16384]Reference
	cell_references(plugin, cell, &references)?
	scratch : [4 * MB]byte
	for reference in references {
		if reference.flags & RECORD_DISABLED != 0 do continue
		if not area_holds(area, reference.position) or area_holds(placed, reference.position) do continue
		scratch.len = 0
		base, base_error := find_record(plugin, reference.base, &scratch)
		if base_error do continue

		light, gives_light := light_of(base, reference)
		if gives_light and scene.lights.len < scene.lights.cap {
			&scene.lights + light
			scene.lights_changed = true
		}
		if base.header.kind == "DOOR" and scene.doors.len < scene.doors.cap {
			_, leads := door_destination(plugin, reference.form_id, &scratch)
			if leads do &scene.doors + Scene_Door{reference = reference.form_id, position = reference.position}
		}

		path := model_path(base)
		if path.len == 0 or is_marker(path[:]) do continue
		model_index, known := known_model(scene, path[:])
		if known {
			if model_index >= 0 do add_instance(scene, model_index, reference_transform(reference))
		elif scene.waiting.len < scene.waiting.cap
			waiting := next(&scene.waiting)
			waiting.path.len = 0
			&waiting.path + path[:]
			waiting.world = reference_transform(reference)
		}
	}
}

// Loads what's waiting until it's all loaded (true) or budget nanoseconds
// have gone (false) — at least one thing each call. Land first.
load_waiting :: fun(scene: ^Scene, plugin: ^Plugin, loader: Loader, budget: u64) -> bool {
	start := time_now()
	for scene.waiting_land_next < scene.waiting_land.len {
		if time_now() - start > budget do return false
		item := scene.waiting_land[scene.waiting_land_next]
		scene.waiting_land_next += 1
		area := shown_area(scene)
		inside := item.x >= area.low_x and item.x <= area.high_x and item.y >= area.low_y and item.y <= area.high_y
		if inside do load_land(scene, plugin, item.cell, item.x, item.y, loader)
	}
	for scene.waiting_next < scene.waiting.len {
		if time_now() - start > budget do return false
		item := &scene.waiting[scene.waiting_next]
		scene.waiting_next += 1
		// (Outside, the camera may have moved on since it was queued.)
		place := Vec3{item.world[3][0], item.world[3][1], item.world[3][2]}
		if scene.world != 0 and not area_holds(shown_area(scene), place) do continue
		model_index := scene_model(scene, loader, item.path[:])
		if model_index >= 0 do add_instance(scene, model_index, item.world)
	}
	scene.waiting.len = 0
	scene.waiting_next = 0
	scene.waiting_land.len = 0
	scene.waiting_land_next = 0
	return true
}

// Whether anything is waiting to be loaded.
anything_waiting :: fun(scene: ^Scene) -> bool {
	return scene.waiting_next < scene.waiting.len or scene.waiting_land_next < scene.waiting_land.len
}

// Where one arrives in the scene's cell through one of its doors: the
// other side of a door here says where. False when no door here leads
// anywhere that leads back.
scene_entrance :: fun(scene: ^Scene, plugin: ^Plugin) -> Door_Destination, bool {
	scratch : [4 * MB]byte
	for door in scene.doors {
		scratch.len = 0
		there, leads := door_destination(plugin, door.reference, &scratch)
		if not leads do continue
		back, leads_back := door_destination(plugin, there.door, &scratch)
		if leads_back and back.door == door.reference do return back, true
	}
	return Door_Destination{door = 0, position = Vec3{0, 0, 0}, rotation = Vec3{0, 0, 0}}, false
}

// Shows an interior cell: its references and its lighting, in place of
// what the scene showed, all loaded.
show_interior :: fun(scene: ^Scene, plugin: ^Plugin, cell: u32, loader: Loader) -> err {
	drop_land(scene, EVERYWHERE, true)
	scene_clear_cell(scene)
	scene.world = 0
	scratch : [1 * MB]byte
	scene.lighting = cell_lighting(plugin, cell, &scratch)
	add_cell(scene, plugin, cell, EVERYWHERE, NOWHERE)?
	_ = load_waiting(scene, plugin, loader, 0xFFFFFFFFFFFFFFFF)
	choose_all_lights(scene)

	// Water inside (sewers, caves): a plane under all that's placed.
	height, has_water := cell_water(plugin, cell, &scratch)
	if has_water and scene.instances.len > 0 {
		low := Vec3{1000000, 1000000, 0}
		high := Vec3{-1000000, -1000000, 0}
		for instance in scene.instances {
			if instance.center.x < low.x do low.x = instance.center.x
			if instance.center.y < low.y do low.y = instance.center.y
			if instance.center.x > high.x do high.x = instance.center.x
			if instance.center.y > high.y do high.y = instance.center.y
		}
		water := next(&scene.waters)
		water.low_x = low.x - 4096
		water.low_y = low.y - 4096
		water.high_x = high.x + 4096
		water.high_y = high.y + 4096
		water.height = height
		for k in 0:WATER_VERTICES do water.depths[k] = 1000   // (deep: there's no land under it to know)
		scene.waters_changed = true
	}
}

// ---- outside ------------------------------------------------------------------------

// The area of cells loaded around a cell.
area_around :: fun(x: i64, y: i64) -> Grid_Area {
	return Grid_Area{everywhere = false,
		low_x = x - EXTERIOR_RADIUS, low_y = y - EXTERIOR_RADIUS,
		high_x = x + EXTERIOR_RADIUS, high_y = y + EXTERIOR_RADIUS}
}

// Lets go of the land outside an area (all of it, when all): its slots
// free for other land.
drop_land :: fun(scene: ^Scene, area: Grid_Area, all: bool) {
	k : i64 = 0
	for k < scene.grounds.len {
		ground := scene.grounds[k]
		inside := ground.x >= area.low_x and ground.x <= area.high_x and ground.y >= area.low_y and ground.y <= area.high_y
		if all or not inside {
			scene.grounds[k] = scene.grounds[scene.grounds.len - 1]
			scene.grounds.len -= 1
		else
			k += 1
		}
	}
}

// Whether the land of the cell at x, y is on the card.
land_loaded :: fun(scene: ^Scene, x: i64, y: i64) -> bool {
	for ground in scene.grounds {
		if ground.x == x and ground.y == y do return true
	}
	return false
}

// A land slot no land is in, -1 when all are taken.
free_land_slot :: fun(scene: ^Scene) -> i64 {
	for slot in 0:LAND_SLOTS {
		taken := false
		for ground in scene.grounds {
			if ground.slot == slot do taken = true
		}
		if not taken do return slot
	}
	return -1
}

// Puts a cell's land on the card, unless it's there or the cell has none.
load_land :: fun(scene: ^Scene, plugin: ^Plugin, cell: u32, x: i64, y: i64, loader: Loader) {
	if land_loaded(scene, x, y) do return
	slot := free_land_slot(scene)
	if slot < 0 do return
	land_at, found := find_land(plugin, cell)
	if not found do return
	room := loader.room
	room.file.len = 0
	record, record_error := record_at(plugin, land_at, &room.file)
	if record_error do return
	cell_land : Land
	read_land(record.data, &cell_land)
	mesh : Land_Mesh
	build_land_mesh(plugin, &cell_land, x, y, &mesh)
	&scene.grounds + upload_land(loader.renderer, &mesh, x, y, slot, loader.textures, &room.texture)
}

// The lighting outside, until weather is read: daylight, and fog hiding
// where the loaded cells end.
exterior_lighting :: fun() -> Cell_Lighting {
	lighting := DAYLIGHT
	lighting.fog_near = CELL_SIZE * EXTERIOR_RADIUS * 0.5
	lighting.fog_far = CELL_SIZE * (EXTERIOR_RADIUS + 0.5)
	return lighting
}

// The area of cells shown outside: around the cell it was loaded around.
shown_area :: fun(scene: ^Scene) -> Grid_Area {
	return area_around(scene.center_x, scene.center_y)
}

// Shows a world's cells around the one at x, y: their land and references,
// and the world's persistent references among them. What's on the card
// already shows at once; the rest waits to be loaded, the nearest cells'
// first.
//
// Moving within the world shown, only what's changed is: what's left the
// area is let go, and only the cells come into it are read and placed.
show_exterior :: fun(scene: ^Scene, plugin: ^Plugin, world_id: u32, x: i64, y: i64) -> err {
	area := area_around(x, y)
	placed := NOWHERE   // what's placed already, and stays
	if scene.world == world_id {
		placed = shown_area(scene)
		drop_outside(scene, area)
	else
		drop_land(scene, area, true)
		scene_clear_cell(scene)
		scene.lighting = exterior_lighting()
	}
	scene.world = world_id
	scene.center_x = x
	scene.center_y = y

	// Ring by ring outward from the middle: the nearest wait first.
	for ring in 0..EXTERIOR_RADIUS {
		for cell_y in y - ring..y + ring {
			for cell_x in x - ring..x + ring {
				on_ring := cell_x == x - ring or cell_x == x + ring or cell_y == y - ring or cell_y == y + ring
				if not on_ring do continue
				already := cell_x >= placed.low_x and cell_x <= placed.high_x and cell_y >= placed.low_y and cell_y <= placed.high_y
				if already do continue
				cell := exterior_cell(plugin, world_id, cell_x, cell_y)
				if cell == 0 do continue
				if not land_loaded(scene, cell_x, cell_y) and scene.waiting_land.len < scene.waiting_land.cap {
					&scene.waiting_land + Waiting_Land{cell = cell, x = cell_x, y = cell_y}
				}
				add_cell_water(scene, plugin, cell, cell_x, cell_y)
				add_cell(scene, plugin, cell, EVERYWHERE, NOWHERE)?
			}
		}
	}
	persistent := persistent_cell(plugin, world_id)
	if persistent != 0 do add_cell(scene, plugin, persistent, area, placed)?
	choose_all_lights(scene)
	scene.lights_changed = true
}

// Lets go of what's placed outside an area: instances, lights and doors by
// where they are, and land. The instances' lights are chosen again after,
// as the lights' places in the list move.
drop_outside :: fun(scene: ^Scene, area: Grid_Area) {
	kept : i64 = 0
	for k in 0:scene.instances.len {
		placement := scene.instances[k].world
		if area_holds(area, Vec3{placement[3][0], placement[3][1], placement[3][2]}) {
			scene.instances[kept] = scene.instances[k]
			kept += 1
		}
	}
	scene.instances.len = kept

	kept = 0
	for k in 0:scene.lights.len {
		if area_holds(area, scene.lights[k].position) {
			scene.lights[kept] = scene.lights[k]
			kept += 1
		}
	}
	scene.lights.len = kept

	kept = 0
	for k in 0:scene.doors.len {
		if area_holds(area, scene.doors[k].position) {
			scene.doors[kept] = scene.doors[k]
			kept += 1
		}
	}
	scene.doors.len = kept

	kept = 0
	for k in 0:scene.waters.len {
		water := &scene.waters[k]
		middle := Vec3{(water.low_x + water.high_x) / 2, (water.low_y + water.high_y) / 2, 0}
		if area_holds(area, middle) {
			if kept != k do scene.waters[kept] = scene.waters[k]
			kept += 1
		}
	}
	if kept != scene.waters.len do scene.waters_changed = true
	scene.waters.len = kept

	drop_land(scene, area, false)
	// What still waits is let go as it comes up, if it's left the area.
}

// Adds an exterior cell's water, if it has any and any of it is above the
// land: over the cell, its depth at each of the land's points.
add_cell_water :: fun(scene: ^Scene, plugin: ^Plugin, cell: u32, x: i64, y: i64) {
	scratch : [256 * KB]byte
	height, has_water := cell_water(plugin, cell, &scratch)
	if not has_water or scene.waters.len == scene.waters.cap do return
	// Deep where there's no land under it to know.
	depths : [WATER_VERTICES!]f32
	for k in 0:WATER_VERTICES do depths[k] = 1000
	land_at, has_land := find_land(plugin, cell)
	if has_land {
		scratch.len = 0
		record, record_error := record_at(plugin, land_at, &scratch)
		if record_error do return
		cell_land : Land
		read_land(record.data, &cell_land)
		// All of the land above the water: none to draw.
		under := false
		for k in 0:WATER_VERTICES {
			depths[k] = height - cell_land.heights[k]
			if depths[k] > 0 do under = true
		}
		if not under do return
	}
	water := next(&scene.waters)
	water.low_x = f32(x * CELL_SIZE)
	water.low_y = f32(y * CELL_SIZE)
	water.high_x = f32((x + 1) * CELL_SIZE)
	water.high_y = f32((y + 1) * CELL_SIZE)
	water.height = height
	water.depths = depths
	scene.waters_changed = true
}
