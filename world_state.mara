// The world as it is, apart from how anyone sees it: what a server will
// own and tell its players, stepped as a server would step it — on a fixed
// tick (WORLD_TICK), not with the frames drawn.
//
// For now: its clock; its sky's climate and weather (by form id: what a
// weather looks and sounds like is the viewer's to read), rolled from the
// world's own seed; its players — where each is, as their client reports
// it, the place they're in and the people in it, as they stand; the doors
// that open in place, open or shut. (The sky's one for all the players:
// the climate of the world the last came into.)
module world_state

use mara.core
use mara.math
use mara.time
use mara.memory
use mara.string
use esm
use world
use sky
use logging

// The world steps this often (seconds of real time), and at most this
// many times to catch up after a long frame (more are let go).
WORLD_TICK :: 0.03333333
MOST_TICKS_AT_ONCE :: 8
// How much faster than ours the game's day goes (Oblivion's own), and,
// hurried (T held), how much faster again.
TIME_SCALE :: 30
HURRIED_TIME_SCALE :: 2000
// How long a weather stays before the next is chosen, in the game's hours.
WEATHER_LEAST_HOURS :: 4
WEATHER_MOST_HOURS :: 8
// The hour the world starts at.
START_HOUR :: 10
// The players, the people in a player's place, and the doors the world
// keeps, at most.
MAX_PLAYERS :: 8
WORLD_ACTORS :: 512
WORLD_DOORS :: 1024

// A player, as their client reports them: their number (0: no one in this
// slot), the world they're in (0 inside), where their feet are, which way
// they face (radians from north toward east), whether they hurry time; the
// place they're in — an interior (place_cell), or a world's cells round
// place_x, place_y (place_world) — and the people in it (NPCs placed,
// ACHR), as they stand now: where, turned how, how big.
Player_State :: struct {
	id: i64
	world: u32
	feet: Vec3
	yaw: f32
	hurried: bool
	place_world: u32
	place_cell: u32
	place_x: i64
	place_y: i64
	actors: [WORLD_ACTORS]Reference
}

// A door that opens in place, as the world has it: open or shut, and when
// it last changed (the world's seconds). One the world hasn't is shut.
Door_State :: struct {
	reference: u32
	open: bool
	since: f64
}

World_State :: struct {
	// The clock: the game's hour (0 to 24) and its days gone; how long the
	// world has run (seconds of real time), in ticks; whether time's
	// hurried (the player holds T).
	hour: f32
	day: i64
	seconds: f64
	ticks: i64
	hurried: bool
	// The sky: its climate (a CLMT's, read: its form id 0 for the default;
	// inside an interior lit by the sky, that interior's), and whether one's
	// been taken yet; the weathers that may come where the player is. Its
	// weather: the one coming in and the one going out (form ids; 0 for
	// none yet), how far in the new one is (0 to 1), how long it takes to
	// come in and how long it stays before the next is chosen (the game's
	// hours); the seed every choice is rolled from.
	climate: Climate
	sky_taken: bool
	weathers_here: [16]Weather_Chance
	weather: u32
	last_weather: u32
	weather_share: f32
	weather_transition: f32
	weather_hours_left: f32
	weather_seed: u64
	// The players: a slot for each that may join.
	players: [MAX_PLAYERS!]Player_State
	// The doors that open in place that have been opened (or shut again).
	doors: [WORLD_DOORS]Door_State
}

// A world starting: its clock at START_HOUR of its first day, no sky yet,
// its seed from the time it starts.
world_start :: fun(state: ^World_State) {
	state.hour = START_HOUR
	state.day = 0
	state.seconds = 0
	state.ticks = 0
	state.hurried = false
	state.climate = default_climate()
	state.sky_taken = false
	state.weathers_here.len = 0
	state.weather = 0
	state.last_weather = 0
	state.weather_share = 1
	state.weather_transition = 1
	state.weather_hours_left = 0
	state.weather_seed = time_now() | 1
	for &player in state.players do player_clear(player, 0)
	state.doors.len = 0
}

// Steps the world a tick (WORLD_TICK of real time): the clock on (faster
// hurried), the weather coming in further, and when its hours are up the
// next chosen (see world_change_weather for what it fails with).
world_step :: fun(state: ^World_State, plugin: ^Plugin) -> err {
	state.ticks += 1
	state.seconds += WORLD_TICK
	hours := world_tick_hours(state)
	state.hour += hours
	if state.hour >= 24 {
		state.hour -= 24
		state.day += 1
	}
	if not state.sky_taken do return
	state.weather_share = min(1, state.weather_share + hours / max(state.weather_transition, 0.01))
	state.weather_hours_left -= hours
	if state.weather_hours_left <= 0 do world_change_weather(state, plugin, false)?
}

// An hour of the game's day as a clock shows it: 07:03.
clock_text :: fun(hour: f32) -> [8]utf8 {
	text : [8]utf8
	whole_hours := i64(hour)
	minutes := i64((hour - f32(whole_hours)) * 60)
	if whole_hours < 10 do &text + "0"
	&text + int_text(whole_hours)
	&text + ":"
	if minutes < 10 do &text + "0"
	&text + int_text(minutes)
	return text
}

// The game's hours a tick moves the clock on: by TIME_SCALE, or hurried
// by HURRIED_TIME_SCALE.
world_tick_hours :: fun(state: ^World_State) -> f32 {
	scale : f32 = if state.hurried do HURRIED_TIME_SCALE else TIME_SCALE
	return WORLD_TICK * scale / 3600
}

// A player's slot made empty, or theirs (id) from the start: nowhere yet.
player_clear :: fun(player: ^Player_State, id: i64) {
	player.id = id
	player.world = 0
	player.feet = Vec3{0, 0, 0}
	player.yaw = 0
	player.hurried = false
	player.place_world = 0
	player.place_cell = 0
	player.place_x = 0
	player.place_y = 0
	player.actors.len = 0
}

// Takes a climate for the sky: the weathers that may come where a player
// is. The weather goes on under the same climate (from Tamriel into a
// city, and back); a first climate, or another, starts one of its own at
// once. Taken whatever fails (the first failure given back).
world_take_climate :: fun(state: ^World_State, plugin: ^Plugin, climate: ^Climate, player: ^Player_State) -> err {
	same := state.sky_taken and climate.form_id == state.climate.form_id
	state.climate = climate^
	state.sky_taken = true
	_, regions_error := world_weathers_here(state, plugin, player)
	weather_error : err
	if not same do weather_error = world_change_weather(state, plugin, true)
	return if regions_error do regions_error else weather_error
}

// The weathers that may come where a player is: their cell's regions', or
// the climate's (those too where the regions can't be read: why given
// back). True when they're not the ones that could before.
world_weathers_here :: fun(state: ^World_State, plugin: ^Plugin, player: ^Player_State) -> bool, err {
	scratch : [256 * KB]byte
	x, y := grid_of(player.feet)
	found : [16]Weather_Chance
	region_error := cell_weathers(plugin, player.world, x, y, &found, &scratch)
	if region_error do found.len = 0
	if found.len == 0 do found = state.climate.weathers
	same := found.len == state.weathers_here.len
	if same {
		for possible, k in found {
			if possible.weather != state.weathers_here[k].weather do same = false
		}
	}
	state.weathers_here = found
	return not same, region_error
}

// Chooses the next weather among those that may come here, by their
// chances, and how long it stays: coming in over its own time, or at once.
// (A weather whose record can't be read comes in as the default would;
// why's given back.)
world_change_weather :: fun(state: ^World_State, plugin: ^Plugin, at_once: bool) -> err {
	state.weather_hours_left = WEATHER_LEAST_HOURS + (WEATHER_MOST_HOURS - WEATHER_LEAST_HOURS) * random_share(&state.weather_seed)
	chosen := pick_weather(&state.weathers_here, random_share(&state.weather_seed))
	if chosen == state.weather and not at_once do return
	scratch : [256 * KB]byte
	weather, weather_error := read_weather(plugin, chosen, &scratch)
	if weather_error do weather = default_weather()
	state.last_weather = if at_once do chosen else state.weather
	state.weather = chosen
	state.weather_transition = weather.transition
	state.weather_share = if at_once do 1 else 0
	return weather_error
}

// ---- the people, the doors -------------------------------------------------------

// Takes an interior as the place a player's in: the people in it.
player_take_interior :: fun(player: ^Player_State, plugin: ^Plugin, cell: u32) -> err {
	player.place_world = 0
	player.place_cell = cell
	player.actors.len = 0
	add_actors(player, plugin, cell, EVERYWHERE, NOWHERE)?
}

// Takes a world's cells round the one at x, y as the place a player's
// in: the people in them and in the world's persistent cell there. Moving
// within the world, those still in it stay as they are, those out of it
// go, and only the cells come into it are read. All its cells are read
// whatever fails (the first failure given back).
player_take_area :: fun(player: ^Player_State, plugin: ^Plugin, world_id: u32, x: i64, y: i64) -> err {
	area := area_around(x, y)
	kept := NOWHERE
	if player.place_world == world_id and player.place_cell == 0 {
		kept = area_around(player.place_x, player.place_y)
		staying : i64 = 0
		for k in 0:player.actors.len {
			if not area_holds(area, player.actors[k].position) do continue
			player.actors[staying] = player.actors[k]
			staying += 1
		}
		player.actors.len = staying
	else
		player.actors.len = 0
	}
	player.place_world = world_id
	player.place_cell = 0
	player.place_x = x
	player.place_y = y
	first_error : err
	for cell_y in area.low_y..area.high_y {
		for cell_x in area.low_x..area.high_x {
			if cell_x >= kept.low_x and cell_x <= kept.high_x and cell_y >= kept.low_y and cell_y <= kept.high_y do continue
			cell := exterior_cell(plugin, world_id, cell_x, cell_y)
			if cell == 0 do continue
			cell_error := add_actors(player, plugin, cell, EVERYWHERE, NOWHERE)
			if cell_error and not first_error do first_error = cell_error
		}
	}
	persistent := persistent_cell(plugin, world_id)
	if persistent != 0 {
		persistent_error := add_actors(player, plugin, persistent, area, kept)
		if persistent_error and not first_error do first_error = persistent_error
	}
	return first_error
}

// Adds a cell's people (those not disabled) in an area and not in kept.
add_actors :: fun(player: ^Player_State, plugin: ^Plugin, cell: u32, area: Grid_Area, kept: Grid_Area) -> err {
	references : [16384]Reference = void
	references.len = 0
	cell_references(plugin, cell, &references)?
	for reference in references {
		if reference.flags & RECORD_DISABLED != 0 do continue
		if not area_holds(area, reference.position) or area_holds(kept, reference.position) do continue
		base_at, found := index_get(&plugin.records, u64(reference.base))
		if not found or record_header_at(plugin, base_at).kind != "NPC_" do continue
		if not fits(player.actors.len + 1, player.actors.cap) do break
		&player.actors + reference
	}
}

// Opens a shut door that opens in place, or shuts an open one, now (the
// world's seconds): whether it's open after.
world_use_door :: fun(state: ^World_State, reference: u32) -> bool {
	for &door in state.doors {
		if door.reference != reference do continue
		door.open = not door.open
		door.since = state.seconds
		return door.open
	}
	if not fits(state.doors.len + 1, state.doors.cap) do return false
	&state.doors + Door_State{reference = reference, open = true, since = state.seconds}
	return true
}

// Whether a door that opens in place is open (one the world hasn't is shut).
world_door_open :: fun(state: ^World_State, reference: u32) -> bool {
	for door in state.doors {
		if door.reference == reference do return door.open
	}
	return false
}

// A player moved into other cells: the weathers that may come there, and
// if they're others, the next soon.
world_player_crossed :: fun(state: ^World_State, plugin: ^Plugin, player: ^Player_State) -> err {
	others, regions_error := world_weathers_here(state, plugin, player)
	if others do state.weather_hours_left = min(state.weather_hours_left, 0.1)
	return regions_error
}
