// sooblivion: an engine for The Elder Scrolls IV: Oblivion, written in
// Mara. It runs on the game's own data files — the plugins (.esm, .esp)
// and archives (.bsa) in its Data folder.
//
// For now it is a set of commands for looking into those files:
//
//     sooblivion esm [plugin]            what a plugin holds, by record type
//     sooblivion bsa <archive>           an archive's folders and files
//     sooblivion bsa <archive> <file>    one file from an archive, unpacked
module sooblivion

use mara.core
use mara.os
use mara.memory
use mara.time
use esm
use bsa
use inflate
use nif
use dds
use png
use model
use world
use scene
use land
use sky
use shader_package
use distant
use grass
use collision
use walking
use animation
use particles
use audio
use mp3
render :: use render
use mara.math
use sdl_platform
use mara.sdl
use mara.open_gl
use mara.string

#allocator Arena_Basic(2 * GB)

// Where the game's data is, unless a command is given a path.
DATA_FOLDER :: "D:/SteamLibrary/steamapps/common/Oblivion/Data/"

// A path given on the command line, or a file in the data folder.
data_path :: fun(name: []utf8) -> Path {
	path : Path
	if contains_separator(name) {
		&path + name
	else
		&path + DATA_FOLDER
		&path + name
	}
	return path
}

contains_separator :: fun(name: []utf8) -> bool {
	for c in name {
		if path_separator(c) or c == ':' do return true
	}
	return false
}

// `sooblivion esm [plugin]`: reads a whole plugin and prints how many
// records of each type it holds.
command_esm :: fun(name: []utf8) {
	path := data_path(name)
	storage : [400 * MB]byte
	start := time_now()
	data, read_error := read_entire_file(path, &storage)
	if read_error {
		print("couldn't read %: %", path, read_error)
		return
	}
	print("read % MB in % ms", data.len / MB, elapsed_ms(start))

	stats : Plugin_Stats
	scratch : [16 * MB]byte
	walk_start := time_now()
	walk_error := plugin_stats(data, &stats, &scratch)
	if walk_error do print("stopped: %", walk_error)
	print("walked in % ms: % groups, % record types, % broken records",
		elapsed_ms(walk_start), stats.groups, stats.kinds.len, stats.broken_records)

	total_records : i64 = 0
	for entry in stats.kinds {
		print("  %  % records (% packed), % fields, % KB",
			entry.kind, entry.records, entry.packed, entry.fields, entry.bytes / KB)
		total_records += entry.records
	}
	print("% records in all", total_records)
}

// `sooblivion bsa <archive> [file | -test]`: an archive's directory, one
// of its files written out to the current folder, or every file unpacked
// as a test.
command_bsa :: fun(name: []utf8, what: []utf8) {
	path := data_path(name)
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)

	if what.len == 0 {
		print("% folders, % files, flags %, % with bad hashes",
			archive.folders.len, archive.files.len, archive.header.flags, count_bad_hashes(&archive))
		shown : i64 = 0
		for folder in archive.folders {
			if shown == 12 do break
			print("  % (% files)", folder_name(&archive, folder), folder.file_count)
			shown += 1
		}
		return
	}

	storage : [128 * MB]byte
	if what == "-test" {
		start := time_now()
		failed : i64 = 0
		total : i64 = 0
		for file, i in archive.files {
			storage.len = 0
			data, read_error := read_file(&archive, i, &storage)
			if read_error {
				failed += 1
				if failed <= 10 do print("  % failed: %", file_name(&archive, file), read_error)
				continue
			}
			total += data.len
		}
		print("% files read, % failed, % MB unpacked, in % ms",
			archive.files.len, failed, total / MB, elapsed_ms(start))
		return
	}
	if what == "-cut" {
		// Every packed file's stream cut short — at a quarter, a half and
		// three quarters of it — unpacked into exactly its size's room: each
		// should fail with Input_Ended.
		start := time_now()
		cuts : i64 = 0
		ended : i64 = 0
		others : i64 = 0
		for file, i in archive.files {
			if not file.packed or file.size <= 8 do continue
			storage.len = 0
			packed := storage[storage.cap - file.size : storage.cap]
			_, seek_error := file_seek(archive.file, file.offset, SEEK_SET)
			read_error := read_exactly(archive.file, &packed)
			if seek_error or read_error {
				print("  couldn't read %: % %", file_name(&archive, file), seek_error, read_error)
				continue
			}
			unpacked_size : u32 = packed[0]
			stream := packed[4 : packed.len]
			for quarter in 1..3 {
				output := storage[0 : i64(unpacked_size)]
				output.len = 0
				cut_error := unzip(stream[0 : stream.len * quarter / 4], &output)
				cuts += 1
				if cut_error == Input_Ended {
					ended += 1
				else
					others += 1
					if others <= 10 do print("  % cut at %/4: %", file_name(&archive, file), quarter, cut_error)
				}
			}
		}
		print("% cuts: % Input_Ended, % otherwise, in % ms", cuts, ended, others, elapsed_ms(start))
		return
	}

	index, found := find_file(&archive, what)
	if not found {
		// A folder's name lists its files.
		folder_at, is_folder := find_folder(&archive, what)
		if not is_folder {
			print("no % in %", what, path)
			return
		}
		folder := archive.folders[folder_at]
		for k in 0:folder.file_count {
			file := archive.files[folder.first_file + k]
			print("  %  (% bytes%)", file_name(&archive, file), file.size, if file.packed do ", packed" else "")
		}
		return
	}
	data, read_error := read_file(&archive, index, &storage)
	if read_error {
		print("couldn't read %: %", what, read_error)
		return
	}
	out_name := get_file(what)
	write_error := write_entire_file(out_name, data)
	if write_error do print("couldn't write %: %", out_name, write_error)
	else do print("wrote % (% bytes)", out_name, data.len)
}

// Writes data to a new file at path (or over the one there).
write_entire_file :: fun(path: []utf8, data: []byte) -> err {
	file := file_open_write(path)?
	defer file_close(file)
	rest := data
	for rest.len > 0 {
		written := file_write(file, rest)?
		if written <= 0 do return Write_Failed
		rest = rest[written : rest.len]
	}
}

// A kind of failure the nifs command counted: the block type a NIF's
// reading stopped at, and why.
Failure_Count :: struct {
	type_name: str64
	reason: err
	files: i64
	example: str256   // the first file it happened in
}

// `sooblivion nifs [archive]`: reads every NIF in an archive, all its
// blocks, and counts the ones that don't read cleanly to their end, by the
// block type where they went wrong.
command_nifs :: fun(name: []utf8) {
	path := data_path(name)
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)

	failures : [256]Failure_Count
	storage : [128 * MB]byte
	nif_storage : [16 * MB]byte
	nif_count : i64 = 0
	failed : i64 = 0
	block_total : i64 = 0
	with_trailing : i64 = 0   // read cleanly, with bytes left after their end
	model_storage : [64 * MB]byte
	model_failures : i64 = 0
	part_total : i64 = 0
	triangle_total : i64 = 0
	untextured : i64 = 0
	// The Havok blocks: how many of each type, in how many files.
	havok_types : [64]Type_Count
	// Specular properties on and off; the materials' glossiness.
	specular_on : i64 = 0
	specular_off : i64 = 0
	glossiness_total : f64 = 0
	materials : i64 = 0
	black_specular : i64 = 0
	// The animations' sequences: each name, how many, how many loop.
	sequence_names : [256]Sequence_Count
	start := time_now()

	for file, i in archive.files {
		if not ends_with(file_name(&archive, file), ".nif") do continue
		nif_count += 1
		storage.len = 0
		data, read_error := read_file(&archive, i, &storage)
		if read_error {
			failed += 1
			continue
		}
		nif_storage.len = 0
		failure := Nif_Failure{block = 0, type_name = storage[0:0]}
		mesh, nif_error := read_nif(data, &nif_storage, &failure)
		if not nif_error {
			block_total += mesh.blocks.len
			for b in 0:mesh.blocks.len {
				type_name := mesh.header.type_names[i64(mesh.header.block_types[b])]
				if not starts_with(type_name, "bhk") and not starts_with(type_name, "hk") do continue
				counted := false
				for &entry in havok_types {
					if entry.name[:] == type_name {
						entry.count += 1
						counted = true
					}
				}
				if not counted and havok_types.len < havok_types.cap {
					entry := next(&havok_types)
					entry.name.len = 0
					&entry.name + type_name
					entry.count = 1
				}
			}
			for &block in mesh.blocks {
				match block^ {
				Specular specular
					if specular.enabled do specular_on += 1
					else do specular_off += 1
				Sequence sequence
					tally_sequence(&sequence_names, sequence.name, sequence.cycle == CYCLE_LOOP)
					if sequence.name == "Idle" or sequence.name == "SpecialIdle" do print("  idle: % %", sequence.name, file_name(&archive, file))
				Material material
					glossiness_total += f64(material.glossiness)
					materials += 1
					if material.specular.x == 0 and material.specular.y == 0 and material.specular.z == 0 do black_specular += 1
				else
				}
			}
			if mesh.trailing_bytes > 0 do with_trailing += 1
			model_storage.len = 0
			built, model_error := build_model(&mesh, &model_storage)
			if model_error {
				model_failures += 1
				continue
			}
			for part in built.parts {
				part_total += 1
				triangle_total += part.indices.len / 3
				if part.texture.len == 0 do untextured += 1
			}
			continue
		}
		failed += 1
		entry := failure_entry(&failures, failure.type_name, nif_error)
		entry.files += 1
		if entry.files == 1 {
			&entry.example + folder_name(&archive, archive.folders[file.folder])
			&entry.example + "\\"
			&entry.example + file_name(&archive, file)
		}
	}
	print("% NIFs read, % blocks, % failed, % with bytes after their end, in % ms",
		nif_count, block_total, failed, with_trailing, elapsed_ms(start))
	print("models: % parts, % triangles, % parts without a texture, % failed",
		part_total, triangle_total, untextured, model_failures)
	print("a vertex is % bytes, an instance drawn % (the mesh program reads 64 and 176)", size_of(Vertex), size_of(Drawn_Instance))
	line : str1024
	for &entry in sequence_names {
		if entry.count < 3 do continue
		&line + entry.name[:]
		&line + " "
		&line + int_text(entry.count)[:]
		&line + "/"
		&line + int_text(entry.looping)[:]
		&line + "  "
		if line.len > 900 {
			print("  sequences (all/looping): %", line)
			line.len = 0
		}
	}
	print("  sequences (all/looping): %", line)
	print("specular properties: % on, % off; % materials, % with a black specular color, glossiness % on average", specular_on,
		specular_off, materials, black_specular, if materials > 0 do glossiness_total / f64(materials) else 0)
	for entry in failures {
		print("  % files stopped at %: %   (first: %)", entry.files, entry.type_name, entry.reason, entry.example)
	}
	for &entry in havok_types do print("  % %", entry.count, entry.name)
}

// A block type's name and how many there are.
Type_Count :: struct {
	name: [64]utf8
	count: i64
}

// The entry for a failure at a block type, made when it's the first.
failure_entry :: fun(failures: ^[]Failure_Count, type_name: []utf8, reason: err) -> ^Failure_Count {
	for &entry in failures {
		if entry.type_name[:] == type_name and entry.reason == reason do return entry
	}
	entry := next(failures)
	entry^.type_name.len = 0
	&entry^.type_name + type_name
	entry^.reason = reason
	entry^.files = 0
	entry^.example.len = 0
	return entry
}

// `sooblivion textures [archive]`: reads the header of every texture in an
// archive and counts their formats and sizes.
command_textures :: fun(name: []utf8) {
	path := data_path(name)
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)

	storage : [128 * MB]byte
	format_counts : [Pixel_Format]i64
	texture_count : i64 = 0
	failed : i64 = 0
	short_mips : i64 = 0    // textures without their full chain of mipmaps
	largest : i64 = 0
	pixels : i64 = 0
	for file, i in archive.files {
		if not ends_with(file_name(&archive, file), ".dds") do continue
		texture_count += 1
		storage.len = 0
		data, read_error := read_file(&archive, i, &storage)
		if read_error {
			failed += 1
			continue
		}
		texture, texture_error := read_texture(data)
		if texture_error {
			failed += 1
			if failed <= 3 do print("  %\\% : %", folder_name(&archive, archive.folders[file.folder]), file_name(&archive, file), texture_error)
			continue
		}
		format_counts[texture.format] += 1
		last := texture.mips[texture.mips.len - 1]
		if last.width > 1 or last.height > 1 do short_mips += 1
		if texture.width * texture.height > largest do largest = texture.width * texture.height
		pixels += texture.width * texture.height
	}
	print("% textures, % failed, % without all their mipmaps, largest % pixels, % M pixels in all",
		texture_count, failed, short_mips, largest, pixels / 1000000)
	for count, format in format_counts {
		print("  %: %", format, count)
	}
}

// `sooblivion texture <file> [archive]`: decodes a texture's largest image
// and writes it out as a PNG in the current folder, for looking at.
command_texture :: fun(what: []utf8, name: []utf8) {
	path := data_path(name)
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)

	index, found := find_file(&archive, what)
	if not found {
		print("no % in %", what, path)
		return
	}
	storage : [64 * MB]byte
	data, read_error := read_file(&archive, index, &storage)
	if read_error {
		print("couldn't read %: %", what, read_error)
		return
	}
	texture, texture_error := read_texture(data)
	if texture_error {
		print("% isn't a texture this reads: %", what, texture_error)
		return
	}
	pixel_storage : [64 * MB]byte
	pixels, decode_error := decode_rgba(texture, 0, &pixel_storage)
	if decode_error {
		print("couldn't decode %: %", what, decode_error)
		return
	}
	png_storage : [80 * MB]byte
	row_storage : [80 * MB]byte
	encode_png(pixels, texture.mips[0].width, texture.mips[0].height, &png_storage, &row_storage)

	out_name : Path
	&out_name + get_file(what)
	&out_name + ".png"
	write_error := write_entire_file(out_name, png_storage[:])
	if write_error do print("couldn't write %: %", out_name, write_error)
	else do print("wrote % (% x %, %, % mipmaps)", out_name, texture.width, texture.height, texture.format, texture.mips.len)
}

// `sooblivion model <file> [archive]`: reads a mesh and prints the parts
// the renderer would draw.
command_model :: fun(what: []utf8, name: []utf8) {
	path := data_path(name)
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)

	index, found := find_file(&archive, what)
	if not found {
		print("no % in %", what, path)
		return
	}
	storage : [64 * MB]byte
	data, read_error := read_file(&archive, index, &storage)
	if read_error {
		print("couldn't read %: %", what, read_error)
		return
	}
	nif_storage : [16 * MB]byte
	failure := Nif_Failure{block = 0, type_name = storage[0:0]}
	mesh, nif_error := read_nif(data, &nif_storage, &failure)
	if nif_error {
		print("couldn't read % as a NIF: % at block % (%)", what, nif_error, failure.block, failure.type_name)
		return
	}
	model_storage : [64 * MB]byte
	built, model_error := build_model(&mesh, &model_storage)
	if model_error {
		print("couldn't make a model of %: %", what, model_error)
		return
	}
	print("% blocks, % parts, from % to %", mesh.blocks.len, built.parts.len, built.bounds_min, built.bounds_max)
	// Its blocks' types, each with how many.
	types : [64]Type_Count
	for b in 0:mesh.blocks.len {
		type_name := mesh.header.type_names[i64(mesh.header.block_types[b])]
		counted := false
		for &entry in types {
			if entry.name[:] == type_name {
				entry.count += 1
				counted = true
			}
		}
		if not counted and types.len < types.cap {
			entry := next(&types)
			entry.name.len = 0
			&entry.name + type_name
			entry.count = 1
		}
	}
	line : str1024
	for &entry in types {
		&line + entry.name[:]
		&line + " "
		&line + int_text(entry.count)[:]
		&line + "  "
	}
	print("blocks: %", line)
	for &block in mesh.blocks {
		match block^ {
		String_Extra extra
			print("  string extra data % = %", extra.name, extra.value)
		Node node
			print("  node %: at %, flags %", node.object.name, node.object.translation, node.object.flags)
		else
		}
	}
	// Each shape's tangent space as kept, beside its first triangle's
	// directions of u and v (in the shape's space).
	shown_shapes : i64 = 0
	for &block in mesh.blocks {
		if shown_shapes == 4 do break
		match block^ {
		Shape shape
			if shape.data < 0 do continue
			match mesh.blocks[shape.data] {
			Shape_Data data
				if show_tangent_space(&mesh, shape.object.extra_data, data.geometry) do shown_shapes += 1
			else
			}
		else
		}
	}
	for part in built.parts {
		// Where its texture coordinates reach, and its first vertex.
		low_uv : [2!]f32 = [1000000, 1000000]
		high_uv : [2!]f32 = [-1000000, -1000000]
		for vertex in part.vertices {
			for k in 0:2 {
				if vertex.uv[k] < low_uv[k] do low_uv[k] = vertex.uv[k]
				if vertex.uv[k] > high_uv[k] do high_uv[k] = vertex.uv[k]
			}
		}
		if part.vertices.len > 0 do print("  texture coordinates from % to %; first vertex %", low_uv, high_uv, part.vertices[0])
		print("  material: diffuse %, emissive %, specular % (glossiness %), alpha %; glow map %", part.diffuse, part.emissive,
			part.specular, part.glossiness, part.alpha, part.glow_texture)
		if part.billboard_mode >= 0 do print("  under a billboard node, mode %, at %", part.billboard_mode, part.billboard_node[3])
		if part.flip >= 0 {
			flip := &built.flips[part.flip]
			print("  flipbook: % frames (the first %), % to % s at % times from %; keys at % = %",
				flip.frames.len, if flip.frames.len > 0 do flip.frames[0][:] else "", flip.start_time, flip.stop_time,
				flip.frequency, flip.phase, flip.key_times, flip.key_values)
		}
		if part.indices.len >= 3 {
			// Which way its first triangle faces, by its winding (counter-clockwise seen from the front).
			a := part.vertices[i64(part.indices[0])].position
			b := part.vertices[i64(part.indices[1])].position
			c := part.vertices[i64(part.indices[2])].position
			print("  its first triangle faces %", vec3_normalize(cross(b - a, c - a)))
		}
		print("  % vertices, % triangles, texture % (clamp mode %) % % % % %",
			part.vertices.len, part.indices.len / 3, part.texture, part.clamp_mode,
			if part.alpha_blend do "blended" else "", if part.additive do "(added)" else "",
			if part.depth_write do "" else "no depth written",
			if part.alpha_test do "alpha-tested" else "",
			if part.two_sided do "two-sided" else "")
	}
	for &motion in built.motions {
		print("part % changes (%) over % to % s, cycle %, frequency %, phase %: keys at % = %; value %", motion.part, motion.what,
			motion.start_time, motion.stop_time, motion.cycle, motion.frequency, motion.phase, motion.key_times, motion.key_values,
			motion.value)
	}
	for &system in built.particles {
		emitter := system.emitter
		print("particles: room for %, emitter shape % of size % at %, its z %, its y %", system.capacity, emitter.shape, emitter.size,
			system.emitter_place[3], system.emitter_place[2], system.emitter_place[1])
		print("  speed % (± %), declination % (± %), planar angle % (± %)", emitter.speed, emitter.speed_variation,
			emitter.declination, emitter.declination_variation, emitter.planar_angle, emitter.planar_angle_variation)
		print("  color %, radius % (± %), life % s (± %)", emitter.color, emitter.radius, emitter.radius_variation,
			emitter.life_span, emitter.life_span_variation)
		print("  % a second, keys at % = %; on at % = %", system.birth_rate, system.birth_times, system.birth_rates,
			system.active_times, system.active_values)
		print("  played at % times from %, % to % s, cycle %", system.frequency, system.phase, system.start_time, system.stop_time, system.cycle)
		print("  grows % s, fades % s; colors at % = %", system.grow_time, system.fade_time, system.color_times, system.colors)
		print("  turns % (± %) from % (± %) %; pulled % (toward %)", system.rotation_speed, system.rotation_speed_variation,
			system.rotation_angle, system.rotation_angle_variation, if system.random_sign do ", either way" else "",
			system.gravity, if system.pulled_in do system.gravity_center else Vec3{0, 0, 0})
		look := &system.look
		print("  texture % (clamp mode %), flipbook %, % % % %, emissive %, alpha %, vertex mode %, lighting mode %",
			look.texture, look.clamp_mode, look.flip, if look.alpha_blend do "blended" else "", if look.additive do "(added)" else "",
			if look.depth_write do "" else "no depth written", if look.alpha_test do "alpha-tested" else "",
			look.emissive, look.alpha, look.vertex_mode, look.lighting_mode)
		// Played at 10 seconds, unplaced, seen from the south (as a model
		// stands in the world: z up).
		corners : [4096]Particle_Vertex
		add_particle_squares(system, mat4_identity(), 10, 1, Vec3{1, 0, 0}, Vec3{0, 0, 1}, Vec3{0.1, 0.1, 0.1}, Vec3{0, 0, 0}, &corners)
		if corners.len == 0 {
			print("  at 10 s: none")
			continue
		}
		low := Vec3{1000000, 1000000, 1000000}
		high := Vec3{-1000000, -1000000, -1000000}
		for c in 0:corners.len / 4 {
			middle := (corners[c * 4].position + corners[c * 4 + 2].position) * 0.5
			for axis in 0:3 {
				low[axis] = min(low[axis], middle[axis])
				high[axis] = max(high[axis], middle[axis])
			}
		}
		first_size := vec3_length(corners[0].position - corners[2].position) * 0.5
		print("  at 10 s: % particles, from % to %; the newest % across, color %", corners.len / 4, low, high, first_size, corners[0].color)
	}
}

// The game's plugins (Oblivion.esm and the downloaded content, in the
// game's order), read one after another into data_storage and indexed into
// index_storage: what the viewer and the cell commands start from.
load_oblivion :: fun(data_storage: ^[]byte, index_storage: ^[]byte) -> Plugin, err {
	start := time_now()
	order : Load_Order
	read_load_order(&order)?
	plugin := Plugin{0}
	first := data_storage.len
	for &file, k in order.plugins {
		at := data_storage.len - first
		path := data_path(file.name[:])
		data := read_entire_file(path[:], data_storage)?
		span := Plugin_Span{0}
		&span.name + file.name[:]
		span.start = at
		span.end = at + data.len
		span.own_index = u32(k)
		&plugin.files + span
	}
	plugin.data = data_storage[first : data_storage.len]
	index_plugin(&plugin, index_storage)?
	print("indexed % records of % plugins in % ms: % cells' groups, % exterior cells, % worlds with persistent cells",
		plugin.records.count, plugin.files.len, elapsed_ms(start), plugin.cell_children.count, plugin.exterior_cells.count, plugin.persistent_cells.count)
	return plugin
}

// `sooblivion cells [word]`: the interior cells whose editor ids have word in them.
command_cells :: fun(word: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [64 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	shown : i64 = 0
	for &span in plugin.files {
		at := span.interior_cells_at
		for at < span.interior_cells_end {
			header : Record_Header = plugin.data[at]
			if header.kind == "GRUP" {
				at += HEADER_SIZE
				continue
			}
			if header.kind == "CELL" {
				record, record_error := record_at(&plugin, at, &scratch)
				if not record_error {
					name := editor_id(record.data)
					if contains_folded(name, word) {
						print("  % (%)", name, span.name)
						shown += 1
					}
				}
			}
			at += HEADER_SIZE + i64(header.size)
		}
	}
	print("% cells", shown)
}

// `sooblivion cell <editor id> [-all]`: what's placed in an interior cell
// (the first 25, or all), and the meshes it needs.
command_cell :: fun(name: []utf8, every_one: bool) {
	data_storage : [400 * MB]byte
	index_storage : [64 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	cell, cell_error := find_interior_cell(&plugin, name, &scratch)
	if cell_error {
		print("no interior cell %", name)
		return
	}
	references : [8192]Reference
	references_error := cell_references(&plugin, cell, &references)
	if references_error do print("couldn't read all of the cell's references: %", references_error)
	print("cell % holds % references", name, references.len)
	with_model : i64 = 0
	for reference, i in references {
		base, base_error := find_record(&plugin, reference.base, &scratch)
		if base_error do continue
		path := model_path(base)
		if path.len > 0 do with_model += 1
		if i < 25 or every_one {
			print("  % %  at %  turned %  scale %  %",
				base.header.kind, editor_id(base.data), reference.position, reference.rotation, reference.scale, path)
		}
	}
	print("% of them have a mesh", with_model)

	lighting, lighting_error := cell_lighting(&plugin, cell, &scratch)
	if lighting_error do print("couldn't read the cell's lighting: %", lighting_error)
	print("lighting: ambient %, directional % from %, fog % from % to %", lighting.ambient,
		lighting.directional, lighting.direction, lighting.fog_color, lighting.fog_near, lighting.fog_far)
	light_count : i64 = 0
	for reference in references {
		base, base_error := find_record(&plugin, reference.base, &scratch)
		if base_error do continue
		light, gives_light := light_of(base, reference)
		if gives_light {
			light_count += 1
			if light_count <= 3 do print("  light % at %, radius %, color %", editor_id(base.data), light.position, light.radius, light.color)
		}
		if base.header.kind != "DOOR" do continue
		there, leads, door_error := door_destination(&plugin, reference.form_id, &scratch)
		if door_error do print("  couldn't read door %: %", reference.form_id, door_error)
		if door_error or not leads do continue
		target := cell_of_reference(&plugin, there.door)
		target_name : str256
		target_record, target_error := find_record(&plugin, target, &scratch)
		if not target_error do &target_name + editor_id(target_record.data)
		print("  door % leads to cell % (%), arriving at % facing %", editor_id(base.data), target, target_name, there.position, there.rotation.z)
	}
	print("% lights", light_count)

	// Every mesh the cell needs, read and made a model, as the viewer
	// would (without the graphics card).
	directory_storage : [64 * MB]byte
	archives : Archives
	archives_error := open_all_archives(&archives, &directory_storage)
	if archives_error {
		print("couldn't open the archives: %", archives_error)
		return
	}
	defer close_archives(&archives)
	file_room : [64 * MB]byte
	block_room : [16 * MB]byte
	model_room : [64 * MB]byte
	loaded : i64 = 0
	for reference in references {
		base, base_error := find_record(&plugin, reference.base, &scratch)
		if base_error do continue
		path := model_path(base)
		if path.len == 0 or is_marker(path[:]) do continue
		mesh_file, found := find_archived(&archives, path[:])
		if not found {
			print("  missing mesh %", path)
			continue
		}
		file_room.len = 0
		data, read_error := read_archived(&archives, mesh_file, &file_room)
		if read_error {
			print("  couldn't read %: %", path, read_error)
			continue
		}
		block_room.len = 0
		failure := Nif_Failure{block = 0, type_name = file_room[0:0]}
		mesh, nif_error := read_nif(data, &block_room, &failure)
		if nif_error {
			print("  couldn't read % as a NIF: %", path, nif_error)
			continue
		}
		model_room.len = 0
		built, model_error := build_model(&mesh, &model_room)
		if model_error {
			print("  couldn't make a model of %: %", path, model_error)
			continue
		}
		if built.parts.len > 64 do print("  % has % parts: more than the renderer keeps", path, built.parts.len)
		loaded += 1
	}
	print("% references' meshes loaded", loaded)
}

// `sooblivion map [world]`: draws a world's land as a picture, map.png:
// 8 pixels for each cell's side, its heights shaded, below water blue.
command_map :: fun(name: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	if world_id == 0 {
		print("no world %", name)
		return
	}
	// The world's cells' extent on the grid.
	low_x : i64 = 1000000
	low_y : i64 = 1000000
	high_x : i64 = -1000000
	high_y : i64 = -1000000
	for key in plugin.exterior_cells.keys {
		if key == 0 or u32(key >> 32) != world_id do continue
		x := i64(i16(u16((key >> 16) & 0xFFFF)))
		y := i64(i16(u16(key & 0xFFFF)))
		if x < low_x do low_x = x
		if x > high_x do high_x = x
		if y < low_y do low_y = y
		if y > high_y do high_y = y
	}
	print("% cells from % % to % %", plugin.exterior_cells.count, low_x, low_y, high_x, high_y)

	PIXELS_PER_CELL :: 8
	width := (high_x - low_x + 1) * PIXELS_PER_CELL
	height := (high_y - low_y + 1) * PIXELS_PER_CELL
	pixels : [64 * MB]byte
	for i in 0:width * height * 4 do &pixels + u8(0)
	cell_land : Land
	lands : i64 = 0
	// The water's heights, and how many cells have each.
	water_heights : [64]f32
	water_counts : [64]i64
	// The trees placed, and the cell with the most.
	trees : i64 = 0
	most_trees : i64 = 0
	most_trees_x : i64 = 0
	most_trees_y : i64 = 0
	for cell_y in low_y..high_y {
		for cell_x in low_x..high_x {
			cell := exterior_cell(&plugin, world_id, cell_x, cell_y)
			if cell == 0 do continue
			// Its trees.
			references : [16384]Reference
			references_error := cell_references(&plugin, cell, &references)
			if references_error do print("  couldn't read all of cell % %'s references: %", cell_x, cell_y, references_error)
			cell_trees : i64 = 0
			for reference in references {
				header_at, known := index_get(&plugin.records, u64(reference.base))
				if not known do continue
				header : Record_Header = plugin.data[header_at]
				if header.kind == "TREE" do cell_trees += 1
			}
			trees += cell_trees
			if cell_trees > most_trees {
				most_trees = cell_trees
				most_trees_x = cell_x
				most_trees_y = cell_y
			}
			water_height, has_water, water_error := cell_water(&plugin, cell, &scratch)
			if water_error do print("  couldn't read cell % %'s water: %", cell_x, cell_y, water_error)
			if has_water {
				known := -1
				for known_height, k in water_heights {
					if known_height == water_height do known = k
				}
				if known >= 0 {
					water_counts[known] += 1
				elif water_heights.len < water_heights.cap
					&water_heights + water_height
					&water_counts + 1
				}
			}
			land_at, has_land := find_land(&plugin, cell)
			if not has_land do continue
			scratch.len = 0
			record, record_error := record_at(&plugin, land_at, &scratch)
			if record_error do continue
			read_land(&plugin, record, &cell_land)
			lands += 1
			for row in 0:PIXELS_PER_CELL {
				for column in 0:PIXELS_PER_CELL {
					vertex := (row * 4) * LAND_SIDE + column * 4
					ground := cell_land.heights[vertex]
					// The picture's rows go down from the north.
					x := (cell_x - low_x) * PIXELS_PER_CELL + column
					y := (high_y - cell_y) * PIXELS_PER_CELL + (PIXELS_PER_CELL - 1 - row)
					at := (y * width + x) * 4
					shade := cell_land.normals[vertex].z * 0.6 + 0.4
					if ground < 0 {
						pixels[at] = u8(40)
						pixels[at + 1] = u8(70)
						pixels[at + 2] = u8(140)
					else
						level := ground / 16000
						if level > 1 do level = 1
						pixels[at] = u8(255 * shade * (0.35 + level * 0.6))
						pixels[at + 1] = u8(255 * shade * (0.55 + level * 0.4))
						pixels[at + 2] = u8(255 * shade * (0.25 + level * 0.7))
					}
					pixels[at + 3] = u8(255)
				}
			}
		}
	}
	png_storage : [80 * MB]byte
	row_storage : [80 * MB]byte
	encode_png(pixels[:], width, height, &png_storage, &row_storage)
	write_error := write_entire_file("map.png", png_storage[:])
	if write_error do print("couldn't write map.png: %", write_error)
	else do print("wrote map.png: % x %, % cells with land", width, height, lands)
	for known_height, k in water_heights do print("  water at %: % cells", known_height, water_counts[k])
	print("% trees; the most in a cell: % in % %", trees, most_trees, most_trees_x, most_trees_y)
}

// `sooblivion area <world> <x> <y>`: what the viewer would load around a
// cell outside — land models, references, persistent ones nearby — and
// whether the land's textures are in the archive. No window.
command_area :: fun(name: []utf8, x: i64, y: i64) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	if world_id == 0 {
		print("no world %", name)
		return
	}
	directory_storage : [64 * MB]byte
	textures, textures_error := open_archive(data_path("Oblivion - Textures - Compressed.bsa"), &directory_storage)
	if textures_error do return
	defer close_archive(&textures)

	area := area_around(x, y)
	cell_land : Land
	land_mesh : Land_Mesh
	references : [16384]Reference
	land_cells : i64 = 0
	parts : i64 = 0     // the quadrants' textures: base and layers
	missing_textures : i64 = 0
	for cell_y in area.low_y..area.high_y {
		for cell_x in area.low_x..area.high_x {
			cell := exterior_cell(&plugin, world_id, cell_x, cell_y)
			if cell == 0 do continue
			references_error := cell_references(&plugin, cell, &references)
			if references_error do print("  couldn't read all of cell % %'s references: %", cell_x, cell_y, references_error)
			land_at, found := find_land(&plugin, cell)
			if not found do continue
			scratch.len = 0
			record, record_error := record_at(&plugin, land_at, &scratch)
			if record_error do continue
			read_land(&plugin, record, &cell_land)
			build_land_mesh(&plugin, &cell_land, cell_x, cell_y, &land_mesh)
			land_cells += 1
			for q in 0:4 {
				quadrant := &land_mesh.textures[q]
				for k in 0:quadrant.count {
					parts += 1
					_, texture_found := find_file(&textures, quadrant.paths[k][:])
					if not texture_found {
						missing_textures += 1
						if missing_textures <= 5 do print("  no texture %", quadrant.paths[k])
					}
				}
			}
		}
	}
	print("% land cells, % land textures (% missing), % references in the cells", land_cells, parts, missing_textures, references.len)

	// The cells' water: whether their flags say they have it, and its height.
	for cell_y in area.low_y..area.high_y {
		for cell_x in area.low_x..area.high_x {
			cell := exterior_cell(&plugin, world_id, cell_x, cell_y)
			if cell == 0 do continue
			scratch.len = 0
			record, record_error := find_record(&plugin, cell, &scratch)
			if record_error do continue
			flags_field, has_flags := find_field(record.data, "DATA")
			height_field, has_height := find_field(record.data, "XCLW")
			flags : u8 = 0
			if has_flags and flags_field.len >= 1 do flags = flags_field[0]
			height : f32 = -999999
			if has_height and height_field.len >= 4 do height = height_field[0]
			print("  cell % %: flags %, water height %", cell_x, cell_y, flags, height)
		}
	}

	// What the cells' references are: by their base's record type, and
	// whether their meshes are in the archive.
	Kind_Tally :: struct {
		kind: [4!]utf8
		count: i64
		with_mesh: i64      // a .nif in the archive
		speed_trees: i64    // a .spt: SpeedTree, not drawn yet
		disabled: i64
	}
	tallies : [64]Kind_Tally
	directory_storage2 : [64 * MB]byte
	meshes, meshes_error := open_archive(data_path("Oblivion - Meshes.bsa"), &directory_storage2)
	if meshes_error do return
	defer close_archive(&meshes)
	for reference in references {
		scratch.len = 0
		base, base_error := find_record(&plugin, reference.base, &scratch)
		if base_error do continue
		at : i64 = -1
		for known, k in tallies {
			if known.kind == base.header.kind do at = k
		}
		if at < 0 {
			at = tallies.len
			&tallies + Kind_Tally{kind = base.header.kind, count = 0, with_mesh = 0, speed_trees = 0, disabled = 0}
		}
		tally := &tallies[at]
		tally.count += 1
		if reference.flags & RECORD_DISABLED != 0 do tally.disabled += 1
		path := model_path(base)
		if ends_with(path[:], ".spt") do tally.speed_trees += 1
		_, found := find_file(&meshes, path[:])
		if found do tally.with_mesh += 1
	}
	for tally in tallies {
		print("  %: %, % with a mesh, % SpeedTrees, % disabled", tally.kind, tally.count, tally.with_mesh, tally.speed_trees, tally.disabled)
	}
	persistent := persistent_cell(&plugin, world_id)
	references.len = 0
	persistent_error := cell_references(&plugin, persistent, &references)
	if persistent_error do print("couldn't read all of the world's persistent references: %", persistent_error)
	nearby : i64 = 0
	for reference in references {
		if area_holds(area, reference.position) do nearby += 1
	}
	print("the world's persistent cell holds %, % of them in the area", references.len, nearby)
	middle := Vec3{(f32(x) + 0.5) * CELL_SIZE, (f32(y) + 0.5) * CELL_SIZE, 0}
	print("the ground in the middle of % % is at %", x, y, ground_height(&plugin, world_id, middle, &scratch))
}

// `sooblivion walk <world> <x> <y> <cells>`: walks east from a cell, one
// cell at a time, and times what each step costs: placing the cells around
// it, and reading what they need that earlier steps didn't — meshes (read,
// unpacked, made models), their textures, the land. No window: the
// graphics card's part isn't counted.
command_walk :: fun(name: []utf8, x: i64, y: i64, steps: i64) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	if world_id == 0 {
		print("no world %", name)
		return
	}
	directory_storage : [64 * MB]byte
	meshes, meshes_error := open_archive(data_path("Oblivion - Meshes.bsa"), &directory_storage)
	if meshes_error do return
	defer close_archive(&meshes)
	textures, textures_error := open_archive(data_path("Oblivion - Textures - Compressed.bsa"), &directory_storage)
	if textures_error do return
	defer close_archive(&textures)

	table_storage : [2 * MB]byte
	walked : Scene
	scene_clear(&walked, &table_storage)
	seen_textures := key_index(1 << 14, &table_storage)
	file_room : [64 * MB]byte
	block_room : [16 * MB]byte
	model_room : [64 * MB]byte
	texture_room : [64 * MB]byte

	for step in 0..steps {
		cell_x := x + step
		place_start := time_now()
		show_error := show_exterior(&walked, &plugin, world_id, cell_x, y)
		if show_error do print("  placing the cells around % % stopped early: %", cell_x, y, show_error)
		place_ms := elapsed_ms(place_start)

		// What's waiting, read as loading would: the meshes and their
		// textures, then the land, each timed.
		mesh_start := time_now()
		mesh_count : i64 = 0
		texture_count : i64 = 0
		texture_ns : u64 = 0
		for &item in walked.waiting {
			// Placed as loading would place it (as model 0: there's no card here).
			add_instance(&walked, 0, item.world)
			_, known := known_model(&walked, item.path[:])
			if known do continue
			_ = index_put(&walked.paths, text_hash(item.path[:]), 1)
			index, found := find_file(&meshes, item.path[:])
			if not found do continue
			file_room.len = 0
			data, read_error := read_file(&meshes, index, &file_room)
			if read_error do continue
			block_room.len = 0
			failure := Nif_Failure{block = 0, type_name = file_room[0:0]}
			mesh, nif_error := read_nif(data, &block_room, &failure)
			if nif_error do continue
			model_room.len = 0
			built, model_error := build_model(&mesh, &model_room)
			if model_error do continue
			mesh_count += 1
			texture_start := time_now()
			for part in built.parts {
				key := text_hash(part.texture[:])
				_, had := index_get(&seen_textures, key)
				if had or part.texture.len == 0 do continue
				_ = index_put(&seen_textures, key, 1)
				texture_index, texture_found := find_file(&textures, part.texture[:])
				if not texture_found do continue
				texture_room.len = 0
				texture_data, texture_error := read_file(&textures, texture_index, &texture_room)
				if texture_error do continue
				_, _ = read_texture(texture_data)
				texture_count += 1
			}
			texture_ns += time_now() - texture_start
		}
		mesh_ms := elapsed_ms(mesh_start) - i64(texture_ns / 1000000)

		land_start := time_now()
		cell_land : Land
		land_mesh : Land_Mesh
		for item in walked.waiting_land {
			land_at, found := find_land(&plugin, item.cell)
			if not found do continue
			file_room.len = 0
			record, record_error := record_at(&plugin, land_at, &file_room)
			if record_error do continue
			read_land(&plugin, record, &cell_land)
			build_land_mesh(&plugin, &cell_land, item.x, item.y, &land_mesh)
			// (On the card it'd be in a slot; here it's only remembered.)
			&walked.grounds + Gpu_Land{x = item.x, y = item.y, slot = free_land_slot(&walked), center = land_mesh.center, radius = land_mesh.radius}
		}
		print("step to % %: placing % ms (% instances ready, % waiting); % new meshes % ms; % new textures % ms; % land cells % ms; % stretches of water; % cells' trees waiting",
			cell_x, y, place_ms, walked.instances.len, walked.waiting.len, mesh_count, mesh_ms,
			texture_count, i64(texture_ns / 1000000), walked.waiting_land.len, elapsed_ms(land_start), walked.waters.len,
			walked.waiting_trees.len - walked.waiting_trees_next)
		walked.waiting.len = 0
		walked.waiting_land.len = 0
	}
}

// `sooblivion record <editor id or form id>`: a record's fields, each read three ways
// — as text, as u32s, as f32s — for working out what's in them.
// `sooblivion records <kind>`: the records of a kind (GRAS, TREE…), by
// editor id and form id.
command_records :: fun(kind: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [1 * MB]byte
	line : str1024
	count : i64 = 0
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		header : Record_Header = plugin.data[i64(plugin.records.values[slot])]
		if header.kind != kind do continue
		scratch.len = 0
		record, record_error := record_at(&plugin, i64(plugin.records.values[slot]), &scratch)
		if record_error do continue
		entry : str256
		&entry + editor_id(record.data)
		&entry + " ("
		&entry + int_text(i64(key))[:]
		&entry + ")  "
		if line.len + entry.len > 120 {
			print(line)
			line.len = 0
		}
		&line + entry[:]
		count += 1
	}
	print(line)
	print("% records", count)
	if kind == "TREE" do check_tree_billboards(&plugin)
}

// `sooblivion sound <editor id>`: a SOUN record as it's played — how far it's
// heard, its file's clip (channels, rate, length) — and a second of it
// mixed (without opening the sound device): how loud at its near distance.
command_sound :: fun(name: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	directory_storage : [64 * MB]byte
	archives : Archives
	open_error := open_all_archives(&archives, &directory_storage)
	if open_error {
		print("couldn't open the archives: %", open_error)
		return
	}
	defer close_archives(&archives)
	scratch : [1 * MB]byte
	form_id, found := find_by_editor_id(&plugin, name, &scratch)
	if not found {
		print("no record %", name)
		return
	}
	scratch.len = 0
	record, record_error := find_record(&plugin, form_id, &scratch)
	if record_error {
		print("couldn't read %: %", name, record_error)
		return
	}
	kind, made := sound_kind_of(record)
	if not made {
		print("% isn't a sound", name)
		return
	}
	print("%: % (a folder: %), heard full within %, out to %; pitch shifted %, % dB quieter, flags %, hours % to %", name,
		kind.path, kind.folder, kind.min_distance, kind.max_distance, kind.pitch_shift, kind.attenuation, kind.flags,
		kind.start_hour, kind.stop_hour)

	room : [32 * MB]byte
	mixer : Mixer
	audio_init(&mixer, 24 * MB, &room)
	clip_index, clip_error := clip_for(&mixer, &archives, &kind)
	if clip_error {
		print("its clip couldn't be loaded: %", clip_error)
		return
	}
	clip := mixer.clips[clip_index]
	print("clip: % channels at % a second, % frames (% s)", clip.channels, clip.rate, clip.frames, f32(clip.frames) / f32(clip.rate))
	listener := Listener{position = Vec3{0, 0, 0}, right = Vec3{1, 0, 0}}
	place := Vec3{kind.min_distance, 0, 0}   // at its near distance, to the right
	gains := side_gains(&kind, place, listener, loudness(&kind, kind.min_distance))
	_ = start_voice(&mixer, &kind, clip_index, 0, gains, kind.flags & SOUND_LOOP != 0)
	peak : [2!]f32 = [0, 0]
	for block in 0:10 {
		mixer.mix.len = AHEAD * 2
		for k in 0:mixer.mix.len do mixer.mix[k] = 0
		for &voice in mixer.voices do mix_voice(&mixer, voice, AHEAD)
		for k in 0:AHEAD {
			peak[0] = max(peak[0], abs_f32(mixer.mix[k * 2]))
			peak[1] = max(peak[1], abs_f32(mixer.mix[k * 2 + 1]))
		}
	}
	print("gains at its near distance, to the right: %; a second mixed peaks at % left, % right", gains, peak[0], peak[1])
}

// Prints a shape's tangent space as its file keeps it, for its first
// triangle's first corner: both halves, each against the triangle's
// directions of u and v (dot products), and the corner's normal. False
// when it keeps none.
show_tangent_space :: fun(mesh: ^Nif, extra_data: Refs, geometry: Geometry) -> bool {
	if geometry.uv_set_count == 0 or geometry.vertex_count < 3 do return false
	for k in 0:extra_data.count {
		extra := extra_data.at(k)
		if extra < 0 do continue
		match mesh.blocks[extra] {
		Binary_Extra binary
			if binary.name != TANGENT_SPACE do continue
		count := geometry.vertex_count
		// The first triangle's corners.
		corners : [3!]i64 = [0, 1, 2]
		if geometry.triangles.len != 0 {
			for c in 0:3 {
				corner : u16 = geometry.triangles[c * 2]
				corners[c] = i64(corner)
			}
		elif geometry.strips.len >= 6
			for c in 0:3 {
				corner : u16 = geometry.strips[c * 2]
				corners[c] = i64(corner)
			}
		}
		points : [3!]Vec3
		uvs : [3!][2!]f32
		for c in 0:3 {
			point : Vec3 = geometry.vertices[corners[c] * 12]
			uv : [2!]f32 = geometry.uvs[corners[c] * 8]
			points[c] = point
			uvs[c] = uv
		}
		along_u, along_v := uv_directions(points, uvs)
		first : Vec3 = binary.data[corners[0] * 12]
		second : Vec3 = binary.data[count * 12 + corners[0] * 12]
		normal : Vec3 = geometry.normals[corners[0] * 12]
		print("  tangent space (% bytes for % vertices): first half % · u % · v %; second half % · u % · v %; normal %",
			binary.data.len, count, first, dot(first, along_u), dot(first, along_v), second, dot(second, along_u),
			dot(second, along_v), normal)
			return true
		else
		}
	}
	return false
}

// A triangle's directions of u and v across it (each a unit vector): where
// its texture's x and y run.
uv_directions :: fun(points: [3!]Vec3, uvs: [3!][2!]f32) -> Vec3, Vec3 {
	edge_one := points[1] - points[0]
	edge_two := points[2] - points[0]
	du_one := uvs[1][0] - uvs[0][0]
	dv_one := uvs[1][1] - uvs[0][1]
	du_two := uvs[2][0] - uvs[0][0]
	dv_two := uvs[2][1] - uvs[0][1]
	area := du_one * dv_two - du_two * dv_one
	if abs(area) < 0.0000001 do return Vec3{0, 0, 0}, Vec3{0, 0, 0}
	along_u := (edge_one * dv_two - edge_two * dv_one) * (1 / area)
	along_v := (edge_two * du_one - edge_one * du_two) * (1 / area)
	return vec3_normalize(along_u), vec3_normalize(along_v)
}

// `sooblivion anim <mesh>`: a mesh's animations — each sequence (its
// span, how it goes on past its end, its speed) and what it drives: each
// block's node, controller and property type, and its interpolator's kind
// — and the controllers on the mesh's objects that run by themselves.
command_anim :: fun(what: []utf8) {
	path := data_path("Oblivion - Meshes.bsa")
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)
	index, found := find_file(&archive, what)
	if not found {
		print("no % in %", what, path)
		return
	}
	storage : [16 * MB]byte
	data, read_error := read_file(&archive, index, &storage)
	if read_error {
		print("couldn't read it: %", read_error)
		return
	}
	nif_storage : [16 * MB]byte
	failure := Nif_Failure{block = 0, type_name = storage[0:0]}
	mesh, nif_error := read_nif(data, &nif_storage, &failure)
	if nif_error {
		print("couldn't read it: %", nif_error)
		return
	}
	for &block, b in mesh.blocks {
		match block^ {
		Sequence sequence
			print("sequence %: % to % s, cycle %, frequency %, % blocks", sequence.name, sequence.start_time, sequence.stop_time,
				sequence.cycle, sequence.frequency, sequence.block_count)
			for k in 0:sequence.block_count {
				if sequence.blocks.len < (k + 1) * CONTROLLED_BLOCK_SIZE do break
				at := k * CONTROLLED_BLOCK_SIZE
				interpolator : i32 = sequence.blocks[at]
				palette : i32 = sequence.blocks[at + 9]
				node_at : u32 = sequence.blocks[at + 13]
				property_at : u32 = sequence.blocks[at + 17]
				controller_at : u32 = sequence.blocks[at + 21]
				node : [64]utf8
				property : [64]utf8
				controller : [64]utf8
				if palette >= 0 {
					palette_name(&mesh, i64(palette), i64(node_at), &node)
					if property_at != 0xFFFFFFFF do palette_name(&mesh, i64(palette), i64(property_at), &property)
					palette_name(&mesh, i64(palette), i64(controller_at), &controller)
				}
				if interpolator >= 0 and i64(interpolator) < mesh.blocks.len {
					print("  % % % (%)", node, controller, property, mesh.header.type_names[i64(mesh.header.block_types[i64(interpolator)])])
				else
					print("  % % % (no interpolator)", node, controller, property)
				}
			}
		else
		}
		match block^ {
		Transform_Data keys
			print("transform data %: % rotation keys (type %), % translation keys", b, keys.rotation_count, keys.rotation_type, keys.translation_count)
		else
		}
		type_name := mesh.header.type_names[i64(mesh.header.block_types[b])]
		if ends_with(type_name, "Controller") and type_name != "NiControllerManager" {
			print("controller %: %", b, type_name)
		}
		match block^ {
		Value_Controller value
			made := value.controller
			print("  kind %, flags %, % to % s at % times from %, interpolator %, slot %, operation %", made.kind, made.flags,
				made.start_time, made.stop_time, made.frequency, made.phase, made.interpolator, made.slot, made.operation)
		else
		}
	}
	// What moves by itself: the Idle's moving tracks, each node's pose at
	// four moments of the loop.
	idle := find_sequence(&mesh, "Idle")
	if idle < 0 do idle = find_sequence(&mesh, "SpecialIdle")
	if idle < 0 do return
	tracks : [8]Track
	track_room : [4 * MB]byte
	read_tracks(&mesh, idle, &tracks, &track_room, false)
	start, stop := sequence_span(&mesh, idle)
	for &track in tracks {
		node := find_node(&mesh, track.node_name[:])
		if node >= 0 {
			match mesh.blocks[node] {
			Node moved
				track.rest = local_transform(moved.object)
			else
			}
		}
		line : str1024
		for quarter in 0:4 {
			pose := track_pose(track, start + (stop - start) * f32(quarter) / 4)
			&line + vec3_text(Vec3{pose[3][0], pose[3][1], pose[3][2]})[:]
			&line + " x "
			&line + vec3_text(Vec3{pose[0][0], pose[0][1], pose[0][2]})[:]
			&line + ";  "
		}
		print("moves % (% translation keys, % rotation keys, % % % angle keys): %", track.node_name, track.translations.len,
			track.rotations.len, track.angles[0].len, track.angles[1].len, track.angles[2].len, line)
	}
}

// A vector as text, two decimals each: "[1.25, -3, 0.5]".
vec3_text :: fun(v: Vec3) -> str64 {
	text : str64
	&text + "["
	for axis in 0:3 {
		if axis > 0 do &text + ", "
		hundredths := i64(v[axis] * 100)
		if v[axis] < 0 and hundredths == 0 do &text + "-"
		&text + int_text(hundredths / 100)[:]
		&text + "."
		rest := abs(hundredths % 100)
		if rest < 10 do &text + "0"
		&text + int_text(rest)[:]
	}
	&text + "]"
	return text
}

// A sequence name's count in the survey, and how many loop.
Sequence_Count :: struct {
	name: [64]utf8
	count: i64
	looping: i64
}

tally_sequence :: fun(counts: ^[]Sequence_Count, name: []utf8, looping: bool) {
	for &entry in counts {
		if compare_folded(entry.name[:], name) == 0 {
			entry.count += 1
			if looping do entry.looping += 1
			return
		}
	}
	if counts.len == counts.cap do return
	entry := next(counts)
	entry.name.len = 0
	&entry.name + name[0 : min(name.len, entry.name.cap)]
	entry.count = 1
	entry.looping = if looping do 1 else 0
}

// The record whose editor id is name (any letter case): its form id; false
// when there's none. (Every record is looked at.)
find_by_editor_id :: fun(plugin: ^Plugin, name: []utf8, scratch: ^[]byte) -> u32, bool {
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		scratch.len = 0
		record, record_error := record_at(plugin, i64(plugin.records.values[slot]), scratch)
		if record_error do continue
		if compare_folded(editor_id(record.data), name) == 0 do return u32(key), true
	}
	return 0, false
}

// `sooblivion sounds`: the game's sounds — how its SOUN records play (their
// flags, how far they're heard, those naming a folder, files the archive
// hasn't), and the lights, doors and activators that make them.
command_sounds :: fun() {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	directory_storage : [16 * MB]byte
	sounds, open_error := open_archive(data_path("Oblivion - Sounds.bsa"), &directory_storage)
	if open_error {
		print("couldn't open the sounds: %", open_error)
		return
	}
	defer close_archive(&sounds)

	scratch : [1 * MB]byte
	flag_counts : [8!]i64 = all 0
	kinds : i64 = 0
	folders : i64 = 0
	missing : i64 = 0
	first_missing : str256
	timed : i64 = 0
	lights_with_sound : i64 = 0
	doors_with_sound : i64 = 0
	activators_with_sound : i64 = 0
	shortest : f32 = 1000000
	longest : f32 = 0
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		header : Record_Header = plugin.data[i64(plugin.records.values[slot])]
		if header.kind != "SOUN" and header.kind != "LIGH" and header.kind != "DOOR" and header.kind != "ACTI" do continue
		scratch.len = 0
		record, record_error := record_at(&plugin, i64(plugin.records.values[slot]), &scratch)
		if record_error do continue
		if header.kind == "SOUN" {
			kind, made := sound_kind_of(record)
			if not made do continue
			kinds += 1
			for bit in 0:8 {
				if kind.flags & (u32(1) << u32(bit)) != 0 do flag_counts[bit] += 1
			}
			if kind.start_hour != kind.stop_hour do timed += 1
			if kind.max_distance > 0 {
				shortest = min(shortest, kind.max_distance)
				longest = max(longest, kind.max_distance)
			}
			found := false
			if kind.folder {
				folders += 1
				folder_path := kind.path[:]
				if ends_with(folder_path, "\\") do folder_path = folder_path[0 : folder_path.len - 1]
				_, found = find_folder(&sounds, folder_path)
			else
				_, found = find_file(&sounds, kind.path[:])
			}
			if not found {
				missing += 1
				if missing == 1 do &first_missing + kind.path[:]
				if missing <= 25 do print("  missing: %", kind.path)
			}
			continue
		}
		_, has_sound := form_field(&plugin, record, "SNAM")
		if header.kind == "LIGH" and has_sound do lights_with_sound += 1
		if header.kind == "DOOR" and has_sound do doors_with_sound += 1
		if header.kind == "ACTI" and has_sound do activators_with_sound += 1
	}
	print("% sounds: % naming a folder, % played in some hours only, heard out to % to % units", kinds, folders, timed, shortest, longest)
	print("  flags: % random pitch, % played at random, % environment ignored, % random location, % looping, % menu, % 2D, % all round",
		flag_counts[0], flag_counts[1], flag_counts[2], flag_counts[3], flag_counts[4], flag_counts[5], flag_counts[6], flag_counts[7])
	print("  % not in the archive (the first: %)", missing, first_missing)
	print("% lights, % doors, % activators make sounds", lights_with_sound, doors_with_sound, activators_with_sound)
}

// Whether each tree's billboard is in the archive: how many are, and the
// trees whose aren't.
check_tree_billboards :: fun(plugin: ^Plugin) {
	directory_storage : [64 * MB]byte
	textures, open_error := open_archive(data_path("Oblivion - Textures - Compressed.bsa"), &directory_storage)
	if open_error {
		print("couldn't open the textures: %", open_error)
		return
	}
	defer close_archive(&textures)
	scratch : [1 * MB]byte
	found_count : i64 = 0
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		header : Record_Header = plugin.data[i64(plugin.records.values[slot])]
		if header.kind != "TREE" do continue
		scratch.len = 0
		record, record_error := record_at(plugin, i64(plugin.records.values[slot]), &scratch)
		if record_error do continue
		look, is_tree := tree_look(record)
		if not is_tree {
			print("  % has no size", editor_id(record.data))
			continue
		}
		_, found := find_file(&textures, look.billboard[:])
		if found do found_count += 1
		else do print("  % has no billboard: %", editor_id(record.data), look.billboard)
	}
	print("% trees' billboards found", found_count)
}

command_record :: fun(name: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	// A number names a record by its form id.
	wanted, named_by_id := parse_number(name)
	form_id := u32(wanted)
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		scratch.len = 0
		record, record_error := record_at(&plugin, i64(plugin.records.values[slot]), &scratch)
		if record_error do continue
		if compare_folded(editor_id(record.data), name) != 0 and (not named_by_id or u32(key) != form_id) do continue
		print("% % (form id %), % bytes", record.header.kind, name, record.header.form_id, record.data.len)
		fields := Fields{data = record.data, at = 0, broken = false}
		for field in next_field(&fields) {
			line : str1024
			&line + "  "
			&line + field.kind[:]
			&line + " "
			&line + int_text(field.data.len)[:]
			&line + ": "
			// As text, where it reads as text.
			printable := field.data.len > 0
			for b in 0:field.data.len {
				c : u8 = field.data[b]
				if (c < 32 or c > 126) and not (c == 0 and b == field.data.len - 1) do printable = false
			}
			if printable {
				&line + field_text(field.data)
			else
				shown := field.data.len / 4
				if shown > 40 do shown = 40
				for k in 0:shown {
					value : u32 = field.data[k * 4]
					number : f32 = field.data[k * 4]
					&line + int_text(i64(value))[:]
					if value > 0x30000000 and value < 0x50000000 or value > 0xB0000000 and value < 0xD0000000 {
						&line + "/"
						&line + int_text(i64(number * 1000))[:]
						&line + "m"
					}
					&line + " "
				}
				if field.data.len % 4 != 0 {
					&line + "| bytes:"
					for b in 0:field.data.len {
						if b >= 64 do break
						c : u8 = field.data[b]
						&line + " "
						&line + int_text(i64(c))[:]
					}
				}
			}
			print(line)
		}
	}
}

// `sooblivion sky [world]`: the sky outside at hours through a day — its
// colors, the sun, the light and fog — as the viewer would draw it.
command_sky :: fun(name: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	if world_id == 0 {
		print("no world %", name)
		return
	}
	climate, climate_error := world_climate(&plugin, world_id, &scratch)
	if climate_error {
		print("couldn't read the climate: %", climate_error)
		return
	}
	print("climate %", editor_id_of(&plugin, climate.form_id))
	// The climate's likeliest weather.
	likeliest : u32 = 0
	best : i64 = -1
	for chance in climate.weathers {
		if chance.chance > best {
			best = chance.chance
			likeliest = chance.weather
		}
	}
	weather, weather_error := read_weather(&plugin, likeliest, &scratch)
	if weather_error {
		print("couldn't read the weather: %", weather_error)
		return
	}
	print("weathers %; the likeliest %, sunrise % to %, sunset % to %, clouds % and %, sun %", climate.weathers, likeliest,
		climate.sunrise_begin, climate.sunrise_end, climate.sunset_begin, climate.sunset_end,
		weather.cloud_lower, weather.cloud_upper, climate.sun_texture)
	water, water_error := world_water(&plugin, world_id, &scratch)
	if water_error do print("couldn't read the water: %", water_error)
	else do print("water: %", water)
	// The weathers that may come at a few places: their regions'.
	for place in [[-48, -9], [8, 30], [30, -30], [0, 0], [-20, 20]] {
		chances : [16]Weather_Chance
		region_error := cell_weathers(&plugin, world_id, place[0], place[1], &chances, &scratch)
		line : str1024
		for chance in chances {
			&line + editor_id_of(&plugin, chance.weather)[:]
			&line + " "
			&line + int_text(chance.chance)[:]
			&line + "  "
		}
		if region_error do print("  at %: couldn't read its regions: %", place, region_error)
		elif chances.len == 0 do print("  at %: the climate's", place)
		else do print("  at %: %", place, line)
		sounds : [32]Region_Sound
		sounds_error := cell_region_sounds(&plugin, world_id, place[0], place[1], &sounds, &scratch)
		if sounds_error do print("    couldn't read its sounds: %", sounds_error)
		sound_line : str1024
		for sound in sounds {
			&sound_line + editor_id_of(&plugin, sound.sound)[:]
			&sound_line + " ("
			&sound_line + int_text(i64(sound.weathers))[:]
			&sound_line + ", "
			&sound_line + int_text(i64(sound.chance * 100))[:]
			&sound_line + "%)  "
			if sound_line.len > 900 do break
		}
		print("    sounds: %", sound_line)
	}
	for hour in [0, 5, 7, 8, 9, 12, 16, 17, 18, 19, 21] {
		state := sky_at(climate, &weather, f32(hour), 10240)
		print("  %:00  daylight %  sky % / % / %  sun % toward %  ambient %  sunlight %  fog % % to %", hour, state.daylight,
			state.upper, state.horizon, state.lower, state.sun_color, state.sun_direction,
			state.lighting.ambient, state.lighting.directional, state.lighting.fog_color,
			state.lighting.fog_near, state.lighting.fog_far)
	}
}

// `sooblivion lod <world> <x> <y>`: the piece of distant land a cell is
// in, and its normal map beside the cell's own land's normals at a few of
// the land's points, to see which way the map's axes go.
// `sooblivion doors`: the doors placed in all the cells: how many lead
// somewhere (load doors), and the bases of those that don't (that open
// in place), the most placed first, with their meshes.
command_doors :: fun() {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [1 * MB]byte
	references : [16384]Reference
	leading : i64 = 0
	in_place : i64 = 0
	bases : [2048]Base_Count
	for key in plugin.cell_children.keys {
		if key == 0 do continue
		references.len = 0
		references_error := cell_references(&plugin, u32(key), &references)
		if references_error do print("  couldn't read all of cell %'s references: %", key, references_error)
		for reference in references {
			scratch.len = 0
			base, base_error := find_record(&plugin, reference.base, &scratch)
			if base_error or base.header.kind != "DOOR" do continue
			_, leads, door_error := door_destination(&plugin, reference.form_id, &scratch)
			if door_error {
				print("  couldn't read door %: %", reference.form_id, door_error)
				continue
			}
			if leads {
				leading += 1
				continue
			}
			in_place += 1
			counted := false
			for &entry in bases {
				if entry.base == reference.base {
					entry.count += 1
					counted = true
				}
			}
			if not counted and bases.len < bases.cap do &bases + Base_Count{base = reference.base, count = 1}
		}
	}
	print("% doors lead somewhere, % open in place, of % bases", leading, in_place, bases.len)
	for shown in 0:12 {
		most : i64 = -1
		for &entry, k in bases {
			if entry.count > 0 and (most < 0 or entry.count > bases[most].count) do most = k
		}
		if most < 0 do break
		scratch.len = 0
		record, record_error := find_record(&plugin, bases[most].base, &scratch)
		if not record_error do print("  % % %", bases[most].count, editor_id(record.data), model_path(record))
		bases[most].count = 0
	}
}

// `sooblivion door <mesh>`: how a door opens in place: its Open and Close
// sequences' tracks — the nodes they move, their keys, where each node is
// at the start and the end — and what splitting it there makes: the
// frame's parts and collision, and each moving node's.
command_door :: fun(what: []utf8) {
	path := data_path("Oblivion - Meshes.bsa")
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)
	index, found := find_file(&archive, what)
	if not found {
		print("no % in %", what, path)
		return
	}
	storage : [16 * MB]byte
	data, read_error := read_file(&archive, index, &storage)
	if read_error do return
	nif_storage : [16 * MB]byte
	failure := Nif_Failure{block = 0, type_name = storage[0:0]}
	mesh, nif_error := read_nif(data, &nif_storage, &failure)
	if nif_error {
		print("couldn't read it: %", nif_error)
		return
	}
	moving : [8]i64
	for name in ["Open", "Close"] {
		sequence := find_sequence(&mesh, name)
		if sequence < 0 {
			print("no % sequence", name)
			continue
		}
		start, stop := sequence_span(&mesh, sequence)
		tracks : [8]Track
		track_room : [4 * MB]byte
		read_tracks(&mesh, sequence, &tracks, &track_room, false)
		print("%: from % to % s, % tracks", name, start, stop, tracks.len)
		match mesh.blocks[sequence] {
		Sequence played
			if played.text_keys >= 0 and played.text_keys < mesh.blocks.len {
				match mesh.blocks[played.text_keys] {
				Text_Keys text_keys
					at : i64 = 0
					for k in 0:text_keys.count {
						seconds, text, next_at := next_text_key(text_keys.keys, at)
						print("  at % s: %", seconds, text)
						at = next_at
					}
				else
				}
			}
		else
		}
		for &track in tracks {
			node := find_node(&mesh, track.node_name[:])
			if node >= 0 {
				match mesh.blocks[node] {
				Node moved
					track.rest = local_transform(moved.object)
				else
				}
				known := false
				for m in moving {
					if m == node do known = true
				}
				if not known and moving.len < moving.cap do &moving + node
			}
			at_start := track_pose(track, start)
			at_stop := track_pose(track, stop)
			print("  % (block %): % rotation keys, % translation keys; x axis % to %, at % to %", track.node_name, node,
				track.rotations.len, track.translations.len,
				Vec3{at_start[0][0], at_start[0][1], at_start[0][2]}, Vec3{at_stop[0][0], at_stop[0][1], at_stop[0][2]},
				Vec3{at_start.w.x, at_start.w.y, at_start.w.z}, Vec3{at_stop.w.x, at_stop.w.y, at_stop.w.z})
		}
	}
	model_storage : [16 * MB]byte
	points : [200000]Vec3
	frame, frame_error := build_model_part(&mesh, -1, moving[:], &model_storage)
	add_collision_part(&mesh, -1, moving[:], &points)
	if not frame_error do print("the frame: % parts, % collision triangles", frame.parts.len, points.len / 3)
	for node in moving {
		points.len = 0
		piece, piece_error := build_model_part(&mesh, node, [], &model_storage)
		add_collision_part(&mesh, node, [], &points)
		parent, in_tree := parent_transform(&mesh, node)
		if not piece_error do print("block %: % parts, % collision triangles; its parent at % (found %)", node, piece.parts.len,
			points.len / 3, Vec3{parent.w.x, parent.w.y, parent.w.z}, in_tree)
	}
}

// `sooblivion find <editor id>`: where a base record is placed: each
// reference's cell (its grid place, outside) and position.
command_find :: fun(name: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [1 * MB]byte
	base_id := find_by_editor_id_any(&plugin, name, &scratch)
	if base_id == 0 {
		print("no record %", name)
		return
	}
	references : [16384]Reference
	found : i64 = 0
	for key in plugin.cell_children.keys {
		if key == 0 do continue
		references.len = 0
		references_error := cell_references(&plugin, u32(key), &references)
		if references_error do print("  couldn't read all of cell %'s references: %", key, references_error)
		for reference in references {
			if reference.base != base_id do continue
			found += 1
			x, y := grid_of(reference.position)
			cell_name := editor_id_of(&plugin, u32(key))
			print("  in % (grid % % if outside) at %", cell_name, x, y, reference.position)
		}
	}
	print("% placed", found)
}

// A record's form id by its editor id, of any kind; 0 for none.
find_by_editor_id_any :: fun(plugin: ^Plugin, name: []utf8, scratch: ^[]byte) -> u32 {
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		scratch.len = 0
		record, record_error := record_at(plugin, i64(plugin.records.values[slot]), scratch)
		if record_error do continue
		if compare_folded(editor_id(record.data), name) == 0 do return u32(key)
	}
	return 0
}

// A base record and how many references place it.
Base_Count :: struct {
	base: u32
	count: i64
}

// `sooblivion collision <mesh>`: a mesh's collision, as walking meets it:
// its triangles, and the box around them beside the box around what's
// drawn. `collision -all`: every mesh's, counted; and how many of the
// convex hulls' faces are found with the planes' distance added (as
// collision.mara takes it) and subtracted.
command_collision :: fun(what: []utf8, through: Vec3, has_point: bool) {
	path := data_path("Oblivion - Meshes.bsa")
	directory_storage : [64 * MB]byte
	archive, open_error := open_archive(path, &directory_storage)
	if open_error {
		print("couldn't open %: %", path, open_error)
		return
	}
	defer close_archive(&archive)
	storage : [64 * MB]byte
	nif_storage : [16 * MB]byte
	points : [600000]Vec3

	if what == "-all" {
		start := time_now()
		with_collision : i64 = 0
		triangles : i64 = 0
		most : i64 = 0
		most_name : [256]utf8
		faces_added : i64 = 0
		faces_subtracted : i64 = 0
		planes : i64 = 0
		for file, i in archive.files {
			if not ends_with(file_name(&archive, file), ".nif") do continue
			storage.len = 0
			data, read_error := read_file(&archive, i, &storage)
			if read_error do continue
			nif_storage.len = 0
			failure := Nif_Failure{block = 0, type_name = storage[0:0]}
			mesh, nif_error := read_nif(data, &nif_storage, &failure)
			if nif_error do continue
			points.len = 0
			add_collision(&mesh, &points)
			if points.len > 0 do with_collision += 1
			triangles += points.len / 3
			if points.len / 3 > most {
				most = points.len / 3
				most_name.len = 0
				&most_name + file_name(&archive, file)
			}
			for &block in mesh.blocks {
				match block^ {
				Convex_Shape convex
					for p in 0:convex.plane_count {
						plane : [4!]f32 = convex.planes[p * 16]
						added : i64 = 0
						subtracted : i64 = 0
						for v in 0:convex.vertex_count {
							corner : Vec3 = convex.vertices[v * 16]
							along := corner.x * plane[0] + corner.y * plane[1] + corner.z * plane[2]
							if abs_f32(along + plane[3]) < ON_PLANE do added += 1
							if abs_f32(along - plane[3]) < ON_PLANE do subtracted += 1
						}
						planes += 1
						if added >= 3 do faces_added += 1
						if subtracted >= 3 do faces_subtracted += 1
					}
				else
				}
			}
		}
		print("% meshes with collision, % triangles, the most % (%), in % ms", with_collision, triangles, most, most_name, elapsed_ms(start))
		print("convex hulls: % planes, % faces found adding their distance, % subtracting it", planes, faces_added, faces_subtracted)
		return
	}

	index, found := find_file(&archive, what)
	if not found {
		print("no % in %", what, path)
		return
	}
	data, read_error := read_file(&archive, index, &storage)
	if read_error {
		print("couldn't read %: %", what, read_error)
		return
	}
	failure := Nif_Failure{block = 0, type_name = storage[0:0]}
	mesh, nif_error := read_nif(data, &nif_storage, &failure)
	if nif_error {
		print("couldn't read % as a NIF: %", what, nif_error)
		return
	}
	add_collision(&mesh, &points)
	model_storage : [64 * MB]byte
	built, model_error := build_model(&mesh, &model_storage)
	low := Vec3{1000000, 1000000, 1000000}
	high := Vec3{-1000000, -1000000, -1000000}
	for point in points {
		for axis in 0:3 {
			if point[axis] < low[axis] do low[axis] = point[axis]
			if point[axis] > high[axis] do high[axis] = point[axis]
		}
	}
	print("% collision triangles, from % to %", points.len / 3, low, high)
	if not model_error do print("drawn: from % to %", built.bounds_min, built.bounds_max)
	if has_point and not model_error {
		// Lines along each axis through the point: where they meet the
		// collision, and the drawn triangles (a hole drawn but not in the
		// collision shows here).
		for axis in 0:3 {
			start := through
			start[axis] = through[axis] - 2000
			way := Vec3{0, 0, 0}
			way[axis] = 1
			collision_hits : [16]f32
			for t in 0:points.len / 3 {
				distance, hit := line_hits(start, way, points[t * 3], points[t * 3 + 1], points[t * 3 + 2])
				if hit and collision_hits.len < collision_hits.cap do &collision_hits + (start[axis] + distance)
			}
			drawn_hits : [16]f32
			for &part in built.parts {
				for t in 0:part.indices.len / 3 {
					a := part.vertices[i64(part.indices[t * 3])].position
					b := part.vertices[i64(part.indices[t * 3 + 1])].position
					c := part.vertices[i64(part.indices[t * 3 + 2])].position
					distance, hit := line_hits(start, way, a, b, c)
					if hit and drawn_hits.len < drawn_hits.cap do &drawn_hits + (start[axis] + distance)
				}
			}
			print("  along axis % through %: collision at %; drawn at %", axis, through, collision_hits, drawn_hits)
		}
	}
	// Lines through the middle along each axis, from outside the box: where
	// each first meets the collision (an opening, a doorway's, meets none).
	middle := (low + high) * 0.5
	for axis in 0:3 {
		start := middle
		start[axis] = low[axis] - 50
		way := Vec3{0, 0, 0}
		way[axis] = 1
		nearest : f32 = 1000000
		for t in 0:points.len / 3 {
			distance, hit := line_hits(start, way, points[t * 3], points[t * 3 + 1], points[t * 3 + 2])
			if hit and distance < nearest do nearest = distance
		}
		if nearest < 1000000 do print("  a line through the middle along axis % meets it at %", axis, start[axis] + nearest)
		else do print("  a line through the middle along axis % meets nothing", axis)
	}
	for &block, k in mesh.blocks {
		type_name := mesh.header.type_names[i64(mesh.header.block_types[k])]
		match block^ {
		Rigid_Body body
			print("  block % (%): a body on layer %, its shape block % %", k, type_name, body.layer, body.shape, if body.moved do "(moved)" else "")
		Strips_Shape strips_shape
			for s in 0:strips_shape.strips.count {
				layer := if strips_shape.filters.len >= (s + 1) * 4 do i64(u8(strips_shape.filters[s * 4])) else -1
				print("  block % (%): strips block %, on layer %", k, type_name, strips_shape.strips.at(s), layer)
			}
		Other
			if starts_with(type_name, "bhk") do print("  block % (%): kept as Other", k, type_name)
		else
			if starts_with(type_name, "bhk") do print("  block % (%)", k, type_name)
		}
	}
}

// `sooblivion grass <world> <x> <y>`: the grass a cell's land grows, as
// the viewer places it: how many blades of each kind, how tall, how high
// above the water. No window (the kinds' models aren't loaded: each
// kind's "model" is its index here).
command_grass :: fun(name: []utf8, x: i64, y: i64) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	cell := exterior_cell(&plugin, world_id, x, y)
	parent, parent_error := world_parent(&plugin, world_id, &scratch)
	if parent_error do parent = 0
	land_at, has_land := shown_land(&plugin, world_id, parent, x, y)
	if world_id == 0 or cell == 0 or not has_land {
		print("no land at % % in %", x, y, name)
		return
	}
	scratch.len = 0
	record, record_error := record_at(&plugin, land_at, &scratch)
	if record_error {
		print("couldn't read the land: %", record_error)
		return
	}
	cell_land : Land
	read_land(&plugin, record, &cell_land)

	// The land's textures and their grasses, as the scene reads them.
	kinds : [256]Grass_Kind
	kind_ids : [256]u32
	textures : [40]Texture_Grasses
	for &quadrant in cell_land.quadrants {
		texture_ids : [9]u32
		&texture_ids + quadrant.base
		for &layer in quadrant.layers do &texture_ids + layer.texture
		for texture in texture_ids {
			known := false
			for &entry in textures {
				if entry.texture == texture do known = true
			}
			if known or texture == 0 or textures.len == textures.cap do continue
			grasses := Texture_Grasses{texture = texture, kinds = [-1, -1]}
			scratch.len = 0
			texture_record, texture_error := find_record(&plugin, texture, &scratch)
			if texture_error do continue
			count : i64 = 0
			fields := Fields{data = texture_record.data, at = 0, broken = false}
			for field in next_field(&fields) {
				if field.kind != "GNAM" or field.data.len < 4 or count == GRASSES_PER_TEXTURE do continue
				grass_id : u32 = field.data[0]
				kind_index : i64 = -1
				for id, k in kind_ids {
					if id == grass_id do kind_index = k
				}
				if kind_index < 0 {
					grass_scratch : [64 * KB]byte
					grass_record, grass_error := find_record(&plugin, grass_id, &grass_scratch)
					if not grass_error {
						look, readable := read_grass_look(grass_record)
						if readable {
							&kinds + Grass_Kind{look = look, model = kinds.len}
							&kind_ids + grass_id
							kind_index = kinds.len - 1
						}
					}
				}
				grasses.kinds[count] = kind_index
				count += 1
			}
			print("texture % (%): grasses % and %", texture, editor_id_of(&plugin, texture), grasses.kinds[0], grasses.kinds[1])
			&textures + grasses
		}
	}
	water_height, has_water, water_error := cell_water(&plugin, cell, &scratch)
	if water_error do print("couldn't read the cell's water: %", water_error)
	if not has_water do water_height = -1000000
	blades : [render.GRASS_PER_CELL]render.Placed_Grass
	start := time_now()
	place_grass(&cell_land, x, y, water_height, textures[:], &kinds, &blades)
	print("% blades in % us; water at %", blades.len, (time_now() - start) / 1000, if has_water do water_height else 0)
	small, small_error := small_world(&plugin, world_id, &scratch)
	if small and not small_error do print("(a small world: the viewer grows none of it)")
	for &kind, k in kinds {
		count : i64 = 0
		lowest : f32 = 1000000
		tallest : f32 = 0
		for &blade in blades {
			if blade.model != k do continue
			count += 1
			if blade.position.z - water_height < lowest do lowest = blade.position.z - water_height
			if blade.height > tallest do tallest = blade.height
		}
		print("  %: % (density %, slopes % to %, water rule % at %) — % blades, the tallest x%, the lowest % above the water",
			k, kind.look.model, kind.look.density, kind.look.least_slope, kind.look.most_slope,
			kind.look.water_rule, kind.look.water_distance, count, tallest, lowest)
	}
}

// The world's references seen from afar: how many, of how many bases,
// how many of those have a far mesh (their mesh's name with _far); and the
// game's distantlod file for the cell at x, y, its kinds' records.
survey_distant_objects :: fun(plugin: ^Plugin, world_id: u32, x: i64, y: i64, archives: ^Archives) {
	references : [4096]Reference
	bases : [8192]u32
	total : i64 = 0
	most : i64 = 0
	cells_with : i64 = 0
	scratch : [1 * MB]byte
	for key in plugin.exterior_cells.keys {
		if key == 0 or u32(key >> 32) != world_id do continue
		cell_x := i64(i16(u16((key >> 16) & 0xFFFF)))
		cell_y := i64(i16(u16(key & 0xFFFF)))
		cell := exterior_cell(plugin, world_id, cell_x, cell_y)
		references.len = 0
		cell_distant_references(plugin, cell, &references)
		if references.len == 0 do continue
		cells_with += 1
		total += references.len
		if references.len > most do most = references.len
		for reference in references {
			known := false
			for base in bases {
				if base == reference.base do known = true
			}
			if not known and bases.len < bases.cap do &bases + reference.base
		}
	}
	far_meshes : i64 = 0
	kinds : [16]Kind_Count
	for base in bases {
		scratch.len = 0
		record, record_error := find_record(plugin, base, &scratch)
		if record_error do continue
		counted := false
		for &kind_count in kinds {
			if kind_count.kind == record.header.kind {
				kind_count.count += 1
				counted = true
			}
		}
		if not counted and kinds.len < kinds.cap do &kinds + Kind_Count{kind = record.header.kind, count = 1}
		path := model_path(record)
		if path.len < 4 do continue
		far : [256]utf8
		&far + path[0 : path.len - 4]
		&far + "_far.nif"
		_, found := find_archived(archives, far[:])
		if found do far_meshes += 1
		if record.header.kind != "TREE" do print("    % %: % (far mesh: %)", record.header.kind, editor_id(record.data), path, found)
	}
	print("% references seen from afar in % cells (the most in a cell %), of % bases, % with a far mesh",
		total, cells_with, most, bases.len, far_meshes)
	// What the viewer places of them: all but trees and the disabled.
	placed : i64 = 0
	for key in plugin.exterior_cells.keys {
		if key == 0 or u32(key >> 32) != world_id do continue
		cell := exterior_cell(plugin, world_id, i64(i16(u16((key >> 16) & 0xFFFF))), i64(i16(u16(key & 0xFFFF))))
		references.len = 0
		cell_distant_references(plugin, cell, &references)
		for reference in references {
			if reference.flags & RECORD_DISABLED != 0 do continue
			scratch.len = 0
			record, record_error := find_record(plugin, reference.base, &scratch)
			if record_error or record.header.kind == "TREE" or model_path(record).len == 0 do continue
			placed += 1
		}
	}
	print("% of them placed by the viewer (not trees, not disabled, with a mesh)", placed)
	for &kind_count in kinds do print("  % bases of kind %", kind_count.count, kind_count.kind)

	// The game's list for the cell.
	world_name := editor_id_of(plugin, world_id)
	path : [256]utf8
	&path + "distantlod\\"
	for c in world_name do &path + lower(c)
	&path + "_"
	&path + int_text(x)[:]
	&path + "_"
	&path + int_text(y)[:]
	&path + ".lod"
	lod_file, found := find_archived(archives, path[:])
	if not found {
		print("no % in the archives", path)
		return
	}
	file_storage : [1 * MB]byte
	data, read_error := read_archived(archives, lod_file, &file_storage)
	if read_error do return
	kind_total : u32 = data[0]
	at : i64 = 4
	print("% has % kinds:", path, kind_total)
	for k in 0:i64(kind_total) {
		form_id : u32 = data[at]
		count : u32 = data[at + 4]
		at += 8 + i64(count) * 28
		scratch.len = 0
		record, record_error := find_record(plugin, form_id, &scratch)
		if record_error {
			print("  % (unknown): %", form_id, count)
			continue
		}
		print("  % % %: %", form_id, record.header.kind, editor_id(record.data), count)
	}
}

// A record kind and how many of it.
Kind_Count :: struct {
	kind: [4!]utf8
	count: i64
}

command_lod :: fun(name: []utf8, x: i64, y: i64) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	if world_id == 0 {
		print("no world %", name)
		return
	}
	directory_storage : [64 * MB]byte
	archives : Archives
	open_error := open_all_archives(&archives, &directory_storage)
	if open_error {
		print("couldn't open the archives: %", open_error)
		return
	}
	defer close_archives(&archives)

	// All the world's pieces, read as the viewer reads them.
	file_room : [16 * MB]byte
	block_room : [16 * MB]byte
	model_room : [16 * MB]byte
	texture_room : [1 * KB]byte
	room := load_room(&file_room, &block_room, &model_room, &texture_room)
	start := time_now()
	pieces : i64 = 0
	vertices : i64 = 0
	triangles : i64 = 0
	steps := LOD_REACH * 2 / LOD_CELLS
	for row in 0:steps {
		for column in 0:steps {
			piece_name := lod_name(world_id, column * LOD_CELLS - LOD_REACH, row * LOD_CELLS - LOD_REACH)
			piece_file, found := find_archived(&archives, lod_mesh_path(piece_name[:])[:])
			if not found do continue
			built, read_error := read_lod_mesh(&archives, &room, piece_file)
			if read_error {
				print("  couldn't read piece %: %", piece_name, read_error)
				continue
			}
			pieces += 1
			for part in built.parts {
				vertices += part.vertices.len
				triangles += part.indices.len / 3
			}
		}
	}
	print("% pieces of distant land, % vertices, % triangles, read in % ms", pieces, vertices, triangles, elapsed_ms(start))

	corner_x := lod_corner(x)
	corner_y := lod_corner(y)
	piece := lod_name(world_id, corner_x, corner_y)
	print("cell % % is in piece %", x, y, piece)
	survey_distant_objects(&plugin, world_id, x, y, &archives)
	path : [256]utf8
	&path + "textures\\landscapelod\\generated\\"
	&path + piece[:]
	&path + "_fn.dds"
	texture_storage : [16 * MB]byte
	texture, read_error := render.read_archive_texture(&archives, path[:], &texture_storage)
	if read_error {
		print("couldn't read %: %", path, read_error)
		return
	}
	pixel_storage : [8 * MB]byte
	pixels, decode_error := decode_rgba(texture, 0, &pixel_storage)
	if decode_error {
		print("couldn't decode %: %", path, decode_error)
		return
	}

	cell := exterior_cell(&plugin, world_id, x, y)
	land_at, has_land := find_land(&plugin, cell)
	if cell == 0 or not has_land {
		print("no land in cell % %", x, y)
		return
	}
	scratch.len = 0
	record, record_error := record_at(&plugin, land_at, &scratch)
	if record_error {
		print("couldn't read the land: %", record_error)
		return
	}
	cell_land : Land
	read_land(&plugin, record, &cell_land)
	piece_size := f32(LOD_CELLS * CELL_SIZE)
	for point in [[4, 4], [16, 16], [28, 8], [8, 28], [20, 30]] {
		column := point[0]
		row := point[1]
		// Where the point is on the piece's textures: u east, v north.
		u := (f32((x - corner_x) * CELL_SIZE) + f32(column) * LAND_SPACING) / piece_size
		v := (f32((y - corner_y) * CELL_SIZE) + f32(row) * LAND_SPACING) / piece_size
		pixel_x := i64(u * f32(texture.width))
		pixel_y := i64(v * f32(texture.height))
		at := (pixel_y * texture.width + pixel_x) * 4
		mapped := Vec3{f32(pixels[at]) / 255 * 2 - 1, f32(pixels[at + 1]) / 255 * 2 - 1, f32(pixels[at + 2]) / 255 * 2 - 1}
		print("  point % %: the land's normal %, the map's %", column, row, cell_land.normals[row * LAND_SIDE + column], mapped)
	}
}

// `sooblivion shader [name] [package]`: the shaders in one of the game's
// shader packages (Data\Shaders\shaderpackage019.sdp unless named), or
// one of them disassembled, its constants' names listed first.
command_shader :: fun(name: []utf8, package: []utf8) {
	path : Path
	&path + DATA_FOLDER
	&path + "Shaders/"
	&path + package
	storage : [4 * MB]byte
	data, read_error := read_entire_file(path, &storage)
	if read_error {
		print("couldn't read %: %", path, read_error)
		return
	}
	shaders : [1024]Packaged_Shader
	read_package(data, &shaders)
	if name.len == 0 {
		line : str1024
		for shader in shaders {
			if line.len + shader.name.len + 2 > line.cap {
				print(line)
				line.len = 0
			}
			&line + shader.name
			&line + "  "
		}
		print(line)
		print("% shaders", shaders.len)
		return
	}
	for shader in shaders {
		if compare_folded(shader.name, name) != 0 do continue
		lines : [2048][256]utf8
		constants : [256]Named_Constant
		disassemble(shader.code, &lines, &constants)
		print("% (% bytes)", shader.name, shader.code.len)
		for constant in constants {
			// Its registers: c3, or c3 to c6.
			registers : str64
			letter := "c"
			if constant.register_set == 3 do letter = "s"
			elif constant.register_set == 1 do letter = "i"
			elif constant.register_set == 0 do letter = "b"
			&registers + letter[:]
			&registers + int_text(i64(constant.index))[:]
			if constant.count > 1 {
				&registers + " to "
				&registers + letter[:]
				&registers + int_text(i64(constant.index + constant.count - 1))[:]
			}
			print("  // %  %", registers, constant.name)
		}
		for line in lines do print(line)
		return
	}
	print("no shader % in %", name, path)
}

usage :: fun() {
	print("sooblivion                         the game's world, from the Inn of Ill Omen (as when double-clicked)")
	print("sooblivion view-cell <editor id>   an interior cell; its doors lead on, inside and out")
	print("sooblivion view-world [world x y]  a world's exterior from a cell (Tamriel 0 0)")
	print("sooblivion view <mesh>             one mesh")
	print("sooblivion esm [plugin]            what a plugin holds, by record type")
	print("sooblivion bsa <archive>           an archive's folders and files")
	print("sooblivion bsa <archive> <file>    one file from an archive, unpacked")
	print("sooblivion plugins                 the plugins loaded, in order, and the archives")
	print("sooblivion overlaps <world> <x> <y> <z> [radius]")
	print("                                   drawn shapes lying on one another near a point (flicker)")
	print("sooblivion mp3 <file> [raw]        decodes an MP3 (into raw floats, if given)")
	print("sooblivion music <kind> [raw]      a kind's first track through the mix, no sound device (explore, public, dungeon)")
	print("sooblivion help                    this")
}

// `sooblivion mp3 <file> [raw]`: decodes an MP3 file (a path, or one in
// the data folder), saying its channels and rate, how long it is and how
// long decoding took; its samples into raw, if given (32-bit floats, the
// channels interleaved).
command_mp3 :: fun(name: []utf8, raw_path: []utf8) {
	path := data_path(name)
	storage : [64 * MB]byte
	data, read_error := read_entire_file(path, &storage)
	if read_error {
		print("couldn't read %: %", path, read_error)
		return
	}
	decoder := Mp3_Decoder{0}
	pcm : [512 * MB]byte
	start := time_now()
	start_error := mp3_start(&decoder, data)
	if start_error {
		print("couldn't decode %: %", path, start_error)
		return
	}
	written : i64 = 0
	frames : i64 = 0
	more := true
	for more {
		decoded, frame_error := mp3_next_frame(&decoder)
		if frame_error {
			print("stopped at frame %: %", frames, frame_error)
			break
		}
		more = decoded
		if not decoded do break
		frames += 1
		if raw_path.len == 0 do continue
		for sample in decoder.samples {
			if written + 4 > pcm.cap do break
			pcm[written] = sample
			written += 4
		}
	}
	seconds := f64(frames * FRAME_SAMPLES) / f64(decoder.sample_rate)
	print("% channels at % Hz: % frames, % s of sound, decoded in % ms", decoder.channels, decoder.sample_rate, frames, seconds, elapsed_ms(start))
	if raw_path.len == 0 do return
	pcm.len = written
	write_error := write_entire_file(raw_path, pcm[:])
	if write_error do print("couldn't write %: %", raw_path, write_error)
}

// `sooblivion skin <mesh> [animation]`: a skinned mesh posed — by its own
// bones as the file has them (its bind pose: its vertices should stay where
// they are), then by the skeleton (characters\_male\skeleton.nif) as the
// animation (characters\_male\idle.kf) has it at its start: how far the
// vertices move, and the box round them each way.
command_skin :: fun(what: []utf8, animation_path: []utf8) {
	directory_storage : [64 * MB]byte
	archives : Archives
	open_error := open_all_archives(&archives, &directory_storage)
	if open_error {
		print("couldn't open the archives: %", open_error)
		return
	}
	defer close_archives(&archives)
	file_storage : [16 * MB]byte
	nif_storage : [16 * MB]byte
	mesh, mesh_error := read_archived_nif(&archives, what, &file_storage, &nif_storage)
	if mesh_error {
		print("couldn't read %: %", what, mesh_error)
		return
	}
	model_storage : [64 * MB]byte
	unposed, unposed_error := build_model(&mesh, &model_storage)
	if unposed_error {
		print("couldn't make a model of it: %", unposed_error)
		return
	}
	no_tracks : [0]Track
	bind : [128]Pose_Bone
	pose_nodes(&mesh, &no_tracks, 0, &bind)
	in_bind, bind_error := build_posed_model(&mesh, bind[:], mat4_identity(), &model_storage)
	if bind_error {
		print("couldn't pose it: %", bind_error)
		return
	}
	farthest : f32 = 0
	for &part, p in unposed.parts {
		for &vertex, v in part.vertices {
			farthest = max(farthest, vec3_length(in_bind.parts[p].vertices[v].position - vertex.position))
		}
	}
	print("% bones in its own pose; posed by them, its vertices move % at most", bind.len, farthest)
	print("  unposed: from % to %", unposed.bounds_min, unposed.bounds_max)

	skeleton_storage : [16 * MB]byte
	skeleton_nif : [16 * MB]byte
	skeleton, skeleton_error := read_archived_nif(&archives, "meshes/characters/_male/skeleton.nif", &skeleton_storage, &skeleton_nif)
	animation_storage : [16 * MB]byte
	animation_nif : [16 * MB]byte
	motion, animation_error := read_archived_nif(&archives, animation_path, &animation_storage, &animation_nif)
	if skeleton_error or animation_error {
		print("couldn't read the skeleton or the animation: % %", skeleton_error, animation_error)
		return
	}
	tracks : [256]Track
	track_room : [4 * MB]byte
	for &block, index in motion.blocks {
		match block^ {
		Sequence sequence
			read_tracks(&motion, index, &tracks, &track_room, true)
			print("% tracks of sequence %", tracks.len, sequence.name)
			break
		else
		}
	}
	posed_bones : [128]Pose_Bone
	pose_nodes(&skeleton, &tracks, 0, &posed_bones)
	posed, posed_error := build_posed_model(&mesh, posed_bones[:], mat4_identity(), &model_storage)
	if posed_error {
		print("couldn't pose it: %", posed_error)
		return
	}
	print("  posed by the skeleton (% bones): from % to %", posed_bones.len, posed.bounds_min, posed.bounds_max)
}

// `sooblivion npc <editor id>`: an NPC as the viewer puts it together: its
// parts (each mesh, the texture it's drawn with, the bone it hangs from),
// then its model made (no window): how many shapes, the box round them.
command_npc :: fun(name: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugins: %", load_error)
		return
	}
	scratch : [1 * MB]byte
	npc_id, found := find_by_editor_id(&plugin, name, &scratch)
	if not found {
		print("no record %", name)
		return
	}
	look : Npc_Look
	look_error := read_npc_look(&plugin, npc_id, &look)
	if look_error {
		print("couldn't read its look: %", look_error)
		return
	}
	print("% (%), skeleton %, height %", name, if look.female do "a woman" else "a man", look.skeleton, look.height)
	for &part in look.parts do print("  % % %", part.mesh, part.texture, part.bone)
	directory_storage : [64 * MB]byte
	archives : Archives
	open_error := open_all_archives(&archives, &directory_storage)
	if open_error {
		print("couldn't open the archives: %", open_error)
		return
	}
	defer close_archives(&archives)
	file_room : [16 * MB]byte
	block_room : [16 * MB]byte
	model_room : [64 * MB]byte
	texture_room : [1 * KB]byte
	room := load_room(&file_room, &block_room, &model_room, &texture_room)
	bones : [MAX_POSE_BONES]Pose_Bone
	pose_error := read_skeleton_pose(&archives, &room, look.skeleton[:], &bones)
	if pose_error {
		print("couldn't pose its skeleton: %", pose_error)
		return
	}
	report := Npc_Report{failures = 0, first = [], reason = Not_In_Archive}
	whole := assemble_npc(&archives, &room, &look, bones[:], &report)
	print("% shapes, from % to %", whole.parts.len, whole.bounds_min, whole.bounds_max)
	for &part in whole.parts {
		low := Vec3{1000000, 1000000, 1000000}
		high := Vec3{-1000000, -1000000, -1000000}
		for &vertex in part.vertices {
			for axis in 0:3 {
				low[axis] = min(low[axis], vertex.position[axis])
				high[axis] = max(high[axis], vertex.position[axis])
			}
		}
		print("    % from % to %", part.texture, low, high)
	}
	if report.failures > 0 do print("% parts left out; the first: %, %", report.failures, report.first, report.reason)
}

// A drawn triangle in the world, for command_overlaps: its corners, the
// way it faces, the shape it's from (an index into the shapes).
Placed_Triangle :: struct {
	corners: [3!]Vec3
	facing: Vec3
	shape: i64
}

// A shape command_overlaps looks at: its mesh, its texture, the reference
// that places it.
Placed_Shape :: struct {
	mesh: [256]utf8
	texture: [160]utf8
	reference: u32
}

// Two shapes found lying on one another: how many pairs of their
// triangles do, and how far the second's corners are in front of the
// first's plane in such a pair, at least and at most (behind: below 0).
Overlapping_Shapes :: struct {
	first: i64
	second: i64
	pairs: i64
	lowest: f32
	highest: f32
}

OVERLAP_GAP :: 0.5     // triangles closer than this to one plane count as on it
OVERLAP_HAIR :: 0.05   // triangles reaching less than this into each other only touch

// `sooblivion overlaps <world> <x> <y> <z> [radius]`: the drawn triangles
// near a point (within radius, 500 when not given) that lie on one
// another: on one plane, facing the same way, covering some of the same
// place, from different shapes. Where the frame flickers between two
// shapes, they show up here.
command_overlaps :: fun(name: []utf8, point: Vec3, radius: f32) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugins: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	if world_id == 0 {
		print("no world %", name)
		return
	}
	directory_storage : [64 * MB]byte
	archives : Archives
	open_error := open_all_archives(&archives, &directory_storage)
	if open_error {
		print("couldn't open the archives: %", open_error)
		return
	}
	defer close_archives(&archives)
	file_room : [16 * MB]byte
	block_room : [16 * MB]byte
	model_room : [64 * MB]byte
	shapes : [4096]Placed_Shape
	triangles : [200000]Placed_Triangle
	references : [16384]Reference

	// The triangles near the point, from the cell it's in and those round it.
	middle_x := i64(floor_f32(point.x / CELL_SIZE))
	middle_y := i64(floor_f32(point.y / CELL_SIZE))
	for cell_y in middle_y - 1 .. middle_y + 1 {
		for cell_x in middle_x - 1 .. middle_x + 1 {
			cell := exterior_cell(&plugin, world_id, cell_x, cell_y)
			if cell == 0 do continue
			references.len = 0
			references_error := cell_references(&plugin, cell, &references)
			if references_error do continue
			for reference in references {
				if reference.flags & RECORD_DISABLED != 0 do continue
				scratch.len = 0
				base, base_error := find_record(&plugin, reference.base, &scratch)
				if base_error do continue
				path := model_path(base)
				if path.len == 0 or is_marker(path[:]) do continue
				file_room.len = 0
				block_room.len = 0
				mesh, mesh_error := read_archived_nif(&archives, path[:], &file_room, &block_room)
				if mesh_error do continue
				model_room.len = 0
				built, model_error := build_model(&mesh, &model_room)
				if model_error do continue
				place := reference_transform(reference)
				for &part in built.parts {
					if shapes.len == shapes.cap do break
					kept := false
					for t in 0:part.indices.len / 3 {
						corners : [3!]Vec3
						for k in 0:3 {
							position := part.vertices[i64(part.indices[t * 3 + k])].position
							placed := mat4_mul_vec4(place, Vec4{position.x, position.y, position.z, 1})
							corners[k] = Vec3{placed[0], placed[1], placed[2]}
						}
						if not triangle_near(corners, point, radius) or triangles.len == triangles.cap do continue
						facing := cross(vec3_sub(corners[1], corners[0]), vec3_sub(corners[2], corners[0]))
						if vec3_length(facing) < 0.0001 do continue
						&triangles + Placed_Triangle{corners = corners, facing = vec3_normalize(facing), shape = shapes.len}
						kept = true
					}
					if kept do &shapes + Placed_Shape{mesh = path, texture = part.texture, reference = reference.form_id}
				}
			}
		}
	}

	// Each pair of triangles from different shapes.
	found : [256]Overlapping_Shapes
	for i in 0:triangles.len {
		a := &triangles[i]
		for j in i + 1 : triangles.len {
			b := &triangles[j]
			if a.shape == b.shape or dot(a.facing, b.facing) < 0.995 do continue
			lowest : f32 = 1000000
			highest : f32 = -1000000
			for k in 0:3 {
				in_front := dot(vec3_sub(b.corners[k], a.corners[0]), a.facing)
				lowest = min(lowest, in_front)
				highest = max(highest, in_front)
			}
			if max(abs_f32(lowest), abs_f32(highest)) > OVERLAP_GAP or not triangles_cover(a, b) do continue
			first := min(a.shape, b.shape)
			second := max(a.shape, b.shape)
			index : i64 = -1
			for &pair, p in found {
				if pair.first == first and pair.second == second do index = p
			}
			if index < 0 {
				if found.len == found.cap do continue
				&found + Overlapping_Shapes{first = first, second = second, pairs = 0, lowest = lowest, highest = highest}
				index = found.len - 1
			}
			// (The triangles go in shape by shape, so a's shape is the first.)
			found[index].pairs += 1
			found[index].lowest = min(found[index].lowest, lowest)
			found[index].highest = max(found[index].highest, highest)
		}
	}
	print("% shapes, % triangles within % of %", shapes.len, triangles.len, radius, point)
	for &pair in found {
		first := &shapes[pair.first]
		second := &shapes[pair.second]
		print("  % pairs, the second % to % in front:", pair.pairs, pair.lowest, pair.highest)
		print("    % % (reference %)", first.mesh, first.texture, first.reference)
		print("    % % (reference %)", second.mesh, second.texture, second.reference)
	}
}

// Whether a triangle comes within radius of a point (its box does).
triangle_near :: fun(corners: [3!]Vec3, point: Vec3, radius: f32) -> bool {
	closest := point
	for axis in 0:3 {
		low := min(corners[0][axis], min(corners[1][axis], corners[2][axis]))
		high := max(corners[0][axis], max(corners[1][axis], corners[2][axis]))
		closest[axis] = min(max(point[axis], low), high)
	}
	return vec3_length(vec3_sub(closest, point)) < radius
}

// Whether two triangles on one plane (a's) cover some of the same place:
// seen flat, along the axis a faces most, no edge of either has all of the
// other on its outer side.
triangles_cover :: fun(a: ^Placed_Triangle, b: ^Placed_Triangle) -> bool {
	dropped := 0
	for axis in 1:3 {
		if abs_f32(a.facing[axis]) > abs_f32(a.facing[dropped]) do dropped = axis
	}
	across := (dropped + 1) % 3
	up := (dropped + 2) % 3
	flat_a : [3!]Vec3
	flat_b : [3!]Vec3
	for k in 0:3 {
		flat_a[k] = Vec3{a.corners[k][across], a.corners[k][up], 0}
		flat_b[k] = Vec3{b.corners[k][across], b.corners[k][up], 0}
	}
	return not outside_an_edge(flat_a, flat_b) and not outside_an_edge(flat_b, flat_a)
}

// Whether all of second (flat: z 0) lies on the outer side of one of
// first's edges, or reaches in less than a hair (OVERLAP_HAIR).
outside_an_edge :: fun(first: [3!]Vec3, second: [3!]Vec3) -> bool {
	for k in 0:3 {
		start := first[k]
		edge := vec3_sub(first[(k + 1) % 3], start)
		// Square to the edge, pointing away from the third corner.
		outward := vec3_normalize(Vec3{-edge.y, edge.x, 0})
		if dot(outward, vec3_sub(first[(k + 2) % 3], start)) > 0 do outward = vec3_negate(outward)
		reaching_in := false
		for corner in second {
			if dot(outward, vec3_sub(corner, start)) < -OVERLAP_HAIR do reaching_in = true
		}
		if not reaching_in do return true
	}
	return false
}

// `sooblivion plugins`: the plugins the game loads, in its order, and its
// archives in the order a file is looked for in them.
command_plugins :: fun() {
	order : Load_Order
	order_error := read_load_order(&order)
	if order_error {
		print("couldn't read the load order: %", order_error)
		return
	}
	for &plugin, k in order.plugins do print("  % %", k, plugin.name)
	directory_storage : [64 * MB]byte
	archives : Archives
	open_error := open_game_archives(&order, &archives, &directory_storage)
	if open_error {
		print("couldn't open the archives: %", open_error)
		return
	}
	defer close_archives(&archives)
	for &archive in archives.list do print("  % files, % folders", archive.files.len, archive.folders.len)
}

// `sooblivion music <explore | public | dungeon> [raw]`: plays a kind of
// music through the mix without opening the sound device, as the viewer
// would: its first track whole, saying which it was and how long mixing
// it took; the mix into raw, if given (32-bit floats, stereo).
command_music :: fun(kind_name: []utf8, raw_path: []utf8) {
	kind := MUSIC_EXPLORE
	if kind_name == "public" do kind = MUSIC_PUBLIC
	elif kind_name == "dungeon" do kind = MUSIC_DUNGEON
	room : [1 * MB]byte
	mixer : Mixer
	audio_init(&mixer, 64 * KB, &room)
	music_folder := data_path("Music")
	music_open(&mixer, music_folder[:])
	want_music(&mixer, kind)
	pcm : [512 * MB]byte
	written : i64 = 0
	start := time_now()
	blocks : i64 = 0
	for mixer.music.tracks_started < 2 and mixer.failures == 0 {
		mixer.mix.len = AHEAD * 2
		for k in 0:mixer.mix.len do mixer.mix[k] = 0
		mix_music(&mixer, AHEAD)
		blocks += 1
		if mixer.music.tracks_started == 1 and blocks == 1 do print("track: %", mixer.music.track)
		if mixer.music.tracks_started >= 2 do break
		if raw_path.len == 0 do continue
		for sample in mixer.mix {
			if written + 4 > pcm.cap do break
			pcm[written] = sample
			written += 4
		}
	}
	if mixer.failures > 0 do print("couldn't play %: %", mixer.first_failure, mixer.first_failure_reason)
	print("% s mixed in % ms", f64(blocks * AHEAD) / MIX_RATE, elapsed_ms(start))
	stop_track(&mixer.music)
	if raw_path.len == 0 do return
	pcm.len = written
	write_error := write_entire_file(raw_path, pcm[:])
	if write_error do print("couldn't write %: %", raw_path, write_error)
}

// Keeps the console open until Enter is pressed (or its input ends).
wait_for_enter :: fun() {
	print("press Enter to close")
	line : [256]byte
	_ = file_read(standard_input(), &line)   // (what's typed, or nothing: done either way)
}

// Where the game starts when sooblivion is given nothing to do (double-
// clicked): an inn by the road, its door leading outside.
START_CELL :: "InnIllOmen"

main :: (args: [][]utf8) {
	if args.len < 2 {
		// Double-clicked, most likely: the console window goes when the
		// program does, so a message about not starting is waited on.
		if command_view_cell(START_CELL) do wait_for_enter()
		return
	}
	command := args[1]
	if command == "help" {
		usage()
	elif command == "esm"
		command_esm(if args.len > 2 do args[2] else "Oblivion.esm")
	elif command == "view" and args.len > 2
		command_view(args[2])
	elif command == "texture" and args.len > 2
		command_texture(args[2], if args.len > 3 do args[3] else "Oblivion - Textures - Compressed.bsa")
	elif command == "model" and args.len > 2
		command_model(args[2], if args.len > 3 do args[3] else "Oblivion - Meshes.bsa")
	elif command == "cells"
		command_cells(if args.len > 2 do args[2] else "")
	elif command == "view-cell" and args.len > 2
		_ = command_view_cell(args[2])   // (it says why it couldn't)
	elif command == "area" and args.len > 4
		x, x_ok := parse_number(args[3])
		y, y_ok := parse_number(args[4])
		if x_ok and y_ok do command_area(args[2], i64(x), i64(y))
		else do usage()
	elif command == "walk" and args.len > 5
		x, x_ok := parse_number(args[3])
		y, y_ok := parse_number(args[4])
		steps, steps_ok := parse_number(args[5])
		if x_ok and y_ok and steps_ok do command_walk(args[2], i64(x), i64(y), i64(steps))
		else do usage()
	elif command == "view-world"
		if args.len > 4 {
			x, x_ok := parse_number(args[3])
			y, y_ok := parse_number(args[4])
			if x_ok and y_ok do command_view_world(args[2], i64(x), i64(y))
			else do usage()
		elif args.len > 2
			command_view_world(args[2], 0, 0)
		else
			command_view_world("Tamriel", 0, 0)
		}
	elif command == "map"
		command_map(if args.len > 2 do args[2] else "Tamriel")
	elif command == "sky"
		command_sky(if args.len > 2 do args[2] else "Tamriel")
	elif command == "doors"
		command_doors()
	elif command == "find" and args.len > 2
		command_find(args[2])
	elif command == "door" and args.len > 2
		command_door(args[2])
	elif command == "anim" and args.len > 2
		command_anim(args[2])
	elif command == "collision" and args.len > 5
		x, x_ok := parse_number(args[3])
		y, y_ok := parse_number(args[4])
		z, z_ok := parse_number(args[5])
		if x_ok and y_ok and z_ok do command_collision(args[2], Vec3{f32(x), f32(y), f32(z)}, true)
		else do usage()
	elif command == "collision" and args.len > 2
		command_collision(args[2], Vec3{0, 0, 0}, false)
	elif command == "grass" and args.len > 4
		x, x_ok := parse_number(args[3])
		y, y_ok := parse_number(args[4])
		if x_ok and y_ok do command_grass(args[2], i64(x), i64(y))
		else do usage()
	elif command == "lod" and args.len > 4
		x, x_ok := parse_number(args[3])
		y, y_ok := parse_number(args[4])
		if x_ok and y_ok do command_lod(args[2], i64(x), i64(y))
		else do usage()
	elif command == "shader"
		name : []utf8 = args[0][0:0]
		if args.len > 2 do name = args[2]
		command_shader(name, if args.len > 3 do args[3] else "shaderpackage019.sdp")
	elif command == "records" and args.len > 2
		command_records(args[2])
	elif command == "record" and args.len > 2
		command_record(args[2])
	elif command == "cell" and args.len > 2
		command_cell(args[2], args.len > 3 and args[3] == "-all")
	elif command == "textures"
		command_textures(if args.len > 2 do args[2] else "Oblivion - Textures - Compressed.bsa")
	elif command == "sounds"
		command_sounds()
	elif command == "plugins"
		command_plugins()
	elif command == "overlaps" and args.len > 5
		x, x_ok := parse_number(args[3])
		y, y_ok := parse_number(args[4])
		z, z_ok := parse_number(args[5])
		radius, radius_ok := parse_number(if args.len > 6 do args[6] else "500")
		if x_ok and y_ok and z_ok and radius_ok do command_overlaps(args[2], Vec3{f32(x), f32(y), f32(z)}, f32(radius))
		else do usage()
	elif command == "npc" and args.len > 2
		command_npc(args[2])
	elif command == "skin" and args.len > 2
		command_skin(args[2], if args.len > 3 do args[3] else "meshes/characters/_male/idle.kf")
	elif command == "music" and args.len > 2
		command_music(args[2], if args.len > 3 do args[3] else "")
	elif command == "mp3" and args.len > 2
		command_mp3(args[2], if args.len > 3 do args[3] else "")
	elif command == "sound" and args.len > 2
		command_sound(args[2])
	elif command == "nifs"
		command_nifs(if args.len > 2 do args[2] else "Oblivion - Meshes.bsa")
	elif command == "bsa" and args.len > 2
		command_bsa(args[2], if args.len > 3 do args[3] else "")
	else
		usage()
	}
}

// Milliseconds since start, a time_now.
elapsed_ms :: fun(start: u64) -> i64 {
	return i64((time_now() - start) / 1000000)
}
