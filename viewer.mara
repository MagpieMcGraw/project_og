// The viewer: the game's window showing a mesh, an interior cell, or a
// world's land and what's on it; a camera flown around; doors that lead
// to other cells.
//
// W, A, S, D fly, Left Shift faster; the right mouse button turns mouse
// look on and off; E goes through the door nearest the camera; Escape quits.
module sooblivion

use mara.core
use mara.math
use mara.memory
use mara.sdl
use mara.time
use bsa
use nif
use model
use world
use land
use scene
use sdl_platform
render :: use render

// How high above the floor the camera is when arriving: a person's eyes,
// in Oblivion's units.
EYE_HEIGHT :: 120
// How near a door must be to go through it.
DOOR_REACH :: 300

// What the viewer commands share: the archives, the window, drawing, and
// what's drawn.
Viewer :: struct {
	meshes: Archive
	textures: Archive
	platform: Platform
	renderer: render.Renderer
	shown: Scene
	room: Load_Room
	camera: render.Camera
	chosen_door: i64    // the door view_loop stopped for
}

// Why the viewer's loop stopped.
View_Event :: union {
	quit = 0
	door        // E was pressed near a door: viewer.chosen_door
	crossed     // outside, the camera went into another cell
}

// Opens the archives (their directories into directory_storage) and the
// window, and sets up drawing, into viewer; the scene's tables are carved
// from table_storage.
viewer_open :: fun(viewer: ^Viewer, directory_storage: ^[]byte, table_storage: ^[]byte) -> err {
	viewer.meshes = open_archive(data_path("Oblivion - Meshes.bsa"), directory_storage)?
	viewer.textures = open_archive(data_path("Oblivion - Textures - Compressed.bsa"), directory_storage)?
	viewer.platform = platform_open("sooblivion", 1280, 720)?
	renderer_init(&viewer.renderer)?
	scene_clear(&viewer.shown, table_storage)
	viewer.camera = render.Camera(){position = Vec3{0, 0, 0}, yaw = 0, pitch = 0}
	viewer.chosen_door = -1
}

viewer_close :: fun(viewer: ^Viewer) {
	platform_close(&viewer.platform)
	close_archive(&viewer.textures)
	close_archive(&viewer.meshes)
}

// The rooms loading uses, as views of storages the caller keeps: each up
// to its cap ([:] would stop at its len, 0 here).
load_room :: fun(file_room: ^[]byte, block_room: ^[]byte, model_room: ^[]byte, texture_room: ^[]byte) -> Load_Room {
	return Load_Room{
		file = file_room[0 : file_room.cap],
		blocks = block_room[0 : block_room.cap],
		model = model_room[0 : model_room.cap],
		texture = texture_room[0 : texture_room.cap]}
}

// The viewer's loop: draws the scene from the camera, flying it speed
// units a second, until something happens that the command answers.
view_loop :: fun(viewer: ^Viewer, speed: f32) -> View_Event {
	platform := &viewer.platform
	camera := &viewer.camera
	shown := &viewer.shown
	input : Input
	frame_start := time_now()
	for true {
		read_input(platform, &input)
		if input.quit or input.pressed[Escape] do return .quit
		if input.mouse_pressed[3] do set_mouse_look(platform, not platform.mouse_look)
		if input.pressed[E] {
			viewer.chosen_door = nearest_door(shown, camera.position)
			if viewer.chosen_door >= 0 do return .door
		}

		seconds, now := time_since(frame_start)
		frame_start = now
		if platform.mouse_look {
			camera.yaw += input.mouse_moved_x * 0.003
			camera.pitch -= input.mouse_moved_y * 0.003
			if camera.pitch > 1.5 do camera.pitch = 1.5
			if camera.pitch < -1.5 do camera.pitch = -1.5
		}
		forward, right, up := camera_axes(camera^)
		step := f32(seconds) * speed
		if input.held[LShift] do step *= 4
		if input.held[W] do camera.position = camera.position + forward * step
		if input.held[S] do camera.position = camera.position - forward * step
		if input.held[D] do camera.position = camera.position + right * step
		if input.held[A] do camera.position = camera.position - right * step

		if shown.world != 0 {
			x, y := grid_of(camera.position)
			if x != shown.center_x or y != shown.center_y do return .crossed
		}

		draw_instances(&viewer.renderer, &shown.models, &shown.instances, &shown.lights, shown.lighting,
			camera^, platform.width, platform.height)
		present(platform)
	}
	return .quit
}

// The door nearest a place, within reach of it: its index in the scene's
// doors, or -1. (A door's place is at its foot; the eyes are above it.)
nearest_door :: fun(shown: ^Scene, place: Vec3) -> i64 {
	nearest : i64 = -1
	nearest_distance : f32 = DOOR_REACH
	for candidate, i in shown.doors {
		distance := vec3_length(candidate.position + Vec3{0, 0, EYE_HEIGHT} - place)
		if distance < nearest_distance {
			nearest = i
			nearest_distance = distance
		}
	}
	return nearest
}

// `sooblivion view <mesh>`: shows a mesh in the window.
command_view :: fun(what: []utf8) {
	directory_storage : [64 * MB]byte
	table_storage : [1 * MB]byte
	viewer : Viewer
	open_error := viewer_open(&viewer, &directory_storage, &table_storage)
	if open_error {
		print("couldn't open the viewer: %", open_error)
		return
	}
	defer viewer_close(&viewer)
	file_room : [64 * MB]byte
	block_room : [16 * MB]byte
	model_room : [64 * MB]byte
	texture_room : [64 * MB]byte
	viewer.room = load_room(&file_room, &block_room, &model_room, &texture_room)

	shown := &viewer.shown
	model_index := scene_model(shown, &viewer.renderer, &viewer.meshes, &viewer.textures, what, &viewer.room)
	if model_index < 0 {
		print("couldn't load %", what)
		return
	}
	&shown.instances + render.Instance{model = model_index, world = mat4_identity()}

	// Start back from the model's middle, far enough to see all of it.
	gpu_model := shown.models[model_index]
	viewer.camera.position = gpu_model.center - Vec3{0, gpu_model.radius * 2, 0}
	for view_loop(&viewer, gpu_model.radius) != .quit {}
}

// `sooblivion view-cell <editor id>`: shows an interior cell in the
// window; its doors lead on, inside and out.
command_view_cell :: fun(name: []utf8) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	cell, cell_error := find_interior_cell(&plugin, name, &scratch)
	if cell_error {
		print("no interior cell %", name)
		return
	}
	directory_storage : [64 * MB]byte
	table_storage : [1 * MB]byte
	viewer : Viewer
	open_error := viewer_open(&viewer, &directory_storage, &table_storage)
	if open_error {
		print("couldn't open the viewer: %", open_error)
		return
	}
	defer viewer_close(&viewer)
	file_room : [64 * MB]byte
	block_room : [16 * MB]byte
	model_room : [64 * MB]byte
	texture_room : [64 * MB]byte
	viewer.room = load_room(&file_room, &block_room, &model_room, &texture_room)

	go_inside(&viewer, &plugin, cell)
	start_in_cell(&viewer, &plugin)
	explore(&viewer, &plugin)
}

// `sooblivion view-world [world] [x y]`: shows a world's land and what's
// on it around the cell at x, y on its grid.
command_view_world :: fun(name: []utf8, x: i64, y: i64) {
	data_storage : [400 * MB]byte
	index_storage : [96 * MB]byte
	plugin, load_error := load_oblivion(&data_storage, &index_storage)
	if load_error {
		print("couldn't load the plugin: %", load_error)
		return
	}
	scratch : [16 * MB]byte
	world_id := find_world(&plugin, name, &scratch)
	if world_id == 0 {
		print("no world %", name)
		return
	}
	directory_storage : [64 * MB]byte
	table_storage : [1 * MB]byte
	viewer : Viewer
	open_error := viewer_open(&viewer, &directory_storage, &table_storage)
	if open_error {
		print("couldn't open the viewer: %", open_error)
		return
	}
	defer viewer_close(&viewer)
	file_room : [64 * MB]byte
	block_room : [16 * MB]byte
	model_room : [64 * MB]byte
	texture_room : [64 * MB]byte
	viewer.room = load_room(&file_room, &block_room, &model_room, &texture_room)

	// In the middle of the cell, high enough to be over its land.
	middle := Vec3{(f32(x) + 0.5) * CELL_SIZE, (f32(y) + 0.5) * CELL_SIZE, 0}
	middle.z = ground_height(&plugin, world_id, middle, &scratch) + EYE_HEIGHT
	go_outside(&viewer, &plugin, world_id, middle)
	explore(&viewer, &plugin)
}

// Flies around until the viewer quits: through doors when E is pressed at
// one, and loading the cells around the camera as it moves outside.
explore :: fun(viewer: ^Viewer, plugin: ^Plugin) {
	scratch : [16 * MB]byte
	for true {
		speed : f32 = 400
		if viewer.shown.world != 0 do speed = 1500
		event := view_loop(viewer, speed)
		match event {
		quit
			return
		crossed
			x, y := grid_of(viewer.camera.position)
			show_error := show_exterior(&viewer.shown, plugin, viewer.shown.world, x, y,
				&viewer.renderer, &viewer.meshes, &viewer.textures, &viewer.room)
			if show_error do print("loading the cells stopped: %", show_error)
		door
			scratch.len = 0
			there, leads := door_destination(plugin, viewer.shown.doors[viewer.chosen_door].reference, &scratch)
			if not leads do continue
			target := cell_of_reference(plugin, there.door)
			if target == 0 {
				print("that door's other side isn't in any cell found")
				continue
			}
			arrival := there.position + Vec3{0, 0, EYE_HEIGHT}
			world_id := cell_world(plugin, target)
			if world_id != 0 do go_outside(viewer, plugin, world_id, arrival)
			else do go_inside(viewer, plugin, target)
			viewer.camera.position = arrival
			viewer.camera.yaw = there.rotation.z
			viewer.camera.pitch = 0
		}
	}
}

// Shows an interior cell, its name in the window's title.
go_inside :: fun(viewer: ^Viewer, plugin: ^Plugin, cell: u32) {
	shown := &viewer.shown
	start := time_now()
	show_error := show_interior(shown, plugin, cell, &viewer.renderer, &viewer.meshes, &viewer.textures, &viewer.room)
	if show_error do print("reading the cell stopped: %", show_error)
	title := record_name(plugin, cell)
	_ = SetWindowTitle(viewer.platform.window, cstring(title))
	print("% : % instances, % lights, % doors; % models loaded (% meshes failed), in % ms",
		title, shown.instances.len, shown.lights.len, shown.doors.len, shown.models.len, shown.failed_paths, elapsed_ms(start))
}

// Shows a world's cells around a place in it, the world's name in the
// window's title, the camera there.
go_outside :: fun(viewer: ^Viewer, plugin: ^Plugin, world_id: u32, place: Vec3) {
	shown := &viewer.shown
	start := time_now()
	x, y := grid_of(place)
	show_error := show_exterior(shown, plugin, world_id, x, y, &viewer.renderer, &viewer.meshes, &viewer.textures, &viewer.room)
	if show_error do print("loading the cells stopped: %", show_error)
	viewer.camera.position = place
	title := record_name(plugin, world_id)
	_ = SetWindowTitle(viewer.platform.window, cstring(title))
	print("% (% %): % instances, % lights, % doors, % land cells; % models loaded (% meshes failed), in % ms",
		title, x, y, shown.instances.len, shown.lights.len, shown.doors.len, shown.terrain.len,
		shown.models.len, shown.failed_paths, elapsed_ms(start))
}

// A record's name for people (FULL), else its editor id.
record_name :: fun(plugin: ^Plugin, form_id: u32) -> str256 {
	scratch : [1 * MB]byte
	name : str256
	record, record_error := find_record(plugin, form_id, &scratch)
	if record_error do return name
	full_name, has_name := find_field(record.data, "FULL")
	if has_name do &name + field_text(full_name)
	else do &name + editor_id(record.data)
	return name
}

// Puts the camera where one arrives in the scene's cell through a door;
// failing that, in the middle of what's placed.
start_in_cell :: fun(viewer: ^Viewer, plugin: ^Plugin) {
	entrance, found := scene_entrance(&viewer.shown, plugin)
	if found {
		viewer.camera.position = entrance.position + Vec3{0, 0, EYE_HEIGHT}
		viewer.camera.yaw = entrance.rotation.z
		viewer.camera.pitch = 0
		return
	}
	low := Vec3{1000000, 1000000, 1000000}
	high := Vec3{-1000000, -1000000, -1000000}
	for instance in viewer.shown.instances {
		for axis in 0:3 {
			place := instance.world[3][axis]
			if place < low[axis] do low[axis] = place
			if place > high[axis] do high[axis] = place
		}
	}
	viewer.camera.position = (low + high) * 0.5
}

// The height of a world's land under a place: its nearest vertex's. 0 where
// there's no land.
ground_height :: fun(plugin: ^Plugin, world_id: u32, place: Vec3, scratch: ^[]byte) -> f32 {
	x, y := grid_of(place)
	cell := exterior_cell(plugin, world_id, x, y)
	if cell == 0 do return 0
	land_at, has_land := find_land(plugin, cell)
	if not has_land do return 0
	scratch.len = 0
	record, record_error := record_at(plugin, land_at, scratch)
	if record_error do return 0
	cell_land : Land
	read_land(record.data, &cell_land)
	column := i64((place.x - f32(x * CELL_SIZE)) / LAND_SPACING + 0.5)
	row := i64((place.y - f32(y * CELL_SIZE)) / LAND_SPACING + 0.5)
	return cell_land.heights[row * LAND_SIDE + column]
}
