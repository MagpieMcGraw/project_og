// Drawing models with OpenGL: their parts uploaded to the graphics card
// with their textures, and drawn from a camera.
//
// Oblivion's world has z up, x east and y north; a unit is about 1.4 cm, a
// cell 4096 units across.
module render

use mara.core
use mara.math
use mara.open_gl
use model
use dds
use bsa
use world
use mara.string

// The most lights that light one object.
MAX_LIGHTS :: 8

VERTEX_SHADER_SOURCE :: "#version 450 core
layout(location = 0) in vec3 position;
layout(location = 1) in vec3 normal;
layout(location = 2) in vec2 uv;
layout(location = 3) in vec4 color;

uniform mat4 world_view_projection;
uniform mat4 world;

out vec3 world_position;
out vec3 world_normal;
out vec2 texture_uv;
out vec4 vertex_color;

void main() {
	gl_Position = world_view_projection * vec4(position, 1.0);
	world_position = (world * vec4(position, 1.0)).xyz;
	world_normal = mat3(world) * normal;
	texture_uv = uv;
	vertex_color = color;
}
"

FRAGMENT_SHADER_SOURCE :: "#version 450 core
#define MAX_LIGHTS 8
in vec3 world_position;
in vec3 world_normal;
in vec2 texture_uv;
in vec4 vertex_color;

uniform sampler2D base_texture;
uniform float alpha_threshold;    // pixels below it are left out; 0 for none
uniform vec3 sun_direction;       // where the light comes from
uniform vec3 sun_color;
uniform vec3 ambient_color;
uniform vec3 emissive_color;
uniform int light_count;
uniform vec3 light_position[MAX_LIGHTS];
uniform vec3 light_color[MAX_LIGHTS];
uniform float light_radius[MAX_LIGHTS];
uniform vec3 camera_position;
uniform vec3 fog_color;
uniform float fog_near;
uniform float fog_far;            // no fog when it isn't past fog_near

out vec4 fragment_color;

void main() {
	vec4 base = texture(base_texture, texture_uv) * vertex_color;
	if (base.a < alpha_threshold) discard;
	vec3 normal = normalize(world_normal);
	if (!gl_FrontFacing) normal = -normal;   // a two-sided part's back
	vec3 light = ambient_color + emissive_color + sun_color * max(dot(normal, sun_direction), 0.0);
	for (int i = 0; i < light_count; i++) {
		vec3 to_light = light_position[i] - world_position;
		float distance = length(to_light);
		float reach = clamp(1.0 - distance / light_radius[i], 0.0, 1.0);
		float facing = max(dot(normal, to_light / max(distance, 0.001)), 0.0);
		light += light_color[i] * facing * reach * reach;
	}
	vec3 color = base.rgb * light;
	if (fog_far > fog_near) {
		float fog = clamp((length(world_position - camera_position) - fog_near) / (fog_far - fog_near), 0.0, 1.0);
		color = mix(color, fog_color, fog);
	}
	fragment_color = vec4(color, base.a);
}
"

// A model's part on the graphics card.
Gpu_Part :: struct {
	vertex_array: u32
	vertex_buffer: u32
	index_buffer: u32
	index_count: i32
	texture: u32
	alpha_blend: bool
	alpha_test: bool
	alpha_threshold: f32
	two_sided: bool
	emissive: Vec3
}

// A model on the graphics card: its parts, and a sphere around them in
// the model's space (for choosing the lights that reach it).
Gpu_Model :: struct {
	parts: [64]Gpu_Part
	center: Vec3
	radius: f32
}

// A model placed in the world.
Instance :: struct {
	model: i64     // in the models drawn
	world: Mat4
}

// A texture loaded once, by its path.
Cached_Texture :: struct {
	path: [160]utf8
	id: u32
}

// The renderer: its shader, its textures, and where they're read from.
Renderer :: struct {
	program: u32
	world_view_projection_at: i32   // the shader's uniforms' places
	world_at: i32
	alpha_threshold_at: i32
	sun_direction_at: i32
	sun_color_at: i32
	ambient_color_at: i32
	emissive_color_at: i32
	light_count_at: i32
	light_position_at: [MAX_LIGHTS!]i32
	light_color_at: [MAX_LIGHTS!]i32
	light_radius_at: [MAX_LIGHTS!]i32
	camera_position_at: i32
	fog_color_at: i32
	fog_near_at: i32
	fog_far_at: i32
	textures: [4096]Cached_Texture
	white_texture: u32              // for parts with none
}

// What setting up the renderer can fail with.
Render_Error :: error {
	Shader_Failed
}

// Compiles the shader and makes the white texture.
renderer_init :: fun(renderer: ^Renderer) -> err {
	vertex_shader := gl_compile_shader(VERTEX_SHADER, VERTEX_SHADER_SOURCE)
	fragment_shader := gl_compile_shader(FRAGMENT_SHADER, FRAGMENT_SHADER_SOURCE)
	if vertex_shader == 0 or fragment_shader == 0 do return Shader_Failed
	renderer.program = gl_link_program(vertex_shader, fragment_shader)
	if renderer.program == 0 do return Shader_Failed
	program := renderer.program
	renderer.world_view_projection_at = GetUniformLocation(program, "world_view_projection")
	renderer.world_at = GetUniformLocation(program, "world")
	renderer.alpha_threshold_at = GetUniformLocation(program, "alpha_threshold")
	renderer.sun_direction_at = GetUniformLocation(program, "sun_direction")
	renderer.sun_color_at = GetUniformLocation(program, "sun_color")
	renderer.ambient_color_at = GetUniformLocation(program, "ambient_color")
	renderer.emissive_color_at = GetUniformLocation(program, "emissive_color")
	renderer.light_count_at = GetUniformLocation(program, "light_count")
	renderer.camera_position_at = GetUniformLocation(program, "camera_position")
	renderer.fog_color_at = GetUniformLocation(program, "fog_color")
	renderer.fog_near_at = GetUniformLocation(program, "fog_near")
	renderer.fog_far_at = GetUniformLocation(program, "fog_far")
	for i in 0:MAX_LIGHTS {
		renderer.light_position_at[i] = array_uniform(program, "light_position[", i)
		renderer.light_color_at[i] = array_uniform(program, "light_color[", i)
		renderer.light_radius_at[i] = array_uniform(program, "light_radius[", i)
	}
	renderer.textures.len = 0

	white : [4!]u8 = [255, 255, 255, 255]
	GenTextures(1, &renderer.white_texture)
	BindTexture(TEXTURE_2D, renderer.white_texture)
	TexImage2D(TEXTURE_2D, 0, i32(RGBA8), 1, 1, 0, RGBA, UNSIGNED_BYTE, &white[0])
	TexParameteri(TEXTURE_2D, TEXTURE_MIN_FILTER, i32(LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_MAG_FILTER, i32(LINEAR))
}

// Where an item of a uniform array is in the shader: name[index].
array_uniform :: fun(program: u32, name_start: []utf8, index: i64) -> i32 {
	name : str64
	&name + name_start
	&name + int_text(index)[:]
	&name + "]"
	return GetUniformLocation(program, cstring(name))
}

// The texture at path in the archive, loaded onto the card the first time
// it's asked for; the white texture when it can't be read. scratch is room
// for reading and decoding it.
texture_for :: fun(renderer: ^Renderer, archive: ^Archive, path: []utf8, scratch: ^[]byte) -> u32 {
	if path.len == 0 do return renderer.white_texture
	for cached in renderer.textures {
		if cached.path[:] == path do return cached.id
	}
	id := load_texture(archive, path, scratch)
	if id == 0 do id = renderer.white_texture
	if renderer.textures.len < renderer.textures.cap {
		entry := next(&renderer.textures)
		entry.path.len = 0
		&entry.path + path
		entry.id = id
	}
	return id
}

// Reads a texture from the archive onto the card: block compressed ones as
// they are, the rest decoded to plain pixels. 0 when it can't be read.
load_texture :: fun(archive: ^Archive, path: []utf8, scratch: ^[]byte) -> u32 {
	index, found := find_file(archive, path)
	if not found do return 0
	scratch.len = 0
	data, read_error := read_file(archive, index, scratch)
	if read_error do return 0
	texture, texture_error := read_texture(data)
	if texture_error do return 0

	id : u32 = 0
	GenTextures(1, &id)
	BindTexture(TEXTURE_2D, id)
	for mip, level in texture.mips {
		width := i32(mip.width)
		height := i32(mip.height)
		pixels := texture.pixels[mip.at : mip.at + mip.size]
		match texture.format {
		dxt1
			CompressedTexImage2D(TEXTURE_2D, i32(level), RGBA_S3TC_DXT1, width, height, 0, i32(mip.size), &pixels[0])
		dxt3
			CompressedTexImage2D(TEXTURE_2D, i32(level), RGBA_S3TC_DXT3, width, height, 0, i32(mip.size), &pixels[0])
		dxt5
			CompressedTexImage2D(TEXTURE_2D, i32(level), RGBA_S3TC_DXT5, width, height, 0, i32(mip.size), &pixels[0])
		else
			decoded, decode_error := decode_rgba(texture, level, scratch)
			if decode_error do break
			TexImage2D(TEXTURE_2D, i32(level), i32(RGBA8), width, height, 0, RGBA, UNSIGNED_BYTE, &decoded[0])
		}
	}
	// A texture without all its mipmaps can't use them (it would draw black).
	last := texture.mips[texture.mips.len - 1]
	full_chain := last.width == 1 and last.height == 1
	if full_chain do TexParameteri(TEXTURE_2D, TEXTURE_MIN_FILTER, i32(LINEAR_MIPMAP_LINEAR))
	else do TexParameteri(TEXTURE_2D, TEXTURE_MIN_FILTER, i32(LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_MAG_FILTER, i32(LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_S, i32(REPEAT))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_T, i32(REPEAT))
	return id
}

// Puts a model's parts on the card, their textures read from the archive.
upload_model :: fun(renderer: ^Renderer, built: Model, archive: ^Archive, scratch: ^[]byte, gpu: ^Gpu_Model) {
	gpu.parts.len = 0
	gpu.center = (built.bounds_min + built.bounds_max) * 0.5
	gpu.radius = vec3_length(built.bounds_max - built.bounds_min) * 0.5
	for part in built.parts {
		if gpu.parts.len == gpu.parts.cap do break
		if part.indices.len == 0 do continue
		gpu_part := next(&gpu.parts)
		GenVertexArrays(1, &gpu_part.vertex_array)
		BindVertexArray(gpu_part.vertex_array)

		GenBuffers(1, &gpu_part.vertex_buffer)
		BindBuffer(ARRAY_BUFFER, gpu_part.vertex_buffer)
		BufferData(ARRAY_BUFFER, isize(part.vertices.len * size_of(Vertex)), &part.vertices[0], STATIC_DRAW)
		GenBuffers(1, &gpu_part.index_buffer)
		BindBuffer(ELEMENT_ARRAY_BUFFER, gpu_part.index_buffer)
		BufferData(ELEMENT_ARRAY_BUFFER, isize(part.indices.len * 2), &part.indices[0], STATIC_DRAW)

		// position, normal, uv, color: as Vertex lays them out.
		stride := i32(size_of(Vertex))
		EnableVertexAttribArray(0)
		VertexAttribPointer(0, 3, FLOAT, 0, stride, 0)
		EnableVertexAttribArray(1)
		VertexAttribPointer(1, 3, FLOAT, 0, stride, 12)
		EnableVertexAttribArray(2)
		VertexAttribPointer(2, 2, FLOAT, 0, stride, 24)
		EnableVertexAttribArray(3)
		VertexAttribPointer(3, 4, FLOAT, 0, stride, 32)

		gpu_part.index_count = i32(part.indices.len)
		gpu_part.texture = texture_for(renderer, archive, part.texture[:], scratch)
		gpu_part.alpha_blend = part.alpha_blend
		gpu_part.alpha_test = part.alpha_test
		gpu_part.alpha_threshold = part.alpha_threshold
		gpu_part.two_sided = part.two_sided
		gpu_part.emissive = part.emissive
	}
	BindVertexArray(0)
}

// Where the camera is and which way it looks.
Camera :: struct {
	position: Vec3
	yaw: f32      // turned from looking north (+y), clockwise seen from above
	pitch: f32    // up from level
	field_of_view: f32 = 1.2   // vertical, in radians
	near: f32 = 5
	far: f32 = 60000
}

// The way the camera looks, and its right and up.
camera_axes :: fun(camera: Camera) -> Vec3, Vec3, Vec3 {
	forward := Vec3{sin_f32(camera.yaw) * cos_f32(camera.pitch), cos_f32(camera.yaw) * cos_f32(camera.pitch), sin_f32(camera.pitch)}
	right := Vec3{cos_f32(camera.yaw), -sin_f32(camera.yaw), 0}
	up := cross(right, forward)
	return forward, right, up
}

// The matrix taking the world to the camera's view: the camera looking
// down its -z, as OpenGL has it.
view_matrix :: fun(camera: Camera) -> Mat4 {
	forward, right, up := camera_axes(camera)
	view := mat4_identity()
	view[0][0] = right.x
	view[1][0] = right.y
	view[2][0] = right.z
	view[0][1] = up.x
	view[1][1] = up.y
	view[2][1] = up.z
	view[0][2] = -forward.x
	view[1][2] = -forward.y
	view[2][2] = -forward.z
	view[3][0] = -dot(right, camera.position)
	view[3][1] = -dot(up, camera.position)
	view[3][2] = dot(forward, camera.position)
	return view
}

// Draws the instances of models from the camera, into a frame width by
// height pixels, lit by the cell's lighting and its lights: opaque parts
// first, then the blended ones over them.
draw_instances :: fun(renderer: ^Renderer, models: ^[]Gpu_Model, instances: ^[]Instance, lights: ^[]Point_Light,
	lighting: Cell_Lighting, camera: Camera, width: i64, height: i64)
{
	Viewport(0, 0, i32(width), i32(height))
	fog := lighting.fog_color
	ClearColor(fog.x, fog.y, fog.z, 1.0)
	Clear(COLOR_BUFFER_BIT | DEPTH_BUFFER_BIT)
	Enable(DEPTH_TEST)
	DepthFunc(LEQUAL)
	UseProgram(renderer.program)
	ActiveTexture(TEXTURE0)

	projection := mat4_perspective(camera.field_of_view, f32(width) / f32(height), camera.near, camera.far)
	view_projection := mat4_mul(projection, view_matrix(camera))
	sun := vec3_normalize(lighting.direction)
	Uniform3f(renderer.sun_direction_at, sun.x, sun.y, sun.z)
	Uniform3f(renderer.sun_color_at, lighting.directional.x, lighting.directional.y, lighting.directional.z)
	Uniform3f(renderer.ambient_color_at, lighting.ambient.x, lighting.ambient.y, lighting.ambient.z)
	Uniform3f(renderer.camera_position_at, camera.position.x, camera.position.y, camera.position.z)
	Uniform3f(renderer.fog_color_at, fog.x, fog.y, fog.z)
	Uniform1f(renderer.fog_near_at, lighting.fog_near)
	Uniform1f(renderer.fog_far_at, lighting.fog_far)

	for pass in 0:2 {
		blended_pass := pass == 1
		if blended_pass {
			Enable(BLEND)
			BlendFunc(SRC_ALPHA, ONE_MINUS_SRC_ALPHA)
			DepthMask(0)
		else
			Disable(BLEND)
			DepthMask(1)
		}
		for &instance in instances {
			gpu_model := &models[instance.model]
			world_view_projection := mat4_mul(view_projection, instance.world)
			UniformMatrix4fv(renderer.world_view_projection_at, 1, 0, &world_view_projection[0][0])
			UniformMatrix4fv(renderer.world_at, 1, 0, &instance.world[0][0])
			set_lights(renderer, gpu_model, instance, lights)
			for part in gpu_model.parts {
				if part.alpha_blend != blended_pass do continue
				if part.two_sided do Disable(CULL_FACE)
				else do Enable(CULL_FACE)
				threshold : f32 = 0
				if part.alpha_test do threshold = part.alpha_threshold
				Uniform1f(renderer.alpha_threshold_at, threshold)
				Uniform3f(renderer.emissive_color_at, part.emissive.x, part.emissive.y, part.emissive.z)
				BindTexture(TEXTURE_2D, part.texture)
				BindVertexArray(part.vertex_array)
				DrawElements(TRIANGLES, part.index_count, UNSIGNED_SHORT, void)
			}
		}
	}
	DepthMask(1)
	Disable(BLEND)
	BindVertexArray(0)
}

// Gives the shader the lights that reach an instance: those whose reach
// meets the sphere around it, the nearest MAX_LIGHTS of them.
set_lights :: fun(renderer: ^Renderer, gpu_model: ^Gpu_Model, instance: ^Instance, lights: ^[]Point_Light) {
	placed := mat4_mul_vec4(instance.world, Vec4{gpu_model.center.x, gpu_model.center.y, gpu_model.center.z, 1})
	center := Vec3{placed.x, placed.y, placed.z}
	// The instance's scale: how long its x axis is in the world.
	scale := vec3_length(Vec3{instance.world[0][0], instance.world[0][1], instance.world[0][2]})
	radius := gpu_model.radius * scale

	// The nearest, kept sorted by distance.
	chosen : [MAX_LIGHTS!]i64
	distances : [MAX_LIGHTS!]f32
	count : i64 = 0
	for light, index in lights {
		distance := vec3_length(light.position - center)
		if distance > light.radius + radius do continue
		if count == MAX_LIGHTS and distance >= distances[MAX_LIGHTS - 1] do continue
		at := count
		if count < MAX_LIGHTS do count += 1
		else do at = MAX_LIGHTS - 1
		for at > 0 and distances[at - 1] > distance {
			chosen[at] = chosen[at - 1]
			distances[at] = distances[at - 1]
			at -= 1
		}
		chosen[at] = index
		distances[at] = distance
	}
	Uniform1i(renderer.light_count_at, i32(count))
	for i in 0:count {
		light := lights[chosen[i]]
		Uniform3f(renderer.light_position_at[i], light.position.x, light.position.y, light.position.z)
		Uniform3f(renderer.light_color_at[i], light.color.x, light.color.y, light.color.z)
		Uniform1f(renderer.light_radius_at[i], light.radius)
	}
}
