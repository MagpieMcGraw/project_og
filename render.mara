// Drawing the world with OpenGL, in few calls.
//
// Meshes: every model's vertices and indexes go into one shared pair of
// buffers on the card, each part a range of them. A model placed in the
// world (an Instance) has what drawing it needs worked out once: its
// matrix, a sphere around it, the lights that reach it. Each frame, the
// instances outside the camera's view are left out, the rest gathered by
// mesh part, and each part drawn once for all its instances (instancing),
// many parts in each call (MultiDrawElementsIndirect).
//
// Textures stay as the game has them — their own format, size and
// mipmaps — and are drawn bindless where the card can (ARB_bindless_texture):
// each instance carries its texture's handle, so parts of any textures go
// in one call, and the meshes take about three calls a frame. Where it
// can't, parts are drawn in a call for each texture, bound to a unit.
//
// Land: every cell's land is laid out alike, so all of it shares one list
// of indexes, and each pixel blends its quadrant's textures: their handles
// in a storage buffer (bindless), or bound to units a quadrant at a time.
//
// Oblivion's world has z up, x east and y north; a unit is about 1.4 cm, a
// cell 4096 units across.
module render

use mara.core
use mara.math
use mara.string
use mara.memory
use mara.open_gl
use model
use dds
use bsa
use world
use land
use sky

// ---- sizes ---------------------------------------------------------------------

// The lights the shader knows at once (a scene's first ones), and how many
// light one object.
SCENE_LIGHTS :: 256
LIGHTS_PER_OBJECT :: 8
NO_LIGHT :: 0xFFFF

// Room in the shared mesh buffers: vertices (48 bytes each) and indexes.
MESH_VERTEX_ROOM :: 4194304
MESH_INDEX_ROOM :: 33554432
// Mesh parts on the card, textures loaded, instances drawn in a frame.
MAX_PARTS :: 65536
MAX_TEXTURES :: 8192
MAX_DRAWN :: 65536

// Cells of land on the card at once, and their quadrants.
LAND_SLOTS :: 64
LAND_QUADRANTS :: 256   // LAND_SLOTS x 4

// How sharp textures stay seen at a slant: anisotropic filtering, at most.
MOST_ANISOTROPY :: 16

// The texture units a land quadrant's textures are bound to, without bindless.
LAYER_UNITS :: [QUADRANT_TEXTURES!]GL_Texture_Unit{
	TEXTURE0, TEXTURE1, TEXTURE2, TEXTURE3, TEXTURE4, TEXTURE5, TEXTURE6, TEXTURE7, TEXTURE8}

// ---- shaders ---------------------------------------------------------------------
// Each is written once and compiled two ways: with `#define BINDLESS` (and
// the extension) at its top, or without.

MESH_VERTEX_SHADER :: "
layout(location = 0) in vec3 position;
layout(location = 1) in vec3 normal;
layout(location = 2) in vec2 uv;
layout(location = 3) in vec4 color;
// Each instance's: its matrix's columns, its lights, its part's material,
// its part's texture's handle.
layout(location = 4) in vec4 world_x;
layout(location = 5) in vec4 world_y;
layout(location = 6) in vec4 world_z;
layout(location = 7) in vec4 world_w;
layout(location = 8) in uvec4 lights_first;
layout(location = 9) in uvec4 lights_second;
layout(location = 10) in vec4 material;    // alpha threshold, emissive color
layout(location = 11) in uvec2 texture_handle;

uniform mat4 view_projection;

out vec3 world_position;
out vec3 world_normal;
out vec2 texture_uv;
out vec4 vertex_color;
flat out uvec4 light_set_first;
flat out uvec4 light_set_second;
flat out vec4 part_material;
flat out uvec2 part_texture;

void main() {
	mat4 world = mat4(world_x, world_y, world_z, world_w);
	vec4 placed = world * vec4(position, 1.0);
	gl_Position = view_projection * placed;
	world_position = placed.xyz;
	world_normal = mat3(world) * normal;
	texture_uv = uv;
	vertex_color = color;
	light_set_first = lights_first;
	light_set_second = lights_second;
	part_material = material;
	part_texture = texture_handle;
}
"

MESH_FRAGMENT_SHADER :: "
#define SCENE_LIGHTS 256
in vec3 world_position;
in vec3 world_normal;
in vec2 texture_uv;
in vec4 vertex_color;
flat in uvec4 light_set_first;
flat in uvec4 light_set_second;
flat in vec4 part_material;
flat in uvec2 part_texture;

#ifdef BINDLESS
#define BASE_TEXTURE sampler2D(part_texture)
#else
uniform sampler2D base_texture;
#define BASE_TEXTURE base_texture
#endif

uniform vec3 sun_direction;       // where the light comes from
uniform vec3 sun_color;
uniform vec3 ambient_color;
uniform vec3 light_positions[SCENE_LIGHTS];
uniform vec3 light_colors[SCENE_LIGHTS];
uniform float light_reaches[SCENE_LIGHTS];
uniform vec3 camera_position;
uniform vec3 fog_color;
uniform float fog_near;
uniform float fog_far;            // no fog when it isn't past fog_near

out vec4 fragment_color;

vec3 point_light(uint index, vec3 normal) {
	vec3 to_light = light_positions[index] - world_position;
	float distance = length(to_light);
	float reach = clamp(1.0 - distance / light_reaches[index], 0.0, 1.0);
	float facing = max(dot(normal, to_light / max(distance, 0.001)), 0.0);
	return light_colors[index] * facing * reach * reach;
}

void main() {
	vec4 base = texture(BASE_TEXTURE, texture_uv) * vertex_color;
	if (base.a < part_material.x) discard;
	vec3 normal = normalize(world_normal);
	if (!gl_FrontFacing) normal = -normal;   // a two-sided part's back
	vec3 light = ambient_color + part_material.yzw + sun_color * max(dot(normal, sun_direction), 0.0);
	for (int i = 0; i < 4; i++) {
		if (light_set_first[i] == 65535u) break;
		light += point_light(light_set_first[i], normal);
	}
	for (int i = 0; i < 4; i++) {
		if (light_set_second[i] == 65535u) break;
		light += point_light(light_set_second[i], normal);
	}
	vec3 color = base.rgb * light;
	if (fog_far > fog_near) {
		float fog = clamp((length(world_position - camera_position) - fog_near) / (fog_far - fog_near), 0.0, 1.0);
		color = mix(color, fog_color, fog);
	}
	fragment_color = vec4(color, base.a);
}
"

LAND_VERTEX_SHADER :: "
layout(location = 0) in vec3 position;
layout(location = 1) in vec3 normal;
layout(location = 2) in vec2 uv;
layout(location = 3) in vec3 color;
layout(location = 4) in vec4 weights_first;    // layers 1 to 4, over the base
layout(location = 5) in vec4 weights_second;   // layers 5 to 8

uniform mat4 view_projection;

out vec3 world_position;
out vec3 world_normal;
out vec2 texture_uv;
out vec3 vertex_color;
out vec4 layer_weights_first;
out vec4 layer_weights_second;
flat out uint quadrant;   // which of the land buffer's quadrants: 289 vertices each, in a row

void main() {
	gl_Position = view_projection * vec4(position, 1.0);
	world_position = position;
	world_normal = normal;
	texture_uv = uv;
	vertex_color = color;
	layer_weights_first = weights_first;
	layer_weights_second = weights_second;
	quadrant = uint(gl_VertexID) / 289u;
}
"

LAND_FRAGMENT_SHADER :: "
in vec3 world_position;
in vec3 world_normal;
in vec2 texture_uv;
in vec3 vertex_color;
in vec4 layer_weights_first;
in vec4 layer_weights_second;
flat in uint quadrant;

#ifdef BINDLESS
// Each quadrant's 9 textures' handles: its base, then its layers.
layout(std430, binding = 1) readonly buffer Land_Textures {
	uvec2 land_textures[];
};
vec3 layer_color(int layer) {
	return texture(sampler2D(land_textures[quadrant * 9u + uint(layer)]), texture_uv).rgb;
}
#else
uniform sampler2D layer_textures[9];
vec3 layer_color(int layer) {
	return texture(layer_textures[layer], texture_uv).rgb;
}
#endif

uniform vec3 sun_direction;
uniform vec3 sun_color;
uniform vec3 ambient_color;
uniform vec3 camera_position;
uniform vec3 fog_color;
uniform float fog_near;
uniform float fog_far;

out vec4 fragment_color;

void main() {
	float weights[8] = float[8](layer_weights_first.x, layer_weights_first.y, layer_weights_first.z, layer_weights_first.w,
		layer_weights_second.x, layer_weights_second.y, layer_weights_second.z, layer_weights_second.w);
	vec3 color = layer_color(0);
	for (int i = 0; i < 8; i++) {
		if (weights[i] > 0.0) color = mix(color, layer_color(i + 1), weights[i]);
	}
	color *= vertex_color;
	vec3 normal = normalize(world_normal);
	color *= ambient_color + sun_color * max(dot(normal, sun_direction), 0.0);
	if (fog_far > fog_near) {
		float fog = clamp((length(world_position - camera_position) - fog_near) / (fog_far - fog_near), 0.0, 1.0);
		color = mix(color, fog_color, fog);
	}
	fragment_color = vec4(color, 1.0);
}
"

// The sky's color seen looking a way: up from the horizon to the top of
// the sky, down from it to the sky's lower color. Shared by the sky and
// the water (which shows it reflected).
SKY_COLOR_FUNCTION :: "
uniform vec3 sky_upper;
uniform vec3 sky_lower;
uniform vec3 sky_horizon;
vec3 sky_color(vec3 direction) {
	if (direction.z >= 0.0) return mix(sky_horizon, sky_upper, pow(min(direction.z * 1.5, 1.0), 0.6));
	return mix(sky_horizon, sky_lower, min(-direction.z * 4.0, 1.0));
}
"

// The sky: one triangle over the whole screen, each pixel the sky the way
// it looks — its colors, two layers of clouds on a plane far above, the sun.
SKY_VERTEX_SHADER :: "
out vec2 screen;
void main() {
	screen = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2) * 2.0 - 1.0;
	gl_Position = vec4(screen, 1.0, 1.0);
}
"

SKY_FRAGMENT_SHADER :: "
in vec2 screen;
uniform mat4 inverse_view_projection;
uniform vec3 camera_position;
uniform vec3 fog_color;
uniform vec3 sun_direction;
uniform vec3 sun_color;
uniform vec3 cloud_lower_color;
uniform vec3 cloud_upper_color;
uniform vec2 cloud_lower_offset;
uniform vec2 cloud_upper_offset;
uniform sampler2D cloud_lower_texture;
uniform sampler2D cloud_upper_texture;
uniform sampler2D sun_texture;
out vec4 fragment_color;

void main() {
	vec4 far = inverse_view_projection * vec4(screen, 1.0, 1.0);
	vec3 direction = normalize(far.xyz / far.w - camera_position);
	vec3 color = sky_color(direction);

	// The sun: its texture on a patch of sky around its direction.
	vec3 side = normalize(cross(sun_direction, vec3(0.0, 0.0, 1.0)));
	vec3 up = cross(side, sun_direction);
	if (dot(direction, sun_direction) > 0.0) {
		vec2 at = vec2(dot(direction, side), dot(direction, up)) / 0.12 + 0.5;
		if (all(greaterThan(at, vec2(0.0))) && all(lessThan(at, vec2(1.0)))) {
			vec4 sun = texture(sun_texture, at);
			color += sun_color * sun.rgb * sun.a;
		}
	}

	// The clouds: two layers on a plane above, faded toward the horizon.
	if (direction.z > 0.0) {
		vec2 on_plane = direction.xy / direction.z;
		float fade = smoothstep(0.03, 0.3, direction.z);
		vec4 upper = texture(cloud_upper_texture, on_plane * 0.3 + cloud_upper_offset);
		color = mix(color, cloud_upper_color * upper.rgb, upper.a * fade);
		vec4 lower = texture(cloud_lower_texture, on_plane * 0.45 + cloud_lower_offset);
		color = mix(color, cloud_lower_color * lower.rgb, lower.a * fade);
	}

	// Low in the sky, it fades into the fog, as the land at its edge does.
	color = mix(color, fog_color, 1.0 - smoothstep(-0.02, 0.12, direction.z));
	fragment_color = vec4(color, 1.0);
}
"

// Water, after Oblivion's own (its WATER000 pixel shader, ported): a
// normal from a scrolling ripple texture, flattened with distance; the
// water's color, deep to shallow by how straight down it's seen; the sky
// reflected (the game's reflection render, here the sky's color the
// reflected way), blended toward its reflection color; Fresnel between
// them; the sun's glint; and its opacity from Fresnel and its depth, so
// shallow water fades out at the shore.
WATER_VERTEX_SHADER :: "
layout(location = 0) in vec3 position;
layout(location = 1) in float depth;
uniform mat4 view_projection;
out vec3 world_position;
out float water_depth;
void main() {
	world_position = position;
	water_depth = depth;
	gl_Position = view_projection * vec4(position, 1.0);
}
"

WATER_FRAGMENT_SHADER :: "
in vec3 world_position;
in float water_depth;
uniform sampler2D normal_map;
uniform vec3 camera_position;
uniform float time;
uniform vec2 scroll;
uniform vec3 shallow_color;
uniform vec3 deep_color;
uniform vec3 reflection_color;
uniform float reflectivity;
uniform float fresnel_base;
uniform float sun_power;
uniform vec3 sun_direction;
uniform vec3 sun_color;
uniform float daylight;
uniform vec3 fog_color;
uniform float fog_near;
uniform float fog_far;
out vec4 fragment_color;

// The game's settings (Oblivion.ini's [Water]): the least opacity
// (fAlpha, what the shader's VarAmounts.z holds), the units of depth to
// the depth map's 1 (uDepthRange), and the ripples' repeats across a cell
// (fTileTextureDivisor: 4096 / 4.75 units a repeat).
const float least_opacity = 0.5;
const float depth_scale = 125.0;
const float ripple_size = 862.3;

void main() {
	// The ripples, as strong as the original's near the eye, gone flat by
	// 10000 units away; two layers of the texture, against its repeating.
	float flat_distance = length(camera_position.xy - world_position.xy);
	float near = clamp(1.0 - flat_distance * 0.0001, 0.0, 1.0);
	vec2 at = world_position.xy / ripple_size;
	vec3 first = texture(normal_map, at + scroll * time).xyz * 2.0 - 1.0;
	vec3 second = texture(normal_map, at * 2.37 - scroll.yx * time * 1.4 + 0.5).xyz * 2.0 - 1.0;
	vec3 normal = first + second;
	normal.xy *= near * near;
	normal = normalize(normal);

	vec3 to_eye = camera_position - world_position;
	float distance = length(to_eye);
	vec3 eye = to_eye / distance;
	float facing = clamp(dot(eye, normal), 0.0, 1.0);
	float fresnel = fresnel_base + (1.0 - fresnel_base) * pow(1.0 - facing, 5.0);
	vec3 reflected = reflect(-eye, normal);

	vec3 body = mix(deep_color, shallow_color, facing);
	vec3 reflection = mix(reflection_color, sky_color(reflected), reflectivity);
	vec3 color = mix(body, reflection, fresnel);
	color += sun_color * pow(clamp(dot(reflected, sun_direction), 0.0, 1.0), sun_power * 8.0) * daylight;

	// Opacity, as the original: Fresnel's (at least the least), toward a
	// quarter where it's shallow; faded out from depth 0.55 to 0.2.
	float depth = clamp(water_depth / depth_scale, 0.0, 1.0);
	float opaque = max(least_opacity, fresnel);
	float opacity = mix(0.25, opaque, depth);
	if (depth < 0.55) {
		float shore = 1.0 - (depth - 0.2) / 0.35;
		opacity *= 1.0 - shore * shore * shore;
	}
	if (depth < 0.2) opacity = 0.0;

	if (fog_far > fog_near) {
		float fog = clamp((distance - fog_near) / (fog_far - fog_near), 0.0, 1.0);
		color = mix(color, fog_color, fog);
		opacity = mix(opacity, 1.0, fog);
	}
	fragment_color = vec4(color, opacity);
}
"

// The points of a stretch of water along each side: as many as a cell's land.
WATER_SIDE :: 33
WATER_VERTICES :: 1089    // 33 x 33
WATER_INDICES :: 6144     // 32 x 32 x 6
// Stretches of water on the card at once.
WATER_SLOTS :: 64
// The ripple texture's size.
RIPPLE_SIZE :: 256

// ---- what's on the card -------------------------------------------------------------

// A mesh part on the card: its range of the shared buffers, and how it's drawn.
Mesh_Part :: struct {
	first_index: u32
	index_count: u32
	base_vertex: i32
	texture_slot: i64      // its texture: its place in the renderer's textures
	alpha_blend: bool
	two_sided: bool
	alpha_threshold: f32   // pixels less opaque are left out; 0 for none
	emissive: Vec3
}

// A model on the card: its parts (in the renderer's), and a sphere around
// them in the model's space.
Gpu_Model :: struct {
	first_part: i64
	part_count: i64
	center: Vec3
	radius: f32
}

// A model placed in the world, with what drawing it needs worked out once.
Instance :: struct {
	model: i64             // in the models drawn
	world: Mat4
	center: Vec3           // a sphere around it, in the world
	radius: f32
	lights: [LIGHTS_PER_OBJECT!]u16   // the scene's lights that reach it, nearest first; NO_LIGHT after
}

// A cell's land on the card: where on the grid, its slot in the land
// buffer, and a sphere around it.
Gpu_Land :: struct {
	x: i64
	y: i64
	slot: i64
	center: Vec3
	radius: f32
}

// A land quadrant's textures: its base's and its layers' places in the
// renderer's textures (the base's again where it has fewer layers).
Quadrant_Slots :: struct {
	textures: [QUADRANT_TEXTURES!]i64
}

// A stretch of water: a rectangle at a height, and the water's depth at
// each of WATER_SIDE x WATER_SIDE points over it, row by row from the south.
Water_Cell :: struct {
	low_x: f32
	low_y: f32
	high_x: f32
	high_y: f32
	height: f32
	depths: [WATER_VERTICES!]f32
}

// A point of water as the water program reads it.
Water_Vertex :: struct {
	position: Vec3
	depth: f32
}

// What the sky and the water look like: the sky's state at the hour, the
// textures of its clouds and sun (slots in the renderer's textures), how
// far the clouds have drifted, and the water's color.
Sky_Look :: struct {
	state: Sky_State
	cloud_lower: i64
	cloud_upper: i64
	sun: i64
	cloud_lower_offset: f32
	cloud_upper_offset: f32
	outside: bool        // the sky is drawn only outside
	time: f32            // seconds, for the water's ripples
	water: Water_Type    // its colors lit by the hour's light
}

// The sky program and where its uniforms are.
Sky_Program :: struct {
	program: u32
	inverse_view_projection_at: i32
	camera_position_at: i32
	fog_color_at: i32
	sky_upper_at: i32
	sky_lower_at: i32
	sky_horizon_at: i32
	sun_direction_at: i32
	sun_color_at: i32
	cloud_lower_color_at: i32
	cloud_upper_color_at: i32
	cloud_lower_offset_at: i32
	cloud_upper_offset_at: i32
}

// The water program and where its uniforms are.
Water_Program :: struct {
	program: u32
	view_projection_at: i32
	camera_position_at: i32
	time_at: i32
	scroll_at: i32
	shallow_color_at: i32
	deep_color_at: i32
	reflection_color_at: i32
	reflectivity_at: i32
	fresnel_base_at: i32
	sun_power_at: i32
	sky_upper_at: i32
	sky_lower_at: i32
	sky_horizon_at: i32
	sun_direction_at: i32
	sun_color_at: i32
	daylight_at: i32
	fog_color_at: i32
	fog_near_at: i32
	fog_far_at: i32
}

// A texture on the card, loaded once, by its path.
Cached_Texture :: struct {
	path: [160]utf8
	id: u32
	handle: u64            // its bindless handle, resident; 0 without bindless
}

// What an instance of a mesh part is drawn with, as the mesh shader reads
// it: its matrix, its lights, the part's material and texture — 104 bytes.
Drawn_Instance :: struct {
	world: Mat4
	lights: [LIGHTS_PER_OBJECT!]u16
	material: [4!]f32      // alpha threshold, emissive red, green, blue
	texture: u64           // the bindless handle
}

// One draw of MultiDrawElementsIndirect, as OpenGL reads it: 20 bytes.
Draw_Command :: struct {
	count: u32             // indexes
	instance_count: u32
	first_index: u32
	base_vertex: i32
	base_instance: u32     // the first of its instances in the instance buffer
}

// What a frame drew.
Frame_Stats :: struct {
	instances: i64         // placed
	visible: i64           // in view, drawn
	drawn_parts: i64       // part instances
	draw_calls: i64
	land_cells: i64        // in view, drawn
}

// Where the uniforms both kinds of program have are, in one program.
Shared_Uniforms :: struct {
	view_projection_at: i32
	sun_direction_at: i32
	sun_color_at: i32
	ambient_color_at: i32
	camera_position_at: i32
	fog_color_at: i32
	fog_near_at: i32
	fog_far_at: i32
}

// A mesh program, and where its uniforms are.
Mesh_Program :: struct {
	program: u32
	shared: Shared_Uniforms
	light_position_at: [SCENE_LIGHTS!]i32
	light_color_at: [SCENE_LIGHTS!]i32
	light_reach_at: [SCENE_LIGHTS!]i32
}

// A land program, and where its uniforms are.
Land_Program :: struct {
	program: u32
	shared: Shared_Uniforms
	layer_texture_at: [QUADRANT_TEXTURES!]i32   // without bindless: the samplers, units 0 to 8
}

// The renderer: its programs, its buffers, its textures, and room for a
// frame's work.
Renderer :: struct {
	// Whether the card draws bindless, and whether it's used now (B in the
	// viewer turns it off, to see the other way). Each program is compiled
	// both ways when it can: [0] binds textures, [1] is bindless.
	bindless_available: bool
	use_bindless: bool
	mesh_programs: [2!]Mesh_Program
	land_programs: [2!]Land_Program
	sky_program: Sky_Program
	water_program: Water_Program
	anisotropy: f32

	// The sky's triangle reads nothing but needs a vertex array; the water's
	// rectangles are made again each frame.
	empty_vertex_array: u32
	water_vertex_array: u32
	water_vertex_buffer: u32
	water_index_buffer: u32
	water_indirect_buffer: u32
	water_commands: [WATER_SLOTS]Draw_Command
	ripple_texture: u32

	// The shared mesh buffers, and how much of them is used.
	mesh_vertex_array: u32
	mesh_vertex_buffer: u32
	mesh_index_buffer: u32
	instance_buffer: u32
	indirect_buffer: u32
	vertices_used: i64
	indices_used: i64
	parts: [MAX_PARTS]Mesh_Part

	// The land's buffers, its quadrants' textures, and their handles' buffer.
	land_vertex_array: u32
	land_vertex_buffer: u32
	land_index_buffer: u32
	land_indirect_buffer: u32
	land_texture_buffer: u32                   // each quadrant's 9 handles (bindless)
	land_quadrants: [LAND_QUADRANTS!]Quadrant_Slots

	// Textures, found by their paths' hashes.
	textures: [MAX_TEXTURES]Cached_Texture
	texture_index: Key_Index

	// A frame's work.
	visible: [MAX_DRAWN]i64        // instances in view
	part_counts: [MAX_PARTS]i64    // instances of each part this frame
	part_starts: [MAX_PARTS]i64    // where each part's instances start in records
	touched: [MAX_PARTS]i64        // the parts drawn, each as its sort key
	records: [MAX_DRAWN]Drawn_Instance
	commands: [MAX_DRAWN]Draw_Command
	land_commands: [LAND_QUADRANTS]Draw_Command
}

// What setting up the renderer can fail with.
Render_Error :: error {
	Shader_Failed
}

// ---- setting up ------------------------------------------------------------------

// Compiles the programs (both ways where the card draws bindless), makes
// the buffers and the white texture. The texture index is carved from
// storage.
renderer_init :: fun(renderer: ^Renderer, storage: ^[]byte) -> err {
	renderer.bindless_available = gl_has_extension("GL_ARB_bindless_texture") != 0
	renderer.use_bindless = renderer.bindless_available
	most : f32 = 0
	GetFloatv(MAX_TEXTURE_MAX_ANISOTROPY, &most)
	renderer.anisotropy = if most < MOST_ANISOTROPY do most else MOST_ANISOTROPY

	make_mesh_program(&renderer.mesh_programs[0], false)?
	make_land_program(&renderer.land_programs[0], false)?
	make_sky_program(&renderer.sky_program)?
	make_water_program(&renderer.water_program)?
	if renderer.bindless_available {
		make_mesh_program(&renderer.mesh_programs[1], true)?
		make_land_program(&renderer.land_programs[1], true)?
	}

	setup_mesh_buffers(renderer)
	setup_land_buffers(renderer)
	setup_water_buffers(renderer)

	renderer.parts.len = 0
	// Every part's count and start, by its index: all there, all 0.
	renderer.part_counts.len = MAX_PARTS
	renderer.part_starts.len = MAX_PARTS
	for p in 0:MAX_PARTS {
		renderer.part_counts[p] = 0
		renderer.part_starts[p] = 0
	}
	renderer.textures.len = 0
	renderer.texture_index = key_index(1 << 14, storage)

	// The white texture: slot 0, for parts with none.
	white : [4!]u8 = [255, 255, 255, 255]
	id : u32 = 0
	GenTextures(1, &id)
	BindTexture(TEXTURE_2D, id)
	TexImage2D(TEXTURE_2D, 0, i32(RGBA8), 1, 1, 0, RGBA, UNSIGNED_BYTE, &white[0])
	TexParameteri(TEXTURE_2D, TEXTURE_MAX_LEVEL, 0)
	TexParameteri(TEXTURE_2D, TEXTURE_MIN_FILTER, i32(LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_MAG_FILTER, i32(LINEAR))
	entry := next(&renderer.textures)
	entry.path.len = 0
	entry.id = id
	entry.handle = resident_handle(renderer, id)
	for q in 0:LAND_QUADRANTS {
		for k in 0:QUADRANT_TEXTURES do renderer.land_quadrants[q].textures[k] = 0
	}
}

// A texture's bindless handle, made resident; 0 without bindless. Its
// parameters are set for good after this.
resident_handle :: fun(renderer: ^Renderer, id: u32) -> u64 {
	if not renderer.bindless_available do return 0
	handle := GetTextureHandleARB(id)
	MakeTextureHandleResidentARB(handle)
	return handle
}

// The program a frame's drawing uses: [1], bindless, when it's in use.
which_program :: fun(renderer: ^Renderer) -> i64 {
	return if renderer.use_bindless do 1 else 0
}

// A shader's source: the version, then — bindless — the extension and the
// BINDLESS define, then shared (functions it uses), then its body. Into
// source.
shader_source :: fun(shared: []utf8, body: []utf8, bindless: bool, source: ^[]utf8) {
	source.len = 0
	source + "#version 450 core\n"
	if bindless do source + "#extension GL_ARB_bindless_texture : require\n#define BINDLESS 1\n"
	source + shared
	source + body
}

// A program of a vertex and a fragment shader, compiled one way or the
// other; shared goes before the fragment shader's body.
compile_program :: fun(vertex_body: []utf8, fragment_body: []utf8, bindless: bool, shared: []utf8 = "") -> u32, err {
	source : [16 * KB]utf8
	shader_source("", vertex_body, bindless, &source)
	vertex_shader := gl_compile_shader(VERTEX_SHADER, cstring(source))
	shader_source(shared, fragment_body, bindless, &source)
	fragment_shader := gl_compile_shader(FRAGMENT_SHADER, cstring(source))
	if vertex_shader == 0 or fragment_shader == 0 do return 0, Shader_Failed
	program := gl_link_program(vertex_shader, fragment_shader)
	if program == 0 do return 0, Shader_Failed
	return program
}

// Where a program's shared uniforms are.
find_shared_uniforms :: fun(program: u32) -> Shared_Uniforms {
	return Shared_Uniforms{
		view_projection_at = GetUniformLocation(program, "view_projection"),
		sun_direction_at = GetUniformLocation(program, "sun_direction"),
		sun_color_at = GetUniformLocation(program, "sun_color"),
		ambient_color_at = GetUniformLocation(program, "ambient_color"),
		camera_position_at = GetUniformLocation(program, "camera_position"),
		fog_color_at = GetUniformLocation(program, "fog_color"),
		fog_near_at = GetUniformLocation(program, "fog_near"),
		fog_far_at = GetUniformLocation(program, "fog_far")}
}

make_mesh_program :: fun(made: ^Mesh_Program, bindless: bool) -> err {
	made.program = compile_program(MESH_VERTEX_SHADER, MESH_FRAGMENT_SHADER, bindless)?
	made.shared = find_shared_uniforms(made.program)
	for i in 0:SCENE_LIGHTS {
		made.light_position_at[i] = array_uniform(made.program, "light_positions[", i)
		made.light_color_at[i] = array_uniform(made.program, "light_colors[", i)
		made.light_reach_at[i] = array_uniform(made.program, "light_reaches[", i)
	}
}

make_land_program :: fun(made: ^Land_Program, bindless: bool) -> err {
	made.program = compile_program(LAND_VERTEX_SHADER, LAND_FRAGMENT_SHADER, bindless)?
	made.shared = find_shared_uniforms(made.program)
	UseProgram(made.program)
	for k in 0:QUADRANT_TEXTURES {
		made.layer_texture_at[k] = array_uniform(made.program, "layer_textures[", k)
		if not bindless do Uniform1i(made.layer_texture_at[k], i32(k))
	}
}

make_sky_program :: fun(made: ^Sky_Program) -> err {
	made.program = compile_program(SKY_VERTEX_SHADER, SKY_FRAGMENT_SHADER, false, SKY_COLOR_FUNCTION)?
	program := made.program
	made.inverse_view_projection_at = GetUniformLocation(program, "inverse_view_projection")
	made.camera_position_at = GetUniformLocation(program, "camera_position")
	made.fog_color_at = GetUniformLocation(program, "fog_color")
	made.sky_upper_at = GetUniformLocation(program, "sky_upper")
	made.sky_lower_at = GetUniformLocation(program, "sky_lower")
	made.sky_horizon_at = GetUniformLocation(program, "sky_horizon")
	made.sun_direction_at = GetUniformLocation(program, "sun_direction")
	made.sun_color_at = GetUniformLocation(program, "sun_color")
	made.cloud_lower_color_at = GetUniformLocation(program, "cloud_lower_color")
	made.cloud_upper_color_at = GetUniformLocation(program, "cloud_upper_color")
	made.cloud_lower_offset_at = GetUniformLocation(program, "cloud_lower_offset")
	made.cloud_upper_offset_at = GetUniformLocation(program, "cloud_upper_offset")
	UseProgram(program)
	Uniform1i(GetUniformLocation(program, "cloud_lower_texture"), 0)
	Uniform1i(GetUniformLocation(program, "cloud_upper_texture"), 1)
	Uniform1i(GetUniformLocation(program, "sun_texture"), 2)
}

make_water_program :: fun(made: ^Water_Program) -> err {
	made.program = compile_program(WATER_VERTEX_SHADER, WATER_FRAGMENT_SHADER, false, SKY_COLOR_FUNCTION)?
	program := made.program
	made.view_projection_at = GetUniformLocation(program, "view_projection")
	made.camera_position_at = GetUniformLocation(program, "camera_position")
	made.time_at = GetUniformLocation(program, "time")
	made.scroll_at = GetUniformLocation(program, "scroll")
	made.shallow_color_at = GetUniformLocation(program, "shallow_color")
	made.deep_color_at = GetUniformLocation(program, "deep_color")
	made.reflection_color_at = GetUniformLocation(program, "reflection_color")
	made.reflectivity_at = GetUniformLocation(program, "reflectivity")
	made.fresnel_base_at = GetUniformLocation(program, "fresnel_base")
	made.sun_power_at = GetUniformLocation(program, "sun_power")
	made.sky_upper_at = GetUniformLocation(program, "sky_upper")
	made.sky_lower_at = GetUniformLocation(program, "sky_lower")
	made.sky_horizon_at = GetUniformLocation(program, "sky_horizon")
	made.sun_direction_at = GetUniformLocation(program, "sun_direction")
	made.sun_color_at = GetUniformLocation(program, "sun_color")
	made.daylight_at = GetUniformLocation(program, "daylight")
	made.fog_color_at = GetUniformLocation(program, "fog_color")
	made.fog_near_at = GetUniformLocation(program, "fog_near")
	made.fog_far_at = GetUniformLocation(program, "fog_far")
}

// The sky's empty vertex array; the water's buffers — a slot of points
// for each stretch, the indexes they share — and its ripple texture.
setup_water_buffers :: fun(renderer: ^Renderer) {
	GenVertexArrays(1, &renderer.empty_vertex_array)
	GenVertexArrays(1, &renderer.water_vertex_array)
	BindVertexArray(renderer.water_vertex_array)
	GenBuffers(1, &renderer.water_vertex_buffer)
	BindBuffer(ARRAY_BUFFER, renderer.water_vertex_buffer)
	BufferData(ARRAY_BUFFER, WATER_SLOTS * WATER_VERTICES * size_of(Water_Vertex), void, DYNAMIC_DRAW)
	stride := i32(size_of(Water_Vertex))
	EnableVertexAttribArray(0)
	VertexAttribPointer(0, 3, FLOAT, 0, stride, 0)    // position
	EnableVertexAttribArray(1)
	VertexAttribPointer(1, 1, FLOAT, 0, stride, 12)   // depth

	// Two triangles for each square of the grid, counter-clockwise from above.
	indices : [WATER_INDICES]u16
	for row in 0:WATER_SIDE - 1 {
		for column in 0:WATER_SIDE - 1 {
			south_west := u16(row * WATER_SIDE + column)
			south_east := south_west + 1
			north_west := south_west + u16(WATER_SIDE)
			north_east := north_west + 1
			&indices + south_west
			&indices + south_east
			&indices + north_east
			&indices + south_west
			&indices + north_east
			&indices + north_west
		}
	}
	GenBuffers(1, &renderer.water_index_buffer)
	BindBuffer(ELEMENT_ARRAY_BUFFER, renderer.water_index_buffer)
	BufferData(ELEMENT_ARRAY_BUFFER, isize(indices.len * 2), &indices[0], STATIC_DRAW)
	BindVertexArray(0)
	GenBuffers(1, &renderer.water_indirect_buffer)
	make_ripple_texture(renderer)
}

// The ripples' normals: a texture made of many waves of whole numbers of
// lengths across it (so it repeats without a seam), each a random way and
// phase, the shorter ones lower; mipmapped, so far water averages to flat.
// (The game made its ripples on the card each frame; this stands in.)
make_ripple_texture :: fun(renderer: ^Renderer) {
	WAVES :: 48
	directions_x : [WAVES!]f32
	directions_y : [WAVES!]f32
	phases : [WAVES!]f32
	heights : [WAVES!]f32
	seed : u64 = 0x2545F4914F6CDD1D
	for w in 0:WAVES {
		// A wave of 2 to 14 lengths across, some way; its height the less the shorter.
		seed = seed *% 6364136223846793005 +% 1442695040888963407
		x := i64((seed >> 33) % 29) - 14
		seed = seed *% 6364136223846793005 +% 1442695040888963407
		y := i64((seed >> 33) % 29) - 14
		if x * x + y * y < 4 do x = 2 + w % 3
		seed = seed *% 6364136223846793005 +% 1442695040888963407
		phases[w] = f32((seed >> 33) % 10000) / 10000 * 6.2831853
		directions_x[w] = f32(x)
		directions_y[w] = f32(y)
		lengths := sqrt_f32(f32(x * x + y * y))
		heights[w] = 1 / (lengths * sqrt_f32(lengths))
	}
	pixels : [RIPPLE_SIZE * RIPPLE_SIZE * 4]u8
	pixels.len = pixels.cap
	for py in 0:RIPPLE_SIZE {
		for px in 0:RIPPLE_SIZE {
			// The height's slope here: each wave's.
			slope_x : f32 = 0
			slope_y : f32 = 0
			u := f32(px) / RIPPLE_SIZE * 6.2831853
			v := f32(py) / RIPPLE_SIZE * 6.2831853
			for w in 0:WAVES {
				change := cos_f32(directions_x[w] * u + directions_y[w] * v + phases[w]) * heights[w]
				slope_x += change * directions_x[w]
				slope_y += change * directions_y[w]
			}
			normal := vec3_normalize(Vec3{-slope_x * 0.35, -slope_y * 0.35, 1})
			at := (py * RIPPLE_SIZE + px) * 4
			pixels[at] = u8((normal.x * 0.5 + 0.5) * 255)
			pixels[at + 1] = u8((normal.y * 0.5 + 0.5) * 255)
			pixels[at + 2] = u8((normal.z * 0.5 + 0.5) * 255)
			pixels[at + 3] = 255
		}
	}
	GenTextures(1, &renderer.ripple_texture)
	BindTexture(TEXTURE_2D, renderer.ripple_texture)
	TexImage2D(TEXTURE_2D, 0, i32(RGBA8), RIPPLE_SIZE, RIPPLE_SIZE, 0, RGBA, UNSIGNED_BYTE, &pixels[0])
	GenerateMipmap(TEXTURE_2D)
	TexParameteri(TEXTURE_2D, TEXTURE_MIN_FILTER, i32(LINEAR_MIPMAP_LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_MAG_FILTER, i32(LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_S, i32(REPEAT))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_T, i32(REPEAT))
	if renderer.anisotropy > 1 do TexParameterf(TEXTURE_2D, TEXTURE_MAX_ANISOTROPY, renderer.anisotropy)
	UseProgram(renderer.water_program.program)
	Uniform1i(GetUniformLocation(renderer.water_program.program, "normal_map"), 0)
}

// Puts the stretches of water on the card, each in its slot: their points
// over their rectangles, at their heights, with their depths.
upload_waters :: fun(renderer: ^Renderer, waters: ^[]Water_Cell) {
	BindBuffer(ARRAY_BUFFER, renderer.water_vertex_buffer)
	points : [WATER_VERTICES]Water_Vertex
	for k in 0:waters.len {
		if k == WATER_SLOTS do break
		water := &waters[k]
		points.len = 0
		for row in 0:WATER_SIDE {
			for column in 0:WATER_SIDE {
				x := water.low_x + (water.high_x - water.low_x) * f32(column) / (WATER_SIDE - 1)
				y := water.low_y + (water.high_y - water.low_y) * f32(row) / (WATER_SIDE - 1)
				&points + Water_Vertex{position = Vec3{x, y, water.height}, depth = water.depths[row * WATER_SIDE + column]}
			}
		}
		BufferSubData(ARRAY_BUFFER, isize(k * WATER_VERTICES * size_of(Water_Vertex)),
			WATER_VERTICES * size_of(Water_Vertex), &points[0])
	}
}

// Where an item of a uniform array is in a program: name[index].
array_uniform :: fun(program: u32, name_start: []utf8, index: i64) -> i32 {
	name : str64
	&name + name_start
	&name + int_text(index)[:]
	&name + "]"
	return GetUniformLocation(program, cstring(name))
}

// Gives a program its shared uniforms for a frame.
set_shared_uniforms :: fun(at: Shared_Uniforms, view_projection: Mat4, lighting: Cell_Lighting, sun: Vec3, camera: Camera) {
	matrix := view_projection
	UniformMatrix4fv(at.view_projection_at, 1, 0, &matrix[0][0])
	Uniform3f(at.sun_direction_at, sun.x, sun.y, sun.z)
	Uniform3f(at.sun_color_at, lighting.directional.x, lighting.directional.y, lighting.directional.z)
	Uniform3f(at.ambient_color_at, lighting.ambient.x, lighting.ambient.y, lighting.ambient.z)
	Uniform3f(at.camera_position_at, camera.position.x, camera.position.y, camera.position.z)
	Uniform3f(at.fog_color_at, lighting.fog_color.x, lighting.fog_color.y, lighting.fog_color.z)
	Uniform1f(at.fog_near_at, lighting.fog_near)
	Uniform1f(at.fog_far_at, lighting.fog_far)
}

// The shared mesh buffers, the instance buffer and the indirect buffer,
// and how the mesh programs read them.
setup_mesh_buffers :: fun(renderer: ^Renderer) {
	GenVertexArrays(1, &renderer.mesh_vertex_array)
	BindVertexArray(renderer.mesh_vertex_array)

	GenBuffers(1, &renderer.mesh_vertex_buffer)
	BindBuffer(ARRAY_BUFFER, renderer.mesh_vertex_buffer)
	BufferData(ARRAY_BUFFER, MESH_VERTEX_ROOM * size_of(Vertex), void, STATIC_DRAW)
	stride := i32(size_of(Vertex))
	EnableVertexAttribArray(0)
	VertexAttribPointer(0, 3, FLOAT, 0, stride, 0)    // position
	EnableVertexAttribArray(1)
	VertexAttribPointer(1, 3, FLOAT, 0, stride, 12)   // normal
	EnableVertexAttribArray(2)
	VertexAttribPointer(2, 2, FLOAT, 0, stride, 24)   // uv
	EnableVertexAttribArray(3)
	VertexAttribPointer(3, 4, FLOAT, 0, stride, 32)   // color

	GenBuffers(1, &renderer.mesh_index_buffer)
	BindBuffer(ELEMENT_ARRAY_BUFFER, renderer.mesh_index_buffer)
	BufferData(ELEMENT_ARRAY_BUFFER, MESH_INDEX_ROOM * 2, void, STATIC_DRAW)

	// The instances: one Drawn_Instance each, read once for each instance.
	GenBuffers(1, &renderer.instance_buffer)
	BindBuffer(ARRAY_BUFFER, renderer.instance_buffer)
	BufferData(ARRAY_BUFFER, MAX_DRAWN * size_of(Drawn_Instance), void, STREAM_DRAW)
	instance_stride := i32(size_of(Drawn_Instance))
	for column in 0:4 {
		location := u32(4 + column)
		EnableVertexAttribArray(location)
		VertexAttribPointer(location, 4, FLOAT, 0, instance_stride, usize(column * 16))
		VertexAttribDivisor(location, 1)
	}
	EnableVertexAttribArray(8)
	VertexAttribIPointer(8, 4, UNSIGNED_SHORT, instance_stride, 64)    // lights 1 to 4
	VertexAttribDivisor(8, 1)
	EnableVertexAttribArray(9)
	VertexAttribIPointer(9, 4, UNSIGNED_SHORT, instance_stride, 72)    // lights 5 to 8
	VertexAttribDivisor(9, 1)
	EnableVertexAttribArray(10)
	VertexAttribPointer(10, 4, FLOAT, 0, instance_stride, 80)          // material
	VertexAttribDivisor(10, 1)
	EnableVertexAttribArray(11)
	VertexAttribIPointer(11, 2, UNSIGNED_INT, instance_stride, 96)     // texture handle
	VertexAttribDivisor(11, 1)
	BindVertexArray(0)

	GenBuffers(1, &renderer.indirect_buffer)
}

// The land's buffers — its slots of vertices, the indexes they share, its
// quadrants' textures' handles — and how the land programs read them.
setup_land_buffers :: fun(renderer: ^Renderer) {
	GenVertexArrays(1, &renderer.land_vertex_array)
	BindVertexArray(renderer.land_vertex_array)

	GenBuffers(1, &renderer.land_vertex_buffer)
	BindBuffer(ARRAY_BUFFER, renderer.land_vertex_buffer)
	BufferData(ARRAY_BUFFER, LAND_SLOTS * LAND_MESH_VERTICES * size_of(Land_Vertex), void, STATIC_DRAW)
	stride := i32(size_of(Land_Vertex))
	EnableVertexAttribArray(0)
	VertexAttribPointer(0, 3, FLOAT, 0, stride, 0)            // position
	EnableVertexAttribArray(1)
	VertexAttribPointer(1, 3, FLOAT, 0, stride, 12)           // normal
	EnableVertexAttribArray(2)
	VertexAttribPointer(2, 2, FLOAT, 0, stride, 24)           // uv
	EnableVertexAttribArray(3)
	VertexAttribPointer(3, 3, FLOAT, 0, stride, 32)           // color
	EnableVertexAttribArray(4)
	VertexAttribPointer(4, 4, UNSIGNED_BYTE, 1, stride, 44)   // weights 1 to 4, 0 to 1
	EnableVertexAttribArray(5)
	VertexAttribPointer(5, 4, UNSIGNED_BYTE, 1, stride, 48)   // weights 5 to 8

	indices : [LAND_MESH_INDICES]u16
	land_indices(&indices)
	GenBuffers(1, &renderer.land_index_buffer)
	BindBuffer(ELEMENT_ARRAY_BUFFER, renderer.land_index_buffer)
	BufferData(ELEMENT_ARRAY_BUFFER, isize(indices.len * 2), &indices[0], STATIC_DRAW)
	BindVertexArray(0)
	GenBuffers(1, &renderer.land_indirect_buffer)

	GenBuffers(1, &renderer.land_texture_buffer)
	BindBuffer(SHADER_STORAGE_BUFFER, renderer.land_texture_buffer)
	BufferData(SHADER_STORAGE_BUFFER, LAND_QUADRANTS * QUADRANT_TEXTURES * 8, void, DYNAMIC_DRAW)
}

// ---- textures --------------------------------------------------------------------

// The slot of the texture at path in the archive (an index into the
// renderer's textures), loaded onto the card the first time it's asked
// for; the white texture's (0) when it can't be read. scratch is room for
// reading and decoding it.
texture_for :: fun(renderer: ^Renderer, archive: ^Archive, path: []utf8, scratch: ^[]byte) -> i64 {
	if path.len == 0 do return 0
	key := text_hash(path)
	known, found := index_get(&renderer.texture_index, key)
	if found do return known
	if renderer.textures.len == renderer.textures.cap do return 0
	id := load_texture(renderer, archive, path, scratch)
	slot : i64 = 0
	if id != 0 {
		slot = renderer.textures.len
		entry := next(&renderer.textures)
		entry.path.len = 0
		&entry.path + path
		entry.id = id
		entry.handle = resident_handle(renderer, id)
	}
	_ = index_put(&renderer.texture_index, key, slot)
	return slot
}

// A 64-bit FNV-1a hash of a text, never 0: a path's key in a table.
text_hash :: fun(text: []utf8) -> u64 {
	hash : u64 = 0xCBF29CE484222325
	for c in text {
		hash = (hash ~ u64(c)) *% 0x100000001B3
	}
	if hash == 0 do hash = 1
	return hash
}

// Reads a texture from the archive onto the card: block compressed ones as
// they are, the rest decoded to plain pixels; its mipmaps as many as it
// has, sharp at a slant. 0 when it can't be read.
load_texture :: fun(renderer: ^Renderer, archive: ^Archive, path: []utf8, scratch: ^[]byte) -> u32 {
	texture, read_error := read_archive_texture(archive, path, scratch)
	if read_error do return 0

	id : u32 = 0
	GenTextures(1, &id)
	BindTexture(TEXTURE_2D, id)
	levels : i64 = 0
	for mip, level in texture.mips {
		width := i32(mip.width)
		height := i32(mip.height)
		pixels := texture.pixels[mip.at : mip.at + mip.size]
		match texture.format {
		dxt1
			CompressedTexImage2D(TEXTURE_2D, i32(level), RGBA_S3TC_DXT1, width, height, 0, i32(mip.size), &pixels[0])
		dxt3
			CompressedTexImage2D(TEXTURE_2D, i32(level), RGBA_S3TC_DXT3, width, height, 0, i32(mip.size), &pixels[0])
		dxt5
			CompressedTexImage2D(TEXTURE_2D, i32(level), RGBA_S3TC_DXT5, width, height, 0, i32(mip.size), &pixels[0])
		else
			decoded, decode_error := decode_rgba(texture, level, scratch)
			if decode_error do break
			TexImage2D(TEXTURE_2D, i32(level), i32(RGBA8), width, height, 0, RGBA, UNSIGNED_BYTE, &decoded[0])
		}
		levels += 1
	}
	if levels == 0 do return 0
	// Its mipmaps, as many as it has (many stop short of 1 pixel).
	TexParameteri(TEXTURE_2D, TEXTURE_MAX_LEVEL, i32(levels - 1))
	TexParameteri(TEXTURE_2D, TEXTURE_MIN_FILTER, i32(LINEAR_MIPMAP_LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_MAG_FILTER, i32(LINEAR))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_S, i32(REPEAT))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_T, i32(REPEAT))
	if renderer.anisotropy > 1 do TexParameterf(TEXTURE_2D, TEXTURE_MAX_ANISOTROPY, renderer.anisotropy)
	return id
}

// A texture from the archive, its header read: into scratch (len set to 0).
read_archive_texture :: fun(archive: ^Archive, path: []utf8, scratch: ^[]byte) -> Texture, err {
	scratch.len = 0
	index, found := find_file(archive, path)
	if not found do return Texture(), Not_Found
	data := read_file(archive, index, scratch)?
	return read_texture(data)
}

// ---- meshes --------------------------------------------------------------------------

// What putting a model on the card can fail with.
Upload_Error :: error {
	No_Room_On_Card   // the shared buffers or the parts table are full
}

// Puts a model's parts into the shared buffers, their textures read from
// the archive: the model on the card.
upload_model :: fun(renderer: ^Renderer, built: Model, archive: ^Archive, scratch: ^[]byte) -> Gpu_Model, err {
	vertex_total : i64 = 0
	index_total : i64 = 0
	for part in built.parts {
		vertex_total += part.vertices.len
		index_total += part.indices.len
	}
	if renderer.vertices_used + vertex_total > MESH_VERTEX_ROOM or renderer.indices_used + index_total > MESH_INDEX_ROOM {
		return Gpu_Model{0}, No_Room_On_Card
	}
	if renderer.parts.len + built.parts.len > renderer.parts.cap do return Gpu_Model{0}, No_Room_On_Card

	BindVertexArray(0)   // (binding an index buffer would change a bound vertex array's)
	gpu := Gpu_Model{
		first_part = renderer.parts.len,
		part_count = 0,
		center = (built.bounds_min + built.bounds_max) * 0.5,
		radius = vec3_length(built.bounds_max - built.bounds_min) * 0.5}
	for part in built.parts {
		if part.indices.len == 0 or part.vertices.len == 0 do continue
		BindBuffer(ARRAY_BUFFER, renderer.mesh_vertex_buffer)
		BufferSubData(ARRAY_BUFFER, isize(renderer.vertices_used * size_of(Vertex)),
			isize(part.vertices.len * size_of(Vertex)), &part.vertices[0])
		BindBuffer(ELEMENT_ARRAY_BUFFER, renderer.mesh_index_buffer)
		BufferSubData(ELEMENT_ARRAY_BUFFER, isize(renderer.indices_used * 2), isize(part.indices.len * 2), &part.indices[0])

		threshold : f32 = 0
		if part.alpha_test do threshold = part.alpha_threshold
		next(&renderer.parts)^ = Mesh_Part{
			first_index = u32(renderer.indices_used),
			index_count = u32(part.indices.len),
			base_vertex = i32(renderer.vertices_used),
			texture_slot = texture_for(renderer, archive, part.texture[:], scratch),
			alpha_blend = part.alpha_blend,
			two_sided = part.two_sided,
			alpha_threshold = threshold,
			emissive = part.emissive}
		renderer.vertices_used += part.vertices.len
		renderer.indices_used += part.indices.len
		gpu.part_count += 1
	}
	return gpu
}

// An instance of a model placed in the world: its sphere worked out, no
// lights yet (choose_lights).
place_instance :: fun(gpu: Gpu_Model, model_index: i64, placement: Mat4) -> Instance {
	placed := mat4_mul_vec4(placement, Vec4{gpu.center.x, gpu.center.y, gpu.center.z, 1})
	// The scale: how long the matrix's x axis is.
	scale := vec3_length(Vec3{placement[0][0], placement[0][1], placement[0][2]})
	instance := Instance{
		model = model_index,
		world = placement,
		center = Vec3{placed.x, placed.y, placed.z},
		radius = gpu.radius * scale,
		lights = []}
	for k in 0:LIGHTS_PER_OBJECT do instance.lights[k] = NO_LIGHT
	return instance
}

// Chooses the lights that light an instance: those of the scene's first
// SCENE_LIGHTS whose reach meets its sphere, the nearest first.
choose_lights :: fun(instance: ^Instance, lights: ^[]Point_Light) {
	distances : [LIGHTS_PER_OBJECT!]f32
	count : i64 = 0
	for k in 0:instance.lights.len do instance.lights[k] = NO_LIGHT
	last := lights.len
	if last > SCENE_LIGHTS do last = SCENE_LIGHTS
	for index in 0:last {
		light := lights[index]
		distance := vec3_length(light.position - instance.center)
		if distance > light.radius + instance.radius do continue
		if count == LIGHTS_PER_OBJECT and distance >= distances[LIGHTS_PER_OBJECT - 1] do continue
		at := count
		if count < LIGHTS_PER_OBJECT do count += 1
		else do at = LIGHTS_PER_OBJECT - 1
		for at > 0 and distances[at - 1] > distance {
			instance.lights[at] = instance.lights[at - 1]
			distances[at] = distances[at - 1]
			at -= 1
		}
		instance.lights[at] = u16(index)
		distances[at] = distance
	}
}

// Gives the mesh programs the scene's lights: its first SCENE_LIGHTS.
set_scene_lights :: fun(renderer: ^Renderer, lights: ^[]Point_Light) {
	last := lights.len
	if last > SCENE_LIGHTS do last = SCENE_LIGHTS
	programs : i64 = if renderer.bindless_available do 2 else 1
	for which in 0:programs {
		made := &renderer.mesh_programs[which]
		UseProgram(made.program)
		for i in 0:last {
			light := lights[i]
			Uniform3f(made.light_position_at[i], light.position.x, light.position.y, light.position.z)
			Uniform3f(made.light_color_at[i], light.color.x, light.color.y, light.color.z)
			Uniform1f(made.light_reach_at[i], light.radius)
		}
	}
}

// ---- land ---------------------------------------------------------------------------------

// Puts the land of the cell at x, y on the card: its quadrants' textures
// (loaded the first time each is asked for, their handles where the
// quadrant's land reads them), its vertices into a slot (0 to LAND_SLOTS
// - 1, one no other land is in).
upload_land :: fun(renderer: ^Renderer, mesh: ^Land_Mesh, x: i64, y: i64, slot: i64, archive: ^Archive, scratch: ^[]byte) -> Gpu_Land {
	for q in 0:4 {
		textures := &mesh.textures[q]
		quadrant := &renderer.land_quadrants[slot * 4 + q]
		handles : [QUADRANT_TEXTURES!]u64
		for k in 0:QUADRANT_TEXTURES {
			texture_slot := quadrant.textures[0]
			if k < textures.count do texture_slot = texture_for(renderer, archive, textures.paths[k][:], scratch)
			quadrant.textures[k] = texture_slot
			handles[k] = renderer.textures[texture_slot].handle
		}
		if renderer.bindless_available {
			BindBuffer(SHADER_STORAGE_BUFFER, renderer.land_texture_buffer)
			BufferSubData(SHADER_STORAGE_BUFFER, isize((slot * 4 + q) * QUADRANT_TEXTURES * 8), QUADRANT_TEXTURES * 8, &handles[0])
		}
	}
	BindBuffer(ARRAY_BUFFER, renderer.land_vertex_buffer)
	BufferSubData(ARRAY_BUFFER, isize(slot * LAND_MESH_VERTICES * size_of(Land_Vertex)),
		LAND_MESH_VERTICES * size_of(Land_Vertex), &mesh.vertices[0])
	return Gpu_Land{x = x, y = y, slot = slot, center = mesh.center, radius = mesh.radius}
}

// ---- the camera ----------------------------------------------------------------------

// Where the camera is and which way it looks.
Camera :: struct {
	position: Vec3
	yaw: f32      // turned from looking north (+y), clockwise seen from above
	pitch: f32    // up from level
	field_of_view: f32 = 1.2   // vertical, in radians
	near: f32 = 5
	far: f32 = 60000
}

// The way the camera looks, and its right and up.
camera_axes :: fun(camera: Camera) -> Vec3, Vec3, Vec3 {
	forward := Vec3{sin_f32(camera.yaw) * cos_f32(camera.pitch), cos_f32(camera.yaw) * cos_f32(camera.pitch), sin_f32(camera.pitch)}
	right := Vec3{cos_f32(camera.yaw), -sin_f32(camera.yaw), 0}
	up := cross(right, forward)
	return forward, right, up
}

// The matrix taking the world to the camera's view: the camera looking
// down its -z, as OpenGL has it.
view_matrix :: fun(camera: Camera) -> Mat4 {
	forward, right, up := camera_axes(camera)
	view := mat4_identity()
	view[0][0] = right.x
	view[1][0] = right.y
	view[2][0] = right.z
	view[0][1] = up.x
	view[1][1] = up.y
	view[2][1] = up.z
	view[0][2] = -forward.x
	view[1][2] = -forward.y
	view[2][2] = -forward.z
	view[3][0] = -dot(right, camera.position)
	view[3][1] = -dot(up, camera.position)
	view[3][2] = dot(forward, camera.position)
	return view
}

// The six planes bounding what a view and projection see, each as its
// normal (pointing in) and distance: a point p is inside a plane when
// dot(normal, p) + distance >= 0.
View_Planes :: struct {
	planes: [6!][4!]f32
}

view_planes :: fun(view_projection: Mat4) -> View_Planes {
	m := view_projection
	result := View_Planes{0}
	// Each plane: the matrix's last row, plus or minus one of its first
	// three (row i: the columns' i-th items) — left, right, bottom, top,
	// near, far.
	for p in 0:6 {
		row := p / 2
		sign : f32 = 1
		if p % 2 == 1 do sign = -1
		plane : [4!]f32
		for k in 0:4 do plane[k] = m[k][3] + sign * m[k][row]
		scale := sqrt_f32(plane[0] * plane[0] + plane[1] * plane[1] + plane[2] * plane[2])
		if scale > 0 {
			for k in 0:4 do plane[k] = plane[k] / scale
		}
		result.planes[p] = plane
	}
	return result
}

// Whether any of a sphere is in view.
sphere_in_view :: fun(planes: ^View_Planes, center: Vec3, radius: f32) -> bool {
	for p in 0:6 {
		plane := planes.planes[p]
		if plane[0] * center.x + plane[1] * center.y + plane[2] * center.z + plane[3] < -radius do return false
	}
	return true
}

// ---- drawing a frame -----------------------------------------------------------------

// Draws a frame width by height pixels from the camera: the land in view,
// then the instances in view — opaque parts, then blended — lit by the
// lighting and the lights set with set_scene_lights. Tells what it drew.
draw_frame :: fun(renderer: ^Renderer, models: ^[]Gpu_Model, instances: ^[]Instance, grounds: ^[]Gpu_Land,
	waters: ^[]Water_Cell, look: ^Sky_Look, lighting: Cell_Lighting, camera: Camera, width: i64, height: i64) -> Frame_Stats
{
	stats := Frame_Stats{instances = instances.len, visible = 0, drawn_parts = 0, draw_calls = 0, land_cells = 0}
	Viewport(0, 0, i32(width), i32(height))
	fog := lighting.fog_color
	ClearColor(fog.x, fog.y, fog.z, 1.0)
	Clear(COLOR_BUFFER_BIT | DEPTH_BUFFER_BIT)
	Enable(DEPTH_TEST)
	DepthFunc(LEQUAL)
	Enable(CULL_FACE)
	Disable(BLEND)
	DepthMask(1)
	ActiveTexture(TEXTURE0)

	projection := mat4_perspective(camera.field_of_view, f32(width) / f32(height), camera.near, camera.far)
	view_projection := mat4_mul(projection, view_matrix(camera))
	planes := view_planes(view_projection)
	sun := vec3_normalize(lighting.direction)

	if look.outside do draw_sky(renderer, look, view_projection, lighting, camera, &stats)
	if grounds.len > 0 do draw_land(renderer, grounds, &planes, view_projection, lighting, sun, camera, &stats)
	gather_meshes(renderer, models, instances, &planes, &stats)
	draw_mesh_runs(renderer, view_projection, lighting, sun, camera, false, &stats)
	if waters.len > 0 do draw_water(renderer, waters, &planes, look, view_projection, lighting, camera, &stats)
	draw_mesh_runs(renderer, view_projection, lighting, sun, camera, true, &stats)

	DepthMask(1)
	Disable(BLEND)
	ActiveTexture(TEXTURE0)
	BindVertexArray(0)
	return stats
}

// Draws the sky behind everything: its triangle over the screen, the
// depth buffer neither read nor written.
draw_sky :: fun(renderer: ^Renderer, look: ^Sky_Look, view_projection: Mat4, lighting: Cell_Lighting, camera: Camera, stats: ^Frame_Stats) {
	made := &renderer.sky_program
	state := &look.state
	UseProgram(made.program)
	inverse := mat4_inverse(view_projection)
	UniformMatrix4fv(made.inverse_view_projection_at, 1, 0, &inverse[0][0])
	Uniform3f(made.camera_position_at, camera.position.x, camera.position.y, camera.position.z)
	Uniform3f(made.fog_color_at, lighting.fog_color.x, lighting.fog_color.y, lighting.fog_color.z)
	Uniform3f(made.sky_upper_at, state.upper.x, state.upper.y, state.upper.z)
	Uniform3f(made.sky_lower_at, state.lower.x, state.lower.y, state.lower.z)
	Uniform3f(made.sky_horizon_at, state.horizon.x, state.horizon.y, state.horizon.z)
	Uniform3f(made.sun_direction_at, state.sun_direction.x, state.sun_direction.y, state.sun_direction.z)
	Uniform3f(made.sun_color_at, state.sun_color.x, state.sun_color.y, state.sun_color.z)
	Uniform3f(made.cloud_lower_color_at, state.cloud_lower_color.x, state.cloud_lower_color.y, state.cloud_lower_color.z)
	Uniform3f(made.cloud_upper_color_at, state.cloud_upper_color.x, state.cloud_upper_color.y, state.cloud_upper_color.z)
	Uniform2f(made.cloud_lower_offset_at, look.cloud_lower_offset, look.cloud_lower_offset * 0.3)
	Uniform2f(made.cloud_upper_offset_at, look.cloud_upper_offset, look.cloud_upper_offset * 0.3)
	ActiveTexture(TEXTURE0)
	BindTexture(TEXTURE_2D, renderer.textures[look.cloud_lower].id)
	ActiveTexture(TEXTURE1)
	BindTexture(TEXTURE_2D, renderer.textures[look.cloud_upper].id)
	ActiveTexture(TEXTURE2)
	BindTexture(TEXTURE_2D, renderer.textures[look.sun].id)
	ActiveTexture(TEXTURE0)
	Disable(DEPTH_TEST)
	DepthMask(0)
	BindVertexArray(renderer.empty_vertex_array)
	DrawArrays(TRIANGLES, 0, 3)
	Enable(DEPTH_TEST)
	DepthMask(1)
	stats.draw_calls += 1
}

// Draws the water in view (put on the card with upload_waters): one call
// for all of it, blended over what's below, the depth buffer read but not
// written.
draw_water :: fun(renderer: ^Renderer, waters: ^[]Water_Cell, planes: ^View_Planes, look: ^Sky_Look, view_projection: Mat4,
	lighting: Cell_Lighting, camera: Camera, stats: ^Frame_Stats)
{
	renderer.water_commands.len = 0
	for k in 0:waters.len {
		if k == WATER_SLOTS do break
		water := &waters[k]
		middle := Vec3{(water.low_x + water.high_x) / 2, (water.low_y + water.high_y) / 2, water.height}
		radius := vec3_length(Vec3{water.high_x - water.low_x, water.high_y - water.low_y, 0}) / 2
		if not sphere_in_view(planes, middle, radius) do continue
		&renderer.water_commands + Draw_Command{count = WATER_INDICES, instance_count = 1, first_index = 0,
			base_vertex = i32(k * WATER_VERTICES), base_instance = 0}
	}
	if renderer.water_commands.len == 0 do return

	made := &renderer.water_program
	state := &look.state
	water := &look.water
	UseProgram(made.program)
	matrix := view_projection
	UniformMatrix4fv(made.view_projection_at, 1, 0, &matrix[0][0])
	Uniform3f(made.camera_position_at, camera.position.x, camera.position.y, camera.position.z)
	Uniform1f(made.time_at, look.time)
	Uniform2f(made.scroll_at, water.scroll[0], water.scroll[1])
	Uniform3f(made.shallow_color_at, water.shallow.x, water.shallow.y, water.shallow.z)
	Uniform3f(made.deep_color_at, water.deep.x, water.deep.y, water.deep.z)
	Uniform3f(made.reflection_color_at, water.reflection.x, water.reflection.y, water.reflection.z)
	Uniform1f(made.reflectivity_at, water.reflectivity)
	Uniform1f(made.fresnel_base_at, water.fresnel)
	Uniform1f(made.sun_power_at, water.sun_power)
	Uniform3f(made.sky_upper_at, state.upper.x, state.upper.y, state.upper.z)
	Uniform3f(made.sky_lower_at, state.lower.x, state.lower.y, state.lower.z)
	Uniform3f(made.sky_horizon_at, state.horizon.x, state.horizon.y, state.horizon.z)
	Uniform3f(made.sun_direction_at, state.sun_direction.x, state.sun_direction.y, state.sun_direction.z)
	Uniform3f(made.sun_color_at, state.sun_color.x, state.sun_color.y, state.sun_color.z)
	Uniform1f(made.daylight_at, state.daylight)
	Uniform3f(made.fog_color_at, lighting.fog_color.x, lighting.fog_color.y, lighting.fog_color.z)
	Uniform1f(made.fog_near_at, lighting.fog_near)
	Uniform1f(made.fog_far_at, lighting.fog_far)
	ActiveTexture(TEXTURE0)
	BindTexture(TEXTURE_2D, renderer.ripple_texture)
	BindVertexArray(renderer.water_vertex_array)
	BindBuffer(DRAW_INDIRECT_BUFFER, renderer.water_indirect_buffer)
	BufferData(DRAW_INDIRECT_BUFFER, isize(renderer.water_commands.len * size_of(Draw_Command)), &renderer.water_commands[0], STREAM_DRAW)
	Disable(CULL_FACE)   // (seen from under the water too)
	Enable(BLEND)
	BlendFunc(SRC_ALPHA, ONE_MINUS_SRC_ALPHA)
	DepthMask(0)
	MultiDrawElementsIndirect(TRIANGLES, UNSIGNED_SHORT, 0, i32(renderer.water_commands.len), 0)
	DepthMask(1)
	Disable(BLEND)
	Enable(CULL_FACE)
	stats.draw_calls += 1
}

// Draws the land in view: bindless, in one call; else a call for each
// quadrant, its textures bound to units 0 to 8.
draw_land :: fun(renderer: ^Renderer, grounds: ^[]Gpu_Land, planes: ^View_Planes, view_projection: Mat4,
	lighting: Cell_Lighting, sun: Vec3, camera: Camera, stats: ^Frame_Stats)
{
	bindless := renderer.use_bindless
	renderer.land_commands.len = 0
	for ground in grounds {
		if not sphere_in_view(planes, ground.center, ground.radius) do continue
		stats.land_cells += 1
		if bindless {
			// The whole cell: its four quadrants' indexes, its slot's vertices.
			&renderer.land_commands + Draw_Command{
				count = LAND_MESH_INDICES, instance_count = 1, first_index = 0,
				base_vertex = i32(ground.slot * LAND_MESH_VERTICES), base_instance = 0}
		else
			quadrant_indices := LAND_MESH_INDICES / 4
			for q in 0:4 {
				&renderer.land_commands + Draw_Command{
					count = u32(quadrant_indices), instance_count = 1, first_index = u32(q * quadrant_indices),
					base_vertex = i32(ground.slot * LAND_MESH_VERTICES), base_instance = u32(ground.slot * 4 + q)}
			}
		}
	}
	if renderer.land_commands.len == 0 do return

	made := &renderer.land_programs[which_program(renderer)]
	UseProgram(made.program)
	set_shared_uniforms(made.shared, view_projection, lighting, sun, camera)
	BindVertexArray(renderer.land_vertex_array)
	BindBuffer(DRAW_INDIRECT_BUFFER, renderer.land_indirect_buffer)
	BufferData(DRAW_INDIRECT_BUFFER, isize(renderer.land_commands.len * size_of(Draw_Command)), &renderer.land_commands[0], STREAM_DRAW)
	if bindless {
		BindBufferBase(SHADER_STORAGE_BUFFER, 1, renderer.land_texture_buffer)
		MultiDrawElementsIndirect(TRIANGLES, UNSIGNED_SHORT, 0, i32(renderer.land_commands.len), 0)
		stats.draw_calls += 1
		return
	}
	// A quadrant at a time: its textures (named by its command's base
	// instance) on units 0 to 8, then its command.
	for command, k in renderer.land_commands {
		quadrant := &renderer.land_quadrants[command.base_instance]
		for unit in 0:QUADRANT_TEXTURES {
			ActiveTexture(LAYER_UNITS[unit])
			BindTexture(TEXTURE_2D, renderer.textures[quadrant.textures[unit]].id)
		}
		MultiDrawElementsIndirect(TRIANGLES, UNSIGNED_SHORT, usize(k * size_of(Draw_Command)), 1, 0)
		stats.draw_calls += 1
	}
	ActiveTexture(TEXTURE0)
}

// A part's sort key: blended parts after opaque ones; within those, the
// two-sided after the rest; without bindless, then by texture — so each
// run of one key is one draw call. The part's index in the low bits.
part_key :: fun(part: Mesh_Part, part_index: i64, bindless: bool) -> i64 {
	group_key : i64 = 0
	if not bindless do group_key = part.texture_slot
	if part.two_sided do group_key += MAX_TEXTURES
	if part.alpha_blend do group_key += 2 * MAX_TEXTURES
	return (group_key << 20) | part_index
}

// Gathers the instances in view for drawing: their parts — each part's
// instances together, the parts of one state (and, without bindless, one
// texture) together — into the records and the commands, both put on the
// card. draw_mesh_runs draws them, a call for each gathering.
gather_meshes :: fun(renderer: ^Renderer, models: ^[]Gpu_Model, instances: ^[]Instance, planes: ^View_Planes, stats: ^Frame_Stats) {
	bindless := renderer.use_bindless

	// The instances in view, and how many of each part they draw.
	renderer.visible.len = 0
	renderer.touched.len = 0
	record_count : i64 = 0
	for &instance, index in instances {
		if not sphere_in_view(planes, instance.center, instance.radius) do continue
		placed_model := models[instance.model]
		if record_count + placed_model.part_count > MAX_DRAWN do break
		&renderer.visible + index
		for p in placed_model.first_part:placed_model.first_part + placed_model.part_count {
			if renderer.part_counts[p] == 0 do &renderer.touched + part_key(renderer.parts[p], p, bindless)
			renderer.part_counts[p] += 1
		}
		record_count += placed_model.part_count
	}
	stats.visible = renderer.visible.len
	stats.drawn_parts = record_count
	renderer.commands.len = 0
	if record_count == 0 do return

	// The parts in drawing order; each one's instances' place in the records.
	sort_keys(&renderer.touched)
	renderer.commands.len = 0
	start : i64 = 0
	for key in renderer.touched {
		p := key & 0xFFFFF
		part := renderer.parts[p]
		&renderer.commands + Draw_Command{
			count = part.index_count,
			instance_count = u32(renderer.part_counts[p]),
			first_index = part.first_index,
			base_vertex = part.base_vertex,
			base_instance = u32(start)}
		renderer.part_starts[p] = start
		start += renderer.part_counts[p]
		renderer.part_counts[p] = 0   // counts again as the records fill
	}

	// The records: each part's instances in their place.
	renderer.records.len = record_count
	for index in renderer.visible {
		instance := &instances[index]
		placed_model := models[instance.model]
		for p in placed_model.first_part:placed_model.first_part + placed_model.part_count {
			part := renderer.parts[p]
			record := &renderer.records[renderer.part_starts[p] + renderer.part_counts[p]]
			renderer.part_counts[p] += 1
			record.world = instance.world
			record.lights = instance.lights
			record.material = [part.alpha_threshold, part.emissive.x, part.emissive.y, part.emissive.z]
			record.texture = renderer.textures[part.texture_slot].handle
		}
	}
	for key in renderer.touched do renderer.part_counts[key & 0xFFFFF] = 0

	BindBuffer(ARRAY_BUFFER, renderer.instance_buffer)
	BufferData(ARRAY_BUFFER, MAX_DRAWN * size_of(Drawn_Instance), void, STREAM_DRAW)   // (a fresh buffer: no waiting on last frame's)
	BufferSubData(ARRAY_BUFFER, 0, isize(record_count * size_of(Drawn_Instance)), &renderer.records[0])
	BindBuffer(DRAW_INDIRECT_BUFFER, renderer.indirect_buffer)
	BufferData(DRAW_INDIRECT_BUFFER, isize(renderer.commands.len * size_of(Draw_Command)), &renderer.commands[0], STREAM_DRAW)
}

// Draws the gathered meshes' opaque runs, or their blended ones (after the
// water): a call for each run of commands of one key.
draw_mesh_runs :: fun(renderer: ^Renderer, view_projection: Mat4, lighting: Cell_Lighting, sun: Vec3, camera: Camera,
	blended: bool, stats: ^Frame_Stats)
{
	if renderer.commands.len == 0 do return
	bindless := renderer.use_bindless
	made := &renderer.mesh_programs[which_program(renderer)]
	UseProgram(made.program)
	set_shared_uniforms(made.shared, view_projection, lighting, sun, camera)
	BindVertexArray(renderer.mesh_vertex_array)
	BindBuffer(DRAW_INDIRECT_BUFFER, renderer.indirect_buffer)
	if blended {
		Enable(BLEND)
		BlendFunc(SRC_ALPHA, ONE_MINUS_SRC_ALPHA)
		DepthMask(0)
	}
	run_start : i64 = 0
	for run_start < renderer.commands.len {
		group_key := renderer.touched[run_start] >> 20
		run_end := run_start + 1
		for run_end < renderer.commands.len and renderer.touched[run_end] >> 20 == group_key do run_end += 1

		first_part := renderer.parts[renderer.touched[run_start] & 0xFFFFF]
		if first_part.alpha_blend != blended {
			run_start = run_end
			continue
		}
		if first_part.two_sided do Disable(CULL_FACE)
		else do Enable(CULL_FACE)
		if not bindless do BindTexture(TEXTURE_2D, renderer.textures[first_part.texture_slot].id)
		MultiDrawElementsIndirect(TRIANGLES, UNSIGNED_SHORT, usize(run_start * size_of(Draw_Command)), i32(run_end - run_start), 0)
		stats.draw_calls += 1
		run_start = run_end
	}
}

// Sorts keys, smallest first (Shell's sort: a few thousand at most).
sort_keys :: fun(keys: ^[]i64) {
	gap := keys.len / 2
	for gap > 0 {
		for i in gap:keys.len {
			value := keys[i]
			k := i
			for k >= gap and keys[k - gap] > value {
				keys[k] = keys[k - gap]
				k -= gap
			}
			keys[k] = value
		}
		gap /= 2
	}
}
