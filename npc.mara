// NPCs: the people placed in cells (ACHR), each put together as the game
// does — their race's body and head, their hair and eyes, what they wear —
// skinned to their skeleton and posed as its idle animation starts, then
// made one model, which every placement of the NPC shares. Each face is its
// own (FaceGen: facegen.mara): its head, and what sits on it, shaped by its
// face values, and its skin's colors moved by them.
//
// Not yet: moving.
module scene

use mara.core
use mara.math
use mara.string
use mara.memory
use bsa
use nif
use model
use render
use world
use esm
use animation
use facegen
use dds
use logging

// The animation every NPC is posed by: its first pose.
IDLE_ANIMATION :: "meshes/characters/_male/idle.kf"

// The body's meshes, shared by every race (whose textures they're drawn
// with): 0 the upper body, 1 the legs, 2 the hands, 3 the feet; a man's or
// a woman's.
body_mesh :: fun(part: i64, female: bool) -> str64 {
	if female {
		if part == 0 do return "meshes/characters/_male/femaleupperbody.nif"
		if part == 1 do return "meshes/characters/_male/femalelowerbody.nif"
		if part == 2 do return "meshes/characters/_male/femalehand.nif"
		return "meshes/characters/_male/femalefoot.nif"
	}
	if part == 0 do return "meshes/characters/_male/upperbody.nif"
	if part == 1 do return "meshes/characters/_male/lowerbody.nif"
	if part == 2 do return "meshes/characters/_male/hand.nif"
	return "meshes/characters/_male/foot.nif"
}

// What a worn item covers (its BMDT), the slots the body has parts for:
// the head, the hair, the upper body, the legs, the hands, the feet.
SLOT_HEAD :: 0x1
SLOT_HAIR :: 0x2
SLOT_UPPER_BODY :: 0x4
SLOT_LOWER_BODY :: 0x8
SLOT_HAND :: 0x10
SLOT_FOOT :: 0x20
SLOT_TAIL :: 0x8000

// The player's level leveled lists of gear are taken at: a middling one's.
GEAR_LEVEL :: 10

// The bone the head's parts (eyes, ears, mouth…) and hair hang from.
HEAD_BONE :: "Bip01 Head"

// A key in the scene's paths for an NPC's model: the NPC's form id, and
// a bit no text's hash sets.
NPC_MODEL_KEY :: 0x8000000000000000

// Parts an NPC is made of, at most; shapes its model has, at most.
NPC_PARTS :: 32
NPC_MODEL_PARTS :: 128

// One mesh an NPC is put together from: the texture its shapes are drawn
// with in place of their own (empty: their own), the bone it hangs from if
// it isn't skinned (empty: the one it names, Prn, else none), and the hair
// color it takes (hair_tinted): white for all but its hair.
// Hung from a bone, a part's coordinates are the bone's own axes (a shield
// on the forearm), except from the head: see head_hang.
Npc_Part :: struct {
	mesh: [256]utf8
	texture: [256]utf8
	bone: [64]utf8
	tint: Vec3
	face_index: i64   // its place among the race's head parts (0 the head, 1 and 2 the ears...); -1 for none
}

// What an NPC is put together from: whether she's a woman, how tall (a
// share of the skeleton's height: the race's), the skeleton, the parts.
Npc_Look :: struct {
	female: bool
	height: f32
	skeleton: [256]utf8
	parts: [NPC_PARTS]Npc_Part
	has_face: bool        // its face values read (all NPCs have them)
	face: Face_Values     // how its head and what sits on it are shaped (facegen.mara)
	npc_id: u32           // (its skins are named after it: Face_Skin)
	face_maps: [128]utf8  // the start of its made face maps' paths: textures\faces\<plugin>\<form id>_
}

// A skin made for a face (facegen.mara): a part's texture with its colors
// moved, named for the part to draw it with (facegen\<NPC>\<part>, which
// is no file), its pixels (red, green, blue, alpha, rows from the top).
Face_Skin :: struct {
	path: [96]utf8
	pixels: []byte
	width: i64
	height: i64
}

// A skeleton NPCs are put together on, kept: its path; its bones as its
// idle animation starts (the pose their parts are rigged to); the same
// bones as a rig, with the idle's tracks (their keys in track_room) and
// its span, start to stop, to pose it at any time (pose_npcs).
Npc_Skeleton :: struct {
	path: [256]utf8
	bones: [MAX_POSE_BONES]Pose_Bone
	rig: [MAX_POSE_BONES]Rig_Bone
	tracks: [256]Track
	track_room: [1 * MB]byte
	start: f32
	stop: f32
}

// The most entries an NPC's model's palette has (its parts' together).
NPC_PALETTE :: 2048

// An NPC's model made for the card to move: the scene's model, the
// skeleton it's posed on, how tall (a share of the skeleton's height), and
// its palette's entries (in the scene's rig_entries).
Npc_Rig :: struct {
	model: i64
	skeleton: i64
	height: f32
	first_entry: i64
	entry_count: i64
}

// How long, at most, an NPC's idle is put off at the start, so no two
// breathe together (seconds).
IDLE_SPREAD :: 10

// The bones a skeleton has, at most.
MAX_POSE_BONES :: 128

// What an NPC looks like, from its NPC_ record and its race's: into look.
read_npc_look :: fun(plugin: ^Plugin, npc_id: u32, look: ^Npc_Look) -> err {
	look.parts.len = 0
	look.female = false
	look.height = 1
	look.skeleton.len = 0
	look.has_face = false
	look.face = Face_Values{0}
	look.npc_id = npc_id
	look.face_maps.len = 0
	scratch : [256 * KB]byte
	npc := find_record(plugin, npc_id, &scratch)?
	// Its face maps, as the game names them: after the plugin it's from
	// and its form id there.
	&look.face_maps + "textures\\faces\\"
	for c in plugin.files[npc.file].name do &look.face_maps + lower(c)
	&look.face_maps + "\\"
	add_hex(&look.face_maps, npc.header.form_id)
	&look.face_maps + "_"
	race_id : u32 = 0
	hair_id : u32 = 0
	eyes_id : u32 = 0
	hair_color := Vec3{1, 1, 1}
	carried : [64]u32
	fields := Fields{data = npc.data, at = 0, broken = false}
	for field in next_field(&fields) {
		if field.kind == "ACBS" and field.data.len >= 4 {
			flags : u32 = field.data[0]
			look.female = flags & 1 != 0
		elif field.kind == "MODL"
			archive_path_under("meshes\\", field_text(field.data), &look.skeleton)
		elif field.kind == "RNAM" and field.data.len >= 4
			raw : u32 = field.data[0]
			race_id = record_form(plugin, npc, raw)
		elif field.kind == "HNAM" and field.data.len >= 4
			raw : u32 = field.data[0]
			hair_id = record_form(plugin, npc, raw)
		elif field.kind == "ENAM" and field.data.len >= 4
			raw : u32 = field.data[0]
			eyes_id = record_form(plugin, npc, raw)
		elif field.kind == "HCLR" and field.data.len >= 3
			hair_color = byte_color(field.data, 0)
		elif field.kind == "FGGS" and field.data.len >= 4 * FACE_SYMMETRIC
			for k in 0:FACE_SYMMETRIC {
				value : f32 = field.data[4 * k]
				look.face.symmetric[k] = value
			}
			look.has_face = true
		elif field.kind == "FGGA" and field.data.len >= 4 * FACE_ASYMMETRIC
			for k in 0:FACE_ASYMMETRIC {
				value : f32 = field.data[4 * k]
				look.face.asymmetric[k] = value
			}
		elif field.kind == "FGTS" and field.data.len >= 4 * FACE_TEXTURE
			for k in 0:FACE_TEXTURE {
				value : f32 = field.data[4 * k]
				look.face.texture[k] = value
			}
		elif field.kind == "CNTO" and field.data.len >= 4 and fits(carried.len + 1, carried.cap)
			raw : u32 = field.data[0]
			&carried + record_form(plugin, npc, raw)
		}
	}

	// What it wears: each clothing or armor it carries (leveled lists
	// taken at GEAR_LEVEL) whose slots aren't taken yet, in the order carried.
	taken : u32 = 0
	for item in carried {
		worn_id := level_item(plugin, item, npc_id, 0)
		if worn_id == 0 do continue
		worn_scratch : [64 * KB]byte
		worn, worn_error := find_record(plugin, worn_id, &worn_scratch)
		if worn_error or (worn.header.kind != "CLOT" and worn.header.kind != "ARMO") do continue
		slots_field, has_slots := find_field(worn.data, "BMDT")
		if not has_slots or slots_field.len < 2 do continue
		slots_word : u16 = slots_field[0]
		slots := u32(slots_word)
		if slots & taken != 0 do continue
		// A woman's model (MOD3), else the one model there is (MODL).
		model_field, has_model := find_field(worn.data, if look.female do "MOD3" else "MODL")
		if not has_model {
			male_field, has_male := find_field(worn.data, "MODL")
			if not has_male do continue
			model_field = male_field
		}
		taken |= slots
		add_npc_part(look, field_text(model_field), "", "")
	}

	// The race's body where nothing's worn, its head, and how tall.
	race_scratch : [256 * KB]byte
	race := find_record(plugin, race_id, &race_scratch)?
	head_meshes : [9!][128]utf8
	head_textures : [9!][128]utf8
	body_textures : [4!][128]utf8
	for k in 0:9 {
		head_meshes[k].len = 0
		head_textures[k].len = 0
	}
	for k in 0:4 do body_textures[k].len = 0
	tail_mesh : [128]utf8
	tail_texture : [128]utf8
	// Its parts' fields come in sections: NAM0 the head's, NAM1 the body's
	// (MNAM a man's, FNAM a woman's: a tail's mesh first, if it has one),
	// each part by its INDX (a tail's texture at 4).
	section : i64 = 0   // 1 head, 2 a man's body, 3 a woman's
	index : i64 = -1
	race_fields := Fields{data = race.data, at = 0, broken = false}
	for field in next_field(&race_fields) {
		kind := field.kind
		if kind == "NAM0" {
			section = 1
			index = -1
		elif kind == "NAM1"
			section = 2
			index = -1
		elif kind == "MNAM" and section >= 2
			section = 2
			index = -1
		elif kind == "FNAM" and section >= 2
			section = 3
			index = -1
		elif kind == "INDX" and field.data.len >= 4
			value : u32 = field.data[0]
			index = i64(value)
		elif kind == "MODL" and section == 1 and index >= 0 and index < 9
			&head_meshes[index] + field_text(field.data)
		elif kind == "ICON" and section == 1 and index >= 0 and index < 9
			&head_textures[index] + field_text(field.data)
		elif kind == "ICON" and index >= 0 and index < 4 and own_body_section(section, look.female)
			&body_textures[index] + field_text(field.data)
		elif kind == "ICON" and index == 4 and own_body_section(section, look.female)
			&tail_texture + field_text(field.data)
		elif kind == "MODL" and own_body_section(section, look.female)
			&tail_mesh + field_text(field.data)
		elif kind == "DATA" and field.data.len >= 24 and section == 0
			height : f32 = field.data[if look.female do 20 else 16]
			if height > 0 do look.height = height
		}
	}
	for k in 0:4 {
		slot : u32 = SLOT_UPPER_BODY << u32(k)
		if taken & slot != 0 do continue
		mesh := body_mesh(k, look.female)
		add_npc_part(look, mesh, body_textures[k], "")
	}
	if tail_mesh.len > 0 and taken & SLOT_TAIL == 0 do add_npc_part(look, tail_mesh, tail_texture, "")
	// The head's parts: the head, ears (a man's, a woman's), mouth, lower
	// and upper teeth, tongue, left and right eyes (drawn with its eyes').
	eyes_texture : [128]utf8
	if eyes_id != 0 {
		eyes_scratch : [16 * KB]byte
		eyes, eyes_error := find_record(plugin, eyes_id, &eyes_scratch)
		if not eyes_error {
			icon, has_icon := find_field(eyes.data, "ICON")
			if has_icon do &eyes_texture + field_text(icon)
		}
	}
	for k in 0:9 {
		if k == 1 and look.female do continue
		if k == 2 and not look.female do continue
		if head_meshes[k].len == 0 do continue
		texture := if k >= 7 and eyes_texture.len > 0 do eyes_texture else head_textures[k]
		add_npc_part(look, head_meshes[k], texture, HEAD_BONE)
		look.parts[look.parts.len - 1].face_index = k
	}
	// Its hair, unless something worn covers it.
	if hair_id != 0 and taken & SLOT_HAIR == 0 {
		hair_scratch : [16 * KB]byte
		hair, hair_error := find_record(plugin, hair_id, &hair_scratch)
		if not hair_error {
			hair_model, has_hair_model := find_field(hair.data, "MODL")
			hair_texture, has_hair_texture := find_field(hair.data, "ICON")
			if has_hair_model {
				add_npc_part(look, field_text(hair_model), if has_hair_texture do field_text(hair_texture) else "", HEAD_BONE)
				look.parts[look.parts.len - 1].tint = hair_color
			}
		}
	}
}

// Whether a race's body section (2 a man's, 3 a woman's) is the one for
// an NPC.
own_body_section :: fun(section: i64, female: bool) -> bool {
	return (section == 2 and not female) or (section == 3 and female)
}

// Adds a part to a look: its mesh and texture as the records name them
// (under meshes\ and textures\), the bone it hangs from.
add_npc_part :: fun(look: ^Npc_Look, mesh: []utf8, texture: []utf8, bone: []utf8) {
	if mesh.len == 0 or not fits(look.parts.len + 1, look.parts.cap) do return
	part := next(&look.parts)
	part.mesh.len = 0
	part.texture.len = 0
	part.bone.len = 0
	part.tint = Vec3{1, 1, 1}
	part.face_index = -1
	archive_path_under("meshes\\", mesh, &part.mesh)
	if texture.len > 0 do archive_path_under("textures\\", texture, &part.texture)
	&part.bone + bone
}

// A path as the records write it, as the archives have it: under a folder
// (unless it's there already), lower case, '\' between its parts.
archive_path_under :: fun(folder: []utf8, name: []utf8, path: ^[256]utf8) {
	path.len = 0
	if name.len == 0 do return
	cleaned : [256]utf8
	for c in name {
		if not fits(cleaned.len + 1, cleaned.cap) do break
		if c == '/' do &cleaned + '\\'
		else do &cleaned + lower(c)
	}
	if not starts_with(cleaned, folder) do path + folder
	for c in cleaned {
		if not fits(path.len + 1, path.cap) do break
		path + c
	}
}

// What an item an NPC carries comes to: itself, or for a leveled list
// (LVLI), one of its entries at GEAR_LEVEL — of those at the highest level
// it reaches, or of all it reaches (its flag 1), picked by a number from
// the NPC and the list (the same each time) — itself resolved; 0 for none.
level_item :: fun(plugin: ^Plugin, item: u32, npc_id: u32, depth: i64) -> u32 {
	if depth > 4 do return 0
	scratch : [64 * KB]byte
	record, record_error := find_record(plugin, item, &scratch)
	if record_error do return 0
	if record.header.kind != "LVLI" do return item
	flags : u8 = 0
	chance_none : u8 = 0
	best_level : i64 = -1
	count : i64 = 0
	fields := Fields{data = record.data, at = 0, broken = false}
	for field in next_field(&fields) {
		if field.kind == "LVLF" and field.data.len >= 1 do flags = field.data[0]
		if field.kind == "LVLD" and field.data.len >= 1 do chance_none = field.data[0]
	}
	every_level := flags & 1 != 0
	// The entries that count: their levels, then their number.
	fields = Fields{data = record.data, at = 0, broken = false}
	for field in next_field(&fields) {
		if field.kind != "LVLO" or field.data.len < 8 do continue
		level : i16 = field.data[0]
		if i64(level) > GEAR_LEVEL do continue
		if every_level {
			count += 1
		elif i64(level) > best_level
			best_level = i64(level)
			count = 1
		elif i64(level) == best_level
			count += 1
		}
	}
	if count == 0 do return 0
	pick := (u64(npc_id) *% 0x9E3779B97F4A7C15 + u64(item)) *% 0xBF58476D1CE4E5B9
	if i64((pick >> 33) % 100) < i64(chance_none) do return 0
	chosen := i64((pick >> 17) % u64(count))
	seen : i64 = 0
	fields = Fields{data = record.data, at = 0, broken = false}
	for field in next_field(&fields) {
		if field.kind != "LVLO" or field.data.len < 8 do continue
		level : i16 = field.data[0]
		if i64(level) > GEAR_LEVEL or (not every_level and i64(level) != best_level) do continue
		if seen == chosen {
			raw : u32 = field.data[4]
			return level_item(plugin, record_form(plugin, record, raw), npc_id, depth + 1)
		}
		seen += 1
	}
	return 0
}

// The pose of a skeleton (its path), as its idle animation starts: read
// the first time it's asked for, then kept. Empty when it can't be read.
// The skeleton at path (its index among the scene's kept ones): read the
// first time it's asked for, then kept. -1 when it can't be read.
npc_skeleton :: fun(scene: ^Scene, loader: Loader, path: []utf8) -> i64 {
	for &kept, k in scene.npc_skeletons {
		if kept.path == path do return k
	}
	if not fits(scene.npc_skeletons.len + 1, scene.npc_skeletons.cap) do return -1
	kept := next(&scene.npc_skeletons)
	kept.path.len = 0
	&kept.path + path
	skeleton_error := read_skeleton(loader.archives, loader.room, path, kept)
	if skeleton_error {
		note_failure(scene, path, skeleton_error)
		scene.npc_skeletons.len -= 1
		return -1
	}
	return scene.npc_skeletons.len - 1
}

// A skeleton (at path) and its idle animation (IDLE_ANIMATION), read into
// skeleton (see Npc_Skeleton): the idle's tracks and span first, then the
// skeleton's bones, posed as the idle starts and as a rig. (Their files
// go through room.)
read_skeleton :: fun(archives: ^Archives, room: ^Load_Room, path: []utf8, skeleton: ^Npc_Skeleton) -> err {
	skeleton.bones.len = 0
	skeleton.rig.len = 0
	skeleton.tracks.len = 0
	skeleton.track_room.len = 0
	skeleton.start = 0
	skeleton.stop = 0
	room.file.len = 0
	room.blocks.len = 0
	idle := read_archived_nif(archives, IDLE_ANIMATION, &room.file, &room.blocks)?
	for &block, index in idle.blocks {
		match block^ {
		Sequence sequence
			read_tracks(&idle, index, &skeleton.tracks, &skeleton.track_room, true)
			skeleton.start, skeleton.stop = sequence_span(&idle, index)
			break
		else
		}
	}
	room.file.len = 0
	room.blocks.len = 0
	mesh := read_archived_nif(archives, path, &room.file, &room.blocks)?
	pose_nodes(&mesh, &skeleton.tracks, skeleton.start, &skeleton.bones)
	rig_nodes(&mesh, &skeleton.tracks, &skeleton.rig)
}

// Poses each NPC as its idle has it at a time (seconds; each NPC's own
// time is put off by up to IDLE_SPREAD, by its reference): its palette
// made, into the renderer's, and the instance pointed at it.
pose_npcs :: fun(scene: ^Scene, renderer: ^Renderer, time: f32) {
	renderer.palette.len = 0
	places : [MAX_POSE_BONES]Mat4
	for &instance in scene.instances {
		instance.palette_base = -1
		rig_index, rigged := index_get(&scene.model_rigs, u64(instance.model + 1))
		if not rigged do continue
		rig := &scene.npc_rigs[rig_index - 1]
		if not fits(renderer.palette.len + rig.entry_count, renderer.palette.cap) do continue
		skeleton := &scene.npc_skeletons[rig.skeleton]
		// Where in its idle it is.
		span := skeleton.stop - skeleton.start
		own_time := time + f32((instance.reference *% 2654435761) >> 22) / 1024 * IDLE_SPREAD
		at := skeleton.start
		if span > 0 do at += own_time - floor_f32(own_time / span) * span
		pose_rig(skeleton.rig, &skeleton.tracks, at, &places)
		height := mat4_scale(Vec3{rig.height, rig.height, rig.height})
		instance.palette_base = renderer.palette.len
		for e in rig.first_entry : rig.first_entry + rig.entry_count {
			entry := &scene.rig_entries[e]
			moving := entry.offset
			if entry.bone >= 0 and entry.bone < places.len do moving = mat4_mul(places[entry.bone], entry.offset)
			&renderer.palette + mat4_mul(height, moving)
		}
	}
	upload_palette(renderer)
}

// A NIF from the archives, read: its file into file_storage, its blocks
// into nif_storage.
read_archived_nif :: fun(archives: ^Archives, path: []utf8, file_storage: ^[]byte, nif_storage: ^[]byte) -> Nif, err {
	found, in_archives := find_archived(archives, path)
	if not in_archives do return Nif{0}, Not_In_Archive
	data := read_archived(archives, found, file_storage)?
	failure := Nif_Failure{block = 0, type_name = file_storage[0:0]}
	return read_nif(data, nif_storage, &failure)
}

// The model of an NPC: put together the first time it's asked for (see the
// top), then kept; -1 when it can't be.
npc_model :: fun(scene: ^Scene, plugin: ^Plugin, loader: Loader, npc_id: u32) -> i64 {
	key := u64(npc_id) | NPC_MODEL_KEY
	known, found := index_get(&scene.paths, key)
	if found do return known - 1
	model_index, build_error := build_npc_model(scene, plugin, loader, npc_id)
	if build_error {
		note_failure(scene, "an NPC", build_error)
		model_index = -1
	}
	_ = index_put(&scene.paths, key, model_index + 1)
	return model_index
}

// Puts an NPC together (see the top) and on the card: its model's index.
build_npc_model :: fun(scene: ^Scene, plugin: ^Plugin, loader: Loader, npc_id: u32) -> i64, err {
	if scene.models.len == scene.models.cap do return -1, No_Room_For_Models
	look : Npc_Look
	read_npc_look(plugin, npc_id, &look)?
	skeleton := npc_skeleton(scene, loader, look.skeleton)
	if skeleton < 0 do return -1, No_Skeleton
	pose := scene.npc_skeletons[skeleton].bones[:]
	report := Npc_Report{failures = 0, first = [], reason = Not_In_Archive}
	skins : [4]Face_Skin
	skin_storage : [2 * MB]byte
	whole := assemble_npc(loader.archives, loader.room, &look, pose, true, &report, &skins, &skin_storage)
	if report.failures > 0 do note_failure(scene, report.first, report.reason)
	// Its faces' skins, on the card first: the model's parts are drawn with them.
	for &skin in skins do _ = texture_from_pixels(loader.renderer, skin.path, skin.pixels, skin.width, skin.height)
	gpu := upload_model(loader.renderer, &whole, loader.archives, &loader.room.texture)?
	// Its palette, kept: posed again each frame (pose_npcs).
	if scene.npc_rigs.len == scene.npc_rigs.cap or scene.rig_entries.len + whole.palette.len > scene.rig_entries.cap {
		return -1, No_Room_For_Models
	}
	&scene.npc_rigs + Npc_Rig{model = scene.models.len, skeleton = skeleton, height = look.height,
		first_entry = scene.rig_entries.len, entry_count = whole.palette.len}
	for entry in whole.palette do &scene.rig_entries + entry
	_ = index_put(&scene.model_rigs, u64(scene.models.len + 1), scene.npc_rigs.len)
	// (No collision: walking goes through people for now.)
	&scene.model_collision + Collision_Range{first = scene.collision_points.len, count = 0}
	&scene.models + gpu
	return scene.models.len - 1
}

// What couldn't go into an NPC's model: how many parts, the first's mesh
// and why.
Npc_Report :: struct {
	failures: i64
	first: [256]utf8
	reason: err
}

// An NPC's model, its parts posed and put together (see the top), made in
// room's model room (len set to 0 first). The parts that can't be made
// left out, into report.
// Its faces' skins go into skins (their pixels into skin_storage), named
// for the parts drawn with them: they're put on the card before the model.
// Rigged, its parts are made for the card to move (build_rigged_model),
// their palettes one, the model's; it's left as tall as the skeleton (the
// height goes into the palette).
assemble_npc :: fun(archives: ^Archives, room: ^Load_Room, look: ^Npc_Look, pose: []Pose_Bone, rigged: bool, report: ^Npc_Report,
	skins: ^[]Face_Skin, skin_storage: ^[]byte) -> Model
{
	room.model.len = 0
	// (The parts' list in the model's room, as their vertices are.)
	built := slice([:NPC_MODEL_PARTS]Model_Part, &room.model)
	palette := slice([:if rigged do NPC_PALETTE else 0]Palette_Entry, &room.model)
	low := Vec3{1000000, 1000000, 1000000}
	high := Vec3{-1000000, -1000000, -1000000}
	morph_file : [2 * MB]byte
	moves : [8192]Vec3
	skin_file : [32 * MB]byte   // (an .egt unpacked and packed: the human head's is 9.8 MB unpacked)
	skin_base : [2 * MB]byte
	skins.len = 0
	for &part, part_index in look.parts {
		// Its shape for this face: the morphs beside its mesh (.egm), if it
		// has them.
		moves.len = 0
		if look.has_face {
			morph_file.len = 0
			face_error := part_face_moves(archives, part.mesh, &look.face, &morph_file, &moves)
			if face_error do note_npc_failure(report, part.mesh, face_error)
		}
		room.file.len = 0
		room.blocks.len = 0
		mesh, mesh_error := read_archived_nif(archives, part.mesh, &room.file, &room.blocks)
		if mesh_error {
			note_npc_failure(report, part.mesh, mesh_error)
			continue
		}
		// Hung from its bone, unless it's skinned (then its bones place it).
		hang := mat4_identity()
		hang_bone : i64 = -1
		if not skinned_mesh(&mesh) {
			bone := part.bone[:]
			parent := hanging_bone(&mesh)
			if parent.len > 0 do bone = parent
			if bone.len > 0 {
				place, posed := pose_place(pose, bone)
				if compare_folded(bone, HEAD_BONE) == 0 do place, posed = head_hang(&mesh, pose)
				if posed do hang = place
				hang_bone = pose_index(pose, bone)
			}
		}
		// (Rigged, it hangs from its bone from where it is now: the bone's
		// place undone.)
		hang_offset := hang
		if hang_bone >= 0 do hang_offset = mat4_mul(mat4_inverse(pose[hang_bone].place), hang)
		made : Model
		model_error : err
		if rigged {
			made, model_error = build_rigged_model(&mesh, pose, moves, hang_bone, hang_offset, &room.model)
		else
			made, model_error = build_shaped_model(&mesh, pose, hang, moves, &room.model)
		}
		if model_error {
			note_npc_failure(report, part.mesh, model_error)
			continue
		}
		// Its palette into the model's, its parts' influences counted on.
		palette_base := palette.len
		if rigged and palette.len + made.palette.len > palette.cap {
			note_npc_failure(report, part.mesh, Too_Many_Parts)
			continue
		}
		for entry in made.palette do &palette + entry
		for &made_part, made_index in made.parts {
			if not fits(built.len + 1, built.cap) do break
			for &influence in made_part.influences {
				for k in 0:4 do influence.entries[k] += u16(palette_base)
			}
			if part.texture.len > 0 {
				made_part.texture.len = 0
				add_what_fits(&made_part.texture, part.texture)
			}
			// Its skin for this face (its colors moved by the .egt beside
			// its mesh, if it has one): drawn with that instead.
			if look.has_face and made_index == 0 and fits(skins.len + 1, skins.cap) {
				taken_at := skin_storage.len
				pixels := slice([:4 * MOST_SKIN_TEXELS]byte, skin_storage)
				map_path : [160]utf8
				if part.face_index >= 0 and look.face_maps.len > 0 {
					&map_path + look.face_maps
					&map_path + int_text(part.face_index)
					&map_path + ".dds"
				}
				width, height, skin_error := part_face_skin(archives, part.mesh, made_part.texture, map_path, &look.face, &skin_file,
					&skin_base, &pixels)
				if skin_error do note_npc_failure(report, part.mesh, skin_error)
				// (Parts without one give their room back.)
				if width == 0 do skin_storage.len = taken_at
				if width > 0 {
					skin := next(skins)
					skin.path.len = 0
					&skin.path + "facegen\\"
					&skin.path + int_text(i64(look.npc_id))
					&skin.path + "\\"
					&skin.path + int_text(part_index)
					skin.pixels = pixels
					skin.width = width
					skin.height = height
					made_part.texture.len = 0
					&made_part.texture + skin.path
				}
			}
			if part.tint.x != 1 or part.tint.y != 1 or part.tint.z != 1 {
				for &vertex in made_part.vertices do vertex.color = hair_tinted(vertex.color, part.tint)
			}
			&built + made_part^
		}
		for axis in 0:3 {
			low[axis] = min(low[axis], made.bounds_min[axis])
			high[axis] = max(high[axis], made.bounds_max[axis])
		}
	}
	// As tall as its race is. (Rigged, the palette makes it so.)
	if look.height != 1 and rigged {
		low = low * look.height
		high = high * look.height
	elif look.height != 1
		for &made_part in built {
			for &vertex in made_part.vertices do vertex.position = vertex.position * look.height
		}
		low = low * look.height
		high = high * look.height
	}
	return Model{parts = built, flips = [], particles = [], motions = [], bounds_min = low, bounds_max = high, palette = palette}
}

// How far a part's vertices move for a face, into moves: by its morphs,
// the .egm beside its mesh (read into file_storage). None when it has none.
part_face_moves :: fun(archives: ^Archives, mesh_path: []utf8, face: ^Face_Values, file_storage: ^[]byte, moves: ^[]Vec3) -> err {
	moves.len = 0
	if mesh_path.len < 4 do return
	morph_path : [256]utf8
	&morph_path + mesh_path[0 : mesh_path.len - 4]
	&morph_path + ".egm"
	found, has_morphs := find_archived(archives, morph_path)
	if not has_morphs do return
	data := read_archived(archives, found, file_storage)?
	morphs := read_shape_morphs(data)?
	face_moves(&morphs, face, moves)
}

// A part's skin for a face (facegen.mara): its texture (base_path) moved by
// its face map, the game's made one (map_path) or else one made from the
// morphs beside its mesh (its .egt). Into pixels: how many columns and
// rows; none (0) when it has neither. (The files and the texture's pixels
// go through file_storage and base_storage.)
part_face_skin :: fun(archives: ^Archives, mesh_path: []utf8, base_path: []utf8, map_path: []utf8, face: ^Face_Values,
	file_storage: ^[]byte, base_storage: ^[]byte, pixels: ^[]byte) -> i64, i64, err
{
	if mesh_path.len < 4 or base_path.len == 0 do return 0, 0
	map : [4 * MOST_SKIN_TEXELS]byte
	map_width : i64 = 0
	map_height : i64 = 0
	made, has_made := find_archived(archives, map_path)
	if map_path.len > 0 and has_made {
		file_storage.len = 0
		made_file := read_archived(archives, made, file_storage)?
		made_texture := read_texture(made_file)?
		if made_texture.mips[0].width * made_texture.mips[0].height <= MOST_SKIN_TEXELS {
			decode_rgba(made_texture, 0, &map)?
			map_width = made_texture.mips[0].width
			map_height = made_texture.mips[0].height
		}
	}
	if map_width == 0 {
		morph_path : [256]utf8
		&morph_path + mesh_path[0 : mesh_path.len - 4]
		&morph_path + ".egt"
		found, has_morphs := find_archived(archives, morph_path)
		if not has_morphs do return 0, 0
		file_storage.len = 0
		data := read_archived(archives, found, file_storage)?
		morphs := read_texture_morphs(data)?
		face_map(&morphs, face, &map)
		map_width = morphs.columns
		map_height = morphs.rows
		if map.len == 0 do return 0, 0
	}
	texture := read_archive_texture(archives, base_path, file_storage)?
	base_storage.len = 0
	base := decode_rgba(texture, 0, base_storage)?
	skin_from_map(base, texture.mips[0].width, texture.mips[0].height, map, map_width, map_height, pixels)
	if pixels.len == 0 do return 0, 0
	return map_width, map_height
}

// A form id's eight hex digits (lower case), after what's in text.
add_hex :: fun(text: ^[128]utf8, value: u32) {
	digits := "0123456789abcdef"
	for k in 0:8 do text + digits[i64((value >> u32(28 - 4 * k)) & 15)]
}

// A hair vertex's color for a hair color (tint), as the game's hair
// shaders make it (HAIR2000.pso): a hair mesh's vertex colors aren't its
// colors, its green says how much the hair color shows there; the texture
// is then times 1 + green x (2 x tint - 1), so 0.5 (128) leaves it as it
// is. Its alpha stays.
hair_tinted :: fun(color: [4!]f32, tint: Vec3) -> [4!]f32 {
	shows := color[1]
	return [1 + shows * (2 * tint.x - 1), 1 + shows * (2 * tint.y - 1), 1 + shows * (2 * tint.z - 1), color[3]]
}

note_npc_failure :: fun(report: ^Npc_Report, path: []utf8, reason: err) {
	report.failures += 1
	if report.failures == 1 {
		report.first.len = 0
		&report.first + path
		report.reason = reason
	}
}

// Where a part hung from the head goes: in the head's space (FaceGen's:
// the model's axes at the head bone, hang_place), by its shapes' own
// coordinates — its root node's transform undone. Some files turn their
// root to sit under the head bone itself (the mouth, teeth and tongue; a
// Khajiit's ears: a quarter turn, the bone's at rest, backward); their
// vertices are the head's space's all the same, as their .tri (FaceGen's
// copy of them) has them.
head_hang :: fun(mesh: ^Nif, pose: []Pose_Bone) -> Mat4, bool {
	place, posed := hang_place(pose, HEAD_BONE)
	if not posed or mesh.roots.count == 0 do return place, posed
	root_object := mesh.roots.at(0)
	if root_object < 0 do return place, posed
	match mesh.blocks[root_object] {
	Node node
		return mat4_mul(place, mat4_inverse(local_transform(node.object))), true
	else
	}
	return place, posed
}

// Whether a NIF has a skinned shape.
skinned_mesh :: fun(mesh: ^Nif) -> bool {
	for &block in mesh.blocks {
		match block^ {
		Shape shape
			if shape.skin >= 0 do return true
		else
		}
	}
	return false
}

// The bone a NIF says it hangs from (its Prn string), or empty.
hanging_bone :: fun(mesh: ^Nif) -> []utf8 {
	for &block in mesh.blocks {
		match block^ {
		String_Extra extra
			if compare_folded(extra.name, "Prn") == 0 do return extra.value
		else
		}
	}
	return mesh.header.type_names[0][0:0]
}
