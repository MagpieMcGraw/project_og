// Pictures drawn flat on the window: each a rectangle in pixels from the
// window's top left, showing a texture or part of it, tinted, blended by
// its opacity. Put each frame (layer_image), then drawn in the order put
// (layer_draw): what's put later is drawn over. Pictures one after another
// with the same texture are drawn together.
//
// Shared by the og ports; it began as sooblivion's 2D layer (render.mara's
// ui_begin, ui_image, draw_ui) with no Renderer round it.
module sprite_layer

use mara.core
use mara.memory
use mara.open_gl
use logging

// Corners a frame at most (six a picture), and runs of one texture.
SPRITE_VERTICES :: 24576
SPRITE_RUNS :: 1024

SPRITE_VERTEX_SHADER :: "
layout(location = 0) in vec2 position;
layout(location = 1) in vec2 uv;
layout(location = 2) in vec4 color;
uniform vec2 screen_size;
out vec2 texture_uv;
out vec4 tint;
void main() {
	gl_Position = vec4(position.x / screen_size.x * 2.0 - 1.0, 1.0 - position.y / screen_size.y * 2.0, 0.0, 1.0);
	texture_uv = uv;
	tint = color;
}
"

SPRITE_FRAGMENT_SHADER :: "
in vec2 texture_uv;
in vec4 tint;
uniform sampler2D image;
out vec4 fragment_color;
void main() {
	fragment_color = texture(image, texture_uv) * tint;
}
"

Sprite_Layer_Error :: error {
	Shader_Failed
}

// A corner of a picture: where (pixels from the window's top left), where
// in its texture, its tint (red, green, blue, opacity).
Sprite_Vertex :: struct {
	position: [2!]f32
	uv: [2!]f32
	color: [4!]f32
}

// A run of the layer's corners drawn with one texture.
Sprite_Run :: struct {
	texture: u32
	first: i64
	count: i64
}

Sprite_Layer :: struct {
	program: u32
	screen_size_at: i32
	vertex_array: u32
	vertex_buffer: u32
	vertices: [SPRITE_VERTICES]Sprite_Vertex
	runs: [SPRITE_RUNS]Sprite_Run
}

// The layer made ready to draw with: its shaders, its buffer on the card.
// (A GL context must be current: sdl_platform's platform_open.)
layer_open :: fun(layer: ^Sprite_Layer) -> err {
	source : [4 * KB]utf8
	shader_text(SPRITE_VERTEX_SHADER, &source)
	vertex_shader := gl_compile_shader(VERTEX_SHADER, source)
	shader_text(SPRITE_FRAGMENT_SHADER, &source)
	fragment_shader := gl_compile_shader(FRAGMENT_SHADER, source)
	if vertex_shader == 0 or fragment_shader == 0 do return Shader_Failed
	layer.program = gl_link_program(vertex_shader, fragment_shader)
	if layer.program == 0 do return Shader_Failed
	layer.screen_size_at = GetUniformLocation(layer.program, "screen_size")
	UseProgram(layer.program)
	Uniform1i(GetUniformLocation(layer.program, "image"), 0)
	UseProgram(0)

	GenVertexArrays(1, &layer.vertex_array)
	BindVertexArray(layer.vertex_array)
	GenBuffers(1, &layer.vertex_buffer)
	BindBuffer(ARRAY_BUFFER, layer.vertex_buffer)
	BufferData(ARRAY_BUFFER, SPRITE_VERTICES * size_of(Sprite_Vertex), [], STREAM_DRAW)
	stride := i32(size_of(Sprite_Vertex))
	EnableVertexAttribArray(0)
	VertexAttribPointer(0, 2, FLOAT, 0, stride, 0)    // position
	EnableVertexAttribArray(1)
	VertexAttribPointer(1, 2, FLOAT, 0, stride, 8)    // uv
	EnableVertexAttribArray(2)
	VertexAttribPointer(2, 4, FLOAT, 0, stride, 16)   // color
	BindVertexArray(0)
	layer.vertices.len = 0
	layer.runs.len = 0
}

// A shader's text as GL takes it: the version first, a 0 after it in its
// room (gl_compile_shader hands it to C).
shader_text :: fun(body: []utf8, source: ^[]utf8) {
	source.len = 0
	source + "#version 450 core\n"
	source + body
	source + utf8(0)
	source.len -= 1
}

// Nothing put yet: a frame's pictures start.
layer_begin :: fun(layer: ^Sprite_Layer) {
	layer.vertices.len = 0
	layer.runs.len = 0
}

// Puts a picture on the layer: the part of a texture from u0, v0 to u1, v1
// (0 to 1 across it) in a rectangle (pixels from the window's top left),
// tinted (red, green, blue, opacity; 1 each to leave it be).
layer_image :: fun(layer: ^Sprite_Layer, texture: u32, x: f32, y: f32, width: f32, height: f32, u0: f32, v0: f32, u1: f32, v1: f32,
	color: [4!]f32)
{
	if not fits(layer.vertices.len + 6, layer.vertices.cap) do return
	runs := &layer.runs
	if runs.len == 0 or runs[runs.len - 1].texture != texture {
		if not fits(runs.len + 1, runs.cap) do return
		runs + Sprite_Run{texture = texture, first = layer.vertices.len, count = 0}
	}
	top_left := Sprite_Vertex{position = [x, y], uv = [u0, v0], color = color}
	top_right := Sprite_Vertex{position = [x + width, y], uv = [u1, v0], color = color}
	bottom_right := Sprite_Vertex{position = [x + width, y + height], uv = [u1, v1], color = color}
	bottom_left := Sprite_Vertex{position = [x, y + height], uv = [u0, v1], color = color}
	&layer.vertices + top_left
	&layer.vertices + top_right
	&layer.vertices + bottom_right
	&layer.vertices + top_left
	&layer.vertices + bottom_right
	&layer.vertices + bottom_left
	runs[runs.len - 1].count += 6
}

// Draws what's been put over what's drawn, in the order it was put,
// blended by its opacity, on a window width by height pixels.
layer_draw :: fun(layer: ^Sprite_Layer, width: i64, height: i64) {
	if layer.vertices.len == 0 do return
	UseProgram(layer.program)
	Uniform2f(layer.screen_size_at, f32(width), f32(height))
	BindVertexArray(layer.vertex_array)
	BindBuffer(ARRAY_BUFFER, layer.vertex_buffer)
	BufferData(ARRAY_BUFFER, SPRITE_VERTICES * size_of(Sprite_Vertex), [], STREAM_DRAW)   // (a fresh buffer: no waiting on last frame's)
	BufferSubData(ARRAY_BUFFER, 0, layer.vertices)
	Disable(DEPTH_TEST)
	Disable(CULL_FACE)
	Enable(BLEND)
	BlendFunc(SRC_ALPHA, ONE_MINUS_SRC_ALPHA)
	ActiveTexture(TEXTURE0)
	for run in layer.runs {
		BindTexture(TEXTURE_2D, run.texture)
		DrawArrays(TRIANGLES, i32(run.first), i32(run.count))
	}
	Disable(BLEND)
	BindVertexArray(0)
	UseProgram(0)
}

// A texture made on the card from pixels (red, green, blue, alpha bytes,
// rows from the top), width by height: its name. Sharp (each texel a
// square, as pixel art wants), or smooth; its edges clamped either way.
texture_from_pixels :: fun(pixels: []byte, width: i64, height: i64, smooth: bool = false) -> u32 {
	id : u32 = 0
	GenTextures(1, &id)
	BindTexture(TEXTURE_2D, id)
	TexImage2D(TEXTURE_2D, 0, i32(RGBA8), i32(width), i32(height), 0, RGBA, UNSIGNED_BYTE, pixels)
	sampling := if smooth do LINEAR else NEAREST
	TexParameteri(TEXTURE_2D, TEXTURE_MIN_FILTER, i32(sampling))
	TexParameteri(TEXTURE_2D, TEXTURE_MAG_FILTER, i32(sampling))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_S, i32(CLAMP_TO_EDGE))
	TexParameteri(TEXTURE_2D, TEXTURE_WRAP_T, i32(CLAMP_TO_EDGE))
	BindTexture(TEXTURE_2D, 0)
	return id
}
