// The HUD: the game's menus\main\hud_main_menu.xml, hud_reticle.xml and
// hud_info_menu.xml read into the menu book (menus.mara) and drawn as they
// lay it out, with what the game would set in them: the player's health,
// magicka and fatigue, their weapon's icon, the camera's heading, what the
// reticle is on and what using it would do. And the game's fonts (Data\Fonts
// in the Misc archive: a .fnt of glyphs, a .tex picture) the menus write in.
module sooblivion

use mara.core
use mara.math
use mara.memory
use mara.os
use bsa
use logging
render :: use render

// How high the screen is in the menus' units, and the margin the menus
// keep inside it (Oblivion.ini's iSafeZoneXWide and iSafeZoneYWide).
MENU_HEIGHT :: 960
SAFE_X :: 20
SAFE_Y :: 20
// The activate icons (all_small_activate_icons.dds, 34 apart on PC, as
// hudreticle_reticle's user5 numbers them): the hand that takes, the face
// that talks, the door.
ICON_TAKE :: 1
ICON_TALK :: 7
ICON_DOOR :: 8
// The game's fonts (Oblivion.ini's SFontFile_1 to _5): the files' names
// in the Misc archive's fonts folder, without .fnt.
FONT_FILES :: 5

// A glyph of a font: where in its picture (the corners' u and v), how big
// (in the font's pixels: the menus' units), the room before and after it,
// and how far its top is above the line's baseline.
Glyph :: struct {
	u0: f32
	v0: f32
	u1: f32
	v1: f32
	width: f32
	height: f32
	before: f32
	after: f32
	above: f32
}

// A font: its picture (a texture slot), a line's height, its glyphs by
// byte, and how far above the baseline its tallest reaches.
Font :: struct {
	texture: i64
	line_height: f32
	ascent: f32
	glyphs: [256!]Glyph
}

// The HUD: its menus in the book (their roots: the main one, the info
// one, the reticle; ready once read) and what it shows: the player's
// health, magicka and fatigue (shares, 0 to 1), their weapon's icon (its
// ICON, under textures\menus\icons\; empty: the HUD's own), the name of
// what the reticle is on (empty for nothing; named: whose) and what using
// it would do (ICON_*; 0 for nothing usable).
Hud :: struct {
	ready: bool
	main_menu: i64
	info_menu: i64
	reticle_menu: i64
	health: f32
	magicka: f32
	fatigue: f32
	weapon_icon: [160]utf8
	name: str256
	named: u32
	activate: i64
}

// A font's file's name (1 to 5, as the menus number them).
font_file :: fun(number: i64) -> str64 {
	if number == 2 do return "kingthings_shadowed"
	if number == 3 do return "tahoma_bold_small"
	if number == 4 do return "daedric_font"
	if number == 5 do return "handwritten"
	return "kingthings_regular"
}

// Reads the HUD's menus into the book (opened). Full ribbons, nothing
// aimed at.
load_hud :: fun(hud: ^Hud, book: ^Menu_Book, archives: ^Archives, weapon_icon: []utf8, scratch: ^[]byte) -> err {
	hud.ready = false
	hud.main_menu = book_read(book, archives, "menus\\main\\hud_main_menu.xml", scratch)?
	hud.info_menu = book_read(book, archives, "menus\\main\\hud_info_menu.xml", scratch)?
	hud.reticle_menu = book_read(book, archives, "menus\\main\\hud_reticle.xml", scratch)?
	hud.health = 1
	hud.magicka = 1
	hud.fatigue = 1
	hud.weapon_icon.len = 0
	add_what_fits(&hud.weapon_icon, weapon_icon)
	hud.name.len = 0
	hud.named = 0
	hud.activate = 0
	hud.ready = true
}

// Puts the HUD on the 2D layer for a screen width by height pixels, the
// camera turned yaw (radians, from north, clockwise), exploring or in a
// menu (no reticle then): what the game sets in its menus set, then the
// menus drawn.
draw_hud :: fun(hud: ^Hud, book: ^Menu_Book, renderer: ^render.Renderer, archives: ^Archives, width: i64, height: i64, yaw: f32,
	exploring: bool)
{
	if not hud.ready do return
	book_frame(book)
	_ = book_set(book, "HUDMainMenu", "user3", if exploring do 1 else 0)
	_ = book_set(book, "hudmain_health_full", "user0", hud.health)
	_ = book_set(book, "hudmain_magic_full", "user0", hud.magicka)
	_ = book_set(book, "hudmain_fatigue_full", "user0", hud.fatigue)
	if hud.weapon_icon.len > 0 {
		icon : [192]utf8
		&icon + "Menus\\Icons\\"
		add_what_fits(&icon, hud.weapon_icon)
		_ = book_set_text(book, "hudmain_Weapon_Icon", "filename", icon)
	}
	_ = book_set(book, "hudmain_Weapon_Icon", "user2", 100)   // its condition: whole
	degrees := yaw * 180 / PI
	degrees -= floor_f32(degrees / 360) * 360
	_ = book_set(book, "hudmain_compass_window", "user0", degrees)
	_ = book_set(book, "HUDReticle", "visible", if exploring do MENU_TRUE else MENU_FALSE)
	_ = book_set(book, "hudreticle_reticle", "user5", f32(hud.activate))
	_ = book_set(book, "HUDInfoMenu", "visible", if exploring and hud.name.len > 0 do MENU_TRUE else MENU_FALSE)
	_ = book_set_text(book, "hudinfo_name", "string", hud.name)
	draw_menu(book, hud.main_menu, renderer, archives, width, height)
	draw_menu(book, hud.info_menu, renderer, archives, width, height)
	draw_menu(book, hud.reticle_menu, renderer, archives, width, height)
}

// A font read from the Misc archive's fonts folder (name: its files'
// name): its glyphs from name.fnt (a header of 296 bytes, its line's
// height first; then 256 glyphs of 14 numbers: the texture, the four
// corners' u and v, width, height, the room before and after, how far
// above the baseline), its picture from name_0_lod_a.tex (its width and
// height, then red, green, blue and alpha for each pixel), put on the card.
load_font :: fun(font: ^Font, renderer: ^render.Renderer, archives: ^Archives, name: []utf8, scratch: ^[]byte) -> err {
	glyphs_path : [96]utf8
	&glyphs_path + "fonts\\"
	&glyphs_path + name
	&glyphs_path + ".fnt"
	glyphs_file, has_glyphs := find_archived(archives, glyphs_path)
	if not has_glyphs do return File_Error.Open_Failed
	scratch.len = 0
	data := read_archived(archives, glyphs_file, scratch)?
	if data.len < 296 + 256 * 56 do return File_Error.Read_Failed
	line_height : f32 = data[0]
	font.line_height = line_height
	font.ascent = 0
	for k in 0:256 {
		at := 296 + k * 56
		glyph := &font.glyphs[k]
		glyph.u0 = data[at + 4]
		glyph.v0 = data[at + 8]
		glyph.u1 = data[at + 28]
		glyph.v1 = data[at + 32]
		glyph.width = data[at + 36]
		glyph.height = data[at + 40]
		glyph.before = data[at + 44]
		glyph.after = data[at + 48]
		glyph.above = data[at + 52]
		font.ascent = max(font.ascent, glyph.above)
	}
	picture_path : [96]utf8
	&picture_path + "fonts\\"
	&picture_path + name
	&picture_path + "_0_lod_a.tex"
	picture_file, has_picture := find_archived(archives, picture_path)
	if not has_picture do return File_Error.Open_Failed
	scratch.len = 0
	picture := read_archived(archives, picture_file, scratch)?
	if picture.len < 8 do return File_Error.Read_Failed
	width : u32 = picture[0]
	height : u32 = picture[4]
	if picture.len < 8 + i64(width) * i64(height) * 4 do return File_Error.Read_Failed
	font.texture = render.texture_from_pixels(renderer, picture_path, picture[8 : picture.len], i64(width), i64(height))
}

// How wide a line of text is in a font (the menus' units).
text_width :: fun(font: ^Font, text: []utf8) -> f32 {
	width : f32 = 0
	for c in text {
		glyph := &font.glyphs[i64(c)]
		width += glyph.before + glyph.width + glyph.after
	}
	return width
}

// Puts a line of text on the 2D layer, in a font, its top left at x, y
// (pixels), its glyphs scale pixels to a unit, tinted color.
draw_text :: fun(renderer: ^render.Renderer, font: ^Font, text: []utf8, x: f32, y: f32, scale: f32, color: [4!]f32) {
	pen := x
	baseline := y + font.ascent * scale
	for c in text {
		glyph := &font.glyphs[i64(c)]
		if glyph.width > 0 and glyph.height > 0 {
			render.ui_image(renderer, font.texture, pen + glyph.before * scale, baseline - glyph.above * scale,
				glyph.width * scale, glyph.height * scale, glyph.u0, glyph.v0, glyph.u1, glyph.v1, color)
		}
		pen += (glyph.before + glyph.width + glyph.after) * scale
	}
}
