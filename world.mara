// The game's world as a plugin describes it: records found by their form
// ids, cells found by their editor ids, and the objects placed in them.
//
// Cells hold references (REFR): a base object (a STAT, DOOR, LIGH…, whose
// record names its mesh) placed somewhere, turned and scaled. A cell's
// references are in the group right after its record.
module world

use mara.core
use mara.math
use mara.string
use esm

// What finding things in the world can fail with.
World_Error :: error {
	No_Such_Cell
	No_Such_Record
	Index_Full
}

// ---- finding records ---------------------------------------------------------

// A table from keys — form ids, or a world and a cell's place in it
// (grid_key) — to values: where a record is, or another form id. A power of
// two in size, kept under half full; a key is looked for from its hash's
// slot onward.
Key_Index :: struct {
	keys: []u64       // 0 in an empty slot
	values: []u32
	count: i64
}

// An empty index with room for capacity entries (a power of two).
key_index :: fun(capacity: i64, storage: ^[]byte) -> Key_Index {
	keys := slice([:capacity]u64, storage)
	values := slice([:capacity]u32, storage)
	for i in 0:capacity {
		&keys + u64(0)
		&values + u32(0)
	}
	return Key_Index{keys = keys, values = values, count = 0}
}

// The slot a key's search starts at.
first_slot :: fun(index: ^Key_Index, key: u64) -> i64 {
	mixed := (key *% 0x9E3779B97F4A7C15) >> 32
	return i64(mixed) & (index.keys.len - 1)
}

index_put :: fun(index: ^Key_Index, key: u64, value: i64) -> err {
	if (index.count + 1) * 2 > index.keys.len do return Index_Full
	slot := first_slot(index, key)
	for index.keys[slot] != 0 and index.keys[slot] != key {
		slot = (slot + 1) & (index.keys.len - 1)
	}
	if index.keys[slot] == 0 do index.count += 1
	index.keys[slot] = key
	index.values[slot] = u32(value)
}

// The key's value, and false when the index doesn't have it.
index_get :: fun(index: ^Key_Index, key: u64) -> i64, bool {
	if key == 0 do return 0, false
	slot := first_slot(index, key)
	for index.keys[slot] != 0 {
		if index.keys[slot] == key do return i64(index.values[slot]), true
		slot = (slot + 1) & (index.keys.len - 1)
	}
	return 0, false
}

// The key of an exterior cell: its world, and its place on the world's
// grid (cells 4096 units square, 0 0 the one north-east of the origin).
grid_key :: fun(world: u32, x: i64, y: i64) -> u64 {
	return (u64(world) << 32) | (u64(x & 0xFFFF) << 16) | u64(y & 0xFFFF)
}

// ---- a plugin, indexed ------------------------------------------------------

// A plugin read into memory, with where its records and cells are.
Plugin :: struct {
	data: []byte
	records: Key_Index           // each record's place, by its form id
	cell_children: Key_Index     // each cell's group of references' place, by the cell's form id
	exterior_cells: Key_Index    // each exterior cell's form id, by grid_key
	cell_worlds: Key_Index       // each exterior cell's world, by the cell's form id
	persistent_cells: Key_Index  // each world's cell for its persistent references, by the world
	interior_cells_at: i64       // the top group of interior cells
	interior_cells_end: i64
}

// Indexes a plugin's data: one walk over every group and record. The
// indexes are carved from storage.
index_plugin :: fun(data: []byte, storage: ^[]byte) -> Plugin, err {
	plugin := Plugin{
		data = data,
		records = key_index(1 << 22, storage),
		cell_children = key_index(1 << 17, storage),
		exterior_cells = key_index(1 << 17, storage),
		cell_worlds = key_index(1 << 17, storage),
		persistent_cells = key_index(1 << 10, storage),
		interior_cells_at = 0,
		interior_cells_end = 0}
	// The world whose group the walk is in, where that group ends, and
	// whether its blocks of cells have begun: the cell before them is the
	// world's persistent one.
	world : u32 = 0
	world_end : i64 = 0
	in_blocks := false
	at : i64 = 0
	for at < data.len {
		if at + HEADER_SIZE > data.len do return plugin, Truncated
		if world != 0 and at >= world_end do world = 0
		header : Record_Header = data[at]
		if header.kind[:] == "GRUP" {
			group_header : Group_Header = data[at]
			if group_header.group_type == GROUP_CELL_CHILDREN {
				index_put(&plugin.cell_children, u64(group_header.label), at)?
			}
			if group_header.group_type == GROUP_WORLD_CHILDREN {
				world = group_header.label
				world_end = at + i64(group_header.size)
				in_blocks = false
			}
			if group_header.group_type == GROUP_EXTERIOR_BLOCK do in_blocks = true
			if group_header.group_type == GROUP_TOP {
				label : [4!]utf8 = data[at + 8]
				if label[:] == "CELL" {
					plugin.interior_cells_at = at + HEADER_SIZE
					plugin.interior_cells_end = at + i64(group_header.size)
				}
			}
			at += HEADER_SIZE
			continue
		}
		next_at := at + HEADER_SIZE + i64(header.size)
		if header.form_id != 0 do index_put(&plugin.records, u64(header.form_id), at)?
		if world != 0 and header.kind[:] == "CELL" {
			index_put(&plugin.cell_worlds, u64(header.form_id), i64(world))?
			body := data[at + HEADER_SIZE : next_at]
			grid, has_grid := find_field(body, "XCLC")
			if not in_blocks {
				index_put(&plugin.persistent_cells, u64(world), i64(header.form_id))?
			elif has_grid and grid.len >= 8
				x : i32 = grid[0]
				y : i32 = grid[4]
				index_put(&plugin.exterior_cells, grid_key(world, i64(x), i64(y)), i64(header.form_id))?
			}
		}
		at = next_at
	}
	return plugin
}

// A record: its header and its data, unpacked into scratch when packed.
Record :: struct {
	header: Record_Header
	data: []byte
}

// The record at a place in the plugin's data.
record_at :: fun(plugin: ^Plugin, at: i64, scratch: ^[]byte) -> Record, err {
	header : Record_Header = plugin.data[at]
	body := plugin.data[at + HEADER_SIZE : at + HEADER_SIZE + i64(header.size)]
	data := record_data(header, body, scratch)?
	return Record{header = header, data = data}
}

// The record with a form id.
find_record :: fun(plugin: ^Plugin, form_id: u32, scratch: ^[]byte) -> Record, err {
	at, found := index_get(&plugin.records, u64(form_id))
	if not found do return Record{header = Record_Header{0}, data = plugin.data[0:0]}, No_Such_Record
	return record_at(plugin, at, scratch)
}

// A record's first field of a kind, and false when it has none.
find_field :: fun(data: []byte, kind: []utf8) -> []byte, bool {
	fields := Fields{data = data, at = 0, broken = false}
	for field in next_field(&fields) {
		// The same bytes as field.data, but sliced from data itself: Mara
		// counts field.data as a view of the local `fields`, which can't
		// be returned.
		if field.kind[:] == kind do return data[fields.at - field.data.len : fields.at], true
	}
	return data[0:0], false
}

// A field's text: up to its 0 (the plugins end their text with one).
field_text :: fun(field: []byte) -> []utf8 {
	text : []utf8 = field
	for c, i in text {
		if c == utf8(0) do return text[0 : i]
	}
	return text
}

// A record's editor id (EDID), or empty.
editor_id :: fun(data: []byte) -> []utf8 {
	field, found := find_field(data, "EDID")
	if not found do return field_text(data[0:0])
	return field_text(field)
}

// ---- cells and what's in them ------------------------------------------------

// The interior cell whose editor id is name (any letter case): its form id.
find_interior_cell :: fun(plugin: ^Plugin, name: []utf8, scratch: ^[]byte) -> u32, err {
	at := plugin.interior_cells_at
	for at < plugin.interior_cells_end {
		header : Record_Header = plugin.data[at]
		if header.kind[:] == "GRUP" {
			at += HEADER_SIZE
			continue
		}
		if header.kind[:] == "CELL" {
			record := record_at(plugin, at, scratch)?
			if compare_folded(editor_id(record.data), name) == 0 do return header.form_id
		}
		at += HEADER_SIZE + i64(header.size)
	}
	return 0, No_Such_Cell
}

// An object placed in a cell: what it is, where, turned how, how big.
Reference :: struct {
	form_id: u32
	base: u32          // the record of what's placed: a STAT, DOOR, LIGH…
	position: Vec3
	rotation: Vec3     // radians about x, y and z, each clockwise; turned about z first, x last
	scale: f32
	flags: u32         // RECORD_*: disabled, persistent…
}

// The references in a cell (REFR records; actors aren't yet), into
// references.
cell_references :: fun(plugin: ^Plugin, cell: u32, references: ^[]Reference) -> err {
	group_at, found := index_get(&plugin.cell_children, u64(cell))
	if not found do return
	group_header : Group_Header = plugin.data[group_at]
	end := group_at + i64(group_header.size)
	at := group_at + HEADER_SIZE
	for at < end {
		header : Record_Header = plugin.data[at]
		if header.kind[:] == "GRUP" {
			at += HEADER_SIZE   // the persistent, temporary and distant groups: into them
			continue
		}
		next_at := at + HEADER_SIZE + i64(header.size)
		if header.kind[:] == "REFR" and references.len < references.cap {
			body := plugin.data[at + HEADER_SIZE : next_at]
			references + read_reference(header, body)
		}
		at = next_at
	}
}

// A REFR record's fields: NAME the base, DATA where and how turned, XSCL
// its scale.
read_reference :: fun(header: Record_Header, data: []byte) -> Reference {
	reference := Reference{
		form_id = header.form_id,
		base = 0,
		position = Vec3{0, 0, 0},
		rotation = Vec3{0, 0, 0},
		scale = 1,
		flags = header.flags}
	fields := Fields{data = data, at = 0, broken = false}
	for field in next_field(&fields) {
		kind := field.kind[:]
		if kind == "NAME" and field.data.len >= 4 {
			reference.base = field.data[0]
		elif kind == "DATA" and field.data.len >= 24
			reference.position = field.data[0]
			reference.rotation = field.data[12]
		elif kind == "XSCL" and field.data.len >= 4
			reference.scale = field.data[0]
		}
	}
	return reference
}

// The mesh a base object's record names (MODL), as an archive path:
// meshes\…, lower case. Empty when it names none.
model_path :: fun(record: Record) -> [256]utf8 {
	path : [256]utf8
	field, found := find_field(record.data, "MODL")
	if not found do return path
	name := field_text(field)
	if name.len == 0 do return path
	&path + "meshes\\"
	for c in name {
		if path.len == path.cap do break
		if c == '/' do &path + '\\'
		else do &path + lower(c)
	}
	return path
}

// A reference's place in the world as a matrix: scaled, turned (about z
// first, then y, then x, each clockwise, as OpenMW does it), moved.
reference_transform :: fun(reference: Reference) -> Mat4 {
	turn_x := clockwise(reference.rotation.x, 0)
	turn_y := clockwise(reference.rotation.y, 1)
	turn_z := clockwise(reference.rotation.z, 2)
	turned := mat4_mul(turn_x, mat4_mul(turn_y, turn_z))
	scaled := mat4_mul(turned, mat4_scale(Vec3{reference.scale, reference.scale, reference.scale}))
	return mat4_mul(mat4_translate(reference.position), scaled)
}

// A turn by angle clockwise about an axis (0 x, 1 y, 2 z), looking down
// the axis toward the origin.
clockwise :: fun(angle: f32, axis: i64) -> Mat4 {
	c := cos_f32(angle)
	s := sin_f32(angle)
	m := mat4_identity()
	// The other two axes, in order: (y, z) for x, (z, x) for y, (x, y) for z.
	a := (axis + 1) % 3
	b := (axis + 2) % 3
	m[a][a] = c
	m[a][b] = -s
	m[b][a] = s
	m[b][b] = c
	return m
}

// ---- a cell's light, the lights in it, and its doors ---------------------------

// An interior cell's light (its XCLL): an ambient color, a directional
// light, and fog. Colors 0 to 1.
Cell_Lighting :: struct {
	ambient: Vec3
	directional: Vec3
	direction: Vec3     // where the directional light comes from
	fog_color: Vec3
	fog_near: f32
	fog_far: f32
}

// The lighting an exterior cell or a cell without XCLL is drawn with,
// until weather is read: daylight.
DAYLIGHT :: Cell_Lighting{
	ambient = Vec3{0.4, 0.42, 0.45},
	directional = Vec3{0.75, 0.72, 0.65},
	direction = Vec3{0.3, -0.4, 0.85},
	fog_color = Vec3{0.45, 0.6, 0.8},
	fog_near = 0,
	fog_far = 0}

// A color as a cell or light record stores it: red, green, blue bytes.
byte_color :: fun(data: []byte, at: i64) -> Vec3 {
	red : u8 = data[at]
	green : u8 = data[at + 1]
	blue : u8 = data[at + 2]
	return Vec3{f32(red) / 255, f32(green) / 255, f32(blue) / 255}
}

// A cell's lighting: its XCLL, or daylight when it has none.
cell_lighting :: fun(plugin: ^Plugin, cell: u32, scratch: ^[]byte) -> Cell_Lighting {
	record, record_error := find_record(plugin, cell, scratch)
	if record_error do return DAYLIGHT
	field, found := find_field(record.data, "XCLL")
	if not found or field.len < 36 do return DAYLIGHT
	fog_near : f32 = field[12]
	fog_far : f32 = field[16]
	// The directional light's angles, in degrees: around z, and up from level.
	around : i32 = field[20]
	up : i32 = field[24]
	around_radians := f32(around) * 0.0174533
	up_radians := f32(up) * 0.0174533
	return Cell_Lighting{
		ambient = byte_color(field, 0),
		directional = byte_color(field, 4),
		direction = Vec3{sin_f32(around_radians) * cos_f32(up_radians), cos_f32(around_radians) * cos_f32(up_radians), sin_f32(up_radians)},
		fog_color = byte_color(field, 8),
		fog_near = fog_near,
		fog_far = fog_far}
}

// A light's flags (LIGH's DATA).
LIGHT_NEGATIVE       :: 0x4    // takes light away
LIGHT_OFF_BY_DEFAULT :: 0x20

// A light placed in a cell: where, how far it reaches, its color.
Point_Light :: struct {
	position: Vec3
	radius: f32
	color: Vec3
}

// The light a LIGH base object gives, placed by a reference; false when
// it gives none (off, negative, or no data).
light_of :: fun(base: Record, reference: Reference) -> Point_Light, bool {
	none := Point_Light{position = reference.position, radius = 0, color = Vec3{0, 0, 0}}
	if base.header.kind[:] != "LIGH" do return none, false
	field, found := find_field(base.data, "DATA")
	if not found or field.len < 16 do return none, false
	radius : u32 = field[4]
	flags : u32 = field[12]
	if flags & (LIGHT_NEGATIVE | LIGHT_OFF_BY_DEFAULT) != 0 or radius == 0 do return none, false
	return Point_Light{position = reference.position, radius = f32(radius) * reference.scale, color = byte_color(field, 8)}, true
}

// Where a door leads (a reference's XTEL): the door at the other end, and
// where and facing which way one arrives.
Door_Destination :: struct {
	door: u32
	position: Vec3
	rotation: Vec3
}

// A reference's destination, and false when it leads nowhere.
door_destination :: fun(plugin: ^Plugin, reference: u32, scratch: ^[]byte) -> Door_Destination, bool {
	none := Door_Destination{door = 0, position = Vec3{0, 0, 0}, rotation = Vec3{0, 0, 0}}
	record, record_error := find_record(plugin, reference, scratch)
	if record_error do return none, false
	field, found := find_field(record.data, "XTEL")
	if not found or field.len < 28 do return none, false
	door : u32 = field[0]
	position : Vec3 = field[4]
	rotation : Vec3 = field[16]
	return Door_Destination{door = door, position = position, rotation = rotation}, true
}

// The cell a reference is in: the one whose group of references holds its
// record. 0 when none does.
cell_of_reference :: fun(plugin: ^Plugin, reference: u32) -> u32 {
	at, found := index_get(&plugin.records, u64(reference))
	if not found do return 0
	cells := &plugin.cell_children
	for key, slot in cells.keys {
		if key == 0 do continue
		group_at := i64(cells.values[slot])
		group_header : Group_Header = plugin.data[group_at]
		if at > group_at and at < group_at + i64(group_header.size) do return u32(key)
	}
	return 0
}

// ---- exterior cells ------------------------------------------------------------

// The size of an exterior cell, in units.
CELL_SIZE :: 4096

// The world an exterior cell is in, 0 for an interior one.
cell_world :: fun(plugin: ^Plugin, cell: u32) -> u32 {
	world, found := index_get(&plugin.cell_worlds, u64(cell))
	if not found do return 0
	return u32(world)
}

// The exterior cell at a place on a world's grid, 0 when there's none.
exterior_cell :: fun(plugin: ^Plugin, world: u32, x: i64, y: i64) -> u32 {
	cell, found := index_get(&plugin.exterior_cells, grid_key(world, x, y))
	if not found do return 0
	return u32(cell)
}

// The world's cell holding its persistent references (doors, quest
// things…), 0 when it has none.
persistent_cell :: fun(plugin: ^Plugin, world: u32) -> u32 {
	cell, found := index_get(&plugin.persistent_cells, u64(world))
	if not found do return 0
	return u32(cell)
}

// The place on the grid a point in the world is in.
grid_of :: fun(position: Vec3) -> i64, i64 {
	return i64(floor_f32(position.x / CELL_SIZE)), i64(floor_f32(position.y / CELL_SIZE))
}

// The world whose editor id is name (any letter case): its form id.
find_world :: fun(plugin: ^Plugin, name: []utf8, scratch: ^[]byte) -> u32 {
	for key, slot in plugin.persistent_cells.keys {
		if key == 0 do continue
		record, record_error := find_record(plugin, u32(key), scratch)
		if record_error do continue
		if compare_folded(editor_id(record.data), name) == 0 do return u32(key)
	}
	return 0
}
