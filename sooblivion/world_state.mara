// The world as it is, apart from how anyone sees it: what a server will
// own and tell its players, stepped as a server would step it — on a fixed
// tick (WORLD_TICK), not with the frames drawn.
//
// For now: its clock (one for everyone); its skies, each region's
// weather (by form id: what a weather looks and sounds like is the
// viewer's to read), rolled from the world's own seed, all ticking on
// whether anyone's under them or not; its players — where each is, as
// their client reports it, the sky they're under, the place they're in and
// the people in it, as they stand; the doors that open in place, open or
// shut. And the messages its server and clients send each other.
module world_state

use mara.core
use mara.math
use mara.time
use mara.memory
use mara.string
use esm
use world
use sky
use logging
use indexing
use random

// The messages the server and its clients send each other (og's wire
// carries them), and the port a server listens on unless told another
// (each og port has its own, so two games can run at once).
DEFAULT_PORT :: 27100

// From a client to its server.
MESSAGE_PLAYER :: 1       // where the player is now (Player_Message)
MESSAGE_PLACE :: 2        // the place the player's come into (Place_Message)
MESSAGE_USE_DOOR :: 3     // a door that opens in place, opened or shut (its reference, u32)
MESSAGE_SAY :: 4          // something the player says to the others (Note_Message)
// From a server to its clients.
MESSAGE_CLOCK :: 10       // the clock and the sky (Clock_Message)
MESSAGE_PEOPLE :: 11      // the people in the player's place (a list of References)
MESSAGE_DOORS :: 12       // the doors opened or shut (a list of Door_States)
MESSAGE_NOTE :: 13        // something to tell the player's journal (Note_Message)
MESSAGE_PLAYERS :: 14     // the other players (a list of Other_Players)
MESSAGE_SAID :: 15        // words another player said (Said_Message)

// Where a client's player is now: the world they're in (0 inside), their
// feet, which way they face, how fast they're going (units a second,
// across), whether they hurry time.
Player_Message :: struct {
	world_id: u32
	feet: Vec3
	yaw: f32
	speed: f32
	hurried: bool
	swings: i64     // how many times they've swung their weapon (one more: a swing begun)
	strikes: i64    // how many of their blows met someone
	struck: u32     // whom the last of those met (their reference)
}

// Another player, as a server tells a client of them: their number, the
// world they're in (0 inside) and the interior (0 outside), their feet,
// which way they face, how fast they're going.
Other_Player :: struct {
	id: i64
	world: u32
	cell: u32
	feet: Vec3
	yaw: f32
	speed: f32
	swings: i64
	strikes: i64
	struck: u32
}

// The place a client's player has come into: an interior (cell), or a
// world's cells round x, y (world_id; told again as they cross into
// others); where their feet are there.
Place_Message :: struct {
	world_id: u32
	cell: u32
	x: i64
	y: i64
	feet: Vec3
}

// The clock and the sky, as a server tells a client: the world's seed (for
// chance its players roll alike); the game's hour and days gone, the
// seconds the world's run, whether time's hurried; the sky the client's
// player is under — its climate (its form id; 0 the default) and whether
// there's one yet, whose sky it is (its source: a region's form id, or the
// climate's) and whether they walked into it from another's; the weathers
// coming in and going out under it (form ids), how far in.
Clock_Message :: struct {
	seed: u64
	hour: f32
	day: i64
	seconds: f64
	hurried: bool
	climate: u32
	sky_taken: bool
	sky_source: u32
	walked_into_sky: bool
	weather: u32
	last_weather: u32
	weather_share: f32
}

// Words a player said, as the server tells the others: whose (their
// number), and the words.
Said_Message :: struct {
	player: i64
	text: [200]utf8
}

// Something a server tells a client's journal: what failed, and why.
Note_Message :: struct {
	text: [200]utf8
}

// The world steps this often (seconds of real time), and at most this
// many times to catch up after a long frame (more are let go).
WORLD_TICK :: 0.03333333
MOST_TICKS_AT_ONCE :: 8
// How much faster than ours the game's day goes (Oblivion's own), and,
// hurried (T held), how much faster again.
TIME_SCALE :: 30
HURRIED_TIME_SCALE :: 2000
// How long a weather stays before the next is chosen, in the game's hours.
WEATHER_LEAST_HOURS :: 4
WEATHER_MOST_HOURS :: 8
// The hour the world starts at.
START_HOUR :: 10
// The players, the people in a player's place, the doors and the skies
// the world keeps, at most (a sky for each region with weathers a player's
// come into: Oblivion.esm has 59; and each climate's own).
MAX_PLAYERS :: 8
WORLD_ACTORS :: 512
WORLD_DOORS :: 1024
MAX_SKIES :: 128

World_State_Error :: error {
	Too_Many_Skies   // the world keeps MAX_SKIES skies at most
}

// A player, as their client reports them: their number (0: no one in this
// slot), the world they're in (0 inside), where their feet are, which way
// they face (radians from north toward east), how fast they're going
// (units a second, across), whether they hurry time; the sky they're under
// — its climate (a CLMT's form id; 0 the default), which of the world's
// skies (-1: none yet), whether they walked into it from another's (their
// client blends it in) or came into it at once (through a door); the
// place they're in — an interior (place_cell), or a world's cells round
// place_x, place_y (place_world) — and the people in it (NPCs placed,
// ACHR), as they stand now: where, turned how, how big.
Player_State :: struct {
	id: i64
	world: u32
	feet: Vec3
	yaw: f32
	speed: f32
	hurried: bool
	swings: i64
	strikes: i64
	struck: u32
	climate: u32
	sky: i64
	walked_into_sky: bool
	place_world: u32
	place_cell: u32
	place_x: i64
	place_y: i64
	actors: [WORLD_ACTORS]Reference
}

// A door that opens in place, as the world has it: open or shut, and when
// it last changed (the world's seconds). One the world hasn't is shut.
Door_State :: struct {
	reference: u32
	open: bool
	since: f64
}

// A sky the world keeps: whose it is (its source: a region with weathers,
// by form id, or a climate's own, where no region's weathers come), the
// weathers that may come under it; its weather — the one coming in and the
// one going out (form ids; 0 for the default), how far in the new one is
// (0 to 1), how long it takes to come in and how long it stays before the
// next is chosen (the game's hours); the seed its choices are rolled from
// (its own: the world's, mixed with its source).
Region_Sky :: struct {
	source: u32
	weathers: [16]Weather_Chance
	weather: u32
	last_weather: u32
	share: f32
	transition: f32
	hours_left: f32
	seed: u64
}

World_State :: struct {
	// What every chance its players roll alike is rolled from (chance_at:
	// the birds they hear, thunder).
	seed: u64
	// The clock: the game's hour (0 to 24) and its days gone; how long the
	// world has run (seconds of real time), in ticks; whether time's
	// hurried (the player holds T).
	hour: f32
	day: i64
	seconds: f64
	ticks: i64
	hurried: bool
	// The skies: one for each source a player's been under.
	skies: [MAX_SKIES]Region_Sky
	// The players: a slot for each that may join.
	players: [MAX_PLAYERS!]Player_State
	// The doors that open in place that have been opened (or shut again).
	doors: [WORLD_DOORS]Door_State
}

// A world starting: its clock at START_HOUR of its first day, no skies yet,
// its seed from the time it starts.
world_start :: fun(state: ^World_State) {
	state.hour = START_HOUR
	state.day = 0
	state.seconds = 0
	state.ticks = 0
	state.hurried = false
	state.seed = time_now() | 1
	state.skies.len = 0
	for &player in state.players do player_clear(player, 0)
	state.doors.len = 0
}

// Steps the world a tick (WORLD_TICK of real time): the clock on (faster
// hurried); under every sky, the weather coming in further, and when its
// hours are up the next chosen. All are stepped whatever fails (the first
// failure given back: see sky_change_weather).
world_step :: fun(state: ^World_State, plugin: ^Plugin) -> err {
	state.ticks += 1
	state.seconds += WORLD_TICK
	hours := world_tick_hours(state)
	state.hour += hours
	if state.hour >= 24 {
		state.hour -= 24
		state.day += 1
	}
	first_error : err
	for &region_sky in state.skies {
		region_sky.share = min(1, region_sky.share + hours / max(region_sky.transition, 0.01))
		region_sky.hours_left -= hours
		if region_sky.hours_left > 0 do continue
		change_error := sky_change_weather(region_sky, plugin, false)
		if change_error and not first_error do first_error = change_error
	}
	return first_error
}

// An hour of the game's day as a clock shows it: 07:03.
clock_text :: fun(hour: f32) -> [8]utf8 {
	text : [8]utf8
	whole_hours := i64(hour)
	minutes := i64((hour - f32(whole_hours)) * 60)
	if whole_hours < 10 do &text + "0"
	&text + int_text(whole_hours)
	&text + ":"
	if minutes < 10 do &text + "0"
	&text + int_text(minutes)
	return text
}

// The game's hours a tick moves the clock on: by TIME_SCALE, or hurried
// by HURRIED_TIME_SCALE.
world_tick_hours :: fun(state: ^World_State) -> f32 {
	scale : f32 = if state.hurried do HURRIED_TIME_SCALE else TIME_SCALE
	return WORLD_TICK * scale / 3600
}

// A player's slot made empty, or theirs (id) from the start: nowhere yet.
player_clear :: fun(player: ^Player_State, id: i64) {
	player.id = id
	player.world = 0
	player.feet = Vec3{0, 0, 0}
	player.yaw = 0
	player.speed = 0
	player.hurried = false
	player.swings = 0
	player.strikes = 0
	player.struck = 0
	player.climate = 0
	player.sky = -1
	player.walked_into_sky = false
	player.place_world = 0
	player.place_cell = 0
	player.place_x = 0
	player.place_y = 0
	player.actors.len = 0
}

// Puts a player under the sky where they are, under a climate (by form
// id): in a world, the sky of the region with weathers at their feet, else
// the climate's own (that too where the regions can't be read); in an
// interior lit by the sky, the climate's own — or, the same climate, the
// sky they were under outside. A sky no one's been under yet is made (its
// weathers the region's, else the climate's). walked: whether they walked
// into it (their client blends it in) or came into it at once. Under a sky
// whatever fails, as it can be (the first failure given back); under the
// one they were when the world has no room for another.
player_take_sky :: fun(state: ^World_State, plugin: ^Plugin, player: ^Player_State, climate_id: u32, walked: bool) -> err {
	if player.world == 0 and player.sky >= 0 and player.climate == climate_id do return
	player.climate = climate_id
	source := climate_id
	first_error : err
	if player.world != 0 {
		scratch : [256 * KB]byte
		x, y := grid_of(player.feet)
		region, region_error := cell_weather_region(plugin, player.world, x, y, &scratch)
		if region_error do first_error = region_error
		elif region != 0 do source = region
	}
	at := find_sky(state, source)
	if at < 0 {
		weathers : [16]Weather_Chance
		if source != climate_id {
			weathers_error := region_weathers(plugin, source, &weathers)
			if weathers_error and not first_error do first_error = weathers_error
		}
		if weathers.len == 0 {
			scratch : [256 * KB]byte
			climate, climate_error := read_climate(plugin, climate_id, &scratch)
			if climate_error and not first_error do first_error = climate_error
			if not climate_error do weathers = climate.weathers
		}
		made, made_error := make_sky(state, plugin, source, &weathers)
		if made_error and not first_error do first_error = made_error
		at = made
	}
	if at >= 0 and at != player.sky {
		player.sky = at
		player.walked_into_sky = walked
	}
	return first_error
}

// Which of the world's skies is a source's (a region's, or a climate's
// own); -1 for none yet.
find_sky :: fun(state: ^World_State, source: u32) -> i64 {
	for region_sky, k in state.skies {
		if region_sky.source == source do return k
	}
	return -1
}

// A sky made for a source, with the weathers that may come under it: its
// seed its own, its first weather in at once. Its index; -1 when the world
// has no room for another (Too_Many_Skies). Made though its first weather
// can't be read (why given back).
make_sky :: fun(state: ^World_State, plugin: ^Plugin, source: u32, weathers: ^[]Weather_Chance) -> i64, err {
	if not fits(state.skies.len + 1, state.skies.cap) do return -1, World_State_Error.Too_Many_Skies
	&state.skies + Region_Sky{source = source, weathers = weathers^, weather = 0, last_weather = 0, share = 1, transition = 1, hours_left = 0,
		seed = (state.seed ~ (u64(source) *% 0x9E3779B97F4A7C15)) | 1}
	at := state.skies.len - 1
	weather_error := sky_change_weather(&state.skies[at], plugin, true)
	return at, weather_error
}

// Chooses a sky's next weather among those that may come under it, by
// their chances, and how long it stays: coming in over its own time, or at
// once. (A weather whose record can't be read comes in as the default
// would; why's given back.)
sky_change_weather :: fun(region_sky: ^Region_Sky, plugin: ^Plugin, at_once: bool) -> err {
	region_sky.hours_left = WEATHER_LEAST_HOURS + (WEATHER_MOST_HOURS - WEATHER_LEAST_HOURS) * random_share(&region_sky.seed)
	chosen := pick_weather(&region_sky.weathers, random_share(&region_sky.seed))
	if chosen == region_sky.weather and not at_once do return
	scratch : [256 * KB]byte
	weather, weather_error := read_weather(plugin, chosen, &scratch)
	if weather_error do weather = default_weather()
	region_sky.last_weather = if at_once do chosen else region_sky.weather
	region_sky.weather = chosen
	region_sky.transition = weather.transition
	region_sky.share = if at_once do 1 else 0
	return weather_error
}

// ---- the people, the doors -------------------------------------------------------

// Takes an interior as the place a player's in: the people in it.
player_take_interior :: fun(player: ^Player_State, plugin: ^Plugin, cell: u32) -> err {
	player.place_world = 0
	player.place_cell = cell
	player.actors.len = 0
	add_actors(player, plugin, cell, EVERYWHERE, NOWHERE)?
}

// Takes a world's cells round the one at x, y as the place a player's
// in: the people in them and in the world's persistent cell there. Moving
// within the world, those still in it stay as they are, those out of it
// go, and only the cells come into it are read. All its cells are read
// whatever fails (the first failure given back).
player_take_area :: fun(player: ^Player_State, plugin: ^Plugin, world_id: u32, x: i64, y: i64) -> err {
	area := area_around(x, y)
	kept := NOWHERE
	if player.place_world == world_id and player.place_cell == 0 {
		kept = area_around(player.place_x, player.place_y)
		staying : i64 = 0
		for k in 0:player.actors.len {
			if not area_holds(area, player.actors[k].position) do continue
			player.actors[staying] = player.actors[k]
			staying += 1
		}
		player.actors.len = staying
	else
		player.actors.len = 0
	}
	player.place_world = world_id
	player.place_cell = 0
	player.place_x = x
	player.place_y = y
	first_error : err
	for cell_y in area.low_y..area.high_y {
		for cell_x in area.low_x..area.high_x {
			if cell_x >= kept.low_x and cell_x <= kept.high_x and cell_y >= kept.low_y and cell_y <= kept.high_y do continue
			cell := exterior_cell(plugin, world_id, cell_x, cell_y)
			if cell == 0 do continue
			cell_error := add_actors(player, plugin, cell, EVERYWHERE, NOWHERE)
			if cell_error and not first_error do first_error = cell_error
		}
	}
	persistent := persistent_cell(plugin, world_id)
	if persistent != 0 {
		persistent_error := add_actors(player, plugin, persistent, area, kept)
		if persistent_error and not first_error do first_error = persistent_error
	}
	return first_error
}

// Adds a cell's people (those not disabled) in an area and not in kept.
add_actors :: fun(player: ^Player_State, plugin: ^Plugin, cell: u32, area: Grid_Area, kept: Grid_Area) -> err {
	references : [16384]Reference = void
	references.len = 0
	cell_references(plugin, cell, &references)?
	for reference in references {
		if reference.flags & RECORD_DISABLED != 0 do continue
		if not area_holds(area, reference.position) or area_holds(kept, reference.position) do continue
		base_at, found := index_get(&plugin.records, u64(reference.base))
		if not found or record_header_at(plugin, base_at).kind != "NPC_" do continue
		if not fits(player.actors.len + 1, player.actors.cap) do break
		&player.actors + reference
	}
}

// Opens a shut door that opens in place, or shuts an open one, now (the
// world's seconds): whether it's open after.
world_use_door :: fun(state: ^World_State, reference: u32) -> bool {
	for &door in state.doors {
		if door.reference != reference do continue
		door.open = not door.open
		door.since = state.seconds
		return door.open
	}
	if not fits(state.doors.len + 1, state.doors.cap) do return false
	&state.doors + Door_State{reference = reference, open = true, since = state.seconds}
	return true
}

// Whether a door that opens in place is open (one the world hasn't is shut).
world_door_open :: fun(state: ^World_State, reference: u32) -> bool {
	for door in state.doors {
		if door.reference == reference do return door.open
	}
	return false
}
