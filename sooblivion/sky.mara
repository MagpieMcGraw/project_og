// The sky outside: a world's climate and its weathers, and from them, for
// an hour of the day, the sky's colors, the sun, the clouds, and the light
// and fog everything outside is drawn with.
//
// A weather (WTHR) gives ten colors — sky, fog, clouds, ambient, sunlight,
// sun, stars, horizon — at four times of day: sunrise, day, sunset, night.
// A climate (CLMT) says when the sun rises and sets (between its times, the
// colors blend) and which weathers come; a place's regions (REGN, its
// cell's XCLR) may say otherwise: their weathers, each with a chance.
module sky

use mara.core
use mara.math
use mara.string
use world
use esm
use logging
use indexing

// The weather's colors, as NAM0 lists them.
SKY_UPPER    :: 0
FOG          :: 1
CLOUDS_LOWER :: 2
AMBIENT      :: 3
SUNLIGHT     :: 4
SUN          :: 5
STARS        :: 6
SKY_LOWER    :: 7
HORIZON      :: 8
CLOUDS_UPPER :: 9
WEATHER_COLORS :: 10

// The times of day a weather gives its colors for.
SUNRISE :: 0
DAY     :: 1
SUNSET  :: 2
NIGHT   :: 3

// What a weather is like (its classification): bits.
WEATHER_PLEASANT :: 1
WEATHER_CLOUDY   :: 2
WEATHER_RAINY    :: 4
WEATHER_SNOW     :: 8

// What a weather's sound is for (its SNAM's role).
WEATHER_SOUND_PRECIPITATION :: 1
WEATHER_SOUND_WIND          :: 2
WEATHER_SOUND_THUNDER       :: 3

// A weather: its form id, its colors at each time of day, its fog, its
// clouds; what it's like (WEATHER_*), how long it takes to come in (game
// hours), its sun's glare (0 to 1); its rain or snow (the precipitation
// mesh's archive path, or empty), coming in and going out over shares of
// its coming in; its thunder (how often, 0 to 1) and lightning's color;
// its sounds (form ids, with their roles).
Weather :: struct {
	form_id: u32
	colors: [WEATHER_COLORS!][4!]Vec3
	fog_day_near: f32
	fog_day_far: f32
	fog_night_near: f32
	fog_night_far: f32
	cloud_lower: [160]utf8     // the clouds' textures' archive paths
	cloud_upper: [160]utf8
	cloud_speed_lower: f32     // how fast each layer drifts, in its texture's widths a second
	cloud_speed_upper: f32
	wind_speed: f32            // 0 to 1
	classification: u32
	transition: f32
	sun_glare: f32
	precipitation: [160]utf8
	precipitation_in: f32
	precipitation_out: f32
	thunder: f32
	lightning_color: Vec3
	sounds: [8]Weather_Sound
}

// A sound of a weather's: the sound's form id, and what it's for
// (WEATHER_SOUND_*).
Weather_Sound :: struct {
	sound: u32
	role: u32
}

// A weather that may come: its form id, and how likely (out of its list's
// chances in all).
Weather_Chance :: struct {
	weather: u32
	chance: i64
}

// A climate: the weathers it brings, the sun's hours, the sun's and its
// glare's textures, the night sky's mesh (its stars), and its moons:
// which there are and how many days each phase lasts.
Climate :: struct {
	form_id: u32               // its CLMT's (0: the default, none read)
	weathers: [16]Weather_Chance
	sunrise_begin: f32         // hours, 0 to 24
	sunrise_end: f32
	sunset_begin: f32
	sunset_end: f32
	sun_texture: [160]utf8
	sun_glare_texture: [160]utf8
	stars: [160]utf8           // the night sky mesh's archive path
	masser: bool
	secunda: bool
	phase_days: f32
}

// The sky at an hour: what the sky and water are drawn with, and the
// lighting everything outside is.
Sky_State :: struct {
	upper: Vec3
	lower: Vec3
	horizon: Vec3
	cloud_lower_color: Vec3
	cloud_upper_color: Vec3
	sun_color: Vec3            // the sun's disc
	stars_color: Vec3          // the stars' (dark by day)
	sun_direction: Vec3        // toward the sun (below the horizon at night)
	daylight: f32              // 0 at night, 1 by day
	lighting: Cell_Lighting
}

// The climate of a world: its CNAM's; for a world without one, its parent's
// (WNAM: a city's is Tamriel's), and so on up; else the fallback climate.
world_climate :: fun(plugin: ^Plugin, world_id: u32, scratch: ^[]byte) -> Climate, err {
	climate_id : u32 = 0
	asked := world_id
	for depth in 0:4 {
		record := find_record(plugin, asked, scratch)?
		own, has_own := form_field(plugin, record, "CNAM")
		if has_own and own != 0 {
			climate_id = own
			break
		}
		parent, has_parent := form_field(plugin, record, "WNAM")
		if not has_parent or parent == 0 do break
		asked = parent
	}
	if climate_id == 0 do climate_id = fallback_climate(plugin, scratch)
	return read_climate(plugin, climate_id, scratch)
}

// The climates for where none is named, in Oblivion.esm: TamrielClimate,
// and DefaultClimate (by form id: finding a record by editor id reads
// them all).
CLIMATE_TAMRIEL :: 0x000688E2
CLIMATE_DEFAULT :: 0x0000015F

// The climate for where none is named: TamrielClimate, or DefaultClimate;
// 0 when there's neither.
fallback_climate :: fun(plugin: ^Plugin, scratch: ^[]byte) -> u32 {
	for climate_id in [CLIMATE_TAMRIEL, CLIMATE_DEFAULT] {
		_, found := index_get(&plugin.records, u64(climate_id))
		if found do return u32(climate_id)
	}
	return 0
}

// Whether an interior cell behaves like an exterior (its DATA's flag 0x80:
// the Temple of the One, the Arena, Oblivion's towers), lit by the sky, and
// the climate it names (XCCM; 0 for none: the one outside's).
cell_sky :: fun(plugin: ^Plugin, cell: u32, scratch: ^[]byte) -> bool, u32, err {
	record := find_record(plugin, cell, scratch)?
	flags, has_flags := find_field(record.data, "DATA")
	if not has_flags or flags.len == 0 or (u8(flags[0]) & 0x80) == 0 do return false, 0
	climate_id, _ := form_field(plugin, record, "XCCM")
	return true, climate_id
}

// A CLMT record's climate; the default climate for 0.
read_climate :: fun(plugin: ^Plugin, climate_id: u32, scratch: ^[]byte) -> Climate, err {
	climate := default_climate()
	if climate_id == 0 do return climate
	climate_record := find_record(plugin, climate_id, scratch)?
	climate.form_id = climate_id
	// Its weathers: WLST is (weather, chance) pairs.
	weathers, has_weathers := find_field(climate_record.data, "WLST")
	if has_weathers do add_weather_chances(plugin, climate_record, weathers, &climate.weathers)
	// TNAM: sunrise's and sunset's beginnings and ends, in tens of minutes;
	// how changeable the weather is; the moons (bit 6 Masser, bit 7 Secunda)
	// and how many days a phase lasts (the rest).
	timing, has_timing := find_field(climate_record.data, "TNAM")
	if has_timing and timing.len >= 6 {
		moons : u8 = timing[5]
		climate.masser = moons & 0x40 != 0
		climate.secunda = moons & 0x80 != 0
		climate.phase_days = f32(moons & 0x3F)
	}
	if has_timing and timing.len >= 4 {
		hours : [4!]f32
		for k in 0:4 {
			tens : u8 = timing[k]
			hours[k] = f32(tens) / 6
		}
		climate.sunrise_begin = hours[0]
		climate.sunrise_end = hours[1]
		climate.sunset_begin = hours[2]
		climate.sunset_end = hours[3]
	}
	sun, has_sun := find_field(climate_record.data, "FNAM")
	if has_sun do texture_path_of(field_text(sun), &climate.sun_texture)
	glare, has_glare := find_field(climate_record.data, "GNAM")
	if has_glare do texture_path_of(field_text(glare), &climate.sun_glare_texture)
	night_sky, has_night_sky := find_field(climate_record.data, "MODL")
	if has_night_sky do mesh_path_of(field_text(night_sky), &climate.stars)
	return climate
}

// A list of (weather, chance) pairs, as a record's WLST or RDWT has them,
// into chances.
add_weather_chances :: fun(plugin: ^Plugin, record: Record, pairs: []byte, chances: ^[]Weather_Chance) {
	for k in 0:pairs.len / 8 {
		if not fits(chances.len + 1, chances.cap) do return
		weather : u32 = pairs[k * 8]
		chance : i32 = pairs[k * 8 + 4]
		if weather != 0 and chance > 0 do chances + Weather_Chance{weather = record_form(plugin, record, weather), chance = i64(chance)}
	}
}

// The region whose weathers come at an exterior cell (its grid place in a
// world): of the cell's regions (XCLR), the one with weathers of the
// highest priority; 0 for none (the climate's weathers come there).
cell_weather_region :: fun(plugin: ^Plugin, world_id: u32, x: i64, y: i64, scratch: ^[]byte) -> u32, err {
	cell := exterior_cell(plugin, world_id, x, y)
	if cell == 0 do return 0
	cell_record := find_record(plugin, cell, scratch)?
	regions, has_regions := find_field(cell_record.data, "XCLR")
	if not has_regions do return 0
	best_priority : i64 = -1
	best_region : u32 = 0
	for k in 0:regions.len / 4 {
		region_raw : u32 = regions[k * 4]
		region := record_form(plugin, cell_record, region_raw)
		priority := region_weather_priority(plugin, region)?
		if priority > best_priority {
			best_priority = priority
			best_region = region
		}
	}
	return best_region
}

// The weathers that may come in a region (its RDWT), into chances.
region_weathers :: fun(plugin: ^Plugin, region: u32, chances: ^[]Weather_Chance) -> err {
	chances.len = 0
	region_scratch : [65536]byte
	record := find_record(plugin, region, &region_scratch)?
	fields := Fields{data = record.data, at = 0, broken = false}
	for field in next_field(&fields) {
		if field.kind == "RDWT" do add_weather_chances(plugin, record, field.data, chances)
	}
}

// A region's priority for its weathers (its RDAT of type 3, followed by
// RDWT); -1 for a region without weathers.
region_weather_priority :: fun(plugin: ^Plugin, region: u32) -> i64, err {
	region_scratch : [65536]byte
	record := find_record(plugin, region, &region_scratch)?
	fields := Fields{data = record.data, at = 0, broken = false}
	for field in next_field(&fields) {
		if field.kind != "RDAT" or field.data.len < 6 do continue
		kind : u32 = field.data[0]
		priority : u8 = field.data[5]
		if kind == 3 do return i64(priority)
	}
	return -1
}

// A sound a region makes now and then: which (its form id), in what
// weathers (WEATHER_* bits), how likely each try (0 to 1).
Region_Sound :: struct {
	sound: u32
	weathers: u32
	chance: f32
}

// Room for a cell's region sounds: Oblivion.esm's cells have up to 106
// (seven regions; a region up to 32).
REGION_SOUNDS :: 256

// The sounds an exterior cell's regions make now and then (their RDSD
// lists: each a sound, its weathers, its chance in ten-millionths of a
// try), into sounds.
cell_region_sounds :: fun(plugin: ^Plugin, world_id: u32, x: i64, y: i64, sounds: ^[]Region_Sound, scratch: ^[]byte) -> err {
	sounds.len = 0
	cell := exterior_cell(plugin, world_id, x, y)
	if cell == 0 do return
	cell_record := find_record(plugin, cell, scratch)?
	regions, has_regions := find_field(cell_record.data, "XCLR")
	if not has_regions do return
	for k in 0:regions.len / 4 {
		region_raw : u32 = regions[k * 4]
		region := record_form(plugin, cell_record, region_raw)
		region_scratch : [65536]byte
		record := find_record(plugin, region, &region_scratch)?
		fields := Fields{data = record.data, at = 0, broken = false}
		for field in next_field(&fields) {
			if field.kind != "RDSD" do continue
			count := field.data.len / 12
			if not fits(sounds.len + count, sounds.cap) do count = sounds.cap - sounds.len
			for e in 0:count {
				sound : u32 = field.data[e * 12]
				weathers : u32 = field.data[e * 12 + 4]
				chance : u32 = field.data[e * 12 + 8]
				sounds + Region_Sound{sound = record_form(plugin, record, sound), weathers = weathers, chance = f32(chance) / 10000000}
			}
		}
	}
}

// A mesh's archive path from a record's: meshes\…, lower case.
mesh_path_of :: fun(name: []utf8, path: ^[160]utf8) {
	path.len = 0
	if name.len == 0 do return
	path + "meshes\\"
	for c in name {
		if not fits(path.len + 1, path.cap) do break
		if c == '/' do path + '\\'
		else do path + lower(c)
	}
}

// One of a list of weathers, at random by their chances: its form id; 0
// for an empty list. pick is a number from 0 up to 1.
pick_weather :: fun(chances: ^[]Weather_Chance, pick: f32) -> u32 {
	total : i64 = 0
	for chance in chances^ do total += chance.chance
	if total == 0 do return 0
	at := i64(pick * f32(total))
	for chance in chances^ {
		if at < chance.chance do return chance.weather
		at -= chance.chance
	}
	return chances[chances.len - 1].weather
}

// A climate for a world that has none: no weathers (the default one), the
// sun up from 6 to 20.
default_climate :: fun() -> Climate {
	return Climate{form_id = 0, weathers = [], sunrise_begin = 6, sunrise_end = 10, sunset_begin = 16, sunset_end = 20, sun_texture = [],
		sun_glare_texture = [], stars = [], masser = false, secunda = false, phase_days = 3}
}

// A weather for when there's none to read: a pale blue sky all day, fog far.
default_weather :: fun() -> Weather {
	weather := Weather{form_id = 0, colors = [], fog_day_near = 4096, fog_day_far = 40000, fog_night_near = 2048, fog_night_far = 20000,
		cloud_lower = [], cloud_upper = [], cloud_speed_lower = 0, cloud_speed_upper = 0, wind_speed = 0.1,
		classification = WEATHER_PLEASANT, transition = 0.25, sun_glare = 1, precipitation = [], precipitation_in = 0,
		precipitation_out = 0, thunder = 0, lightning_color = Vec3{1, 1, 1}, sounds = []}
	for c in 0:WEATHER_COLORS {
		for t in 0:4 do weather.colors[c][t] = Vec3{0.5, 0.6, 0.8}
	}
	return weather
}

// The form id of the record of a kind with an editor id; 0 when there's none.
find_by_editor_id :: fun(plugin: ^Plugin, kind: []utf8, name: []utf8, scratch: ^[]byte) -> u32 {
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		header := record_header_at(plugin, i64(plugin.records.values[slot]))
		if header.kind != kind do continue
		scratch.len = 0
		record, record_error := record_at(plugin, i64(plugin.records.values[slot]), scratch)
		if record_error do continue
		if compare_folded(editor_id(record.data), name) == 0 do return u32(key)
	}
	return 0
}

// A texture's archive path from a record's: textures\…, lower case.
texture_path_of :: fun(name: []utf8, path: ^[160]utf8) {
	path.len = 0
	if name.len == 0 do return
	path + "textures\\"
	for c in name {
		if not fits(path.len + 1, path.cap) do break
		if c == '/' do path + '\\'
		else do path + lower(c)
	}
}

// Reads a weather record. Its colors, as NAM0 has them: for each color, at
// each time of day, red, green, blue and a byte unused.
read_weather :: fun(plugin: ^Plugin, weather_id: u32, scratch: ^[]byte) -> Weather, err {
	weather := default_weather()
	if weather_id == 0 do return weather   // (a climate without weathers: the defaults)
	record := find_record(plugin, weather_id, scratch)?
	weather.form_id = weather_id
	colors, has_colors := find_field(record.data, "NAM0")
	if has_colors and colors.len >= WEATHER_COLORS * 16 {
		for c in 0:WEATHER_COLORS {
			for t in 0:4 do weather.colors[c][t] = byte_color(colors, (c * 4 + t) * 4)
		}
	}
	fog, has_fog := find_field(record.data, "FNAM")
	if has_fog and fog.len >= 16 {
		weather.fog_day_near = fog[0]
		weather.fog_day_far = fog[4]
		weather.fog_night_near = fog[8]
		weather.fog_night_far = fog[12]
	}
	lower_clouds, has_lower := find_field(record.data, "CNAM")
	if has_lower do texture_path_of(field_text(lower_clouds), &weather.cloud_lower)
	upper_clouds, has_upper := find_field(record.data, "DNAM")
	if has_upper do texture_path_of(field_text(upper_clouds), &weather.cloud_upper)
	precipitation, has_precipitation := find_field(record.data, "MODL")
	if has_precipitation do mesh_path_of(field_text(precipitation), &weather.precipitation)
	data, has_data := find_field(record.data, "DATA")
	// DATA, bytes: the wind's speed, the clouds' speeds (lower, upper), how
	// fast it comes in, the sun's glare, the sun's damage, its rain's coming
	// in and going out, its thunder's coming in and going out and how often,
	// what it's like, its lightning's color.
	if has_data and data.len >= 3 {
		wind_speed : u8 = data[0]
		weather.wind_speed = f32(wind_speed) / 255
		lower_speed : u8 = data[1]
		upper_speed : u8 = data[2]
		weather.cloud_speed_lower = f32(lower_speed) * 0.00004
		weather.cloud_speed_upper = f32(upper_speed) * 0.00004
	}
	if has_data and data.len >= 15 {
		delta : u8 = data[3]
		glare : u8 = data[4]
		rain_in : u8 = data[6]
		rain_out : u8 = data[7]
		thunder : u8 = data[10]
		classification : u8 = data[11]
		// (The faster it comes in, the shorter: from a quarter hour to an hour.)
		weather.transition = 64 / (f32(delta) + 1)
		if weather.transition > 1 do weather.transition = 1
		weather.sun_glare = f32(glare) / 255
		weather.precipitation_in = f32(rain_in) / 255
		weather.precipitation_out = f32(rain_out) / 255
		weather.thunder = if thunder == 255 do 0 else 1 - f32(thunder) / 255
		weather.classification = u32(classification)
		weather.lightning_color = byte_color(data, 12)
	}
	sounds := Fields{data = record.data, at = 0, broken = false}
	for field in next_field(&sounds) {
		if field.kind != "SNAM" or field.data.len < 8 or not fits(weather.sounds.len + 1, weather.sounds.cap) do continue
		sound : u32 = field.data[0]
		role : u32 = field.data[4]
		&weather.sounds + Weather_Sound{sound = record_form(plugin, record, sound), role = role}
	}
	return weather
}

// How a weather's four times of day mix at an hour: a weight for each.
// Night until sunrise begins; to sunrise's colors by its middle, to day's
// by its end; day until sunset begins; to sunset's by its middle, to
// night's by its end.
time_weights :: fun(climate: Climate, hour: f32) -> [4!]f32 {
	weights : [4!]f32 = [0, 0, 0, 0]
	sunrise_middle := (climate.sunrise_begin + climate.sunrise_end) / 2
	sunset_middle := (climate.sunset_begin + climate.sunset_end) / 2
	if hour < climate.sunrise_begin or hour >= climate.sunset_end {
		weights[NIGHT] = 1
	elif hour < sunrise_middle
		t := (hour - climate.sunrise_begin) / (sunrise_middle - climate.sunrise_begin)
		weights[NIGHT] = 1 - t
		weights[SUNRISE] = t
	elif hour < climate.sunrise_end
		t := (hour - sunrise_middle) / (climate.sunrise_end - sunrise_middle)
		weights[SUNRISE] = 1 - t
		weights[DAY] = t
	elif hour < climate.sunset_begin
		weights[DAY] = 1
	elif hour < sunset_middle
		t := (hour - climate.sunset_begin) / (sunset_middle - climate.sunset_begin)
		weights[DAY] = 1 - t
		weights[SUNSET] = t
	else
		t := (hour - sunset_middle) / (climate.sunset_end - sunset_middle)
		weights[SUNSET] = 1 - t
		weights[NIGHT] = t
	}
	return weights
}

// A weather's color at the mix of times of day.
mixed_color :: fun(weather: ^Weather, color: i64, weights: [4!]f32) -> Vec3 {
	mixed := Vec3{0, 0, 0}
	for t in 0:4 do mixed = mixed + weather.colors[color][t] * weights[t]
	return mixed
}

// The sky at an hour of the day as one weather turns into another: the
// last's sky and the coming one's, mixed by how far it has come (0 to 1).
changing_sky_at :: fun(climate: ^Climate, last: ^Weather, coming: ^Weather, share: f32, hour: f32, most_fog: f32) -> Sky_State {
	to := sky_at(climate^, coming, hour, most_fog)
	if share >= 1 do return to
	from := sky_at(climate^, last, hour, most_fog)
	mixed := to
	mixed.upper = mix_vec3(from.upper, to.upper, share)
	mixed.lower = mix_vec3(from.lower, to.lower, share)
	mixed.horizon = mix_vec3(from.horizon, to.horizon, share)
	mixed.cloud_lower_color = mix_vec3(from.cloud_lower_color, to.cloud_lower_color, share)
	mixed.cloud_upper_color = mix_vec3(from.cloud_upper_color, to.cloud_upper_color, share)
	mixed.sun_color = mix_vec3(from.sun_color, to.sun_color, share)
	mixed.stars_color = mix_vec3(from.stars_color, to.stars_color, share)
	mixed.lighting.ambient = mix_vec3(from.lighting.ambient, to.lighting.ambient, share)
	mixed.lighting.directional = mix_vec3(from.lighting.directional, to.lighting.directional, share)
	mixed.lighting.fog_color = mix_vec3(from.lighting.fog_color, to.lighting.fog_color, share)
	mixed.lighting.fog_near = from.lighting.fog_near + (to.lighting.fog_near - from.lighting.fog_near) * share
	mixed.lighting.fog_far = from.lighting.fog_far + (to.lighting.fog_far - from.lighting.fog_far) * share
	return mixed
}

mix_vec3 :: fun(from: Vec3, to: Vec3, share: f32) -> Vec3 {
	return from + (to - from) * share
}

// The sky at an hour of the day (0 to 24), with the fog no farther than
// most_fog: the world shown ends there.
sky_at :: fun(climate: Climate, weather: ^Weather, hour: f32, most_fog: f32) -> Sky_State {
	weights := time_weights(climate, hour)
	daylight := weights[DAY] + (weights[SUNRISE] + weights[SUNSET]) * 0.5

	// The sun: up in the east at sunrise's beginning, down in the west at
	// sunset's end, highest between; at night, the moon's light from the
	// other side of the sky.
	day_length := climate.sunset_end - climate.sunrise_begin
	progress := (hour - climate.sunrise_begin) / day_length
	angle := progress * 3.14159265
	sun_direction := vec3_normalize(Vec3{cos_f32(angle), -0.3, sin_f32(angle)})
	light_direction := sun_direction
	if sun_direction.z < 0.05 {
		// The moon's light, from high in the sky opposite.
		light_direction = vec3_normalize(Vec3{-sun_direction.x, 0.3, 0.6})
	}

	fog_near := weather.fog_day_near * daylight + weather.fog_night_near * (1 - daylight)
	fog_far := weather.fog_day_far * daylight + weather.fog_night_far * (1 - daylight)
	if fog_far > most_fog do fog_far = most_fog
	if fog_near > fog_far * 0.5 do fog_near = fog_far * 0.5

	return Sky_State{
		upper = mixed_color(weather, SKY_UPPER, weights),
		lower = mixed_color(weather, SKY_LOWER, weights),
		horizon = mixed_color(weather, HORIZON, weights),
		cloud_lower_color = mixed_color(weather, CLOUDS_LOWER, weights),
		cloud_upper_color = mixed_color(weather, CLOUDS_UPPER, weights),
		sun_color = mixed_color(weather, SUN, weights),
		stars_color = mixed_color(weather, STARS, weights),
		sun_direction = sun_direction,
		daylight = daylight,
		lighting = Cell_Lighting{
			ambient = mixed_color(weather, AMBIENT, weights),
			directional = mixed_color(weather, SUNLIGHT, weights),
			direction = light_direction,
			fog_color = mixed_color(weather, FOG, weights),
			fog_near = fog_near,
			fog_far = fog_far}}
}
