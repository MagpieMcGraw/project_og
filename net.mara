// Network connections: TCP over Windows' sockets (Winsock), each one
// non-blocking — read and written as far as it goes each time, never
// waited on but to connect. Addresses are four numbers (127.0.0.1), or
// localhost; a port.
module net

use mara.core
use mara.math
use mara.string

foreign static_lib "ws2_32" {
	fun WSAStartup(version: u16, data: ^byte) -> i32
	fun WSAGetLastError() -> i32
	fun socket(family: i32, kind: i32, protocol: i32) -> u64
	fun bind(id: u64, address: ^byte, size: i32) -> i32
	fun listen(id: u64, backlog: i32) -> i32
	fun accept(id: u64, address: ^byte, size: ^i32) -> u64
	fun connect(id: u64, address: ^byte, size: i32) -> i32
	fun send(id: u64, data: ^byte, size: i32, flags: i32) -> i32
	fun recv(id: u64, data: ^byte, size: i32, flags: i32) -> i32
	fun ioctlsocket(id: u64, command: u32, value: ^u32) -> i32
	fun setsockopt(id: u64, level: i32, name: i32, value: ^byte, size: i32) -> i32
	fun closesocket(id: u64) -> i32
}

// What a socket handle is when there's none (Winsock's INVALID_SOCKET).
NO_SOCKET :: 0xFFFFFFFFFFFFFFFF
// The port a server listens on unless told another.
DEFAULT_PORT :: 27100

AF_INET :: 2
SOCK_STREAM :: 1
IPPROTO_TCP :: 6
SOL_SOCKET :: 0xFFFF
SO_REUSEADDR :: 4
TCP_NODELAY :: 1
FIONBIO :: 0x8004667E
WSAEWOULDBLOCK :: 10035
SOCKET_ERROR :: -1

Net_Error :: error {
	Start_Failed     // Winsock wouldn't start
	Socket_Failed    // no socket to be had
	Bind_Failed      // the port's taken, or not to be had
	Listen_Failed
	Connect_Failed   // nothing listening there
	Bad_Address      // not four numbers (or localhost)
	Closed           // the other side's gone
	Send_Failed
	Receive_Failed
}

// Starts Winsock: once, before any socket.
net_start :: fun() -> err {
	data : [512!]byte
	if WSAStartup(0x0202, &data[0]) != 0 do return Start_Failed
}

// An address as Winsock takes one (sockaddr_in): its family, its port
// (high byte first), its four numbers.
socket_address :: fun(numbers: [4!]u8, port: i64) -> [16!]byte {
	address : [16!]byte
	address[0] = u16(AF_INET)
	address[2] = u8((port >> 8) & 0xFF)
	address[3] = u8(port & 0xFF)
	for k in 0:4 do address[4 + k] = numbers[k]
	return address
}

// The four numbers of an address written as text: a.b.c.d, or localhost.
read_address :: fun(text: []utf8) -> [4!]u8, err {
	numbers : [4!]u8
	if text == "localhost" {
		numbers = [127, 0, 0, 1]
		return numbers
	}
	part : i64 = 0
	value : i64 = 0
	digits : i64 = 0
	for c in text {
		if c == '.' {
			if digits == 0 or part == 3 do return numbers, Bad_Address
			numbers[part] = u8(value)
			part += 1
			value = 0
			digits = 0
			continue
		}
		if c < '0' or c > '9' do return numbers, Bad_Address
		value = value * 10 + i64(c - '0')
		digits += 1
		if value > 255 do return numbers, Bad_Address
	}
	if part != 3 or digits == 0 do return numbers, Bad_Address
	numbers[3] = u8(value)
	return numbers
}

// Makes a socket go on without waiting, and send what it's given at once
// (no gathering of small writes: the world's messages are small, and late).
socket_quick :: fun(id: u64) {
	on : u32 = 1
	_ = ioctlsocket(id, FIONBIO, &on)
	flag : [4!]byte
	flag[0] = u32(1)
	_ = setsockopt(id, IPPROTO_TCP, TCP_NODELAY, &flag[0], 4)
}

// A socket listening on a port: on every address the machine has (others
// may connect: Windows' firewall asks whether they may, the first time),
// or on this machine's own (127.0.0.1) only.
net_listen :: fun(port: i64, everywhere: bool) -> u64, err {
	id := socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
	if id == NO_SOCKET do return NO_SOCKET, Socket_Failed
	again : [4!]byte
	again[0] = u32(1)
	_ = setsockopt(id, SOL_SOCKET, SO_REUSEADDR, &again[0], 4)
	numbers : [4!]u8 = if everywhere do [0, 0, 0, 0] else [127, 0, 0, 1]
	address := socket_address(numbers, port)
	if bind(id, &address[0], 16) == SOCKET_ERROR {
		_ = closesocket(id)
		return NO_SOCKET, Bind_Failed
	}
	if listen(id, 8) == SOCKET_ERROR {
		_ = closesocket(id)
		return NO_SOCKET, Listen_Failed
	}
	socket_quick(id)
	return id
}

// A connection someone's made to a listening socket, if one's waiting.
net_accept :: fun(listener: u64) -> u64, bool {
	id := accept(listener, void, void)
	if id == NO_SOCKET do return NO_SOCKET, false
	socket_quick(id)
	return id, true
}

// Connects to a server at an address (text) and port: waits till it's made.
net_connect :: fun(address_text: []utf8, port: i64) -> u64, err {
	numbers := read_address(address_text)?
	id := socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
	if id == NO_SOCKET do return NO_SOCKET, Socket_Failed
	address := socket_address(numbers, port)
	if connect(id, &address[0], 16) == SOCKET_ERROR {
		_ = closesocket(id)
		return NO_SOCKET, Connect_Failed
	}
	socket_quick(id)
	return id
}

// Sends as much of data as goes now: how many bytes went (0 when none can
// yet). Closed when the other side's gone.
net_send :: fun(id: u64, data: []byte) -> i64, err {
	if data.len == 0 do return 0
	sent := send(id, data.ptr, i32(min(data.len, 1 << 30)), 0)
	if sent == SOCKET_ERROR {
		if WSAGetLastError() == WSAEWOULDBLOCK do return 0
		return 0, Closed
	}
	return i64(sent)
}

// Receives what's come, into the room after what into holds (its len moved
// past it): nothing when nothing has. Closed when the other side's gone.
net_receive :: fun(id: u64, into: ^[]byte) -> err {
	room := into.cap - into.len
	if room == 0 do return
	view := into[into.len : into.cap]
	got := recv(id, view.ptr, i32(min(room, 1 << 30)), 0)
	if got == 0 do return Closed
	if got == SOCKET_ERROR {
		if WSAGetLastError() == WSAEWOULDBLOCK do return
		return Closed
	}
	into.len += i64(got)
}

// Closes a socket (none: nothing).
net_close :: fun(id: u64) {
	if id != NO_SOCKET do _ = closesocket(id)
}
