// The game's sound: its WAV files (16-bit PCM, mono or stereo, at their own
// rates) played through SDL3's audio, mixed here — each voice resampled to
// the mix's rate, its loudness by how far away it is and its side by where
// it is from the camera. The mix is handed to SDL a frame at a time, kept
// a little ahead of what's heard.
//
// The scene's placed sounds (heard), one-shots (play_once): a looping
// sound is played while it's in hearing range, faded in and out at the
// edge; a placed sound that doesn't loop is played again after a pause.
// The music (music.mara) is mixed in with them.
module audio

use mara.core
use mara.math
use mara.string
use mara.sdl
use bsa
use world
use logging

// The mix: its rate, and how far ahead of what's heard it's kept (frames:
// what a slow frame of the game can take before the sound stops).
MIX_RATE :: 44100
AHEAD :: 4410
// Voices playing at once, at most; clips loaded.
MAX_VOICES :: 48
MAX_CLIPS :: 1024
// All the mix's voices are this loud together, so that several at once
// don't clip.
MASTER_VOLUME :: 0.8
// How far to one side a sound right beside the camera is heard: all the
// way (1) would leave the other ear with nothing.
SIDE_SPREAD :: 0.7
// A placed sound that doesn't loop is played again after a pause of this
// many seconds or up to twice that.
REPLAY_PAUSE :: 6

Audio_Error :: error {
	No_Audio          // SDL's audio couldn't be started
	No_Device         // no device to play on
	Not_Wave          // a sound file that isn't a WAV
	Not_Pcm           // a WAV of a kind not played: 16-bit PCM only
	Empty_Folder      // a sound naming a folder with no files
	No_Room_For_Sound // the clips' room is full
	No_Sound_File     // no file (or folder) of the path in the archives
	Wrong_Rate        // music at a rate other than the mix's
}

// A sound file loaded: its samples (16-bit, the channels interleaved, a
// view of the clips' room), its channels and rate, how many frames.
Clip :: struct {
	samples: []byte
	channels: i64
	rate: i64
	frames: i64
}

// A clip playing: where in it (in its frames, between two of them), how far
// it moves each frame of the mix (its rate and pitch), whether it loops;
// its loudness on the left and right now, and where they go by the end of
// the next mix; what it plays for (a placed sound's key, 0 for a one-shot)
// and whether that still wants it.
Voice :: struct {
	clip: i64
	at: f64
	step: f64
	looping: bool
	gains: [2!]f32
	targets: [2!]f32
	source: u64
	wanted: bool
	ended: bool
}

// The sound: SDL's stream (when it could be opened), the clips (found by
// their paths' hashes) and the room they're in, the voices, the mix, and
// what couldn't be played since the journal last told (how many, the
// first's path and why).
Mixer :: struct {
	stream: sdl.AudioStream
	open: bool
	clips: [MAX_CLIPS]Clip
	clip_index: Key_Index
	clip_room: []byte
	voices: [MAX_VOICES]Voice
	mix: [AHEAD * 2]f32
	seed: u64
	failures: i64
	first_failure: [160]utf8
	first_failure_reason: err
	music: Music
}

// Sets the audio up, closed: no clips, no voices; the clips' room (room_size
// bytes) and index carved from storage.
audio_init :: fun(audio: ^Mixer, room_size: i64, storage: ^[]byte) {
	audio.open = false
	audio.clips.len = 0
	audio.voices.len = 0
	audio.seed = 0x2545F4914F6CDD1D
	audio.failures = 0
	audio.first_failure.len = 0
	audio.clip_index = key_index(MAX_CLIPS * 2, storage)
	audio.clip_room = slice([:room_size]byte, storage)
	music_reset(&audio.music)
}

// Starts SDL's audio and opens the default device for a stereo mix.
// Failing, the audio stays closed (and silent): what's played is let go.
audio_open :: fun(audio: ^Mixer) -> err {
	if not sdl.InitSubSystem(sdl.Init_Flags.Audio) do return No_Audio
	audio.stream = sdl.OpenAudioDeviceStream(sdl.AUDIO_DEVICE_DEFAULT_PLAYBACK, sdl.AudioSpec{format = .F32, channels = 2, freq = MIX_RATE})
	if audio.stream == void do return No_Device
	_ = sdl.ResumeAudioStreamDevice(audio.stream)
	audio.open = true
}

audio_close :: fun(audio: ^Mixer) {
	stop_track(&audio.music)
	if audio.open do sdl.DestroyAudioStream(audio.stream)
	audio.open = false
}

// ---- clips -------------------------------------------------------------------------

// A WAV file's sound: its 16-bit PCM samples (a view of data), channels
// and rate.
read_wave :: fun(data: []byte) -> Clip, err {
	clip := Clip{samples = data[0:0], channels = 0, rate = 0, frames = 0}
	if data.len < 12 do return clip, Not_Wave
	riff : [4!]utf8 = data[0]
	wave : [4!]utf8 = data[8]
	if riff != "RIFF" or wave != "WAVE" do return clip, Not_Wave
	at : i64 = 12
	bits : i64 = 0
	for at + 8 <= data.len {
		chunk : [4!]utf8 = data[at]
		size : u32 = data[at + 4]
		body := at + 8
		end := min(body + i64(size), data.len)
		if chunk == "fmt " and end - body >= 16 {
			format : u16 = data[body]
			channels : u16 = data[body + 2]
			rate : u32 = data[body + 4]
			sample_bits : u16 = data[body + 14]
			if format != 1 do return clip, Not_Pcm
			clip.channels = i64(channels)
			clip.rate = i64(rate)
			bits = i64(sample_bits)
		elif chunk == "data"
			clip.samples = data[body : end]
		}
		at = body + i64(size) + i64(size & 1)
	}
	if bits != 16 or clip.channels < 1 or clip.channels > 2 or clip.rate == 0 do return clip, Not_Pcm
	clip.frames = clip.samples.len / (2 * clip.channels)
	return clip
}

// The clip for a sound (its index in the clips): its file's, loaded from
// the archives the first time; a folder's, one of its files at random (in
// the first archive with the folder).
clip_for :: fun(audio: ^Mixer, archives: ^Archives, kind: ^Sound_Kind) -> i64, err {
	path : [256]utf8
	if kind.folder {
		folder_path : []utf8 = kind.path
		if ends_with(folder_path, "\\") do folder_path = folder_path[0 : folder_path.len - 1]
		archive_at, folder_at, found := find_archived_folder(archives, folder_path)
		if not found do return -1, No_Sound_File
		archive := &archives.list[archive_at]
		folder := archive.folders[folder_at]
		if folder.file_count == 0 do return -1, Empty_Folder
		pick := folder.first_file + i64(next_random(&audio.seed) % u64(folder.file_count))
		&path + folder_path
		&path + "\\"
		&path + file_name(archive, archive.files[pick])
	else
		&path + kind.path
	}
	key := path_hash(path)
	known, found := index_get(&audio.clip_index, key)
	if found do return known
	if audio.clips.len == audio.clips.cap do return -1, No_Room_For_Sound
	sound_file, in_archive := find_archived(archives, path)
	if not in_archive do return -1, No_Sound_File
	if archived_size(archives, sound_file) > audio.clip_room.cap - audio.clip_room.len do return -1, No_Room_For_Sound
	data := read_archived(archives, sound_file, &audio.clip_room)?
	clip := read_wave(data)?
	&audio.clips + clip
	index_put(&audio.clip_index, key, audio.clips.len - 1)?
	return audio.clips.len - 1
}

// A 64-bit FNV-1a hash of a path, never 0.
path_hash :: fun(text: []utf8) -> u64 {
	hash : u64 = 0xCBF29CE484222325
	for c in text do hash = (hash ~ u64(c)) *% 0x100000001B3
	if hash == 0 do hash = 1
	return hash
}

// Remembers a sound that couldn't be played: how many, the first's path
// and why (for the journal: take_failures).
note_sound_failure :: fun(audio: ^Mixer, kind: ^Sound_Kind, reason: err) {
	audio.failures += 1
	if audio.failures == 1 {
		audio.first_failure.len = 0
		&audio.first_failure + kind.path
		audio.first_failure_reason = reason
	}
}

// ---- what's heard -------------------------------------------------------------------

// Where the camera hears from: its place, and its right.
Listener :: struct {
	position: Vec3
	right: Vec3
}

// How loud a sound is (as a share of full) from a distance: full within
// its near distance, then falling off with distance, to nothing at its far
// one; a 2D sound, as loud anywhere. Its quieting (decibels) on top.
loudness :: fun(kind: ^Sound_Kind, distance: f32) -> f32 {
	quieting := pow_f32(10, -kind.attenuation / 20)
	if kind.flags & SOUND_2D != 0 do return quieting
	if distance >= kind.max_distance do return 0
	near := max(kind.min_distance, 1)
	if distance <= near do return quieting
	falloff := near / distance
	fade := (kind.max_distance - distance) / (kind.max_distance - near)
	return quieting * falloff * min(1, fade * 4)
}

// The left and right gains of a sound at a place, as loud as given: by
// which side of the camera it's on (a 2D sound, or one heard all round,
// on both alike), keeping its power.
side_gains :: fun(kind: ^Sound_Kind, position: Vec3, listener: Listener, loud: f32) -> [2!]f32 {
	pan : f32 = 0
	if kind.flags & (SOUND_2D | SOUND_360_LFE) == 0 {
		toward := position - listener.position
		distance := vec3_length(toward)
		if distance > 1 do pan = dot(toward, listener.right) / distance * SIDE_SPREAD
	}
	return [loud * sqrt_f32((1 - pan) / 2) * 1.41421, loud * sqrt_f32((1 + pan) / 2) * 1.41421]
}

// Whether a sound plays at an hour of the day: always, or between its start
// and stop hours (round midnight, if the stop comes first).
plays_at_hour :: fun(kind: ^Sound_Kind, hour: f32) -> bool {
	if kind.start_hour == kind.stop_hour do return true
	if kind.start_hour < kind.stop_hour do return hour >= kind.start_hour and hour < kind.stop_hour
	return hour >= kind.start_hour or hour < kind.stop_hour
}

// Starts a voice playing a sound's clip, its gains starting at gains (a
// looping one from a place in its clip at random, so loops of one sound
// don't play in step): its index, -1 when no voice is free.
start_voice :: fun(audio: ^Mixer, kind: ^Sound_Kind, clip_index: i64, source: u64, gains: [2!]f32, looping: bool) -> i64 {
	if not fits(audio.voices.len + 1, audio.voices.cap) do return -1
	clip := audio.clips[clip_index]
	if clip.frames == 0 do return -1
	pitch := 1 + kind.pitch_shift
	if kind.flags & SOUND_RANDOM_PITCH != 0 do pitch *= 1 + (random_share(&audio.seed) - 0.5) * 0.1
	voice := next(&audio.voices)
	voice.clip = clip_index
	voice.at = 0
	if looping do voice.at = f64(random_share(&audio.seed)) * f64(clip.frames)
	voice.step = f64(clip.rate) / MIX_RATE * f64(pitch)
	voice.looping = looping
	voice.gains = if looping do [0, 0] else gains   // (a loop fades in)
	voice.targets = gains
	voice.source = source
	voice.wanted = true
	voice.ended = false
	return audio.voices.len - 1
}

// Plays a sound once at a place (a door opening, say), heard from where the
// listener is now.
play_once :: fun(audio: ^Mixer, archives: ^Archives, kind: ^Sound_Kind, position: Vec3, listener: Listener) {
	if not audio.open do return
	clip_index, clip_error := clip_for(audio, archives, kind)
	if clip_error {
		note_sound_failure(audio, kind, clip_error)
		return
	}
	loud := loudness(kind, vec3_length(position - listener.position))
	_ = start_voice(audio, kind, clip_index, 0, side_gains(kind, position, listener, loud), false)
}

// A sound placed in the scene, as the audio hears it: what it is, where, its
// key (the voice playing it is found by it), when it next plays (a sound
// that doesn't loop: in the mix's seconds), and how loud it is now (a
// share of its loudness: a weather's rain as the weather comes in).
Placed_Sound :: struct {
	kind: Sound_Kind
	position: Vec3
	key: u64
	next_play: f64
	volume: f32
}

// Hearing a frame's sounds: hear_start, then hear_sounds for each list of
// them, then hear_finish fades out the voices whose sound is gone or out
// of range.
hear_start :: fun(audio: ^Mixer) {
	for &voice in audio.voices do voice.wanted = voice.source == 0
}

hear_finish :: fun(audio: ^Mixer) {
	for &voice in audio.voices {
		if not voice.wanted do voice.targets = [0, 0]
	}
}

// Hears placed sounds from the listener at an hour: starts the loops in
// hearing range (and the others when their pause is over), and moves the
// playing ones' gains to where they are now. The time is the mix's, in
// seconds.
hear_sounds :: fun(audio: ^Mixer, archives: ^Archives, sounds: ^[]Placed_Sound, listener: Listener, hour: f32, now: f64) {
	if not audio.open do return
	for &sound in sounds {
		loud : f32 = 0
		if plays_at_hour(&sound.kind, hour) do loud = loudness(&sound.kind, vec3_length(sound.position - listener.position)) * sound.volume
		if loud <= 0.001 do continue
		gains := side_gains(&sound.kind, sound.position, listener, loud)
		playing : i64 = -1
		for &voice, k in audio.voices {
			if voice.source == sound.key {
				playing = k
				break
			}
		}
		if playing >= 0 {
			audio.voices[playing].targets = gains
			audio.voices[playing].wanted = true
			continue
		}
		// Not now: a sound that doesn't loop, before its pause is over; one
		// whose clip couldn't be loaded.
		if now < sound.next_play do continue
		looping := sound.kind.flags & SOUND_LOOP != 0
		if not looping do sound.next_play = now + f64(REPLAY_PAUSE * (1 + random_share(&audio.seed)))
		clip_index, clip_error := clip_for(audio, archives, &sound.kind)
		if clip_error {
			note_sound_failure(audio, &sound.kind, clip_error)
			sound.next_play = now + 1000000   // (not tried again)
			continue
		}
		_ = start_voice(audio, &sound.kind, clip_index, sound.key, gains, looping)
	}
}

// ---- the mix -------------------------------------------------------------------------

// How long the sound device takes to play what it's handed, past what's
// queued for it (a guess: Windows' shared mode and SDL's buffer).
DEVICE_DELAY :: 0.02

// How long a sound started now takes to be heard (seconds): what's queued
// ahead of it, and the device's own delay. 0 with no sound.
sound_delay :: fun(audio: ^Mixer) -> f32 {
	if not audio.open do return 0
	queued := i64(sdl.GetAudioStreamQueued(audio.stream)) / 8
	return f32(queued) / MIX_RATE + DEVICE_DELAY
}

// Mixes as much as keeps the stream AHEAD frames ahead of what's heard,
// and hands it to SDL; voices that ended (or faded out, unwanted) are let go.
mix_ahead :: fun(audio: ^Mixer) {
	if not audio.open do return
	queued := i64(sdl.GetAudioStreamQueued(audio.stream)) / 8
	frames := AHEAD - queued
	if frames <= 0 do return
	audio.mix.len = frames * 2
	for k in 0:audio.mix.len do audio.mix[k] = 0
	for &voice in audio.voices do mix_voice(audio, voice, frames)
	mix_music(audio, frames)
	for k in 0:audio.mix.len do audio.mix[k] = max(-1, min(1, audio.mix[k] * MASTER_VOLUME))
	_ = sdl.PutAudioStreamData(audio.stream, audio.mix)

	// Let go of the voices done: ended, or faded out and not wanted.
	kept : i64 = 0
	for k in 0:audio.voices.len {
		voice := audio.voices[k]
		silent := voice.gains[0] < 0.0001 and voice.gains[1] < 0.0001 and voice.targets[0] < 0.0001 and voice.targets[1] < 0.0001
		if voice.ended or (silent and not voice.wanted) do continue
		audio.voices[kept] = voice
		kept += 1
	}
	audio.voices.len = kept
}

// Adds a voice's next frames to the mix: its clip resampled (between two
// of its frames, in a line), its gains moving to their targets across them.
mix_voice :: fun(audio: ^Mixer, voice: ^Voice, frames: i64) {
	if voice.ended do return
	clip := audio.clips[voice.clip]
	samples := clip.samples
	stereo := clip.channels == 2
	left_step := (voice.targets[0] - voice.gains[0]) / f32(frames)
	right_step := (voice.targets[1] - voice.gains[1]) / f32(frames)
	left_gain := voice.gains[0]
	right_gain := voice.gains[1]
	for k in 0:frames {
		frame := i64(voice.at)
		share := f32(voice.at - f64(frame))
		after := frame + 1
		if after >= clip.frames do after = if voice.looping do 0 else frame
		left, right := clip_frame(samples, frame, stereo)
		next_left, next_right := clip_frame(samples, after, stereo)
		left_gain += left_step
		right_gain += right_step
		audio.mix[k * 2] += (left + (next_left - left) * share) * left_gain
		audio.mix[k * 2 + 1] += (right + (next_right - right) * share) * right_gain
		voice.at += voice.step
		if voice.at >= f64(clip.frames) {
			if not voice.looping {
				voice.ended = true
				break
			}
			voice.at -= f64(clip.frames)
		}
	}
	voice.gains = voice.targets
}

// A clip's frame as left and right samples, -1 to 1 (a mono clip's on both).
clip_frame :: fun(samples: []byte, frame: i64, stereo: bool) -> f32, f32 {
	if stereo {
		left : i16 = samples[frame * 4]
		right : i16 = samples[frame * 4 + 2]
		return f32(left) / 32768, f32(right) / 32768
	}
	middle : i16 = samples[frame * 2]
	value := f32(middle) / 32768
	return value, value
}
