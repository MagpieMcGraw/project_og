// The game's files as the game loads them: its plugins in their order,
// and their archives — the master's (Oblivion.ini's SArchiveList) and each
// plugin's own, named after it (Knights.bsa; "DLCShiveringIsles -
// Meshes.bsa").
module game_files

use mara.core
use mara.os
use mara.memory
use mara.string
use mara.time
use mara.math
use bsa
use esm
use world
use land
use scene

// The plugins loaded, at most.
MAX_PLUGINS :: 16

// The master's archives, as Oblivion.ini's SArchiveList has them unless
// it's been changed.
MASTER_ARCHIVES :: "Oblivion - Meshes.bsa, Oblivion - Textures - Compressed.bsa, Oblivion - Sounds.bsa, Oblivion - Voices1.bsa, Oblivion - Voices2.bsa, Oblivion - Misc.bsa"

// A plugin file the game loads: its name in the data folder, and when it
// was last written (the game's order goes by it).
Plugin_File :: struct {
	name: [64]utf8
	written: i64
}

// The plugins the game loads, in its order: the master first.
Load_Order :: struct {
	plugins: [MAX_PLUGINS]Plugin_File
	listed_in: [16]utf8                  // the list of plugins read: Plugins.txt, or DLCList.txt
	missing: [MAX_PLUGINS]Plugin_File    // those it names that the data folder hasn't (written 0)
}

// The plugins the game loads, in its order: Oblivion.esm, then those the
// player chose (Plugins.txt, in their local app data) that are in the data
// folder, the one written longest ago first, as the game orders them.
// Without a Plugins.txt, the downloaded content the game keeps track of
// (the data folder's DLCList.txt) instead.
read_load_order :: fun(order: ^Load_Order) -> err {
	order.plugins.len = 0
	order.missing.len = 0
	add_plugin(order, "Oblivion.esm")
	storage : [16 * KB]byte
	order.listed_in.len = 0
	text := read_player_plugins(&storage)?
	if text.len > 0 {
		&order.listed_in + "Plugins.txt"
	else
		&order.listed_in + "DLCList.txt"
		list_path := data_path("DLCList.txt")
		data, read_error := read_entire_file(list_path, &storage)
		if read_error == File_Error.Open_Failed do return   // (no downloaded content)
		if read_error do return read_error
		text = data
	}
	start : i64 = 0
	for at in 0..text.len {
		if at < text.len and text[at] != '\n' do continue
		line := trimmed(text[start : at])
		start = at + 1
		if line.len == 0 or line[0] == '#' do continue
		add_plugin(order, line)
	}
}

// The player's chosen plugins, %LOCALAPPDATA%\Oblivion\Plugins.txt, read
// into storage; empty when there's no such file.
read_player_plugins :: fun(storage: ^[]byte) -> []utf8, err {
	none_read : []utf8 = storage[0:0]   // (`return []` gives back an array: MARA_ISSUES.md)
	local, env_error := env("LOCALAPPDATA")
	if env_error == Env_Error.Not_Set do return none_read
	if env_error do return none_read, env_error
	ending := "/Oblivion/Plugins.txt"
	if local.len + ending.len >= local.cap do return none_read
	path := local + ending
	data, read_error := read_entire_file(path, storage)
	if read_error == File_Error.Open_Failed do return none_read
	if read_error do return none_read, read_error
	return data
}

// Adds a plugin to the load order by when it was written, after the master
// (which stays first); not one there already. One the data folder hasn't
// goes into the missing instead.
add_plugin :: fun(order: ^Load_Order, name: []utf8) {
	if order.plugins.len == order.plugins.cap or name.len > 64 do return
	for &plugin in order.plugins {
		if compare_folded(plugin.name, name) == 0 do return
	}
	added := Plugin_File{name = [], written = 0}
	&added.name + name
	path := data_path(name)
	written := file_mtime(path)
	if written == 0 {
		if order.missing.len < order.missing.cap do &order.missing + added
		return
	}
	added.written = written
	place := order.plugins.len
	for place > 1 and order.plugins[place - 1].written > written do place -= 1
	order.plugins.len += 1
	moved := order.plugins.len - 1
	for moved > place {
		order.plugins[moved] = order.plugins[moved - 1]
		moved -= 1
	}
	order.plugins[place] = added
}

// Opens the game's archives into archives, in the order a file is looked
// for in them: each plugin's own, the last loaded first (so a plugin's
// files win over those of the plugins before it), then the master's. Their
// directories go into storage.
open_game_archives :: fun(order: ^Load_Order, archives: ^Archives, storage: ^[]byte) -> err {
	archives.list.len = 0
	listing : [256 * KB]byte
	entries := dir_read(DATA_FOLDER, &listing)?
	for back in 1:order.plugins.len {
		name := order.plugins[order.plugins.len - back].name[:]
		stem := name[0 : name.len - 4]   // (without ".esp")
		for entry in entries {
			if entry.dir or not plugin_archive(stem, entry.name) do continue
			open_one_archive(archives, entry.name, storage)?
		}
	}
	list := MASTER_ARCHIVES
	start : i64 = 0
	for at in 0..list.len {
		if at < list.len and list[at] != ',' do continue
		name := trimmed(list[start : at])
		start = at + 1
		if name.len > 0 do open_one_archive(archives, name, storage)?
	}
}

// The game's archives opened as the viewer has them, for a command.
open_all_archives :: fun(archives: ^Archives, storage: ^[]byte) -> err {
	order : Load_Order
	read_load_order(&order)?
	open_game_archives(&order, archives, storage)?
}

// Whether an archive in the data folder is a plugin's own: named after it
// (its name without the extension, the stem), alone or followed by " - "
// and what it holds. Letters' case not minded.
plugin_archive :: fun(stem: []utf8, name: []utf8) -> bool {
	if name.len <= stem.len or compare_folded(name[0 : stem.len], stem) != 0 do return false
	if compare_folded(name[name.len - 4 : name.len], ".bsa") != 0 do return false
	rest := name[stem.len : name.len]
	return rest.len == 4 or (rest.len > 3 and rest[0:3] == " - ")
}

// Opens an archive in the data folder and adds it to archives.
open_one_archive :: fun(archives: ^Archives, name: []utf8, storage: ^[]byte) -> err {
	if archives.list.len == archives.list.cap do return Too_Many_Archives
	path := data_path(name)
	archive := open_archive(path, storage)?
	&archives.list + archive
}

Game_Files_Error :: error {
	Too_Many_Archives   // more archives than MAX_ARCHIVES
}

// Where the game's data is, unless a command is given a path.
DATA_FOLDER :: "D:/SteamLibrary/steamapps/common/Oblivion/Data/"

// A path given on the command line, or a file in the data folder.
data_path :: fun(name: []utf8) -> Path {
	path : Path
	if contains_separator(name) {
		&path + name
	else
		&path + DATA_FOLDER
		&path + name
	}
	return path
}

contains_separator :: fun(name: []utf8) -> bool {
	for c in name {
		if path_separator(c) or c == ':' do return true
	}
	return false
}

// Writes data to a new file at path (or over the one there).
write_entire_file :: fun(path: []utf8, data: []byte) -> err {
	file := file_open_write(path)?
	defer file_close(file)
	rest := data
	for rest.len > 0 {
		written := file_write(file, rest)?
		if written <= 0 do return Write_Failed
		rest = rest[written : rest.len]
	}
}

// The game's plugins (Oblivion.esm and the downloaded content, in the
// game's order), read one after another into data_storage and indexed into
// index_storage: what the viewer and the cell commands start from.
load_oblivion :: fun(data_storage: ^[]byte, index_storage: ^[]byte) -> Plugin, err {
	start := time_now()
	order : Load_Order
	read_load_order(&order)?
	plugin := Plugin{0}
	first := data_storage.len
	for &file, k in order.plugins {
		at := data_storage.len - first
		path := data_path(file.name)
		data := read_entire_file(path, data_storage)?
		span := Plugin_Span{0}
		&span.name + file.name
		span.start = at
		span.end = at + data.len
		span.own_index = u32(k)
		&plugin.files + span
	}
	plugin.data = data_storage[first : data_storage.len]
	index_plugin(&plugin, index_storage)?
	print("indexed % records of % plugins in % ms: % cells' groups, % exterior cells, % worlds with persistent cells",
		plugin.records.count, plugin.files.len, elapsed_ms(start), plugin.cell_children.count, plugin.exterior_cells.count, plugin.persistent_cells.count)
	return plugin
}

// The record whose editor id is name (any letter case): its form id; false
// when there's none. (Every record is looked at.)
find_by_editor_id :: fun(plugin: ^Plugin, name: []utf8, scratch: ^[]byte) -> u32, bool {
	for key, slot in plugin.records.keys {
		if key == 0 do continue
		scratch.len = 0
		record, record_error := record_at(plugin, i64(plugin.records.values[slot]), scratch)
		if record_error do continue
		if compare_folded(editor_id(record.data), name) == 0 do return u32(key), true
	}
	return 0, false
}

// Milliseconds since start, a time_now.
elapsed_ms :: fun(start: u64) -> i64 {
	return i64((time_now() - start) / 1000000)
}

// The rooms loading uses, as views of storages the caller keeps: each up
// to its cap ( would stop at its len, 0 here).
load_room :: fun(file_room: ^[]byte, block_room: ^[]byte, model_room: ^[]byte, texture_room: ^[]byte) -> Load_Room {
	return Load_Room{
		file = file_room[0 : file_room.cap],
		blocks = block_room[0 : block_room.cap],
		model = model_room[0 : model_room.cap],
		texture = texture_room[0 : texture_room.cap]}
}


// A record's editor id, as text kept by value.
editor_id_of :: fun(plugin: ^Plugin, form_id: u32) -> str256 {
	scratch : [1 * MB]byte
	name : str256
	record, record_error := find_record(plugin, form_id, &scratch)
	if not record_error do &name + editor_id(record.data)
	return name
}


// The height of the land a world shows under a place: its nearest vertex's.
// 0 where there's no land.
ground_height :: fun(plugin: ^Plugin, world_id: u32, place: Vec3, scratch: ^[]byte) -> f32 {
	x, y := grid_of(place)
	parent, parent_error := world_parent(plugin, world_id, scratch)
	if parent_error do parent = 0
	land_at, found := shown_land(plugin, world_id, parent, x, y)
	if not found do return 0
	scratch.len = 0
	record, record_error := record_at(plugin, land_at, scratch)
	if record_error do return 0
	cell_land : Land
	read_land(plugin, record, &cell_land)
	column := i64((place.x - f32(x * CELL_SIZE)) / LAND_SPACING + 0.5)
	row := i64((place.y - f32(y * CELL_SIZE)) / LAND_SPACING + 0.5)
	return cell_land.heights[row * LAND_SIDE + column]
}
