// throne: a source port of Throne of Darkness (Click Entertainment,
// 2001), written in Mara. It will run on the game's own files (its
// LotFiles\*.lot archives: FORMATS.md says what's in them).
//
// For now it is the game's skeleton: a window, and players in one room,
// each walking where they click, the world kept by a server (server and
// client from the start). Opened twice, the second joins the first's game.
//
//     throne                          the game: joins one on this machine, else hosts
//     throne connect <address>        the game, joining the one at an address
//     throne serve [port] [seconds] [open]   a server alone, no window
//     throne bot [seconds] [address]  a player with no window, walking about
//     throne picture <out.png> [seconds] [address] [click x y] [strike] [collision]   the game unseen, its last frame written
module throne

use mara.core
use mara.os
use mara.math
use mara.memory
use mara.time
use mara.string
use mara.sdl
use mara.open_gl
use world_state
use world_server
use world_copy
use game_link
use wire
use sdl_platform
use sprite_layer
use lot
use spr8
use art
use lex
use level
use level_art
use walk_grid
use world_level
use audio
use music_cache
use text
use png
use disk
use game_controls
use logging

#allocator Arena_Basic(256 * MB)

// The window's size at first, in pixels; frames a second, at most.
WINDOW_WIDTH :: 800
WINDOW_HEIGHT :: 600
FRAME_RATE :: 60.0
// A player as drawn: a square this many room pixels across.
PLAYER_SIZE :: 24.0
// How far above a player's feet their name is drawn (level pixels).
NAME_HEIGHT :: 128.0

// What a player does (og's game_controls), and what does each unless the
// controls file (CONTROLS_FILE, beside the journal) says otherwise: walking
// where the mouse is (held, following it), striking toward it, showing
// what stops one, leaving.
CONTROL_WALK :: 0
CONTROL_STRIKE :: 1
CONTROL_SHOW_COLLISION :: 2
CONTROL_QUIT :: 3
CONTROL_NAMES :: ["walk", "strike", "show_collision", "quit"]
CONTROL_DEFAULTS :: ["Mouse_Left", "Mouse_Right", "F2", "Escape"]
CONTROLS_FILE :: "throne_controls.txt"
CONTROLS_TITLE :: "Throne's controls"

// The journal: a log file, the first of throne.log, throne_2.log, …
// that no other copy of the game is writing; the console only when none.
open_journal :: fun() -> Journal {
	for copy in 1..8 {
		path : str64
		&path + "throne"
		if copy > 1 {
			&path + "_"
			&path + int_text(copy)
		}
		&path + ".log"
		file, open_error := file_open_write(path)
		if not open_error do return Journal{file = file, started = time_now(), line = []}
	}
	print("no journal file can be written: the console only")
	return Journal{file = NO_FILE, started = time_now(), line = []}
}

// ---- the game ---------------------------------------------------------------

// Where the level is drawn in the window: where its pixel 0, 0 falls, and
// window pixels to a level pixel. The window shows VIEW_HEIGHT of the
// level's pixels down, as the original's 800 x 600 screen did, its middle
// on what the camera looks at.
VIEW_HEIGHT :: 600.0
View :: struct {
	left: f32
	top: f32
	scale: f32
}

view_of :: fun(platform: ^Platform, camera_x: f32, camera_y: f32) -> View {
	scale := f32(platform.height) / f32(VIEW_HEIGHT)
	return View{left = f32(platform.width) / 2 - camera_x * scale, top = f32(platform.height) / 2 - camera_y * scale, scale = scale}
}

// A player's colour, by their number: the first eight told apart.
PLAYER_COLOURS :: [8!][3!]f32{{0.9, 0.75, 0.2}, {0.3, 0.6, 0.95}, {0.85, 0.3, 0.3}, {0.35, 0.8, 0.4},
	{0.75, 0.45, 0.9}, {0.95, 0.55, 0.2}, {0.3, 0.85, 0.85}, {0.9, 0.9, 0.9}}

// Fills a rectangle of the window (pixels from its top left) with a
// colour: the scissor box cleared.
fill :: fun(platform: ^Platform, x: f32, y: f32, width: f32, height: f32, colour: [3!]f32) {
	Scissor(i32(x), i32(f32(platform.height) - y - height), i32(width), i32(height))
	ClearColor(colour[0], colour[1], colour[2], 1)
	Clear(COLOR_BUFFER_BIT)
}

// What the window draws and plays with: the layer pictures go on, the
// samurai's pictures (if they could be read), the level's (once the
// server's said which), when the game started (for frames), what the
// camera looks at; the sound (og's mixer, its level's music), when heard.
AUDIO_STORAGE :: 2 * MB
AUDIO_CLIP_ROOM :: 1 * MB
Game_View :: struct {
	layer: Sprite_Layer
	white: u32          // a texture of one white pixel, for plain rectangles
	art: Samurai_Art
	font: Font          // the chat font, for names over players
	level: Level_Art
	started: u64
	camera_x: f32
	camera_y: f32
	shown: [MAX_PLAYERS]Shown_Player   // the players as drawn (ease_players)
	eased_at: u64
	sound: bool         // the mixer's open: it's mixed every frame
	mixer: Mixer
	mixer_storage: [AUDIO_STORAGE]byte
	show_collision: bool   // what stops one drawn over the level (F2 turns it on and off)
}

// The view made ready (a GL context current), and its sound opened when
// sound is wanted (not for pictures). When the samurai can't be read, the
// journal says why and players are drawn as squares; without sound, it's
// silent.
view_open :: fun(view: ^Game_View, journal: ^Journal, sound: bool) {
	view.started = time_now()
	view.art.ready = false
	view.level.ready = false
	view.level.name.len = 0
	view.shown.len = 0
	view.eased_at = time_now()
	view.sound = false
	view.show_collision = false
	if sound {
		view.mixer_storage.len = 0
		audio_init(&view.mixer, AUDIO_CLIP_ROOM, &view.mixer_storage)
		audio_error := audio_open(&view.mixer)
		if audio_error {
			note(journal, "no sound: ")
			note_error(journal, audio_error)
			note_end(journal)
		else
			view.sound = true
		}
	}
	layer_error := layer_open(&view.layer)
	if layer_error {
		note(journal, "can't draw pictures: ")
		note_error(journal, layer_error)
		note_end(journal)
		return
	}
	white : [4!]u8 = [255, 255, 255, 255]
	view.white = texture_from_pixels(white[:], 1, 1)
	start := time_now()
	art_error := load_samurai_art(&view.art)
	if art_error and not view.art.ready {
		note(journal, "couldn't read the samurai (players drawn as squares): ")
		note_error(journal, art_error)
		note_end(journal)
		return
	}
	if art_error {
		note(journal, "some samurai's attacks couldn't be read (they stand instead): ")
		note_error(journal, art_error)
		note_end(journal)
	}
	note(journal, "samurai read in ")
	note(journal, i64((time_now() - start) / 1000000))
	note(journal, " ms")
	note_end(journal)
	font_error := load_font(&view.font, CHAT_FONT)
	if font_error {
		note(journal, "couldn't read the chat font (no names over players): ")
		note_error(journal, font_error)
		note_end(journal)
	}
}

// Has the level the server says we're in drawn: its pictures read when
// it's a level not read yet (the journal says how it went).
take_level :: fun(seen: ^World_Copy, view: ^Game_View, journal: ^Journal) {
	if seen.me == 0 or same_text(seen.level, view.level.name) do return
	if seen.level.len == 0 {
		view.level.ready = false
		view.level.name.len = 0
		return
	}
	start := time_now()
	level_error := load_level_art(&view.level, seen.level)
	if level_error {
		note(journal, "couldn't read the level ")
		note(journal, seen.level)
		note(journal, ": ")
		note_error(journal, level_error)
		note_end(journal)
		// (Not tried again: its name is kept.)
		view.level.name = seen.level
		return
	}
	play_level_music(view, journal)
	note(journal, "level ")
	note(journal, seen.level)
	note(journal, " read in ")
	note(journal, i64((time_now() - start) / 1000000))
	note(journal, " ms: ")
	note(journal, view.level.pieces.len)
	note(journal, " things, ")
	note(journal, view.level.textures.len)
	note(journal, " pictures")
	if view.level.missing > 0 {
		note(journal, ", ")
		note(journal, view.level.missing)
		note(journal, " not found")
	}
	note(journal, "; ")
	note(journal, view.level.outlines.len)
	note(journal, " outlines")
	if view.level.walk_error {
		note(journal, "; its walk grid couldn't be read: ")
		note_error(journal, view.level.walk_error)
	elif not view.level.walk_known
		note(journal, "; no walk grid to show (where it lies isn't known)")
	}
	note_end(journal)
}

// The level's music playing (its track unpacked to the cache the first
// time: music_cache.mara), when there's sound.
play_level_music :: fun(view: ^Game_View, journal: ^Journal) {
	if not view.sound or view.level.music.len == 0 do return
	folder, music_error := track_folder(view.level.music)
	if music_error {
		note(journal, "no music for the level (")
		note(journal, view.level.music)
		note(journal, "): ")
		note_error(journal, music_error)
		note_end(journal)
		return
	}
	want_music(&view.mixer, folder)
	note(journal, "music: ")
	note(journal, view.level.music)
	note_end(journal)
}

same_text :: fun(a: []utf8, b: []utf8) -> bool {
	if a.len != b.len do return false
	for c, k in a {
		if b[k] != c do return false
	}
	return true
}

// A player as drawn: their number, where they're drawn.
Shown_Player :: struct {
	id: i64
	x: f32
	y: f32
	strikes: i64          // their strikes as last told
	strike_started: u64   // when their last strike was first seen (time_now)
}
// How fast drawn places catch up with where the server says players are
// (a share of the way, per second: the server's told 30 times a second, the
// window drawn more often); a move further than JUMP pixels is drawn at once.
EASE_RATE :: 20.0
JUMP :: 200.0

// The players' drawn places, eased toward where the server last said they
// are, in the order the server lists them (view.shown[k] is seen.players[k]'s).
ease_players :: fun(seen: ^World_Copy, view: ^Game_View) {
	now := time_now()
	gone := f32(f64(now - view.eased_at) / 1000000000)
	view.eased_at = now
	share := min(f32(1), gone * f32(EASE_RATE))
	kept : [MAX_PLAYERS]Shown_Player
	for player in seen.players {
		shown := Shown_Player{id = player.id, x = player.x, y = player.y, strikes = player.strikes, strike_started = now}
		for old in view.shown {
			if old.id != player.id do continue
			if abs(player.x - old.x) + abs(player.y - old.y) < f32(JUMP) {
				shown.x = old.x + (player.x - old.x) * share
				shown.y = old.y + (player.y - old.y) * share
			}
			// (The same strike as before: it started when first seen.)
			if old.strikes == player.strikes do shown.strike_started = old.strike_started
		}
		&kept + shown
	}
	view.shown = kept
}

// The camera on our player as drawn, once the server's told where they are
// (else on the middle of the level's area).
follow_player :: fun(seen: ^World_Copy, view: ^Game_View) {
	for player, k in seen.players {
		if player.id != seen.me or seen.me == 0 or k >= view.shown.len do continue
		view.camera_x = view.shown[k].x
		view.camera_y = view.shown[k].y
		return
	}
	view.camera_x = (seen.area.left + seen.area.right) / 2
	view.camera_y = (seen.area.top + seen.area.bottom) / 2
}

// Draws the world as the server's told it: the level (or its bare area,
// without its pictures), and each player — a samurai, those higher on the
// screen first so lower ones stand in front; ours with a light mark at its
// feet. (Squares, without the samurai.) Over it all, what stops one, when
// it's shown (show_collision).
draw_world :: fun(platform: ^Platform, seen: ^World_Copy, view: ^Game_View) {
	Disable(SCISSOR_TEST)
	ClearColor(0.04, 0.04, 0.05, 1)
	Clear(COLOR_BUFFER_BIT)
	Enable(SCISSOR_TEST)
	Disable(SCISSOR_TEST)
	room := view_of(platform, view.camera_x, view.camera_y)
	seconds := f64(time_now() - view.started) / 1000000000
	layer_begin(&view.layer)
	if view.level.ready {
		draw_level(&view.layer, &view.level, room.left, room.top, room.scale, platform.width, platform.height, seconds)
	else
		area := seen.area
		rectangle(view, room.left + area.left * room.scale, room.top + area.top * room.scale, (area.right - area.left) * room.scale,
			(area.bottom - area.top) * room.scale, [4!]f32{0.16, 0.13, 0.1, 1})
	}
	// The players by how far down they're drawn.
	order : [MAX_PLAYERS]i64
	for shown, k in view.shown {
		&order + k
		at := order.len - 1
		for at > 0 and view.shown[order[at - 1]].y > shown.y {
			order[at] = order[at - 1]
			at -= 1
		}
		order[at] = k
	}
	for k in order {
		if k >= seen.players.len do continue
		player := seen.players[k]
		x := room.left + view.shown[k].x * room.scale
		y := room.top + view.shown[k].y * room.scale
		if not view.art.ready {
			half := f32(PLAYER_SIZE) / 2 * room.scale
			if player.id == seen.me do rectangle(view, x - half - 2, y - half - 2, half * 2 + 4, half * 2 + 4, [4!]f32{1, 1, 0.85, 1})
			colour := PLAYER_COLOURS[(player.id - 1) % 8]
			rectangle(view, x - half, y - half, half * 2, half * 2, [4!]f32{colour[0], colour[1], colour[2], 1})
			continue
		}
		if player.id == seen.me do rectangle(view, x - 12 * room.scale, y - 2 * room.scale, 24 * room.scale, 4 * room.scale, [4!]f32{1, 1, 0.85, 0.8})
		action := if player.walking do ACTION_RUN else ACTION_STAND
		if player.striking do action = ACTION_ATTACK
		done := f32(f64(time_now() - view.shown[k].strike_started) / 1000000000) / f32(STRIKE_SECONDS)
		draw_samurai(&view.layer, &view.art, player.look, action, player.facing, seconds, x, y, room.scale, done)
		// Their samurai's name over their head (ours brighter).
		name := SAMURAI[player.look % SAMURAI_LOOKS]
		name_scale := room.scale
		name_colour := if player.id == seen.me do [4!]f32{1, 1, 0.8, 1} else [4!]f32{0.85, 0.85, 0.85, 0.9}
		draw_text(&view.layer, &view.font, name, x - text_width(&view.font, name, name_scale) / 2, y - f32(NAME_HEIGHT) * room.scale, name_scale,
			name_colour)
	}
	if view.show_collision and view.level.ready {
		draw_collision(&view.layer, &view.level, view.white, room.left, room.top, room.scale, platform.width, platform.height)
	}
	layer_draw(&view.layer, platform.width, platform.height)
}

// Puts a plain rectangle of a colour on the layer (the white texture tinted).
rectangle :: fun(view: ^Game_View, x: f32, y: f32, width: f32, height: f32, colour: [4!]f32) {
	layer_image(&view.layer, view.white, x, y, width, height, 0, 0, 1, 1, colour)
}

// The controls a player starts with: the game's own, then what the controls
// file changes (the journal says which lines it couldn't take). With no
// file, one's written with the game's own, for the player to change. Not
// from the file: the game's own alone (for pictures and checks, the same
// every time).
open_controls :: fun(controls: ^Controls, journal: ^Journal, from_file: bool) {
	start_error := game_own_controls(controls)
	if start_error {
		note(journal, "the game's own controls don't read: ")
		note_error(journal, start_error)
		note_end(journal)
		return
	}
	if not from_file do return
	_, missing := file_stamp(CONTROLS_FILE)
	if missing {
		write_error := controls_write(controls, CONTROLS_FILE, CONTROLS_TITLE)
		note(journal, "no controls file: ")
		if write_error {
			note(journal, "couldn't write one: ")
			note_error(journal, write_error)
		else
			note(journal, "written with the game's own, ")
			note(journal, CONTROLS_FILE)
		}
		note_end(journal)
		return
	}
	not_understood : [16]i64
	read_error := controls_read(controls, CONTROLS_FILE, &not_understood)
	if read_error {
		note(journal, "couldn't read the controls file (the game's own kept): ")
		note_error(journal, read_error)
		note_end(journal)
		return
	}
	note(journal, "controls from ")
	note(journal, CONTROLS_FILE)
	if not_understood.len > 0 {
		note(journal, "; lines not understood (passed over):")
		for line in not_understood {
			note(journal, " ")
			note(journal, line)
		}
	}
	note_end(journal)
}

// The game's actions, each on what the game puts it on (CONTROL_NAMES and
// CONTROL_DEFAULTS: action CONTROL_WALK is the first, and so on).
game_own_controls :: fun(controls: ^Controls) -> err {
	controls_start(controls)
	for name, k in CONTROL_NAMES {
		// (Each by itself: a list of constant texts handed over whole as a
		// [][]utf8 arrives garbled, compiler 373ba2b7.)
		_ = controls_add(controls, name, CONTROL_DEFAULTS[k])?
	}
}

// One frame of the game, as the controls have it: walking where the mouse
// is (held, following it), striking toward it, what stops one shown or
// not; the link run, the world drawn.
game_frame :: fun(platform: ^Platform, input: ^Input, controls: ^Controls, link: ^Link, journal: ^Journal, view: ^Game_View) {
	room := view_of(platform, view.camera_x, view.camera_y)
	mouse_x := (input.mouse_x - room.left) / room.scale
	mouse_y := (input.mouse_y - room.top) / room.scale
	if action_down(controls, CONTROL_WALK) do send_go(outgoing(link), mouse_x, mouse_y)
	if action_pressed(controls, CONTROL_STRIKE) do send_strike(outgoing(link), mouse_x, mouse_y)
	if action_pressed(controls, CONTROL_SHOW_COLLISION) do view.show_collision = not view.show_collision
	link_run(link, journal)
	take_level(&link.seen, view, journal)
	ease_players(&link.seen, view)
	follow_player(&link.seen, view)
	Viewport(0, 0, i32(platform.width), i32(platform.height))
	draw_world(platform, &link.seen, view)
	if view.sound do mix_ahead(&view.mixer)
}

// The level a game starts in (START_LEVEL), its area, its walk grid into
// walk and its ways out into exits (world_level.mara): a server hosting
// the game needs them. Players start at its shrine.
start_level :: fun(journal: ^Journal, walk: ^Walk_Grid, exits: ^[]Exit) -> [48]utf8, Area {
	return read_world_level(START_LEVEL, "", walk, exits, journal)
}

// The game in a window: joining the game at an address, or with none, the
// one hosted on this machine, else hosting it. Quitting (Escape, unless
// the controls file says otherwise) or closing the window ends it. False
// when it couldn't start (and it says why).
command_play :: fun(address: []utf8) -> bool {
	journal := open_journal()
	defer journal_close(&journal)
	walk : Walk_Grid
	exits : [WORLD_EXITS]Exit
	level_name, area := start_level(&journal, &walk, &exits)
	link : Link
	link_error := link_open(&link, &journal, address, level_name, area, &walk, exits)
	if link_error {
		note(&journal, "couldn't join the game: ")
		note_error(&journal, link_error)
		note_end(&journal)
		return false
	}
	defer link_close(&link)
	platform, open_error := platform_open("throne", WINDOW_WIDTH, WINDOW_HEIGHT)
	if open_error {
		note(&journal, "couldn't open the window: ")
		note_error(&journal, open_error)
		note_end(&journal)
		return false
	}
	defer platform_close(&platform)
	view : Game_View
	view_open(&view, &journal, true)
	defer audio_close(&view.mixer)
	controls : Controls
	open_controls(&controls, &journal, true)
	input : Input
	for true {
		work := Timer()
		read_input(&platform, &input)
		controls_update(&controls, &input)
		if input.quit or action_pressed(&controls, CONTROL_QUIT) do break
		game_frame(&platform, &input, &controls, &link, &journal, &view)
		_ = present(&platform)
		sleep(work, FRAME_RATE)
	}
	return true
}

// `throne picture <out.png> [seconds] [address] [click x y] [strike]
// [collision]`: the game as a player opening it sees it (linked as
// command_play links), in a window that's never shown, for that many
// seconds (2 unless told); its player clicked at the start to walk to a
// spot — x and y shares of the window across and down, 0.8 0.8 unless
// told (strike: right-clicked, to strike toward it); collision: what stops
// one drawn over the level, as F2 shows it. The last frame is written to
// out.png. For looking at what the game draws without a window.
command_picture :: fun(path: []utf8, seconds: f64, address: []utf8, click_x: f32, click_y: f32, strike: bool, collision: bool) {
	journal := open_journal()
	defer journal_close(&journal)
	walk : Walk_Grid
	exits : [WORLD_EXITS]Exit
	level_name, area := start_level(&journal, &walk, &exits)
	link : Link
	link_error := link_open(&link, &journal, address, level_name, area, &walk, exits)
	if link_error {
		print("couldn't join the game: %", link_error)
		return
	}
	defer link_close(&link)
	platform, open_error := platform_open("throne", WINDOW_WIDTH, WINDOW_HEIGHT, true)
	if open_error {
		print("couldn't open the window: %", open_error)
		return
	}
	defer platform_close(&platform)
	view : Game_View
	view_open(&view, &journal, false)
	view.show_collision = collision
	// (The game's own controls: the mouse's buttons, as a player's would be.)
	controls : Controls
	open_controls(&controls, &journal, false)
	input : Input
	struck := false
	start := time_now()
	for true {
		work := Timer()
		gone := f64(time_now() - start) / 1000000000
		// (Striking: the right button pressed once, at 0.1 s.)
		input.mouse_held[1] = not strike and gone > 0.1 and gone < 0.2
		input.mouse_pressed[3] = strike and gone > 0.1 and not struck
		if input.mouse_pressed[3] do struck = true
		input.mouse_x = f32(platform.width) * click_x
		input.mouse_y = f32(platform.height) * click_y
		controls_update(&controls, &input)
		game_frame(&platform, &input, &controls, &link, &journal, &view)
		if gone >= seconds {
			save_frame(&platform, path, &journal)
			break
		}
		_ = present(&platform)
		sleep(work, FRAME_RATE)
	}
	bot_status(&link, &journal)
}

// What's been drawn this frame (not shown yet), written to a PNG at path.
save_frame :: fun(platform: ^Platform, path: []utf8, journal: ^Journal) {
	pixels : [16 * MB]byte = void
	read_pixels(platform.width, platform.height, &pixels)
	if pixels.len == 0 {
		note(journal, "no picture: no room for its pixels")
		note_end(journal)
		return
	}
	// The rows from the top down, as a PNG has them.
	upright : [16 * MB]byte = void
	upright.len = pixels.len
	row := platform.width * 4
	for y in 0:platform.height {
		from := (platform.height - 1 - y) * row
		for k in 0:row do upright[y * row + k] = pixels[from + k]
		for x in 0:platform.width do upright[y * row + x * 4 + 3] = u8(255)
	}
	png_storage : [16 * MB]byte = void
	row_storage : [32 * MB]byte = void
	encode_png(upright, platform.width, platform.height, &png_storage, &row_storage)
	write_error := write_entire_file(path, png_storage)
	if write_error {
		note(journal, "couldn't write the picture: ")
		note_error(journal, write_error)
		note_end(journal)
		return
	}
	note(journal, "picture written to ")
	note(journal, path)
	note_end(journal)
}

write_entire_file :: fun(path: []utf8, data: []byte) -> err {
	file := file_open_write(path)?
	defer file_close(file)
	rest := data
	for rest.len > 0 {
		written := file_write(file, rest)?
		if written <= 0 do return Write_Failed
		rest = rest[written : rest.len]
	}
}

// ---- without a window -------------------------------------------------------

// `throne serve [port] [seconds] [open]`: the game's server alone, no
// window, players connecting to it (`throne connect`): on this machine's
// own address only, or open to others; for that many seconds (0: till it's
// stopped). Who joins and leaves is told.
command_serve :: fun(port: i64, seconds: f64, open: bool) {
	journal := open_journal()
	defer journal_close(&journal)
	walk : Walk_Grid
	exits : [WORLD_EXITS]Exit
	level_name, area := start_level(&journal, &walk, &exits)
	server : World_Server
	server_start(&server, level_name, area, &walk, exits, true)
	listen_error := server_listen(&server, u16(port), open)
	if listen_error {
		print("couldn't listen on port %: %", port, listen_error)
		return
	}
	defer server_stop(&server)
	print("serving the game on port % (%)", port, if open do "open to others" else "this machine's only")
	start := time_now()
	for seconds <= 0 or f64(time_now() - start) / 1000000000 < seconds {
		server_run(&server, &journal)
		sleep_ms(2)
	}
	print("served % ticks", server.state.ticks)
}

// How often a bot picks somewhere new to walk to, and says what it sees
// (seconds).
BOT_WALK_EVERY :: 2.0
BOT_STATUS_EVERY :: 1.0

// `throne bot [seconds] [address]`: a player with no window, linked as
// the game links (game_link: the game at the address, or the one on this
// machine, else hosting), walking somewhere new every BOT_WALK_EVERY
// seconds, for that many seconds (10 unless told). Every second it says
// where it is and whom it sees.
command_bot :: fun(seconds: f64, address: []utf8) {
	journal := open_journal()
	defer journal_close(&journal)
	walk : Walk_Grid
	exits : [WORLD_EXITS]Exit
	level_name, area := start_level(&journal, &walk, &exits)
	link : Link
	link_error := link_open(&link, &journal, address, level_name, area, &walk, exits)
	if link_error {
		print("bot couldn't join the game: %", link_error)
		return
	}
	defer link_close(&link)
	start := time_now()
	walks : u64 = 0
	next_walk : f64 = 0.5
	next_status : f64 = BOT_STATUS_EVERY
	most_seen : i64 = 0
	for true {
		gone := f64(time_now() - start) / 1000000000
		if gone >= seconds do break
		link_run(&link, &journal)
		seen := &link.seen
		if seen.me != 0 and gone >= next_walk {
			// Somewhere in the level's area, by chance this player and that walk alone have.
			chance := (seen.seed ~ (u64(seen.me) *% 0x9E3779B97F4A7C15) ~ (walks *% 0xBF58476D1CE4E5B9)) *% 0x94D049BB133111EB
			bounds := seen.area
			width := u64(max(bounds.right - bounds.left, f32(1)))
			height := u64(max(bounds.bottom - bounds.top, f32(1)))
			send_go(outgoing(&link), bounds.left + f32(chance % width), bounds.top + f32((chance >> 32) % height))
			walks += 1
			next_walk += BOT_WALK_EVERY
		}
		if gone >= next_status {
			bot_status(&link, &journal)
			next_status += BOT_STATUS_EVERY
		}
		most_seen = max(most_seen, seen.players.len)
		sleep_ms(5)
	}
	note(&journal, "bot done: player ")
	note(&journal, link.seen.me)
	note(&journal, if link.hosting do ", hosted" else ", joined")
	note(&journal, "; most players seen at once: ")
	note(&journal, most_seen)
	note_end(&journal)
}

// A line in the journal: which player the bot is, whether it hosts, and
// every player it's been told of, where they are.
bot_status :: fun(link: ^Link, journal: ^Journal) {
	seen := &link.seen
	note(journal, "bot: player ")
	note(journal, seen.me)
	note(journal, if link.hosting do " (hosting)" else " (joined)")
	if link.server_lost do note(journal, " (server lost)")
	note(journal, "; players:")
	for player in seen.players {
		note(journal, " ")
		note(journal, player.id)
		note(journal, " at ")
		note(journal, i64(player.x))
		note(journal, ",")
		note(journal, i64(player.y))
		if player.walking do note(journal, " walking")
	}
	note_end(journal)
}

// `throne controls [check]`: the controls a player would start with (the
// game's own, then the controls file's: written with the game's own when
// there's none), each action and what does it. check: og's game_controls
// tried on made-up input — a file read, written back and read again,
// actions held and let go, listening for a key, the wheel — saying what
// didn't come out as it should.
command_controls :: fun(check: bool) {
	if check {
		check_controls()
		return
	}
	journal := open_journal()
	defer journal_close(&journal)
	controls : Controls
	open_controls(&controls, &journal, true)
	for action, k in controls.actions do print("% = %", action.name, bindings_text(&controls, k))
}

// Where check_controls writes its file.
CONTROLS_CHECK_FILE :: "cache/controls_check.txt"

check_controls :: fun() {
	failures := 0
	controls : Controls
	start_error := game_own_controls(&controls)
	failures += expect(not start_error, "the game's own controls read")
	failures += expect(same_text(bindings_text(&controls, CONTROL_WALK), "Mouse_Left"), "walk starts on Mouse_Left")
	// A file: a comment, walk on two, strike on none, and three lines it
	// can't take (an action and a key with no such name, a line with no =).
	make_folder("cache")
	sample := "// a comment\nwalk = Space, Mouse_Left   // two of them\nstrike =\nfly = F3\nshow_collision = F99\nquit\n"
	sample_error := write_text_file(CONTROLS_CHECK_FILE, sample)
	failures += expect(not sample_error, "the sample file written")
	not_understood : [16]i64
	read_error := controls_read(&controls, CONTROLS_CHECK_FILE, &not_understood)
	failures += expect(not read_error, "the sample file read")
	failures += expect(same_text(bindings_text(&controls, CONTROL_WALK), "Space, Mouse_Left"), "walk on Space and Mouse_Left")
	failures += expect(same_text(bindings_text(&controls, CONTROL_STRIKE), ""), "strike on nothing")
	failures += expect(same_text(bindings_text(&controls, CONTROL_SHOW_COLLISION), "F2"), "show_collision kept on F2 (F99 is no key)")
	failures += expect(same_text(bindings_text(&controls, CONTROL_QUIT), "Escape"), "quit kept on Escape (its line has no =)")
	failures += expect(not_understood.len == 3 and not_understood[0] == 4 and not_understood[1] == 5 and not_understood[2] == 6,
		"lines 4, 5 and 6 not understood")
	// Written back and read again: the same, every line understood.
	write_error := controls_write(&controls, CONTROLS_CHECK_FILE, "The check's controls")
	failures += expect(not write_error, "the controls written back")
	again : Controls
	_ = game_own_controls(&again)
	again_error := controls_read(&again, CONTROLS_CHECK_FILE, &not_understood)
	failures += expect(not again_error and not_understood.len == 0, "the written file read back, every line")
	for k in 0:controls.actions.len {
		failures += expect(same_text(bindings_text(&again, k), bindings_text(&controls, k)), "an action the same read back")
	}
	// Space held three frames, then let go.
	input : Input
	input.pressed[Scancode.Space] = true
	input.held[Scancode.Space] = true
	controls_update(&controls, &input)
	failures += expect(action_down(&controls, CONTROL_WALK) and action_pressed(&controls, CONTROL_WALK), "walk pressed with Space")
	input.pressed[Scancode.Space] = false
	controls_update(&controls, &input)
	failures += expect(action_down(&controls, CONTROL_WALK) and not action_pressed(&controls, CONTROL_WALK), "walk held, not pressed again")
	input.held[Scancode.Space] = false
	controls_update(&controls, &input)
	failures += expect(not action_down(&controls, CONTROL_WALK) and action_released(&controls, CONTROL_WALK), "walk released")
	controls_update(&controls, &input)
	failures += expect(not action_released(&controls, CONTROL_WALK), "released one frame only")
	// Listening: G pressed is bound to strike, and does nothing that frame.
	controls_listen(&controls, CONTROL_STRIKE, 0)
	input.pressed[Scancode.G] = true
	input.held[Scancode.G] = true
	controls_update(&controls, &input)
	failures += expect(same_text(bindings_text(&controls, CONTROL_STRIKE), "G"), "strike listened onto G")
	failures += expect(not action_pressed(&controls, CONTROL_STRIKE), "the key listened for strikes nothing")
	failures += expect(controls.listening < 0 and controls.heard.kind == .keyboard and controls.heard_also < 0, "heard G, no other action on it")
	controls_update(&controls, &input)
	failures += expect(action_down(&controls, CONTROL_STRIKE), "strike down with G after")
	// F2 listened onto strike's second place: show_collision has it too.
	input.pressed[Scancode.G] = false
	input.held[Scancode.G] = false
	controls_listen(&controls, CONTROL_STRIKE, 1)
	input.pressed[Scancode.F2] = true
	controls_update(&controls, &input)
	input.pressed[Scancode.F2] = false
	failures += expect(same_text(bindings_text(&controls, CONTROL_STRIKE), "G, F2"), "strike on G and F2")
	failures += expect(controls.heard_also == CONTROL_SHOW_COLLISION, "F2 said to show collision too")
	// Escape stops listening, binding nothing.
	controls_listen(&controls, CONTROL_WALK, 0)
	input.pressed[Scancode.Escape] = true
	controls_update(&controls, &input)
	input.pressed[Scancode.Escape] = false
	failures += expect(controls.listening < 0 and same_text(bindings_text(&controls, CONTROL_WALK), "Space, Mouse_Left"), "Escape listens no more")
	// The wheel turned down quits, that frame only.
	wheel, _ := binding_named("Wheel_Down")
	_ = controls_bind(&controls, CONTROL_QUIT, 1, wheel)
	input.wheel = -1
	controls_update(&controls, &input)
	failures += expect(action_pressed(&controls, CONTROL_QUIT), "the wheel turned down quits")
	input.wheel = 0
	controls_update(&controls, &input)
	failures += expect(not action_down(&controls, CONTROL_QUIT), "the wheel down that frame only")
	// A mouse button listened for.
	controls_listen(&controls, CONTROL_SHOW_COLLISION, 0)
	input.mouse_pressed[2] = true
	controls_update(&controls, &input)
	input.mouse_pressed[2] = false
	failures += expect(same_text(bindings_text(&controls, CONTROL_SHOW_COLLISION), "Mouse_Middle"), "show_collision listened onto Mouse_Middle")
	if failures == 0 do print("controls check: all as they should be")
	else do print("controls check: % failed", failures)
}

// `throne stairs`: the party (one player) walked down the shrine's stairs
// and back up, on the server's world alone (no window, no network): where
// they arrive each way, and that walking about beside the stairs they came
// by doesn't take them back.
command_stairs :: fun() {
	journal := open_journal()
	defer journal_close(&journal)
	failures := 0
	state : World_State
	walk : Walk_Grid
	exits : [WORLD_EXITS]Exit
	level_name, area := start_level(&journal, &walk, &exits)
	world_start(&state, level_name, area, &walk, exits)
	player := &state.players[0]
	player_clear(player, 1, 0, &state)
	failures += expect(state.exits.len == 1 and same_text(state.exits[0].to_level, "Citadel1_Bedroom"), "the shrine's one way out, to the bedroom")
	if state.exits.len == 0 {
		print("stairs check: % failed", failures)
		return
	}
	walk_to(&state, player, state.exits[0].x, state.exits[0].y)
	failures += expect(take_stairs(&state, &journal), "the shrine's stairs taken")
	failures += expect(same_text(state.level, "Citadel1_Bedroom"), "down in the bedroom")
	print("down: player at %, %", i64(player.x), i64(player.y))
	// A step about beside the stairs back up: not taken.
	walk_to(&state, player, player.x + 24, player.y + 12)
	failures += expect(state.exit_taken < 0, "a step beside the stairs back doesn't take them")
	up := -1
	for exit, k in state.exits {
		if same_text(exit.to_level, "Citadel1_Shrine") do up = k
	}
	failures += expect(up >= 0, "the bedroom's stairs up to the shrine")
	if up >= 0 {
		// Away from them, then onto them.
		walk_to(&state, player, state.exits[up].x - 200, state.exits[up].y + 100)
		walk_to(&state, player, state.exits[up].x, state.exits[up].y)
		failures += expect(state.exit_taken == up, "the stairs up taken")
		failures += expect(take_stairs(&state, &journal) and same_text(state.level, "Citadel1_Shrine"), "back up in the shrine")
		print("up: player at %, %", i64(player.x), i64(player.y))
	}
	if failures == 0 do print("stairs check: all as they should be")
	else do print("stairs check: % failed", failures)
}

// A player walked to a spot, the world stepped till they're there, stopped
// or a way out's taken (20 seconds at most).
walk_to :: fun(state: ^World_State, player: ^Player_State, x: f32, y: f32) {
	player_go(player, x, y, state)
	for tick in 0:i64(20.0 / WORLD_TICK) {
		world_step(state)
		if not player.walking or state.exit_taken >= 0 do break
	}
}

// A check's outcome: 1 when it failed (and it says so), else 0.
expect :: fun(ok: bool, what: []utf8) -> i64 {
	if ok do return 0
	print("failed: %", what)
	return 1
}

// Text written to a file, over what was there.
write_text_file :: fun(path: []utf8, contents: []utf8) -> err {
	file := file_open_write(path)?
	defer file_close(file)
	file_write_text(file, contents)?
}

// ---- starting -----------------------------------------------------------------

usage :: fun() {
	print("throne                                 the game: joins one on this machine, else hosts")
	print("throne connect <address[:port]>        the game, joining the one at an address")
	print("throne serve [port] [seconds] [open]   a server alone, no window (port %)", GAME_PORT)
	print("throne bot [seconds] [address]         a player with no window, walking about")
	print("throne picture <out.png> [seconds] [address] [click x y] [strike] [collision]   the game unseen, its last frame written")
	print("throne sprite <archive> <path | folder> <out.png>   a sprite's frames as the game's atlas lays them out")
	print("throne walk-grid <level>               a level's walk grid: its size and open cells")
	print("throne music-cache <track>             a track (\"music\\castle.mp3\") unpacked where the game plays it from")
	print("throne controls [check]                what each action is on (from %); check: the controls tried", CONTROLS_FILE)
	print("throne stairs                          the party down the shrine's stairs and back, on the world alone: where they arrive")
}

// `throne music-cache <track>`: a music track, as World.ini names it,
// unpacked into the cache as the game does before playing it
// (music_cache.mara): says where, and how big.
command_music_cache :: fun(track: []utf8) {
	folder, music_error := track_folder(track)
	if music_error {
		print("couldn't cache %: %", track, music_error)
		return
	}
	print("% plays from %", track, folder)
}

// `throne walk-grid <level>`: a level's walk grid (World.ini's name for the
// level) read whether or not where it lies is known: its size and how many
// cells are open. For checking the grids unpack (tools/walk.py counts the same).
command_walk_grid :: fun(name: []utf8) {
	world : Lot
	directory : [1 * MB]byte = void
	open_error := lot_open(&world, lot_file_path(WORLD_ARCHIVE), &directory)
	if open_error {
		print("couldn't open the world's archive: %", open_error)
		return
	}
	defer lot_close(&world)
	layout : Layout
	file : [LEVEL_FILE_ROOM]byte = void
	info, level_error := read_level(&world, name, &layout, &file)
	if level_error {
		print("couldn't read the level %: %", name, level_error)
		return
	}
	path : [256]utf8
	&path + info.folder
	&path + info.layout_name
	&path + ".walk.sp"
	grid_file, found := lot_find(&world, path)
	if not found {
		print("no walk grid at %", path)
		return
	}
	read_error := lot_read(&world, grid_file, &file)
	if read_error {
		print("couldn't read %: %", path, read_error)
		return
	}
	walk : Walk_Grid
	stream : [WALK_FILE_ROOM]byte = void
	walk_error := walk_read(&walk, file, 0, 0, &stream)
	if walk_error {
		print("couldn't read %: %", path, walk_error)
		return
	}
	open : i64 = 0
	for up in 0:walk.height {
		for gx in 0:walk.width {
			if not cell_blocked(&walk, gx, up) do open += 1
		}
	}
	print("% walk grid: % x %, % cells open", name, walk.width, walk.height, open)
}

// `throne sprite <archive> <path | folder> <out.png>`: a sprite from one
// of the game's archives (a name in the game's LotFiles, or a path) — the
// file at path, or the first .s8 in the folder — drawn as the game's atlas
// for it lays its frames out (art.mara), written to out.png. No window.
command_sprite :: fun(archive_name: []utf8, path: []utf8, out_path: []utf8) {
	archive : Lot
	directory : [1 * MB]byte = void
	open_error := lot_open(&archive, lot_file_path(archive_name), &directory)
	if open_error {
		print("couldn't open %: %", archive_name, open_error)
		return
	}
	defer lot_close(&archive)
	print("% holds % files", archive_name, archive.files.len)
	sprite : [SPRITE_ROOM]byte = void
	image : [ATLAS_ROOM]byte = void
	atlas := Atlas{0}
	atlas_error : err
	file, found := lot_find(&archive, path)
	if found {
		read_error := lot_read(&archive, file, &sprite)
		if read_error {
			print("couldn't read %: %", path, read_error)
			return
		}
		check_error := spr8_check(sprite)
		if check_error {
			print("% isn't a sprite: %", path, check_error)
			return
		}
		palette, palette_error := spr8_palette(sprite)
		if palette_error {
			print("% has no palette: %", path, palette_error)
			return
		}
		atlas, atlas_error = atlas_shape(sprite, DIRECTIONS)
		if not atlas_error do atlas_error = atlas_draw(sprite, &palette, &atlas, &image)
	else
		atlas, atlas_error = read_atlas(&archive, path, &sprite, &image)
	}
	if atlas_error {
		print("couldn't draw %: %", path, atlas_error)
		return
	}
	print("% frames: % across, % down, cells % x % (canvas % x %, cells from % %)", atlas.columns * atlas.rows, atlas.columns,
		atlas.rows, atlas.cell_width, atlas.cell_height, atlas.canvas_width, atlas.canvas_height, atlas.left, atlas.top)
	png_storage : [ATLAS_ROOM]byte = void
	row_storage : [ATLAS_ROOM + 8 * KB]byte = void
	encode_png(image, atlas.width, atlas.height, &png_storage, &row_storage)
	write_error := write_entire_file(out_path, png_storage)
	if write_error do print("couldn't write %: %", out_path, write_error)
	else do print("written to %", out_path)
}

wait_for_enter :: fun() {
	print("press Enter to close")
	line : [256]byte
	_ = file_read(standard_input(), &line)   // (what's typed, or nothing: done either way)
}

main :: (args: [][]utf8) {
	if args.len < 2 {
		// Double-clicked, most likely: the console window goes when the
		// program does, so a message about not starting is waited on.
		if not command_play("") do wait_for_enter()
		return
	}
	command := args[1]
	if command == "help" {
		usage()
	elif command == "connect" and args.len > 2
		if not command_play(args[2]) do wait_for_enter()
	elif command == "serve"
		port : i64 = GAME_PORT
		seconds : f64 = 0
		open := false
		numbers : i64 = 0
		for k in 2:args.len {
			if args[k] == "open" {
				open = true
				continue
			}
			number, is_number := parse_number(args[k])
			if not is_number do continue
			if numbers == 0 do port = i64(number)
			else do seconds = number
			numbers += 1
		}
		command_serve(port, seconds, open)
	elif command == "picture" and args.len > 2
		seconds : f64 = 2
		address := args[1][0:0]
		click_x : f32 = 0.8
		click_y : f32 = 0.8
		strike := false
		collision := false
		k := 3
		for k < args.len {
			if args[k] == "strike" {
				strike = true
				k += 1
				continue
			}
			if args[k] == "collision" {
				collision = true
				k += 1
				continue
			}
			if args[k] == "click" and k + 2 < args.len {
				x, x_ok := parse_number(args[k + 1])
				y, y_ok := parse_number(args[k + 2])
				if x_ok and y_ok {
					click_x = f32(x)
					click_y = f32(y)
				}
				k += 3
				continue
			}
			number, is_number := parse_number(args[k])
			if is_number do seconds = number
			else do address = args[k]
			k += 1
		}
		command_picture(args[2], seconds, address, click_x, click_y, strike, collision)
	elif command == "walk-grid" and args.len > 2
		command_walk_grid(args[2])
	elif command == "controls"
		command_controls(args.len > 2 and args[2] == "check")
	elif command == "stairs"
		command_stairs()
	elif command == "music-cache" and args.len > 2
		command_music_cache(args[2])
	elif command == "sprite" and args.len > 4
		command_sprite(args[2], args[3], args[4])
	elif command == "bot"
		seconds : f64 = 10
		address := args[1][0:0]
		if args.len > 2 {
			number, is_number := parse_number(args[2])
			if is_number do seconds = number
		}
		if args.len > 3 do address = args[3]
		command_bot(seconds, address)
	else
		usage()
	}
}
