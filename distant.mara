// Distant land: the game's own low-detail land, drawn beyond the cells
// loaded in full, out to where the fog hides everything.
//
// A world's is in pieces of 32 x 32 cells. Each is a mesh already in the
// world's units (meshes\landscape\lod\), with two textures the editor made
// for it (textures\landscapelod\generated\): its colors, and its normals
// (_fn, in the world's axes: x east, y north, z up), which give its shading.
// A piece is named for its world's form id and its lowest cell:
// 60.-32.00.32 is Tamriel's from cell -32, 0.
//
// The far water goes with it: one stretch at sea level under all of it,
// as the game drew it.
module distant

use mara.core
use mara.math
use mara.string
use bsa
use nif
use model
use render
use scene

// The cells along each side of a piece.
LOD_CELLS :: 32
// How far from the world's middle pieces are looked for, in cells.
LOD_REACH :: 512

// The lowest cell of the piece a cell is in.
lod_corner :: fun(cell: i64) -> i64 {
	if cell >= 0 do return cell / LOD_CELLS * LOD_CELLS
	return -((-cell + LOD_CELLS - 1) / LOD_CELLS) * LOD_CELLS
}

// A grid number as the pieces' names have it: two digits at least, "-"
// before it when it's below 0.
grid_number_text :: fun(number: i64, text: ^[]utf8) {
	size := number
	if number < 0 {
		text + "-"
		size = -number
	}
	if size < 10 do text + "0"
	text + int_text(size)[:]
}

// A piece's name, from its world and its lowest cell: "60.-32.00.32".
lod_name :: fun(world_id: u32, x: i64, y: i64) -> str64 {
	name : str64
	&name + int_text(i64(world_id))[:]
	&name + "."
	grid_number_text(x, &name)
	&name + "."
	grid_number_text(y, &name)
	&name + ".32"
	return name
}

// Puts a world's distant land on the card in place of what's there: every
// piece of it the archives have (Tamriel has 36), then the far water under
// all of it. A piece whose mesh can't be read is left out; one whose
// normals are missing is lit as if flat. How many pieces went on.
load_distant_land :: fun(renderer: ^Renderer, world_id: u32, loader: Loader) -> i64 {
	clear_distant_land(renderer)
	renderer.distant_world = world_id
	room := loader.room
	low := Vec3{1000000000, 1000000000, 0}
	high := Vec3{-1000000000, -1000000000, 0}
	pieces : i64 = 0
	steps := LOD_REACH * 2 / LOD_CELLS
	for row in 0:steps {
		for column in 0:steps {
			x := column * LOD_CELLS - LOD_REACH
			y := row * LOD_CELLS - LOD_REACH
			name := lod_name(world_id, x, y)
			built, found := read_lod_mesh(loader.meshes, room, name[:])
			if not found do continue

			path : [256]utf8
			&path + "textures\\landscapelod\\generated\\"
			&path + name[:]
			&path + ".dds"
			colors := texture_for(renderer, loader.textures, path[:], &room.texture)
			path.len = path.len - 4
			&path + "_fn.dds"
			normals := texture_for(renderer, loader.textures, path[:], &room.texture)
			if normals == 0 do normals = renderer.flat_normal_texture

			for k in 0:built.parts.len {
				if upload_distant_piece(renderer, &built.parts[k], colors, normals) do pieces += 1
			}
			if built.bounds_min.x < low.x do low.x = built.bounds_min.x
			if built.bounds_min.y < low.y do low.y = built.bounds_min.y
			if built.bounds_max.x > high.x do high.x = built.bounds_max.x
			if built.bounds_max.y > high.y do high.y = built.bounds_max.y
		}
	}
	if pieces > 0 do set_far_water(renderer, low.x, low.y, high.x, high.y, 0)
	return pieces
}

// A piece's mesh, by its name, as a model (made in room); false when
// there's none, or it can't be read.
read_lod_mesh :: fun(meshes: ^Archive, room: ^Load_Room, name: []utf8) -> Model, bool {
	path : [256]utf8
	&path + "meshes\\landscape\\lod\\"
	&path + name
	&path + ".nif"
	index, found := find_file(meshes, path[:])
	if not found do return Model{0}, false
	room.file.len = 0
	data, read_error := read_file(meshes, index, &room.file)
	if read_error do return Model{0}, false
	room.blocks.len = 0
	failure := Nif_Failure{block = 0, type_name = room.file[0:0]}
	mesh, nif_error := read_nif(data, &room.blocks, &failure)
	if nif_error do return Model{0}, false
	room.model.len = 0
	built, model_error := build_model(&mesh, &room.model)
	if model_error do return Model{0}, false
	return built, true
}
