// Trees: the game's trees are SpeedTree 4 files (.spt), which hold how to
// grow a tree, not its shape: the game grew them with SpeedTree's library
// as it loaded them. This reads the files and grows trees after them in its
// own way: like the game's in size, outline and textures, not branch for
// branch.
//
// A .spt is a run of tags, each a number (u32) and a value whose size the
// tag says (TAG_*: tag_value_size). What's used here:
//   2000 the bark's texture, 2001 the tree's size, 2005 its seed, 2006 its
//     scale in percent (the size of everything below is a share of
//     size x scale / 100);
//   1016 .. 1017 a branch level (the trunk first, then each level of
//     branches on the one before; the last level's "branches" are where
//     the leaves go): 6000 disturbance, 6001 gravity, 6002 flexibility,
//     6003 flexibility's scale, 6004 length, 6005 radius (a share of the
//     branch's length), 6006 the radius along the branch, 6007 the angle
//     from the branch it grows on (curves: Tree_Curve); 6008 and 6009 the
//     segments around and along it; 6010 and 6011 where along it the next
//     level's branches start and stop; 6012 how many there are; 6013 and
//     6014 how often the bark's texture goes round and along;
//   1007 .. 1008 a leaf picture: 4004 where on it it's held, 4005 its size;
//     and 10002 each one's rectangle in the tree's leaf texture (its TREE
//     record's ICON, in textures\trees\leaves\).
module speedtree

use mara.core
use mara.math
use mara.string
use model

MAX_TREE_LEVELS :: 8
MAX_TREE_LEAVES :: 8
MAX_CURVE_POINTS :: 8

// Of the places the branch levels give for leaves, the share that get one
// (the rest would make the crown far thicker than the game's billboards).
LEAF_SHARE :: 0.25

// How many vertices a tree's bark or leaves can have (a part's indexes
// are 16-bit).
TREE_PART_VERTICES :: 65535

SPEED_TREE_HEADER :: "__IdvSpt_02_"

Speed_Tree_Error :: error {
	Not_A_Speed_Tree  // it doesn't start with SpeedTree 4's header
	Unknown_Tag       // a tag whose value's size isn't known
	Cut_Short         // a value runs past the file's end
	Bad_Curve         // a curve's text isn't one
}

// A value along a branch, as SpeedTree keeps one: a curve from x 0 to 1
// (where along the branch, or along the part of its parent it grows from)
// whose height 0 to 1 goes from low to high, and up to variance more or
// less at random.
Tree_Curve :: struct {
	low: f32
	high: f32
	variance: f32
	points: [MAX_CURVE_POINTS]Curve_Point
}

// A point the curve goes through, and its way on from there: a Bezier
// curve between each two, its control points the points' tangents (a
// direction and how far along it).
Curve_Point :: struct {
	x: f32
	y: f32
	tangent: [2!]f32
	reach: f32
}

// A level of branches (the first: the trunk).
Branch_Level :: struct {
	disturbance: Tree_Curve   // a random wander, its variance in degrees
	gravity: Tree_Curve       // how much it bends down (the willow's: 2 to 4)
	flexibility: Tree_Curve
	flexibility_scale: Tree_Curve
	length: Tree_Curve        // a share of the tree's size
	radius: Tree_Curve        // a share of its own length
	taper: Tree_Curve         // its radius along it, a share of the radius
	start_angle: Tree_Curve   // degrees from the branch it grows on (the trunk's -90: up)
	around: i64               // segments round it
	along: i64                // segments along it
	first_child: f32          // where along it the next level's branches start, 0 to 1
	last_child: f32           // and stop
	frequency: f32            // how many: this, times its length's share of the tree's size
	repeat_around: f32        // how often the bark's texture goes round it
	repeat_along: f32         // and along it
}

// A leaf picture of the tree's leaf texture: its size (a share of the
// tree's), where on it it's held (0 to 1 across and up), and its corners'
// places in the texture (right top, left top, left bottom, right bottom;
// u and v, v up).
Tree_Leaf :: struct {
	size: [2!]f32
	pivot: [2!]f32
	corners: [8!]f32
}

// What a SpeedTree file says, as used here (see the top).
Speed_Tree :: struct {
	bark: [64]utf8        // its bark texture's name: no folders or extension, lower case
	size: f32
	scale: f32            // percent
	seed: i64
	levels: [MAX_TREE_LEVELS]Branch_Level
	leaves: [MAX_TREE_LEAVES]Tree_Leaf
}

// ---- reading ----------------------------------------------------------------------

// A SpeedTree file's data read.
read_speed_tree :: fun(data: []byte, tree: ^Speed_Tree) -> err {
	tree.bark.len = 0
	tree.size = 0
	tree.scale = 100
	tree.seed = 0
	tree.levels.len = 0
	tree.leaves.len = 0
	in_level := false
	in_leaf := false
	at : i64 = 0
	first := true
	rectangles_seen := false
	for at < data.len {
		if at + 4 > data.len do return Cut_Short
		tag : u32 = data[at]
		at += 4
		size := tag_value_size(tag, data, at)?
		if at + size > data.len do return Cut_Short
		value := data[at : at + size]
		at += size
		if first {
			if tag != 1000 or text_of(value) != SPEED_TREE_HEADER do return Not_A_Speed_Tree
			first = false
			continue
		}
		if tag == 2000 {
			bark_name(text_of(value), &tree.bark)
		elif tag == 2001
			tree_size : f32 = value[0]
			tree.size = tree_size
		elif tag == 2005
			seed : i32 = value[0]
			tree.seed = i64(seed)
		elif tag == 2006
			scale : f32 = value[0]
			tree.scale = scale
		elif tag == 1016
			in_level = tree.levels.len < tree.levels.cap
			if in_level do &tree.levels + Branch_Level{0}
		elif tag == 1017
			in_level = false
		elif tag >= 6000 and tag <= 6017 and in_level
			read_level_value(&tree.levels[tree.levels.len - 1], tag, value)?
		elif tag == 1007
			in_leaf = tree.leaves.len < tree.leaves.cap
			if in_leaf do &tree.leaves + Tree_Leaf{0}
		elif tag == 1008
			in_leaf = false
		elif tag == 4004 and in_leaf
			across : f32 = value[0]
			up : f32 = value[4]
			tree.leaves[tree.leaves.len - 1].pivot = [across, up]
		elif tag == 4005 and in_leaf
			width : f32 = value[0]
			height : f32 = value[4]
			tree.leaves[tree.leaves.len - 1].size = [width, height]
		elif tag == 10002 and not rectangles_seen
			// A count, then each leaf picture's corners.
			rectangles_seen = true
			for k in 0:tree.leaves.len {
				if 4 + 32 * (k + 1) > value.len do break
				for c in 0:8 {
					corner : f32 = value[4 + 32 * k + 4 * c]
					tree.leaves[k].corners[c] = corner
				}
			}
		}
	}
	if first do return Not_A_Speed_Tree
}

// One of a branch level's values.
read_level_value :: fun(level: ^Branch_Level, tag: u32, value: []byte) -> err {
	text := text_of(value)
	if tag == 6000 do read_curve(text, &level.disturbance)?
	if tag == 6001 do read_curve(text, &level.gravity)?
	if tag == 6002 do read_curve(text, &level.flexibility)?
	if tag == 6003 do read_curve(text, &level.flexibility_scale)?
	if tag == 6004 do read_curve(text, &level.length)?
	if tag == 6005 do read_curve(text, &level.radius)?
	if tag == 6006 do read_curve(text, &level.taper)?
	if tag == 6007 do read_curve(text, &level.start_angle)?
	if tag < 6008 or tag > 6014 or value.len < 4 do return
	count : i32 = value[0]
	number : f32 = value[0]
	if tag == 6008 do level.around = i64(count)
	if tag == 6009 do level.along = i64(count)
	if tag == 6010 do level.first_child = number
	if tag == 6011 do level.last_child = number
	if tag == 6012 do level.frequency = number
	if tag == 6013 do level.repeat_around = number
	if tag == 6014 do level.repeat_along = number
}

// How many bytes a tag's value (at `at` in data) takes: by the tag, as the
// game's 113 trees have them.
tag_value_size :: fun(tag: u32, data: []byte, at: i64) -> i64, err {
	// Text: its length (u32), then it.
	curve := (tag >= 6000 and tag <= 6007) or tag == 6017 or tag == 13005
	named := tag == 1000 or tag == 2000 or tag == 4003 or tag == 14002 or tag == 20002
	if curve or named {
		if at + 4 > data.len do return 0, Cut_Short
		length_of_text : u32 = data[at]
		return 4 + i64(length_of_text)
	}
	// A count, then that many rectangles of 8 floats.
	if tag == 10002 or tag == 10003 or tag == 10004 {
		if at + 4 > data.len do return 0, Cut_Short
		count : u32 = data[at]
		return 4 + 32 * i64(count)
	}
	// Nothing: a group's start or end.
	if (tag >= 1001 and tag <= 1005) or (tag >= 1007 and tag <= 1012) or (tag >= 1015 and tag <= 1017) do return 0
	if tag == 9005 or tag == 9006 do return 0
	if tag >= 8000 and tag <= 20001 and tag % 1000 <= 1 do return 0
	// A byte.
	flag := tag == 2002 or tag == 3003 or tag == 3006 or tag == 3009 or tag == 4000 or tag == 5006 or tag == 6015
	other_flag := tag == 6016 or tag == 13007 or tag == 15002 or tag == 20003 or tag == 20004 or tag == 22000
	if flag or other_flag do return 1
	// Floats: three (a color, a place), or more.
	if tag == 4001 or (tag >= 4004 and tag <= 4006) or (tag >= 5000 and tag <= 5004) or (tag >= 18002 and tag <= 18004) do return 12
	if tag == 12002 do return 16
	if tag == 12003 do return 20
	if tag == 20005 do return 32
	if tag == 8003 or tag == 8005 or tag == 8009 do return 52   // a material: four colors and a shine
	// Four bytes: a number.
	if tag >= 1006 and tag <= 22000 do return 4
	return 0, Unknown_Tag
}

// A value's bytes as text.
text_of :: fun(value: []byte) -> []utf8 {
	if value.len < 4 do return value[0:0]
	return value[4 : value.len]
}

// The bark texture's name from the path the tree was made with
// (C:\...\TreeEnglishOakBark.tga): its file name without its extension,
// lower case.
bark_name :: fun(path: []utf8, name: ^[64]utf8) {
	name.len = 0
	start : i64 = 0
	end := path.len
	for c, k in path {
		if c == '\\' or c == '/' do start = k + 1
	}
	for k in start:path.len {
		if path[k] == '.' do end = k
	}
	for k in start:end {
		if name.len < name.cap do name + lower(path[k])
	}
}

// A curve from its text: "BezierSpline low high variance { count, then
// each point's x, y, tangent x and y, and reach }".
read_curve :: fun(text: []utf8, curve: ^Tree_Curve) -> err {
	at : i64 = 0
	if next_word(text, &at) != "BezierSpline" do return Bad_Curve
	curve.low = next_number(text, &at)?
	curve.high = next_number(text, &at)?
	curve.variance = next_number(text, &at)?
	if next_word(text, &at) != "{" do return Bad_Curve
	count := i64(next_number(text, &at)?)
	curve.points.len = 0
	for k in 0:count {
		x := next_number(text, &at)?
		y := next_number(text, &at)?
		tangent_x := next_number(text, &at)?
		tangent_y := next_number(text, &at)?
		reach := next_number(text, &at)?
		if curve.points.len < curve.points.cap do &curve.points + Curve_Point{x = x, y = y, tangent = [tangent_x, tangent_y], reach = reach}
	}
	if curve.points.len == 0 do return Bad_Curve
}

// The next word of text from at (past spaces, tabs and line ends), at
// moved past it.
next_word :: fun(text: []utf8, at: ^i64) -> []utf8 {
	for at^ < text.len and (text[at^] == ' ' or text[at^] == '\t' or text[at^] == '\n' or text[at^] == '\r') do at^ += 1
	start := at^
	for at^ < text.len and not (text[at^] == ' ' or text[at^] == '\t' or text[at^] == '\n' or text[at^] == '\r') do at^ += 1
	return text[start : at^]
}

// The next word of text as a number (1.5, -6.24607e-008).
next_number :: fun(text: []utf8, at: ^i64) -> f32, err {
	word := next_word(text, at)
	// (parse_number reads no exponent: MARA_ISSUES.md. It's read here.)
	mark := word.len
	for c, k in word {
		if c == 'e' or c == 'E' do mark = k
	}
	number, is_number := parse_number(word[0 : mark])
	if not is_number do return 0, Bad_Curve
	if mark < word.len {
		exponent_text := word[mark + 1 : word.len]
		if exponent_text.len > 0 and exponent_text[0] == '+' do exponent_text = exponent_text[1 : exponent_text.len]
		exponent, is_exponent := parse_number(exponent_text)
		if not is_exponent do return 0, Bad_Curve
		number *= pow(10.0, exponent)
	}
	return f32(number)
}

// ---- curves -------------------------------------------------------------------------

// The curve's height (0 to 1) at x (0 to 1).
curve_height :: fun(curve: ^Tree_Curve, x: f32) -> f32 {
	points := curve.points[:]
	if x <= points[0].x do return points[0].y
	last := points[points.len - 1]
	if x >= last.x do return last.y
	for k in 1:points.len {
		a := points[k - 1]
		b := points[k]
		if x > b.x do continue
		// The Bezier curve from a to b: its x goes up with t, so t is found
		// by halving, then its height there.
		x0 := a.x
		x1 := a.x + a.tangent[0] * a.reach
		x2 := b.x - b.tangent[0] * b.reach
		x3 := b.x
		y0 := a.y
		y1 := a.y + a.tangent[1] * a.reach
		y2 := b.y - b.tangent[1] * b.reach
		y3 := b.y
		low : f32 = 0
		high : f32 = 1
		for halving in 0:24 {
			t := (low + high) / 2
			if bezier(x0, x1, x2, x3, t) < x do low = t
			else do high = t
		}
		return bezier(y0, y1, y2, y3, (low + high) / 2)
	}
	return last.y
}

// A cubic Bezier curve's value at t (0 to 1), from its four values.
bezier :: fun(p0: f32, p1: f32, p2: f32, p3: f32, t: f32) -> f32 {
	u := 1 - t
	return u * u * u * p0 + 3 * u * u * t * p1 + 3 * u * t * t * p2 + t * t * t * p3
}

// The curve's value at x: between low and high by its height, with its
// variance at random.
curve_value :: fun(curve: ^Tree_Curve, x: f32, dice: ^u64) -> f32 {
	value := curve.low + (curve.high - curve.low) * curve_height(curve, x)
	if curve.variance != 0 do value += curve.variance * (2 * roll(dice) - 1)
	return value
}

// A number from 0 up to 1, the dice moved on (splitmix64).
roll :: fun(dice: ^u64) -> f32 {
	dice^ = dice^ +% 0x9E3779B97F4A7C15
	mixed := dice^
	mixed = (mixed ~ (mixed >> 30)) *% 0xBF58476D1CE4E5B9
	mixed = (mixed ~ (mixed >> 27)) *% 0x94D049BB133111EB
	mixed = mixed ~ (mixed >> 31)
	return f32(mixed >> 40) / 16777216
}

// ---- growing ----------------------------------------------------------------------

// A tree being grown: the dice, how big a share of its size is, and its
// bark's and leaves' vertices and indexes so far. (What it's grown after,
// the Speed_Tree, is passed beside it: kept in here, the checker takes it
// for stored in the storage the lists are carved from. MARA_ISSUES.md.)
Growth :: struct {
	dice: u64
	units: f32                // the tree's size, scaled: what lengths are shares of
	bark_vertices: []Vertex
	bark_indices: []u16
	leaf_vertices: []Vertex
	leaf_indices: []u16
	branches: i64
	leaves: i64
	left_out: i64             // branches or leaves with no room left
}

// The model of a tree grown from its SpeedTree parameters with a seed (the
// tree's own, or one of its TREE record's: each grows a different one):
// its bark, round its trunk and branches (textures\trees\branches\), and
// its leaves, cards that face the camera (leaf_texture), made in storage.
grow_tree :: fun(tree: ^Speed_Tree, seed: i64, leaf_texture: []utf8, storage: ^[]byte) -> Model, Growth_Report, err {
	report := Growth_Report{branches = 0, leaves = 0, left_out = 0}
	if tree.levels.len == 0 do return Model{0}, report, Not_A_Speed_Tree
	growth := Growth{
		dice = u64(seed) *% 0x2545F4914F6CDD1D +% 1,
		units = tree.size * tree.scale / 100,
		bark_vertices = slice([:TREE_PART_VERTICES]Vertex, storage),
		bark_indices = slice([:TREE_PART_VERTICES * 6]u16, storage),
		leaf_vertices = slice([:TREE_PART_VERTICES]Vertex, storage),
		leaf_indices = slice([:TREE_PART_VERTICES * 3 / 2]u16, storage),
		branches = 0, leaves = 0, left_out = 0}

	// The trunk: up, leaning a little (its start angle's variance) to a
	// side at random.
	trunk := &tree.levels[0]
	lean := (curve_value(&trunk.start_angle, 0, &growth.dice) + 90) * PI / 180
	side := roll(&growth.dice) * 2 * PI
	lean_axis := Vec3{cos_f32(side), sin_f32(side), 0}
	trunk_way := turned_about(Vec3{0, 0, 1}, lean_axis, lean)
	trunk_length := curve_value(&trunk.length, 0, &growth.dice) * growth.units
	trunk_radius := curve_value(&trunk.radius, 0, &growth.dice) * trunk_length
	grow_branch(&growth, tree, 0, Vec3{0, 0, 0}, trunk_way, trunk_length, trunk_radius, 0)
	shade_leaves(&growth)

	parts := slice([:2]Model_Part, storage)
	low := Vec3{1000000, 1000000, 1000000}
	high := Vec3{-1000000, -1000000, -1000000}
	for &vertex in growth.bark_vertices do widen(&low, &high, vertex.position, 0)
	for &vertex in growth.leaf_vertices do widen(&low, &high, vertex.position, max(abs_f32(vertex.tangent[0]), abs_f32(vertex.tangent[1])))
	bark_texture : [160]utf8
	&bark_texture + "textures\\trees\\branches\\"
	&bark_texture + tree.bark[:]
	&bark_texture + ".dds"
	if growth.bark_indices.len > 0 do &parts + tree_part(&growth, false, bark_texture[:])
	if growth.leaf_indices.len > 0 do &parts + tree_part(&growth, true, leaf_texture)
	report = Growth_Report{branches = growth.branches, leaves = growth.leaves, left_out = growth.left_out}
	return Model{parts = parts[:], flips = [], particles = [], motions = [], bounds_min = low, bounds_max = high}, report
}

// What growing a tree made: how many branches (the trunk one) and leaves,
// and how many were left out for want of room.
Growth_Report :: struct {
	branches: i64
	leaves: i64
	left_out: i64
}

// Grows a branch of a level from start, its way, length and radius, bent
// down by gravity as it goes; then the next level's branches on it, or
// where it's the level before the last, its leaves.
grow_branch :: fun(growth: ^Growth, tree: ^Speed_Tree, level_index: i64, start: Vec3, way: Vec3, branch_length: f32, radius: f32,
	gravity: f32)
{
	level := &tree.levels[level_index]
	along := max(level.along, 1)
	around := max(level.around, 3)
	ring_count := along + 1
	if growth.bark_vertices.len + ring_count * (around + 1) > growth.bark_vertices.cap {
		growth.left_out += 1
		return
	}
	growth.branches += 1

	// Its spine: a point at each ring, wandering (its disturbance) and bent
	// down (its gravity, as far as it reaches out sideways) a little at each.
	spine : [65]Vec3
	&spine + start
	heading := way
	wander := level.disturbance.variance * PI / 180
	step := branch_length / f32(along)
	for k in 0:min(along, spine.cap - 1) {
		if wander != 0 {
			turning := turned_about(square_to(heading), heading, roll(&growth.dice) * 2 * PI)
			heading = vec3_normalize(turned_about(heading, turning, (2 * roll(&growth.dice) - 1) * wander / f32(along)))
		}
		if gravity != 0 and level_index > 0 {
			sideways := sqrt_f32(heading.x * heading.x + heading.y * heading.y)
			bent := Vec3{heading.x, heading.y, heading.z - gravity * sideways / f32(along)}
			if vec3_length(bent) > 0.001 do heading = vec3_normalize(bent)
		}
		&spine + (spine[spine.len - 1] + heading * step)
	}
	add_tube(growth, level, spine[:], radius)

	// The next level's branches, or the leaves.
	if level_index + 1 >= tree.levels.len do return
	child_level := &tree.levels[level_index + 1]
	leaves_next := level_index + 2 == tree.levels.len
	first := level.first_child
	last := level.last_child
	count_share := level.frequency * (branch_length / growth.units) * (last - first)
	count := i64(count_share + roll(&growth.dice))
	turn_round := roll(&growth.dice) * 2 * PI
	for c in 0:count {
		t := first + (last - first) * (f32(c) + roll(&growth.dice)) / f32(count)
		// The child level's curves go across the part this one's children
		// grow from: 0 where they start, 1 where they stop.
		span : f32 = if last > first do (t - first) / (last - first) else 0
		at, parent_way := spine_at(spine[:], t)
		turn_round += 137.5 * PI / 180 + (2 * roll(&growth.dice) - 1) * 0.3
		out := turned_about(square_to(parent_way), parent_way, turn_round)
		angle := curve_value(&child_level.start_angle, span, &growth.dice) * PI / 180
		child_way := vec3_normalize(turned_about(parent_way, vec3_normalize(cross(parent_way, out)), angle))
		if leaves_next {
			if roll(&growth.dice) > LEAF_SHARE do continue
			// A leaf where the leaf level's stem would end.
			stem := curve_value(&child_level.length, span, &growth.dice) * growth.units
			add_leaf(growth, tree, at + child_way * stem)
			continue
		}
		child_length := curve_value(&child_level.length, span, &growth.dice) * growth.units
		if child_length <= 0 do continue
		child_radius := curve_value(&child_level.radius, span, &growth.dice) * child_length
		bend := curve_value(&child_level.gravity, span, &growth.dice)
		grow_branch(growth, tree, level_index + 1, at, child_way, child_length, child_radius, bend)
	}
}

// The point and way of a spine at t (0 to 1) along it.
spine_at :: fun(spine: []Vec3, t: f32) -> Vec3, Vec3 {
	segments := spine.len - 1
	place := t * f32(segments)
	k := min(max(i64(place), 0), segments - 1)
	share := place - f32(k)
	a := spine[k]
	b := spine[k + 1]
	return a + (b - a) * share, vec3_normalize(b - a)
}

// The bark round a spine: a ring of vertices at each of its points (its
// radius there by the level's taper), the rings joined; the texture going
// round and along it as often as the level says.
add_tube :: fun(growth: ^Growth, level: ^Branch_Level, spine: []Vec3, radius: f32) {
	around := max(level.around, 3)
	along := spine.len - 1
	first_vertex := growth.bark_vertices.len
	// A frame carried along the spine (each ring's right is the last one's,
	// turned no more than the spine does), so the bark doesn't twist.
	right := square_to(vec3_normalize(spine[1] - spine[0]))
	for k in 0..along {
		way := if k < along do vec3_normalize(spine[k + 1] - spine[k]) else vec3_normalize(spine[k] - spine[k - 1])
		right = right - way * dot(right, way)
		if vec3_length(right) < 0.0001 do right = square_to(way)
		right = vec3_normalize(right)
		up := cross(way, right)
		ring_radius := radius * curve_height(&level.taper, f32(k) / f32(along))
		for a in 0..around {
			angle := f32(a) / f32(around) * 2 * PI
			outward := right * cos_f32(angle) + up * sin_f32(angle)
			round_way := up * cos_f32(angle) - right * sin_f32(angle)
			&growth.bark_vertices + Vertex{
				position = spine[k] + outward * ring_radius,
				normal = outward,
				uv = [f32(a) / f32(around) * level.repeat_around, f32(k) / f32(along) * level.repeat_along],
				color = [1, 1, 1, 1],
				tangent = [round_way.x, round_way.y, round_way.z, 1]}
		}
	}
	for k in 0:along {
		for a in 0:around {
			here := first_vertex + k * (around + 1) + a
			above := here + around + 1
			&growth.bark_indices + u16(here)
			&growth.bark_indices + u16(here + 1)
			&growth.bark_indices + u16(above + 1)
			&growth.bark_indices + u16(here)
			&growth.bark_indices + u16(above + 1)
			&growth.bark_indices + u16(above)
		}
	}
}

// A leaf card at a place: one of the tree's leaf pictures at random, its
// size and its corners. A card's corners all sit at its place; each keeps
// how far it's set off across and up from there (its tangent's first two),
// which the renderer turns to face the camera.
add_leaf :: fun(growth: ^Growth, tree: ^Speed_Tree, place: Vec3) {
	if tree.leaves.len == 0 do return
	if growth.leaf_vertices.len + 4 > growth.leaf_vertices.cap {
		growth.left_out += 1
		return
	}
	growth.leaves += 1
	picture := &tree.leaves[min(i64(roll(&growth.dice) * f32(tree.leaves.len)), tree.leaves.len - 1)]
	width := picture.size[0] * growth.units
	height := picture.size[1] * growth.units
	// A little darker or lighter, the same all over.
	shade := 0.8 + 0.2 * roll(&growth.dice)
	first_vertex := growth.leaf_vertices.len
	// The corners as the leaf's rectangle has them: right top, left top,
	// left bottom, right bottom.
	across := [4!]f32{1, 0, 0, 1}
	up := [4!]f32{1, 1, 0, 0}
	for c in 0:4 {
		&growth.leaf_vertices + Vertex{
			position = place,
			normal = Vec3{0, 0, 1},
			// (v down in the texture as loaded: the file's is up.)
			uv = [picture.corners[2 * c], 1 - picture.corners[2 * c + 1]],
			color = [shade, shade, shade, 1],
			tangent = [(across[c] - picture.pivot[0]) * width, (up[c] - picture.pivot[1]) * height, 0, 1]}
	}
	for k in [0, 1, 2, 0, 2, 3] do &growth.leaf_indices + u16(first_vertex + k)
}

// The leaves' normals: out from the middle of the crown (and a little up),
// so its far side is in shade and its top in the sun.
shade_leaves :: fun(growth: ^Growth) {
	if growth.leaf_vertices.len == 0 do return
	middle := Vec3{0, 0, 0}
	for &vertex in growth.leaf_vertices do middle = middle + vertex.position
	middle = middle * (1 / f32(growth.leaf_vertices.len))
	for &vertex in growth.leaf_vertices {
		out := vertex.position - middle
		if vec3_length(out) < 0.001 do out = Vec3{0, 0, 1}
		vertex.normal = vec3_normalize(vec3_normalize(out) + Vec3{0, 0, 0.5})
	}
}

// A part of a growing tree's model: its bark (opaque) or its leaves (cut
// out by their texture's alpha, both sides, cards facing the camera).
tree_part :: fun(growth: ^Growth, leaves: bool, texture: []utf8) -> Model_Part {
	part := Model_Part{
		vertices = if leaves do growth.leaf_vertices else growth.bark_vertices,
		indices = if leaves do growth.leaf_indices else growth.bark_indices,
		texture = [],
		glow_texture = [],
		clamp_mode = 3,
		flip = -1,
		additive = false,
		billboard_mode = -1,
		billboard_node = mat4_identity(),
		alpha_blend = false,
		depth_write = true,
		alpha_test = leaves,
		alpha_threshold = if leaves do 0.5 else 0,
		two_sided = leaves,
		diffuse = Vec3{1, 1, 1},
		emissive = Vec3{0, 0, 0},
		specular = Vec3{0, 0, 0},
		glossiness = 10,
		alpha = 1,
		vertex_mode = 2,
		lighting_mode = 1,
		leaf_cards = leaves}
	&part.texture + texture[0 : min(texture.len, part.texture.cap)]
	return part
}

// Widens a box (low to high) to take in a point, and as far round it.
widen :: fun(low: ^Vec3, high: ^Vec3, point: Vec3, reach: f32) {
	for axis in 0:3 {
		low[axis] = min(low[axis], point[axis] - reach)
		high[axis] = max(high[axis], point[axis] + reach)
	}
}

// A way turned about an axis (of length 1) by an angle (radians).
turned_about :: fun(way: Vec3, axis: Vec3, angle: f32) -> Vec3 {
	c := cos_f32(angle)
	s := sin_f32(angle)
	return way * c + cross(axis, way) * s + axis * (dot(axis, way) * (1 - c))
}

// Some way square to another (of length 1).
square_to :: fun(way: Vec3) -> Vec3 {
	other := if abs_f32(way.x) < 0.9 do Vec3{1, 0, 0} else Vec3{0, 1, 0}
	return vec3_normalize(cross(way, other))
}
