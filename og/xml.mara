// XML read a piece at a time (next_piece): a tag — its name, attributes,
// whether it closes or closes itself — or the text up to the next one;
// comments are passed over. Nothing is kept but the tag just read, its
// attributes' values as where they are in the text (attribute gives one
// back, its name in any case). Names are as written. Entities
// (&…;) are left as they are: what they mean is each game's (Oblivion's
// menus have their own).
//
// Came from oblivion's menus.mara (83fce8a), which kept only the
// attributes Oblivion's menus use.
module xml

use mara.core
use mara.math
use mara.string
use logging

// A tag's attributes kept, at most (more are passed over).
XML_ATTRIBUTES :: 16

// An attribute: its name (up to 32 bytes kept), and where its value is in
// the text (between its quotes: from start, stopping before stop).
Xml_Attribute :: struct {
	name: [32]utf8
	start: i64
	stop: i64
}

// An element's tag: its name (up to 64 bytes kept), its attributes,
// whether it closes (</…>) and whether it closes itself (…/>).
Xml_Tag :: struct {
	name: [64]utf8
	attributes: [XML_ATTRIBUTES]Xml_Attribute
	closing: bool
	self_closing: bool
}

// What comes next in the XML from at: a tag (true, read into tag), or
// text up to the next '<' (false, its view in text_found). Comments are
// passed over. At the end: false and no text.
next_piece :: fun(text: []utf8, at: ^i64, tag: ^Xml_Tag) -> bool, []utf8 {
	for at^ < text.len {
		if text[at^] != '<' {
			start := at^
			for at^ < text.len and text[at^] != '<' do at^ += 1
			return false, text[start : at^]
		}
		// A comment: past its end.
		if at^ + 3 < text.len and text[at^ + 1] == '!' and text[at^ + 2] == '-' and text[at^ + 3] == '-' {
			at^ += 4
			for at^ + 2 < text.len and not (text[at^] == '-' and text[at^ + 1] == '-' and text[at^ + 2] == '>') do at^ += 1
			at^ = min(at^ + 3, text.len)
			continue
		}
		read_tag(text, at, tag)
		return true, text[0:0]
	}
	return false, text[0:0]
}

// A tag from at (on its '<'), into tag; at past its '>'.
read_tag :: fun(text: []utf8, at: ^i64, tag: ^Xml_Tag) {
	tag.name.len = 0
	tag.attributes.len = 0
	tag.closing = false
	tag.self_closing = false
	at^ += 1
	if at^ < text.len and text[at^] == '/' {
		tag.closing = true
		at^ += 1
	}
	for at^ < text.len and not is_xml_space(text[at^]) and text[at^] != '>' and text[at^] != '/' {
		if fits(tag.name.len + 1, tag.name.cap) do &tag.name + text[at^]
		at^ += 1
	}
	// Its attributes: name="value".
	for at^ < text.len and text[at^] != '>' {
		if text[at^] == '/' {
			tag.self_closing = true
			at^ += 1
			continue
		}
		if is_xml_space(text[at^]) {
			at^ += 1
			continue
		}
		name : [32]utf8
		for at^ < text.len and text[at^] != '=' and text[at^] != '>' and not is_xml_space(text[at^]) {
			if fits(name.len + 1, name.cap) do &name + text[at^]
			at^ += 1
		}
		for at^ < text.len and text[at^] != '"' and text[at^] != '>' do at^ += 1
		if at^ >= text.len or text[at^] != '"' do continue
		at^ += 1
		start := at^
		for at^ < text.len and text[at^] != '"' do at^ += 1
		if fits(tag.attributes.len + 1, tag.attributes.cap) do &tag.attributes + Xml_Attribute{name = name, start = start, stop = at^}
		if at^ < text.len do at^ += 1
	}
	if at^ < text.len do at^ += 1
}

// The value of an attribute of a tag read from text (a view of it), its
// name in any case; false when it has none.
attribute :: fun(text: []utf8, tag: ^Xml_Tag, name: []utf8) -> []utf8, bool {
	for &kept in tag.attributes {
		if kept.name.len == name.len and compare_folded(kept.name, name) == 0 do return text[kept.start : kept.stop], true
	}
	return text[0:0], false
}

is_xml_space :: fun(c: utf8) -> bool {
	return c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

// Text from the XML without the spaces round it.
trim_xml_text :: fun(text: []utf8) -> []utf8 {
	start : i64 = 0
	stop := text.len
	for start < stop and is_xml_space(text[start]) do start += 1
	for stop > start and is_xml_space(text[stop - 1]) do stop -= 1
	return text[start : stop]
}
