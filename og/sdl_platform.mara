// The window the game draws in, its OpenGL context, and the keyboard and
// mouse: what SDL gives the engine.
module sdl_platform

use mara.core
use mara.time
use mara.sdl
use mara.open_gl
use logging

// glFinish: waits for the card to draw everything asked of it; and
// glReadPixels, to read back what was drawn (read_pixels). (Not in
// mara.open_gl yet.)
foreign static_lib "opengl32" prefix gl {
	fun Finish()
	fun ReadPixels(x: i32, y: i32, width: i32, height: i32, format: u32, kind: u32, pixels: ^byte)
}
PIXELS_RGBA :: 0x1908    // GL_RGBA
PIXELS_BYTES :: 0x1401   // GL_UNSIGNED_BYTE

// What opening the window can fail with.
Platform_Error :: error {
	Init_Failed
	Window_Failed
	Context_Failed
}

// The keyboard and mouse as of the last events read.
Input :: struct {
	quit: bool                      // the window was closed
	pressed: [512 Scancode]bool     // keys that went down since the last read
	held: [512 Scancode]bool        // keys down now
	mouse_pressed: [6!]bool         // buttons by SDL's numbers: 1 left, 2 middle, 3 right
	mouse_held: [6!]bool
	mouse_x: f32                    // where the mouse is, in window pixels
	mouse_y: f32
	mouse_moved_x: f32              // how far it moved since the last read
	mouse_moved_y: f32
	wheel: f32
	focused: bool
}

// The window and its OpenGL context.
Platform :: struct {
	window: Window
	context: GLContext
	width: i64        // the window's size in pixels
	height: i64
	mouse_look: bool  // the mouse turns the camera, held in the window
	vsync: bool       // frames wait for the display's refresh
}

// Opens a window of the size given, with an OpenGL 4.5 core context;
// hidden, it's never shown (what's drawn is read back: read_pixels).
// Failing, the platform given back is all zeros: not to be used.
platform_open :: fun(title: []utf8, width: i64, height: i64, hidden: bool = false) -> Platform, err {
	if not sdl.Init(Video) do return Platform{0}, Init_Failed
	_ = sdl.GL_SetAttribute(ContextProfileMask, i32(GLprofile.Core))
	_ = sdl.GL_SetAttribute(ContextMajorVersion, 4)
	_ = sdl.GL_SetAttribute(ContextMinorVersion, 5)
	_ = sdl.GL_SetAttribute(DepthSize, 24)

	// The title copied into room of its own, a 0 after it, as C reads it:
	// title may be a view with no room past it.
	title_text : str256
	&title_text + title
	flags := OpenGL | Resizable
	if hidden do flags = OpenGL | Hidden
	window := sdl.CreateWindow(title_text, i32(width), i32(height), flags)
	if window == void do return Platform{0}, Window_Failed
	context := sdl.GL_CreateContext(window)
	if context == void do return Platform{0}, Context_Failed
	if not sdl.GL_MakeCurrent(window, context) do return Platform{0}, Context_Failed
	// Without vsync: with it, the frames the driver queues ahead hold back
	// what the mouse does (set_vsync turns it on).
	_ = sdl.GL_SetSwapInterval(0)
	gl_load(GL_GetProcAddress)

	platform := Platform{window = window, context = context, width = width, height = height, mouse_look = false, vsync = false}
	update_size(&platform)
	return platform
}

// The pixels of the framebuffer bound for reading, width by height from
// its bottom left, into pixels (its len set): red, green, blue and alpha
// bytes, the rows from the bottom up. None when pixels hasn't the room.
read_pixels :: fun(width: i64, height: i64, pixels: ^[]byte) {
	pixels.len = 0
	if not fits(width * height * 4, pixels.cap) do return
	pixels.len = width * height * 4
	ReadPixels(0, 0, i32(width), i32(height), PIXELS_RGBA, PIXELS_BYTES, pixels.ptr)
}

platform_close :: fun(platform: ^Platform) {
	sdl.DestroyWindow(platform.window)
	sdl.Quit()
}

// The window's size now, in pixels.
update_size :: fun(platform: ^Platform) {
	width : i32 = 0
	height : i32 = 0
	_ = sdl.GetWindowSizeInPixels(platform.window, &width, &height)
	platform.width = i64(width)
	platform.height = i64(height)
}

// Turns mouse look on or off: on, the cursor is hidden and held in the
// window, and its moves turn the camera however far it goes.
set_mouse_look :: fun(platform: ^Platform, on: bool) {
	platform.mouse_look = on
	_ = sdl.SetWindowRelativeMouseMode(platform.window, on)
}

// Reads the events that came since the last read into input.
read_input :: fun(platform: ^Platform, input: ^Input) {
	input.quit = false
	for k in 0:512 do input.pressed[k] = false
	for b in 0:6 do input.mouse_pressed[b] = false
	input.mouse_moved_x = 0
	input.mouse_moved_y = 0
	input.wheel = 0

	event: Event
	for PollEvent(&event) {
		match event {
		Quit
			input.quit = true
		KeyDown key
			input.pressed[key.scancode] = true
			input.held[key.scancode] = true
		KeyUp key
			input.held[key.scancode] = false
		MouseMotion
			input.mouse_moved_x += event.xrel
			input.mouse_moved_y += event.yrel
			input.mouse_x = event.x
			input.mouse_y = event.y
		MouseButtonDown
			input.mouse_pressed[i64(event.button)] = true
			input.mouse_held[i64(event.button)] = true
		MouseButtonUp
			input.mouse_held[i64(event.button)] = false
		MouseWheel
			input.wheel += event.y
		WindowFocusGained
			input.focused = true
		WindowFocusLost
			input.focused = false
		WindowPixelSizeChanged
			update_size(platform)
		else
		}
	}
}

// Waits for the card to finish what it's been asked to draw.
wait_for_card :: fun() {
	Finish()
}

// Shows what was drawn this frame, then waits for the card to finish it,
// so no frames queue up behind it: the next frame starts from input read
// after this one is up. How long the swap itself took, in nanoseconds
// (the rest was the wait after it).
present :: fun(platform: ^Platform) -> u64 {
	start := time_now()
	_ = GL_SwapWindow(platform.window)
	swapped := time_now()
	Finish()
	return swapped - start
}

// Turns waiting for the display's refresh on or off.
set_vsync :: fun(platform: ^Platform, on: bool) {
	platform.vsync = on
	interval : i32 = 0
	if on do interval = 1
	_ = sdl.GL_SetSwapInterval(interval)
}
