// Tables from keys to numbers (Key_Index), and the hashes that make keys of
// text. Came from sooblivion's world.mara (Key_Index) and its three copies
// of the same hash (83fce8a).
module indexing

use mara.core
use mara.string

Index_Error :: error {
	Index_Full   // an index with no room for another key: it's kept under half full
}

// A table from keys to values: a key is any number but 0 (a record's id, a
// path's hash, two numbers in one), a value up to a u32's. A power of two
// in size, kept under half full; a key is looked for from its hash's slot
// onward.
Key_Index :: struct {
	keys: []u64       // 0 in an empty slot
	values: []u32
	count: i64
}

// An empty index with room for capacity entries (a power of two), carved
// from storage (12 bytes an entry).
key_index :: fun(capacity: i64, storage: ^[]byte) -> Key_Index {
	keys := slice([:capacity]u64, storage)
	values := slice([:capacity]u32, storage)
	for i in 0:capacity {
		&keys + u64(0)
		&values + u32(0)
	}
	return Key_Index{keys = keys, values = values, count = 0}
}

// The slot a key's search starts at.
first_slot :: fun(index: ^Key_Index, key: u64) -> i64 {
	mixed := (key *% 0x9E3779B97F4A7C15) >> 32
	return i64(mixed) & (index.keys.len - 1)
}

// Puts a key's value in, in place of any it had. Index_Full when it would
// be half full.
index_put :: fun(index: ^Key_Index, key: u64, value: i64) -> err {
	if (index.count + 1) * 2 > index.keys.len do return Index_Full
	slot := first_slot(index, key)
	for index.keys[slot] != 0 and index.keys[slot] != key {
		slot = (slot + 1) & (index.keys.len - 1)
	}
	if index.keys[slot] == 0 do index.count += 1
	index.keys[slot] = key
	index.values[slot] = u32(value)
}

// The key's value, and false when the index doesn't have it.
index_get :: fun(index: ^Key_Index, key: u64) -> i64, bool {
	if key == 0 do return 0, false
	slot := first_slot(index, key)
	for index.keys[slot] != 0 {
		if index.keys[slot] == key do return i64(index.values[slot]), true
		slot = (slot + 1) & (index.keys.len - 1)
	}
	return 0, false
}

// A 64-bit FNV-1a hash of a text, never 0: a path's key in an index.
text_hash :: fun(text: []utf8) -> u64 {
	hash : u64 = 0xCBF29CE484222325
	for c in text do hash = (hash ~ u64(c)) *% 0x100000001B3
	if hash == 0 do hash = 1
	return hash
}

// The same hash of a text in lower case: a name's key, in any case.
folded_hash :: fun(text: []utf8) -> u64 {
	hash : u64 = 0xCBF29CE484222325
	for c in text do hash = (hash ~ u64(lower(c))) *% 0x100000001B3
	if hash == 0 do hash = 1
	return hash
}
