// The cache: files unpacked from a game's archives, kept on disk as they're
// unpacked, so they're read again without unpacking (unpacking is most of
// the time loading takes). In the cache folder, in the folder it's run
// from: the files' bytes one after another (CACHE_DATA_PATH), and a record
// of each (CACHE_INDEX_PATH): its key, where its bytes are and how many.
// Both only grow. A record's written after its bytes, so a run stopped
// between leaves bytes no record names, never a record of bytes that
// aren't there; a record half written doesn't pass its check, and the
// records after it are written over. One program at a time adds to it:
// another runs without it.
//
// Came from sooblivion (83fce8a), where it keeps what Oblivion's BSA
// archives unpack.
module file_cache

use mara.core
use mara.os
use mara.memory
use disk
use indexing

CACHE_FOLDER :: "cache"
CACHE_DATA_PATH :: "cache\\unpacked.data"
CACHE_INDEX_PATH :: "cache\\unpacked.index"

// The index's first record says what it is, in its key and at: these, or
// both files are begun afresh. (The magic is "SOOCACHE".)
CACHE_MAGIC :: 0x45484341434F4F53
CACHE_VERSION :: 1

// The most files and bytes it keeps; past either, no more are added.
CACHE_FILES :: 131072
CACHE_MOST_BYTES :: 16 * GB

// A file's record in the index, as it's written there: 32 bytes.
Cache_Record :: struct {
	key: u64
	at: i64       // where its bytes start in the data
	size: i64
	check: u64    // record_check's: a record half written doesn't pass
}

// Where a file's bytes are in the data.
Cache_Place :: struct {
	at: i64
	size: i64
}

File_Cache :: struct {
	usable: bool        // open, and read from
	adding: bool        // added to: not once a write has failed, or it's full
	failure: err        // why it's not usable, or not adding, if it isn't
	data: File_Id
	index_file: File_Id
	data_size: i64
	index_size: i64     // up to the last good record: where the next goes
	keys: Key_Index     // a file's key: its place's index in places
	places: [CACHE_FILES]Cache_Place
	// This run's: files read from it and added to it, and their bytes.
	read_count: i64
	read_bytes: i64
	added_count: i64
	added_bytes: i64
}

// A record's check: its fields mixed with the magic.
record_check :: fun(record: Cache_Record) -> u64 {
	return record.key ~ u64(record.at) ~ (u64(record.size) *% 0x9E3779B97F4A7C15) ~ CACHE_MAGIC
}

// A key made of two: for a file, its archive's stamp and the file's own
// hash, size and place in it. Never 0 (an empty key in a Key_Index).
mix_key :: fun(a: u64, b: u64) -> u64 {
	mixed := (a ~ (b *% 0x9E3779B97F4A7C15)) *% 0xBF58476D1CE4E5B9
	mixed = mixed ~ (mixed >> 31)
	return mixed | 1
}

// A cache not opened: archives are read as if there were none.
no_cache :: fun(cache: ^File_Cache) {
	cache.usable = false
	cache.adding = false
	cache.data = NO_FILE
	cache.index_file = NO_FILE
	cache.places.len = 0
	cache.read_count = 0
	cache.read_bytes = 0
	cache.added_count = 0
	cache.added_bytes = 0
}

// Opens the cache (made if there isn't one) and reads its index, the
// table of its keys taken from storage. After a failure (kept in failure)
// it isn't usable: archives are read as if there were none.
cache_open :: fun(cache: ^File_Cache, storage: ^[]byte) {
	no_cache(cache)
	open_error := open_cache_files(cache, storage)
	if open_error {
		cache.failure = open_error
		cache_close(cache)
	}
}

// Opens the cache's files and reads the index; begins both afresh when the
// index isn't one of this cache's.
open_cache_files :: fun(cache: ^File_Cache, storage: ^[]byte) -> err {
	make_folder(CACHE_FOLDER)
	cache.data = file_open_own(CACHE_DATA_PATH, false)?
	cache.index_file = file_open_own(CACHE_INDEX_PATH, false)?
	cache.keys = key_index(CACHE_FILES * 2, storage)
	cache.data_size = file_size(cache.data)?
	if not read_cache_index(cache)? {
		file_close(cache.data)
		file_close(cache.index_file)
		cache.data = NO_FILE
		cache.index_file = NO_FILE
		cache.data = file_open_own(CACHE_DATA_PATH, true)?
		cache.index_file = file_open_own(CACHE_INDEX_PATH, true)?
		cache.data_size = 0
		header := Cache_Record{key = CACHE_MAGIC, at = CACHE_VERSION, size = 0, check = 0}
		header.check = record_check(header)
		cache.index_size = 0
		write_record(cache, header)?
	}
	cache.usable = true
	cache.adding = true
}

// Reads the index's records into the table, up to the first that doesn't
// pass (a run stopped while writing it): false when the index isn't this
// cache's (or is empty).
read_cache_index :: fun(cache: ^File_Cache) -> bool, err {
	cache.index_size = 0
	_ = file_seek(cache.index_file, 0, SEEK_SET)?
	chunk : [64 * KB]byte
	for true {
		file_read(cache.index_file, &chunk)?
		records := chunk.len / size_of(Cache_Record)
		if records == 0 do break
		for r in 0:records {
			record : Cache_Record = chunk[r * size_of(Cache_Record)]
			if record.check != record_check(record) do return cache.index_size > 0
			if cache.index_size == 0 {
				if record.key != CACHE_MAGIC or record.at != CACHE_VERSION do return false
				cache.index_size = size_of(Cache_Record)
				continue
			}
			if record.at < 0 or record.size < 0 or record.at + record.size > cache.data_size do return true
			if cache.places.len == cache.places.cap do return true
			index_put(&cache.keys, record.key, cache.places.len)?
			&cache.places + Cache_Place{at = record.at, size = record.size}
			cache.index_size += size_of(Cache_Record)
		}
		// (On from the last whole record: a read may stop inside one.)
		_ = file_seek(cache.index_file, cache.index_size, SEEK_SET)?
	}
	return cache.index_size > 0
}

// Writes a record at the end of the index's good records.
write_record :: fun(cache: ^File_Cache, record: Cache_Record) -> err {
	bytes : [32!]byte
	bytes[0] = record
	_ = file_seek(cache.index_file, cache.index_size, SEEK_SET)?
	written := file_write(cache.index_file, bytes)?
	if written != bytes.len do return File_Error.Write_Failed
	cache.index_size += bytes.len
}

// The cached file with the key, read into storage after what it holds (its
// len moved past it): a view of storage, and false when the cache doesn't
// have it (or storage hasn't room: the caller reads it as without).
cache_read :: fun(cache: ^File_Cache, key: u64, storage: ^[]byte) -> []byte, bool {
	start := storage.len
	none := storage[start : start]
	if not cache.usable do return none, false
	place_index, found := index_get(&cache.keys, key)
	if not found do return none, false
	place := cache.places[place_index]
	if start + place.size > storage.cap do return none, false
	data := storage[start : start + place.size]
	_, seek_error := file_seek(cache.data, place.at, SEEK_SET)
	read_error := if seek_error do seek_error else read_exactly(cache.data, &data)
	if read_error {
		// A cache that can't be read is read no more.
		cache.failure = read_error
		cache.usable = false
		cache.adding = false
		return none, false
	}
	storage.len = start + place.size
	cache.read_count += 1
	cache.read_bytes += place.size
	return data, true
}

// Adds a file's bytes to the cache under its key, if it's being added to.
// A write that fails stops the adding (the failure kept); the cache is
// still read.
cache_add :: fun(cache: ^File_Cache, key: u64, data: []byte) {
	if not cache.adding do return
	if cache.places.len == cache.places.cap or cache.data_size + data.len > CACHE_MOST_BYTES {
		cache.adding = false
		return
	}
	add_error := add_to_cache(cache, key, data)
	if add_error {
		cache.failure = add_error
		cache.adding = false
	}
}

// Writes a file's bytes at the end of the data, then its record.
add_to_cache :: fun(cache: ^File_Cache, key: u64, data: []byte) -> err {
	at := cache.data_size
	_ = file_seek(cache.data, at, SEEK_SET)?
	written := file_write(cache.data, data)?
	if written != data.len do return File_Error.Write_Failed
	cache.data_size += data.len
	record := Cache_Record{key = key, at = at, size = data.len, check = 0}
	record.check = record_check(record)
	write_record(cache, record)?
	index_put(&cache.keys, key, cache.places.len)?
	&cache.places + Cache_Place{at = at, size = data.len}
	cache.added_count += 1
	cache.added_bytes += data.len
}

// Closes the cache's files: archives are read as if there were none.
cache_close :: fun(cache: ^File_Cache) {
	file_close(cache.data)
	file_close(cache.index_file)
	cache.data = NO_FILE
	cache.index_file = NO_FILE
	cache.usable = false
	cache.adding = false
}
